--- /dev/null
+++ b/features/support/storage.js
@@ -0,0 +1,22 @@
+// Module-level shared localStorage to persist across window recreations
+let _sharedStorage = {};
+
+function clearSharedStorage() {
+  _sharedStorage = {};
+}
+
+function getSharedStorage() {
+  return _sharedStorage;
+}
+
+function captureFromWindow(win) {
+  if (!win) return;
+  try {
+    for (let i = 0; i < win.localStorage.length; i++) {
+      const key = win.localStorage.key(i);
+      _sharedStorage[key] = win.localStorage.getItem(key);
+    }
+  } catch (e) {}
+}
+
+module.exports = { clearSharedStorage, getSharedStorage, captureFromWindow };
