@@ -0,0 +1,266 @@
+(function () {
+  'use strict';
+
+  var STORAGE_KEY = 'todos-vanillajs';
+  var ENTER_KEY = 13;
+  var ESCAPE_KEY = 27;
+
+  var todos = [];
+  var editingId = null;
+
+  var $newTodo = document.querySelector('.new-todo');
+  var $todoList = document.querySelector('.todo-list');
+  var $toggleAll = document.querySelector('#toggle-all');
+  var $main = document.querySelector('.main');
+  var $footer = document.querySelector('.footer');
+  var $count = document.querySelector('.todo-count strong');
+  var $countLabel = document.querySelector('.todo-count');
+  var $clearCompleted = document.querySelector('.clear-completed');
+  var $filters = document.querySelectorAll('.filters a');
+
+  function generateId() {
+    return Date.now().toString(36) + Math.random().toString(36).substr(2, 5);
+  }
+
+  function save() {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
+  }
+
+  function load() {
+    try {
+      var data = localStorage.getItem(STORAGE_KEY);
+      if (data) {
+        todos = JSON.parse(data);
+      }
+    } catch (e) {
+      todos = [];
+    }
+  }
+
+  function getActiveFilter() {
+    var hash = window.location.hash || '#/';
+    if (hash === '#/active') return 'active';
+    if (hash === '#/completed') return 'completed';
+    return 'all';
+  }
+
+  function getFilteredTodos() {
+    var filter = getActiveFilter();
+    if (filter === 'active') return todos.filter(function (t) { return !t.completed; });
+    if (filter === 'completed') return todos.filter(function (t) { return t.completed; });
+    return todos;
+  }
+
+  function getActiveCount() {
+    return todos.filter(function (t) { return !t.completed; }).length;
+  }
+
+  function render() {
+    var filtered = getFilteredTodos();
+    var activeCount = getActiveCount();
+    var completedCount = todos.length - activeCount;
+
+    // Render todo list
+    $todoList.innerHTML = '';
+    filtered.forEach(function (todo) {
+      var li = document.createElement('li');
+      li.dataset.id = todo.id;
+      if (todo.completed) li.classList.add('completed');
+      if (editingId === todo.id) li.classList.add('editing');
+
+      li.innerHTML =
+        '<div class="view">' +
+          '<input class="toggle" type="checkbox"' + (todo.completed ? ' checked' : '') + '>' +
+          '<label>' + escapeHtml(todo.title) + '</label>' +
+          '<button class="destroy"></button>' +
+        '</div>' +
+        '<input class="edit" value="' + escapeHtml(todo.title) + '">';
+
+      $todoList.appendChild(li);
+    });
+
+    // Update count
+    $count.textContent = activeCount;
+    var labelWord = activeCount === 1 ? 'item' : 'items';
+    $countLabel.innerHTML = '<strong>' + activeCount + '</strong> ' + labelWord + ' left';
+
+    // Show/hide sections
+    if (todos.length === 0) {
+      $main.style.display = 'none';
+      $footer.style.display = 'none';
+    } else {
+      $main.style.display = '';
+      $footer.style.display = '';
+    }
+
+    // Update toggle-all
+    $toggleAll.checked = todos.length > 0 && activeCount === 0;
+
+    // Update clear-completed
+    $clearCompleted.style.display = completedCount > 0 ? '' : 'none';
+
+    // Update filter links
+    var currentFilter = getActiveFilter();
+    $filters.forEach(function (link) {
+      link.classList.remove('selected');
+      var href = link.getAttribute('href');
+      if ((currentFilter === 'all' && href === '#/') ||
+          (currentFilter === 'active' && href === '#/active') ||
+          (currentFilter === 'completed' && href === '#/completed')) {
+        link.classList.add('selected');
+      }
+    });
+  }
+
+  function escapeHtml(text) {
+    var div = document.createElement('div');
+    div.textContent = text;
+    return div.innerHTML;
+  }
+
+  function addTodo(title) {
+    title = title.trim();
+    if (!title) return;
+    todos.push({
+      id: generateId(),
+      title: title,
+      completed: false
+    });
+    save();
+    render();
+  }
+
+  function toggleTodo(id) {
+    todos.forEach(function (todo) {
+      if (todo.id === id) {
+        todo.completed = !todo.completed;
+      }
+    });
+    save();
+    render();
+  }
+
+  function toggleAll() {
+    var allCompleted = todos.every(function (t) { return t.completed; });
+    todos.forEach(function (todo) {
+      todo.completed = !allCompleted;
+    });
+    save();
+    render();
+  }
+
+  function clearCompleted() {
+    todos = todos.filter(function (t) { return !t.completed; });
+    save();
+    render();
+  }
+
+  function deleteTodo(id) {
+    todos = todos.filter(function (t) { return t.id !== id; });
+    save();
+    render();
+  }
+
+  function startEdit(id) {
+    editingId = id;
+    render();
+    var editing = $todoList.querySelector('li.editing .edit');
+    if (editing) {
+      editing.focus();
+      editing.selectionStart = editing.value.length;
+    }
+  }
+
+  function saveEdit(id, title) {
+    title = title.trim();
+    if (!title) {
+      deleteTodo(id);
+      return;
+    }
+    todos.forEach(function (todo) {
+      if (todo.id === id) {
+        todo.title = title;
+      }
+    });
+    editingId = null;
+    save();
+    render();
+  }
+
+  function cancelEdit() {
+    editingId = null;
+    render();
+  }
+
+  // Event listeners
+  $newTodo.addEventListener('keydown', function (e) {
+    if (e.keyCode === ENTER_KEY) {
+      addTodo($newTodo.value);
+      $newTodo.value = '';
+    }
+  });
+
+  $todoList.addEventListener('change', function (e) {
+    if (e.target.classList.contains('toggle')) {
+      var li = e.target.closest('li');
+      toggleTodo(li.dataset.id);
+    }
+  });
+
+  $todoList.addEventListener('click', function (e) {
+    var li = e.target.closest('li');
+    if (!li) return;
+
+    if (e.target.classList.contains('destroy')) {
+      deleteTodo(li.dataset.id);
+    }
+  });
+
+  $todoList.addEventListener('dblclick', function (e) {
+    var li = e.target.closest('li');
+    if (!li) return;
+    if (e.target.tagName === 'LABEL') {
+      startEdit(li.dataset.id);
+    }
+  });
+
+  $todoList.addEventListener('keydown', function (e) {
+    var li = e.target.closest('li');
+    if (!li) return;
+    if (e.target.classList.contains('edit')) {
+      if (e.keyCode === ENTER_KEY) {
+        saveEdit(li.dataset.id, e.target.value);
+      } else if (e.keyCode === ESCAPE_KEY) {
+        cancelEdit();
+      }
+    }
+  });
+
+  $todoList.addEventListener('blur', function (e) {
+    if (e.target.classList.contains('edit')) {
+      var li = e.target.closest('li');
+      if (li) {
+        saveEdit(li.dataset.id, e.target.value);
+      }
+    }
+  }, true);
+
+  $toggleAll.addEventListener('change', function () {
+    toggleAll();
+  });
+
+  $clearCompleted.addEventListener('click', function () {
+    clearCompleted();
+  });
+
+  // Route changes
+  function onHashChange() {
+    render();
+  }
+
+  window.addEventListener('hashchange', onHashChange);
+
+  // Initialize
+  load();
+  render();
+})();
