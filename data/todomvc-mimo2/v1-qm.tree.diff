@@ -0,0 +1,292 @@
+const { Given, When, Then } = require('@cucumber/cucumber');
+const assert = require('assert');
+
+// ============ GIVEN ============
+
+Given('the todo app is loaded', function () {
+  this.loadApp();
+});
+
+Given('the user has added a todo {string}', function (title) {
+  const input = this.document.querySelector('.new-todo');
+  this.typeInInput(input, title);
+  this.pressEnter(input);
+});
+
+Given('the todo {string} is completed', function (title) {
+  const todo = this.findTodoByTitle(title);
+  if (!todo) throw new Error(`Todo "${title}" not found`);
+  const checkbox = todo.querySelector('.toggle');
+  if (!checkbox.checked) {
+    this.clickElement(checkbox);
+  }
+});
+
+Given('all todos are completed', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  if (!toggleAll.checked) {
+    this.clickElement(toggleAll);
+  }
+});
+
+// ============ WHEN ============
+
+When('the user types {string} in the new todo input', function (text) {
+  const input = this.document.querySelector('.new-todo');
+  this.typeInInput(input, text);
+});
+
+When('the user presses Enter', function () {
+  const input = this.document.querySelector('.new-todo');
+  this.pressEnter(input);
+});
+
+When('the user presses Escape', function () {
+  const editingInput = this.document.querySelector('.todo-list li.editing .edit');
+  if (editingInput) {
+    this.pressEscape(editingInput);
+  }
+});
+
+When('the user clicks {string}', function (buttonText) {
+  const buttons = this.document.querySelectorAll('button');
+  for (const btn of buttons) {
+    if (btn.textContent.trim() === buttonText) {
+      this.clickElement(btn);
+      return;
+    }
+  }
+  throw new Error(`Button "${buttonText}" not found`);
+});
+
+When('the user toggles the todo {string}', function (title) {
+  const todo = this.findTodoByTitle(title);
+  if (!todo) throw new Error(`Todo "${title}" not found`);
+  const checkbox = todo.querySelector('.toggle');
+  this.clickElement(checkbox);
+});
+
+When('the user clicks the toggle-all checkbox', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  this.clickElement(toggleAll);
+});
+
+When('the user double-clicks the todo {string}', function (title) {
+  const todo = this.findTodoByTitle(title);
+  if (!todo) throw new Error(`Todo "${title}" not found`);
+  const label = todo.querySelector('label');
+  this.doubleClickElement(label);
+});
+
+When('the user changes the edit input to {string}', function (text) {
+  const editingInput = this.document.querySelector('.todo-list li.editing .edit');
+  if (!editingInput) throw new Error('No editing input found');
+  this.typeInInput(editingInput, text);
+  // Trigger input event for reactivity
+  editingInput.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+});
+
+When('the user blurs the edit input', function () {
+  const editingInput = this.document.querySelector('.todo-list li.editing .edit');
+  if (!editingInput) throw new Error('No editing input found');
+  this.blurElement(editingInput);
+});
+
+When('the user navigates to {string}', function (hash) {
+  this.navigateTo(hash);
+});
+
+When('the user reloads the page', function () {
+  this.reloadPage();
+});
+
+// ============ THEN ============
+
+Then('the new todo input should be focused', function () {
+  const input = this.document.querySelector('.new-todo');
+  assert.strictEqual(input, this.document.activeElement,
+    'New todo input is not focused');
+});
+
+Then('the todo list should contain {int} item(s)', function (count) {
+  const todos = this.getTodos();
+  assert.strictEqual(todos.length, count,
+    `Expected ${count} todos, found ${todos.length}`);
+});
+
+Then('the todo {string} should be visible in the list', function (title) {
+  const todos = this.getTodos();
+  const visible = todos.filter(todo => {
+    const style = this.window.getComputedStyle(todo);
+    if (style.display === 'none') return false;
+    const label = todo.querySelector('label');
+    return label && label.textContent === title;
+  });
+  assert.ok(visible.length > 0, `Todo "${title}" not found in visible list`);
+});
+
+Then('the todo {string} should not be visible in the list', function (title) {
+  const todos = this.getTodos();
+  const visible = todos.filter(todo => {
+    const style = this.window.getComputedStyle(todo);
+    if (style.display === 'none') return false;
+    const label = todo.querySelector('label');
+    return label && label.textContent === title;
+  });
+  assert.strictEqual(visible.length, 0,
+    `Todo "${title}" should not be visible but was found`);
+});
+
+Then('the new todo input should be empty', function () {
+  const input = this.document.querySelector('.new-todo');
+  assert.strictEqual(input.value, '', 'New todo input is not empty');
+});
+
+Then('the todo {string} should have the completed class', function (title) {
+  const todo = this.findTodoByTitle(title);
+  assert.ok(todo, `Todo "${title}" not found`);
+  assert.ok(todo.classList.contains('completed'),
+    `Todo "${title}" does not have completed class`);
+});
+
+Then('the todo {string} should not have the completed class', function (title) {
+  const todo = this.findTodoByTitle(title);
+  assert.ok(todo, `Todo "${title}" not found`);
+  assert.ok(!todo.classList.contains('completed'),
+    `Todo "${title}" has completed class`);
+});
+
+Then('the todo {string} checkbox should be checked', function (title) {
+  const todo = this.findTodoByTitle(title);
+  assert.ok(todo, `Todo "${title}" not found`);
+  const checkbox = todo.querySelector('.toggle');
+  assert.ok(checkbox.checked, `Todo "${title}" checkbox is not checked`);
+});
+
+Then('the todo {string} checkbox should be unchecked', function (title) {
+  const todo = this.findTodoByTitle(title);
+  assert.ok(todo, `Todo "${title}" not found`);
+  const checkbox = todo.querySelector('.toggle');
+  assert.ok(!checkbox.checked, `Todo "${title}" checkbox is checked`);
+});
+
+Then('all todos should be completed', function () {
+  const todos = this.getTodos();
+  assert.ok(todos.length > 0, 'No todos found');
+  for (const todo of todos) {
+    assert.ok(todo.classList.contains('completed'),
+      `Todo "${todo.querySelector('label')?.textContent}" is not completed`);
+  }
+});
+
+Then('no todos should be completed', function () {
+  const todos = this.getTodos();
+  for (const todo of todos) {
+    assert.ok(!todo.classList.contains('completed'),
+      `Todo "${todo.querySelector('label')?.textContent}" is completed`);
+  }
+});
+
+Then('the toggle-all checkbox should be checked', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  assert.ok(toggleAll.checked, 'Toggle-all checkbox is not checked');
+});
+
+Then('the toggle-all checkbox should be unchecked', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  assert.ok(!toggleAll.checked, 'Toggle-all checkbox is checked');
+});
+
+Then('the active count should be {int}', function (count) {
+  const countEl = this.document.querySelector('.todo-count strong');
+  assert.ok(countEl, 'Active count element not found');
+  assert.strictEqual(parseInt(countEl.textContent, 10), count,
+    `Expected active count ${count}, found ${countEl.textContent}`);
+});
+
+Then('the active count label should be {string}', function (label) {
+  const countEl = this.document.querySelector('.todo-count');
+  assert.ok(countEl, 'Count element not found');
+  const text = countEl.textContent.trim();
+  assert.ok(text.includes(label),
+    `Expected count label to contain "${label}", got "${text}"`);
+});
+
+Then('the todo {string} should have the editing class', function (title) {
+  const todo = this.findTodoByTitle(title);
+  assert.ok(todo, `Todo "${title}" not found`);
+  assert.ok(todo.classList.contains('editing'),
+    `Todo "${title}" does not have editing class`);
+});
+
+Then('the edit input for {string} should be visible and focused', function (title) {
+  const todo = this.findTodoByTitle(title);
+  assert.ok(todo, `Todo "${title}" not found`);
+  const editInput = todo.querySelector('.edit');
+  assert.ok(editInput, 'Edit input not found');
+  const style = this.window.getComputedStyle(editInput);
+  assert.notStrictEqual(style.display, 'none', 'Edit input is hidden');
+  assert.strictEqual(editInput, this.document.activeElement,
+    'Edit input is not focused');
+});
+
+Then('the {string} section should be hidden', function (selector) {
+  const el = this.document.querySelector(selector);
+  assert.ok(el, `Element "${selector}" not found`);
+  const style = this.window.getComputedStyle(el);
+  assert.ok(style.display === 'none' || style.visibility === 'hidden' ||
+    style.opacity === '0' || el.hidden,
+    `Element "${selector}" is not hidden`);
+});
+
+Then('the {string} section should be visible', function (selector) {
+  const el = this.document.querySelector(selector);
+  assert.ok(el, `Element "${selector}" not found`);
+  const style = this.window.getComputedStyle(el);
+  assert.notStrictEqual(style.display, 'none',
+    `Element "${selector}" is hidden`);
+});
+
+Then('the {string} button should be hidden', function (buttonText) {
+  const buttons = this.document.querySelectorAll('button');
+  for (const btn of buttons) {
+    if (btn.textContent.trim() === buttonText) {
+      const style = this.window.getComputedStyle(btn);
+      assert.ok(style.display === 'none' || style.visibility === 'hidden' ||
+        btn.hidden,
+        `Button "${buttonText}" is not hidden`);
+      return;
+    }
+  }
+  // If button not found at all, it's effectively hidden
+});
+
+Then('the {string} button should be visible', function (buttonText) {
+  const buttons = this.document.querySelectorAll('button');
+  for (const btn of buttons) {
+    if (btn.textContent.trim() === buttonText) {
+      const style = this.window.getComputedStyle(btn);
+      assert.notStrictEqual(style.display, 'none',
+        `Button "${buttonText}" is hidden`);
+      return;
+    }
+  }
+  throw new Error(`Button "${buttonText}" not found`);
+});
+
+Then('the {string} filter should be selected', function (filterName) {
+  const links = this.document.querySelectorAll('.filters a');
+  for (const link of links) {
+    if (link.textContent.trim() === filterName) {
+      assert.ok(link.classList.contains('selected'),
+        `Filter "${filterName}" does not have selected class`);
+      return;
+    }
+  }
+  throw new Error(`Filter "${filterName}" not found`);
+});
+
+Then('localStorage should contain a key {string}', function (key) {
+  const value = this.window.localStorage.getItem(key);
+  assert.ok(value !== null, `localStorage key "${key}" not found`);
+});
