+const { setWorldConstructor, World } = require('@cucumber/cucumber');
+const fs = require('fs');
+const path = require('path');
+const { getSharedStorage, captureFromWindow } = require('./storage');
+
+class TodoWorld extends World {
+  constructor(options) {
+    super(options);
+    this.window = null;
+    this.document = null;
+    this._lastHash = '';
+  }
+
+  loadApp() {
+    // Capture localStorage from previous window before destroying
+    if (this.window) {
+      captureFromWindow(this.window);
+      try { this.window.close(); } catch (e) {}
+      this.window = null;
+      this.document = null;
+    }
+
+    const htmlPath = path.join(process.cwd(), 'index.html');
+    if (!fs.existsSync(htmlPath)) {
+      throw new Error('index.html not found at project root');
+    }
+    const html = fs.readFileSync(htmlPath, 'utf-8');
+    const jsCode = fs.readFileSync(path.join(process.cwd(), 'js/app.js'), 'utf-8');
+
+    const { Window } = require('happy-dom');
+    this.window = new Window({
+      url: 'http://localhost:3000/' + (this._lastHash || '')
+    });
+    this.document = this.window.document;
+
+    // Restore shared localStorage
+    const storage = getSharedStorage();
+    for (const [key, value] of Object.entries(storage)) {
+      this.window.localStorage.setItem(key, value);
+    }
+
+    this.document.open();
+    this.document.write(html);
+    this.document.close();
+
+    this.window.eval(jsCode);
+  }
+
+  typeInInput(input, text) {
+    input.value = text;
+    input.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+    input.dispatchEvent(new this.window.Event('change', { bubbles: true }));
+  }
+
+  pressEnter(input) {
+    input.dispatchEvent(new this.window.KeyboardEvent('keydown', {
+      key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true
+    }));
+  }
+
+  pressEscape(input) {
+    input.dispatchEvent(new this.window.KeyboardEvent('keydown', {
+      key: 'Escape', code: 'Escape', keyCode: 27, which: 27, bubbles: true
+    }));
+  }
+
+  clickElement(element) {
+    element.dispatchEvent(new this.window.MouseEvent('click', { bubbles: true }));
+  }
+
+  doubleClickElement(element) {
+    element.dispatchEvent(new this.window.MouseEvent('dblclick', { bubbles: true }));
+  }
+
+  blurElement(element) {
+    element.dispatchEvent(new this.window.Event('blur', { bubbles: true }));
+  }
+
+  getTodos() {
+    return Array.from(this.document.querySelectorAll('.todo-list li'));
+  }
+
+  findTodoByTitle(title) {
+    return this.getTodos().find(todo => {
+      const label = todo.querySelector('label');
+      return label && label.textContent === title;
+    });
+  }
+
+  navigateTo(hash) {
+    this.window.location.hash = hash;
+    this.window.dispatchEvent(new this.window.HashChangeEvent('hashchange', {
+      oldURL: 'http://localhost:3000/' + (this._lastHash || ''),
+      newURL: 'http://localhost:3000/' + hash
+    }));
+    this._lastHash = hash;
+  }
+
+  reloadPage() {
+    this.loadApp();
+  }
+}
+
+setWorldConstructor(TodoWorld);
