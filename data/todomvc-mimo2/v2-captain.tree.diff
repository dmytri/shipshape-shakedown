+  function reconcileTodoList(filtered) {
+    var existingLis = $todoList.querySelectorAll('li');
+    var existingMap = {};
+    for (var i = 0; i < existingLis.length; i++) {
+      existingMap[existingLis[i].dataset.id] = existingLis[i];
+    }
+
+    var seenIds = {};
+    var newOrder = [];
+
+    filtered.forEach(function (todo) {
+      seenIds[todo.id] = true;
+      var li = existingMap[todo.id];
+      if (li) {
+        updateTodoLi(li, todo);
+      } else {
+        li = createTodoLi(todo);
+      }
+      newOrder.push(li);
+    });
+
+    // Remove elements not in filtered list
+    for (var j = 0; j < existingLis.length; j++) {
+      if (!seenIds[existingLis[j].dataset.id]) {
+        existingLis[j].remove();
+      }
+    }
+
+    // Reorder DOM to match filtered order
+    for (var k = 0; k < newOrder.length; k++) {
+      $todoList.appendChild(newOrder[k]);
+    }
+  }
