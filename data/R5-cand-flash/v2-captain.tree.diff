--- a/.shipshape/conformance-rules.mjs
+++ b/.shipshape/conformance-rules.mjs
@@ -74,6 +74,45 @@ const RULES = {
     }
   },
 
+  // Rule: No guessed literal delays where a signal is observable
+  "no-guessed-delays": {
+    description: "No guessed literal delays (setTimeout with literal ms > 0); prefer signals",
+    check: (content, filePath) => {
+      if (!filePath.endsWith('.js') && !filePath.endsWith('.mjs')) return [];
+      const violations = [];
+      const delayRe = /setTimeout\s*\(\s*(?:function|\(|[a-zA-Z_$][a-zA-Z0-9_$]*\s*=>)/;
+      // More precise: catch setTimeout with a numeric literal
+      const literalRe = /setTimeout\s*\(\s*(?:[^,]+)\s*,\s*(\d+)\s*\)/g;
+      let match;
+      while ((match = literalRe.exec(content)) !== null) {
+        const ms = parseInt(match[1], 10);
+        if (ms > 0) {
+          const lineNum = content.substring(0, match.index).split('\n').length;
+          violations.push({ line: lineNum, text: match[0].substring(0, 60), file: filePath, detail: `Literal delay ${ms}ms` });
+        }
+      }
+      return violations;
+    }
+  },
+
+  // Rule: Render MUST NOT replace the todo list DOM nodes via innerHTML
+  // Toggling a todo, toggle-all, or clear-completed MUST mutate existing nodes
+  // in place so browser references stay attached.
+  "no-innerhtml-todolist": {
+    description: "Render MUST mutate existing DOM nodes in place; todoList.innerHTML replacement breaks browser element references",
+    check: (content, filePath) => {
+      if (filePath !== 'js/app.js') return [];
+      const violations = [];
+      const re = /todoList\.innerHTML\s*=\s*/g;
+      let match;
+      while ((match = re.exec(content)) !== null) {
+        const lineNum = content.substring(0, match.index).split('\n').length;
+        violations.push({ line: lineNum, file: filePath, detail: "todoList.innerHTML = ... replaces all DOM nodes; mutate in place instead" });
+      }
+      return violations;
+    }
+  },
+
   // Rule: No guessed literal delays where a signal is observable
   "no-guessed-delays": {
     description: "No guessed literal delays (setTimeout with literal ms > 0); prefer signals",
