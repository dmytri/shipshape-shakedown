@@ -142,4 +142,145 @@ Then('the render function must not recreate li elements that already exist', fun
   }
   // Don't block createElement('li') - that's needed for genuinely new todos
   // Instead verify the overall approach preserves existing nodes
+});
+
+// ---- destroyTodo conformance ----
+
+When('the conformance checker inspects the destroyTodo function', function () {
+  const fn = findTodoAppFunction(this.sourceCode, 'destroyTodo');
+  if (!fn) throw new Error('Could not find destroyTodo function in source');
+  this.currentFunction = fn;
+  this.currentFunctionName = 'destroyTodo';
+});
+
+Then('destroyTodo must not call render', function () {
+  const body = this.currentFunction.body;
+  if (/render\s*\(\s*\)/.test(body)) {
+    throw new Error('destroyTodo calls render');
+  }
+});
+
+Then('destroyTodo must not call save', function () {
+  const body = this.currentFunction.body;
+  if (/save\s*\(\s*\)/.test(body)) {
+    throw new Error('destroyTodo calls save');
+  }
+});
+
+// ---- Edit keydown Enter handler ----
+
+/**
+ * Find a named addEventListener handler inside bindEvents.
+ * Returns { body: string } for the handler function body.
+ */
+function findBindEventsHandler(source, eventType, captureFlag) {
+  const bindEventsFn = findTodoAppFunction(source, 'bindEvents');
+  if (!bindEventsFn) throw new Error('Could not find bindEvents function in source');
+  const body = bindEventsFn.body;
+
+  // Build pattern to find: .todo-list' ).addEventListener( '<eventType>' , function (e) { ...
+  // or with captureFlag true: , true )
+  var handlerRe;
+  if (captureFlag) {
+    handlerRe = new RegExp('querySelector\\s*\\(\\s*[\'"`]\\.todo-list[\'"`]\\s*\\)\\s*\\.\\s*addEventListener\\s*\\(\\s*[\'"`]' + eventType + '[\'"`]');
+  } else {
+    handlerRe = new RegExp('querySelector\\s*\\(\\s*[\'"`]\\.todo-list[\'"`]\\s*\\)\\s*\\.\\s*addEventListener\\s*\\(\\s*[\'"`]' + eventType + '[\'"`]\\s*,', 'g');
+  }
+  var match = handlerRe.exec(body);
+  if (!match) throw new Error('Could not find ' + eventType + ' handler registration for .todo-list');
+
+  var handlerDeclStart = match.index + match[0].length;
+  var braceStart = body.indexOf('{', handlerDeclStart);
+  if (braceStart === -1) throw new Error('Could not find opening brace of ' + eventType + ' handler');
+
+  // Count braces to find matching closing brace
+  var depth = 1;
+  var endIdx = -1;
+  for (var i = braceStart + 1; i < body.length; i++) {
+    if (body[i] === '{') depth++;
+    if (body[i] === '}') {
+      depth--;
+      if (depth === 0) { endIdx = i; break; }
+    }
+  }
+  if (endIdx === -1) throw new Error('Could not find end of ' + eventType + ' handler');
+
+  return { body: body.substring(braceStart, endIdx + 1) };
+}
+
+When('the conformance checker inspects the edit keydown Enter handler', function () {
+  // Find the full keydown handler on .todo-list
+  var handler = findBindEventsHandler(this.sourceCode, 'keydown', false);
+  var handlerBody = handler.body;
+
+  // Within the keydown handler, find the ENTER_KEY block
+  var enterBlockRe = /if\s*\(\s*e\.keyCode\s*===?\s*ENTER_KEY\s*\)/;
+  var match = enterBlockRe.exec(handlerBody);
+  if (!match) throw new Error('Could not find ENTER_KEY check in keydown handler');
+
+  var enterStart = match.index + match[0].length;
+  var braceStart = handlerBody.indexOf('{', enterStart);
+  if (braceStart === -1) throw new Error('Could not find opening brace of ENTER_KEY block');
+
+  var depth = 1;
+  var endIdx = -1;
+  for (var i = braceStart + 1; i < handlerBody.length; i++) {
+    if (handlerBody[i] === '{') depth++;
+    if (handlerBody[i] === '}') {
+      depth--;
+      if (depth === 0) { endIdx = i; break; }
+    }
+  }
+  if (endIdx === -1) throw new Error('Could not find end of ENTER_KEY block');
+
+  this.currentFunction = { body: handlerBody.substring(braceStart, endIdx + 1) };
+  this.currentFunctionName = 'editKeydownEnterHandler';
+});
+
+Then('the edit keydown Enter handler must not call save or render after destroyTodo', function () {
+  const body = this.currentFunction.body;
+  // Check that destroyTodo appears in the handler (required for empty-title case)
+  if (!body.includes('destroyTodo')) {
+    throw new Error('edit keydown Enter handler does not call destroyTodo');
+  }
+  // The destroyTodo index MUST be after any save/render call in the block
+  // i.e. save and render must NOT appear after destroyTodo
+  var destroyIdx = body.indexOf('destroyTodo');
+  var saveIdx = body.indexOf('save');
+  var renderIdx = body.indexOf('render');
+  if (destroyIdx === -1) throw new Error('Could not locate destroyTodo call in handler');
+  if (saveIdx !== -1 && saveIdx > destroyIdx) {
+    throw new Error('edit keydown Enter handler calls save after destroyTodo');
+  }
+  if (renderIdx !== -1 && renderIdx > destroyIdx) {
+    throw new Error('edit keydown Enter handler calls render after destroyTodo');
+  }
+});
+
+// ---- Edit blur handler ----
+
+When('the conformance checker inspects the edit blur handler', function () {
+  var handler = findBindEventsHandler(this.sourceCode, 'blur', true);
+  this.currentFunction = handler;
+  this.currentFunctionName = 'editBlurHandler';
+});
+
+Then('the blur handler must guard against model-absent todo before calling destroyTodo', function () {
+  const body = this.currentFunction.body;
+  // The handler MUST check that the todo still exists in the model before calling destroyTodo.
+  // Pattern: check if getTodo(id) returns non-null, or check if the todo is in this.todos.
+  if (!body.includes('destroyTodo')) {
+    throw new Error('Blur handler does not call destroyTodo');
+  }
+  // Find the position of destroyTodo
+  var destroyIdx = body.indexOf('destroyTodo');
+  // There must be a getTodo or this.todos.some/every/find check BEFORE the destroyTodo call
+  // that guards against an already-deleted todo
+  var guardBefore = body.substring(0, destroyIdx);
+  // Guard patterns: getTodo(id) or this.todos.some or this.todos.find
+  var hasGetTodoGuard = /getTodo\s*\(/.test(guardBefore);
+  var hasFindGuard = /\.todos\.(some|find|filter|indexOf)/.test(guardBefore);
+  if (!hasGetTodoGuard && !hasFindGuard) {
+    throw new Error('Blur handler calls destroyTodo without first checking whether the todo still exists in the model');
+  }
 });
