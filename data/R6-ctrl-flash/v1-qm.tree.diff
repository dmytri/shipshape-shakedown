+});
+
+Then('the Active filter link has the selected class', function () {
+  const links = this.document.querySelectorAll('.filters a');
+  const activeLink = Array.from(links).find(a => a.textContent === 'Active');
+  if (!activeLink) throw new Error('Active filter link not found');
+  if (!activeLink.classList.contains('selected')) {
+    throw new Error('Expected Active filter link to have selected class');
+  }
+});
+
+Then('the Completed filter link has the selected class', function () {
+  const links = this.document.querySelectorAll('.filters a');
+  const completedLink = Array.from(links).find(a => a.textContent === 'Completed');
+  if (!completedLink) throw new Error('Completed filter link not found');
+  if (!completedLink.classList.contains('selected')) {
+    throw new Error('Expected Completed filter link to have selected class');
+  }
+});
+
+Then('the Active filter link does not have the selected class', function () {
+  const links = this.document.querySelectorAll('.filters a');
+  const activeLink = Array.from(links).find(a => a.textContent === 'Active');
+  if (!activeLink) throw new Error('Active filter link not found');
+  if (activeLink.classList.contains('selected')) {
+    throw new Error('Expected Active filter link not to have selected class');
+  }
+});
+
+Then('the All filter link does not have the selected class', function () {
+  const links = this.document.querySelectorAll('.filters a');
+  const allLink = Array.from(links).find(a => a.textContent === 'All');
+  if (!allLink) throw new Error('All filter link not found');
+  if (allLink.classList.contains('selected')) {
+    throw new Error('Expected All filter link not to have selected class');
+  }
+});
+
+Then('the item has the title {string}', function (title) {
+  const items = this.document.querySelectorAll('.todo-list li');
+  for (const li of items) {
+    const label = li.querySelector('label');
+    if (label && label.textContent === title) return;
+  }
+  throw new Error(`No item with title "${title}" found`);
+});
+
+Then('the item is completed', function () {
+  const items = this.document.querySelectorAll('.todo-list li');
+  // Check if any visible item has completed class
+  for (const li of items) {
+    const style = this.window.getComputedStyle(li);
+    if (style.display !== 'none' && !li.hidden && li.classList.contains('completed')) return;
+  }
+  // Also check all items
+  for (const li of items) {
+    if (li.classList.contains('completed')) return;
+  }
+  throw new Error('No completed todo item found');
+});
+
+Then('the todo list shows only active todos', function () {
+  const items = this.document.querySelectorAll('.todo-list li');
+  for (const li of items) {
+    if (li.classList.contains('completed')) {
+      const style = this.window.getComputedStyle(li);
+      if (style.display !== 'none') {
+        const label = li.querySelector('label');
+        throw new Error(`Completed todo "${label ? label.textContent : 'unknown'}" is visible in Active filter`);
+      }
+    }
+  }
+});
