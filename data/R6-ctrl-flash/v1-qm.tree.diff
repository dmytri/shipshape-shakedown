+When('the user clicks the All filter link', function () {
+  this.navigate('#/');
+  if (this.window.todoApp) this.window.todoApp.render();
+});
+
+When('the user creates a todo {string}', function (title) {
+  const input = this.document.querySelector('.new-todo');
+  input.value = title;
+  input.dispatchEvent(new this.window.Event('change', { bubbles: true }));
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, which: 13, bubbles: true }));
+});
+
+When('the app is reloaded', function () {
+  // Save state
+  var savedData = {};
+  for (var i = 0; i < this.window.localStorage.length; i++) {
+    var key = this.window.localStorage.key(i);
+    savedData[key] = this.window.localStorage.getItem(key);
+  }
+  var savedHash = this.window.location.hash;
+
+  // Dispose old window
+  if (this.window.happyDOM && typeof this.window.happyDOM.close === 'function') {
+    this.window.happyDOM.close().catch(function(){});
+  }
+
+  // Create new window, load app
+  var fs = require('node:fs');
+  var path = require('node:path');
+  var Window = require('happy-dom').Window;
+  var w = new Window({ url: 'http://localhost/', settings: { disableJavaScriptFileLoading: true } });
+  var d = w.document;
+  d.write(fs.readFileSync(path.resolve(__dirname, '..', '..', 'index.html'), 'utf8'));
+  d.close();
+  w.eval(fs.readFileSync(path.resolve(__dirname, '..', '..', 'js', 'app.js'), 'utf8'));
+  d.dispatchEvent(new w.Event('DOMContentLoaded', { bubbles: true }));
+  w.dispatchEvent(new w.Event('load'));
+
+  // Restore localStorage
+  var ls = w.localStorage;
+  for (var k in savedData) {
+    if (savedData.hasOwnProperty(k)) {
+      ls.setItem(k, savedData[k]);
+    }
+  }
+
+  // Restore hash and trigger re-render
+  var needsRender = false;
+  if (savedHash && savedHash !== '#' && savedHash !== '') {
+    w.location.hash = savedHash;
+    needsRender = true;
+  }
+
+  // Re-init app with restored data
+  w.todoApp.init();
+
+  // If hash was restored and init reset it, re-set it and re-render
+  if (needsRender && w.location.hash === '') {
+    w.location.hash = savedHash;
+    w.todoApp.init();
+  }
+
+  // Replace the world's window/document
+  this.window = w;
+  this.document = d;
+});
