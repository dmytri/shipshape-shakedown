+const { Given, When, Then, Before, After } = require('@cucumber/cucumber');
+
+// Find a todo list item by title, falling back to data-original-title for renamed items.
+function findItem(document, title) {
+  const items = document.querySelectorAll('.todo-list li');
+  for (const li of items) {
+    const label = li.querySelector('label');
+    if (label && label.textContent === title) return li;
+  }
+  // Fallback: search by data-original-title for items renamed during edit
+  for (const li of items) {
+    if (li.getAttribute('data-original-title') === title) return li;
+  }
+  return null;
+}
+
+// ---- Background ----
+
+Given('the app is loaded fresh', function () {
+  // Already done by Before hook in world.js
+});
+
+Given('the app has no todos', function () {
+  // World loads fresh app on each scenario
+});
+
+Given('the new todo input is empty', function () {
+  // Fresh app starts with empty input by default
+});
+
+// ---- Given: todo creation helpers ----
+
+Given('the user has created a todo {string}', function (title) {
+  const input = this.document.querySelector('.new-todo');
+  input.value = title;
+  input.dispatchEvent(new this.window.Event('change', { bubbles: true }));
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, which: 13, bubbles: true }));
+});
+
+Given('the user has created a completed todo {string}', function (title) {
+  const input = this.document.querySelector('.new-todo');
+  input.value = title;
+  input.dispatchEvent(new this.window.Event('change', { bubbles: true }));
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, which: 13, bubbles: true }));
+  // Mark complete
+  const todoItems = this.document.querySelectorAll('.todo-list li');
+  const toggle = todoItems[todoItems.length - 1].querySelector('.toggle');
+  toggle.click();
+});
+
+Given('the user has created todos {string}, {string}', function (t1, t2) {
+  const input = this.document.querySelector('.new-todo');
+  [t1, t2].forEach(t => {
+    input.value = t;
+    input.dispatchEvent(new this.window.Event('change', { bubbles: true }));
+    input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, which: 13, bubbles: true }));
+  });
+});
+
+Given('the user has created todos {string}, {string}, {string}', function (t1, t2, t3) {
+  const input = this.document.querySelector('.new-todo');
+  [t1, t2, t3].forEach(t => {
+    input.value = t;
+    input.dispatchEvent(new this.window.Event('change', { bubbles: true }));
+    input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, which: 13, bubbles: true }));
+  });
+});
+
+Given('the user has created an active todo {string}', function (title) {
+  const input = this.document.querySelector('.new-todo');
+  input.value = title;
+  input.dispatchEvent(new this.window.Event('change', { bubbles: true }));
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, which: 13, bubbles: true }));
+});
+
+Given('the user has marked all todos complete', function () {
+  const toggleAll = this.document.querySelector('.toggle-all');
+  if (toggleAll) toggleAll.click();
+});
+
+// ---- When: actions ----
+
+When('the user types {string} and presses Enter', function (text) {
+  const input = this.document.querySelector('.new-todo');
+  input.value = text;
+  input.dispatchEvent(new this.window.Event('change', { bubbles: true }));
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, which: 13, bubbles: true }));
+});
+
+When('the user presses Enter on an empty input', function () {
+  const input = this.document.querySelector('.new-todo');
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, which: 13, bubbles: true }));
