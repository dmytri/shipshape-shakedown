+  editInput.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Escape', keyCode: 27, which: 27, bubbles: true }));
+});
+
+When('the user changes the edit input to {string} and blurs', function (newTitle) {
+  const editInput = this.document.querySelector('.todo-list li.editing .edit');
+  if (!editInput) throw new Error('No item in edit mode');
+  editInput.value = newTitle;
+  editInput.dispatchEvent(new this.window.Event('blur', { bubbles: true }));
+});
+
+When('the user marks {string} as complete', function (title) {
+  const li = findItem(this.document, title);
+  if (!li) throw new Error(`Todo item "${title}" not found`);
+  li.querySelector('.toggle').click();
