--- a/features/step_definitions/steps.js
+++ b/features/step_definitions/steps.js
@@ -510,8 +510,59 @@ Then(
   }
 );
 
+// ── Conformance: source inspection ──────────────────────────────────────
+let inspectedSource = null;
+let enterHandlerBlock = null;
+
+Given('the production source at {string}', function (relPath) {
+  const filePath = path.resolve(__dirname, '../../' + relPath);
+  if (!fs.existsSync(filePath)) {
+    throw new Error(`Source file "${relPath}" not found at ${filePath}`);
+  }
+  inspectedSource = fs.readFileSync(filePath, 'utf8');
+});
+
+When('the Enter keydown handler for the edit field is inspected', function () {
+  if (!inspectedSource) throw new Error('No source loaded');
+  // Find the keydown handler block that checks ENTER_KEY on .edit inputs
+  // The block is inside: if (e.target.classList.contains('edit'))
+  // We find the edit guard, then find the ENTER_KEY check inside it
+  var editKeyPattern = /e\.target\.classList\.contains\(\s*'edit'\s*\)[\s\S]*?ENTER_KEY[\s\S]*?\{([^}]*)\}/;
+  var match = editKeyPattern.exec(inspectedSource);
+  if (!match) {
+    throw new Error('Could not find Enter keydown handler block for edit field in source');
+  }
+  enterHandlerBlock = match[1];
+});
+
+Then('the handler calls {string} on the edit input', function (call) {
+  if (!enterHandlerBlock) throw new Error('No Enter handler block inspected');
+  // call is something like '.blur()' - check it appears in the handler block
+  if (enterHandlerBlock.indexOf(call) === -1) {
+    throw new Error(
+      `Enter handler does not call "${call}" on the edit input. ` +
+      `Handler block: ${enterHandlerBlock.trim()}`
+    );
+  }
+});
+
+Then('the handler does not call {string} directly', function (funcName) {
+  if (!enterHandlerBlock) throw new Error('No Enter handler block inspected');
+  // Check that the function name does NOT appear as a direct call in the handler
+  // We look for the function name followed by ( to detect a direct call
+  var directCallPattern = new RegExp('\\b' + funcName + '\\s*\\(');
+  if (directCallPattern.test(enterHandlerBlock)) {
+    throw new Error(
+      `Enter handler calls "${funcName}" directly, but should only call blur(). ` +
+      `Handler block: ${enterHandlerBlock.trim()}`
+    );
+  }
+});
+
 // ── After hook ─────────────────────────────────────────────────────────
 After(function () {
   teardown();
   parsedDocument = null;
+  inspectedSource = null;
+  enterHandlerBlock = null;
 });
