+// ── DOM identity ────────────────────────────────────────────────────────
+let storedTodoElement = null;
+
+Given('the DOM element for todo {string} is stored', function (title) {
+  const li = findTodoLi(title);
+  if (!li) throw new Error(`Todo "${title}" not found`);
+  storedTodoElement = li;
+});
+
+Then('the todo {string} DOM element is still the same', function (title) {
+  const li = findTodoLi(title);
+  if (!li) throw new Error(`Todo "${title}" not found`);
+  if (li !== storedTodoElement) {
+    throw new Error(
+      `Todo "${title}" DOM element was recreated (not preserved)`
+    );
+  }
+});
+
+// ── Edit mode visibility ────────────────────────────────────────────────
+Then('the toggle checkbox for {string} is hidden', function (title) {
+  const li = findTodoLi(title);
+  if (!li) throw new Error(`Todo "${title}" not found`);
+  const toggle = li.querySelector('.toggle');
+  if (!toggle) throw new Error(`Toggle checkbox not found for "${title}"`);
+  const style = win.getComputedStyle(toggle);
+  if (style.display !== 'none') {
+    throw new Error(
+      `Toggle checkbox for "${title}" is not hidden (display: ${style.display})`
+    );
+  }
+});
+
+Then('the delete button for {string} is hidden', function (title) {
+  const li = findTodoLi(title);
+  if (!li) throw new Error(`Todo "${title}" not found`);
+  const destroyBtn = li.querySelector('.destroy');
+  if (!destroyBtn) throw new Error(`Delete button not found for "${title}"`);
+  const style = win.getComputedStyle(destroyBtn);
+  if (style.display !== 'none') {
+    throw new Error(
+      `Delete button for "${title}" is not hidden (display: ${style.display})`
+    );
+  }
+});
