+Then('the label for {string} is hidden', function (title) {
+  const li = findTodoLi(title);
+  if (!li) throw new Error(`Todo "${title}" not found`);
+  const label = li.querySelector('.view label');
+  if (!label) throw new Error(`Label not found for "${title}"`);
+  const style = win.getComputedStyle(label);
+  if (style.display !== 'none') {
+    throw new Error(
+      `Label for "${title}" is not hidden (display: ${style.display})`
+    );
+  }
+});
