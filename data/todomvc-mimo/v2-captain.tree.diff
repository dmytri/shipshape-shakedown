+<!doctype html>
+<html lang="en">
+	<head>
+		<meta charset="utf-8">
+		<meta name="viewport" content="width=device-width, initial-scale=1">
+		<title>TodoMVC</title>
+		<link rel="stylesheet" href="node_modules/todomvc-common/base.css">
+		<link rel="stylesheet" href="node_modules/todomvc-app-css/index.css">
+		<link rel="stylesheet" href="css/app.css">
+	</head>
+	<body>
+		<section class="todoapp">
+			<header class="header">
+				<h1>todos</h1>
+				<input class="new-todo" placeholder="What needs to be done?" autofocus>
+			</header>
+			<section class="main">
+				<input id="toggle-all" class="toggle-all" type="checkbox">
+				<label for="toggle-all">Mark all as complete</label>
+				<ul class="todo-list"></ul>
+			</section>
+			<footer class="footer">
+				<span class="todo-count"><strong>0</strong> items left</span>
+				<ul class="filters">
+					<li>
+						<a class="selected" href="#/">All</a>
+					</li>
+					<li>
+						<a href="#/active">Active</a>
+					</li>
+					<li>
+						<a href="#/completed">Completed</a>
+					</li>
+				</ul>
+				<button class="clear-completed">Clear completed</button>
+			</footer>
+		</section>
+		<footer class="info">
+			<p>Double-click to edit a todo</p>
+			<p>Created by <a href="http://todomvc.com">you</a></p>
+			<p>Part of <a href="http://todomvc.com">TodoMVC</a></p>
+		</footer>
+		<script src="node_modules/todomvc-common/base.js"></script>
+		<script src="js/app.js"></script>
+	</body>
+</html>
diff --git a/js/app.js b/js/app.js
new file mode 100644
index 0000000..e9311c3
--- /dev/null
+++ b/js/app.js
@@ -0,0 +1,312 @@
+(function () {
+	'use strict';
+
+	var ENTER_KEY = 13;
+	var ESCAPE_KEY = 27;
+
+	var todos = [];
+	var selectedFilter = 'all';
+	var editingId = null;
+
+	var $ = function (sel) { return document.querySelector(sel); };
+	var $$ = function (sel) { return document.querySelectorAll(sel); };
+
+	function generateId() {
+		return Date.now() + Math.random().toString(36).slice(2, 9);
+	}
+
+	function save() {
+		localStorage.setItem('todos-javascript', JSON.stringify(todos));
+	}
+
+	function load() {
+		try {
+			todos = JSON.parse(localStorage.getItem('todos-javascript')) || [];
+		} catch (e) {
+			todos = [];
+		}
+	}
+
+	function getActiveTodos() {
+		return todos.filter(function (t) { return !t.completed; });
+	}
+
+	function getCompletedTodos() {
+		return todos.filter(function (t) { return t.completed; });
+	}
+
+	function getVisibleTodos() {
+		if (selectedFilter === 'active') {
+			return getActiveTodos();
+		}
+		if (selectedFilter === 'completed') {
+			return getCompletedTodos();
+		}
+		return todos;
+	}
+
+	function findTodo(title) {
+		for (var i = 0; i < todos.length; i++) {
+			if (todos[i].title === title) {
+				return todos[i];
+			}
+		}
+		return null;
+	}
+
+	function findTodoById(id) {
+		for (var i = 0; i < todos.length; i++) {
+			if (todos[i].id === id) {
+				return todos[i];
+			}
+		}
+		return null;
+	}
+
+	function pluralize(count) {
+		return count === 1 ? 'item' : 'items';
+	}
+
+	function render() {
+		var todoList = $('.todo-list');
+		var main = $('.main');
+		var footer = $('.footer');
+		var toggleAll = $('#toggle-all');
+		var todoCount = $('.todo-count');
+		var clearCompleted = $('.clear-completed');
+		var visibleTodos = getVisibleTodos();
+
+		todoList.innerHTML = '';
+
+		visibleTodos.forEach(function (todo) {
+			var li = document.createElement('li');
+			li.setAttribute('data-id', todo.id);
+			if (todo.completed) {
+				li.classList.add('completed');
+			}
+			if (editingId === todo.id) {
+				li.classList.add('editing');
+			}
+
+			li.innerHTML =
+				'<div class="view">' +
+					'<input class="toggle" type="checkbox"' + (todo.completed ? ' checked' : '') + '>' +
+					'<label>' + escapeHtml(todo.title) + '</label>' +
+					'<button class="destroy"></button>' +
+				'</div>' +
+				'<input class="edit" value="' + escapeHtml(todo.title) + '">';
+
+			todoList.appendChild(li);
+		});
+
+		if (todos.length === 0) {
+			main.style.display = 'none';
+			footer.style.display = 'none';
+		} else {
+			main.style.display = '';
+			footer.style.display = '';
+		}
+
+		var activeCount = getActiveTodos().length;
+		todoCount.innerHTML = '<strong>' + activeCount + '</strong> ' + pluralize(activeCount) + ' left';
+
+		var allCompleted = todos.length > 0 && getActiveTodos().length === 0;
+		toggleAll.checked = allCompleted;
+
+		var completedCount = getCompletedTodos().length;
+		clearCompleted.style.display = completedCount > 0 ? '' : 'none';
+
+		$$('#filters a').forEach(function (a) {
+			a.classList.remove('selected');
+		});
+		var filterMap = { all: '#/', active: '#/active', completed: '#/completed' };
+		var selectedLink = document.querySelector('.filters a[href="' + filterMap[selectedFilter] + '"]');
+		if (selectedLink) {
+			selectedLink.classList.add('selected');
+		}
+	}
+
+	function escapeHtml(text) {
+		var div = document.createElement('div');
+		div.appendChild(document.createTextNode(text));
+		return div.innerHTML;
+	}
+
+	function addTodo(title) {
+		var trimmed = title.trim();
+		if (trimmed === '') {
+			return;
+		}
+		todos.push({
+			id: generateId(),
+			title: trimmed,
+			completed: false
+		});
+		save();
+		render();
+	}
+
+	function toggleTodo(id) {
+		var todo = findTodoById(id);
+		if (todo) {
+			todo.completed = !todo.completed;
+			save();
+			render();
+		}
+	}
+
+	function destroyTodo(id) {
+		todos = todos.filter(function (t) { return t.id !== id; });
+		save();
+		render();
+	}
+
+	function toggleAll() {
+		var allCompleted = getActiveTodos().length === 0;
+		todos.forEach(function (t) {
+			t.completed = !allCompleted;
+		});
+		save();
+		render();
+	}
+
+	function clearCompleted() {
+		todos = getActiveTodos();
+		save();
+		render();
+	}
+
+	function startEditing(id) {
+		editingId = id;
+		render();
+		var todo = findTodoById(id);
+		if (todo) {
+			var items = $$('.todo-list li');
+			for (var i = 0; i < items.length; i++) {
+				if (items[i].getAttribute('data-id') === id) {
+					var editInput = items[i].querySelector('.edit');
+					editInput.focus();
+					editInput.setSelectionRange(editInput.value.length, editInput.value.length);
+					break;
+				}
+			}
+		}
+	}
+
+	function saveEdit(id, newTitle) {
+		var trimmed = newTitle.trim();
+		if (trimmed === '') {
+			destroyTodo(id);
+			return;
+		}
+		var todo = findTodoById(id);
+		if (todo) {
+			todo.title = trimmed;
+			editingId = null;
+			save();
+			render();
+		}
+	}
+
+	function cancelEdit() {
+		editingId = null;
+		render();
+	}
+
+	function handleHashChange() {
+		var hash = window.location.hash || '#/';
+		if (hash === '#/active') {
+			selectedFilter = 'active';
+		} else if (hash === '#/completed') {
+			selectedFilter = 'completed';
+		} else {
+			selectedFilter = 'all';
+		}
+		render();
+	}
+
+	function getTodoIdFromEvent(e) {
+		var target = e.target;
+		while (target && target !== document) {
+			if (target.tagName === 'LI' && target.getAttribute('data-id')) {
+				return target.getAttribute('data-id');
+			}
+			target = target.parentNode;
+		}
+		return null;
+	}
+
+	function init() {
+		load();
+		handleHashChange();
+
+		var newTodoInput = $('.new-todo');
+		var todoList = $('.todo-list');
+		var toggleAllBtn = $('#toggle-all');
+		var clearCompletedBtn = $('.clear-completed');
+
+		newTodoInput.addEventListener('keydown', function (e) {
+			if (e.keyCode === ENTER_KEY) {
+				addTodo(newTodoInput.value);
+				newTodoInput.value = '';
+			}
+		});
+
+		todoList.addEventListener('click', function (e) {
+			var id = getTodoIdFromEvent(e);
+			if (!id) {
+				return;
+			}
+			if (e.target.classList.contains('toggle')) {
+				toggleTodo(id);
+			} else if (e.target.classList.contains('destroy')) {
+				destroyTodo(id);
+			}
+		});
+
+		todoList.addEventListener('dblclick', function (e) {
+			var id = getTodoIdFromEvent(e);
+			if (!id) {
+				return;
+			}
+			if (e.target.tagName === 'LABEL') {
+				startEditing(id);
+			}
+		});
+
+		todoList.addEventListener('keydown', function (e) {
+			var id = getTodoIdFromEvent(e);
+			if (!id) {
+				return;
+			}
+			if (e.target.classList.contains('edit')) {
+				if (e.keyCode === ENTER_KEY) {
+					saveEdit(id, e.target.value);
+				} else if (e.keyCode === ESCAPE_KEY) {
+					cancelEdit();
+				}
+			}
+		});
+
+		todoList.addEventListener('blur', function (e) {
+			if (e.target.classList.contains('edit')) {
+				var id = getTodoIdFromEvent(e);
+				if (id) {
+					saveEdit(id, e.target.value);
+				}
+			}
+		}, true);
+
+		toggleAllBtn.addEventListener('change', function () {
+			toggleAll();
+		});
+
+		clearCompletedBtn.addEventListener('click', function () {
+			clearCompleted();
+		});
+
+		window.addEventListener('hashchange', handleHashChange);
+	}
+
+	document.addEventListener('DOMContentLoaded', init);
+})();
