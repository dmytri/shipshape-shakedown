@@ -0,0 +1,291 @@
+(function () {
+	'use strict';
+
+	var ENTER_KEY = 13;
+	var ESCAPE_KEY = 27;
+	var STORAGE_KEY = 'todos-vanillajs';
+
+	// ── Model ──────────────────────────────────────────────────────────────
+
+	var todos = [];
+	var nextId = 1;
+
+	function save() {
+		localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
+	}
+
+	function load() {
+		try {
+			var raw = localStorage.getItem(STORAGE_KEY);
+			if (raw) {
+				todos = JSON.parse(raw);
+				// restore nextId above any existing ids
+				for (var i = 0; i < todos.length; i++) {
+					if (todos[i].id >= nextId) nextId = todos[i].id + 1;
+				}
+			}
+		} catch (e) {
+			todos = [];
+		}
+	}
+
+	function createTodo(title) {
+		var todo = { id: nextId++, title: title, completed: false };
+		todos.push(todo);
+		save();
+		return todo;
+	}
+
+	function destroyTodo(id) {
+		todos = todos.filter(function (t) { return t.id !== id; });
+		save();
+	}
+
+	function toggleTodo(id) {
+		for (var i = 0; i < todos.length; i++) {
+			if (todos[i].id === id) {
+				todos[i].completed = !todos[i].completed;
+				break;
+			}
+		}
+		save();
+	}
+
+	function toggleAll(checked) {
+		for (var i = 0; i < todos.length; i++) {
+			todos[i].completed = checked;
+		}
+		save();
+	}
+
+	function clearCompleted() {
+		todos = todos.filter(function (t) { return !t.completed; });
+		save();
+	}
+
+	function updateTodo(id, title) {
+		for (var i = 0; i < todos.length; i++) {
+			if (todos[i].id === id) {
+				todos[i].title = title;
+				break;
+			}
+		}
+		save();
+	}
+
+	function getFilteredTodos(route) {
+		if (route === '#/active') {
+			return todos.filter(function (t) { return !t.completed; });
+		}
+		if (route === '#/completed') {
+			return todos.filter(function (t) { return t.completed; });
+		}
+		return todos.slice();
+	}
+
+	// ── DOM helpers ────────────────────────────────────────────────────────
+
+	var newTodoInput = document.querySelector('.new-todo');
+	var todoList = document.querySelector('.todo-list');
+	var mainSection = document.querySelector('.main');
+	var footer = document.querySelector('.footer');
+	var toggleAllCheckbox = document.querySelector('.toggle-all');
+	var todoCount = document.querySelector('.todo-count');
+	var clearCompletedBtn = document.querySelector('.clear-completed');
+	var filterLinks = document.querySelectorAll('.filters a');
+
+	function createTodoElement(todo) {
+		var li = document.createElement('li');
+		li.setAttribute('data-id', todo.id);
+		if (todo.completed) li.classList.add('completed');
+
+		var div = document.createElement('div');
+		div.className = 'view';
+
+		var checkbox = document.createElement('input');
+		checkbox.className = 'toggle';
+		checkbox.type = 'checkbox';
+		checkbox.checked = todo.completed;
+
+		var label = document.createElement('label');
+		label.textContent = todo.title;
+
+		var destroyBtn = document.createElement('button');
+		destroyBtn.className = 'destroy';
+
+		var editInput = document.createElement('input');
+		editInput.className = 'edit';
+		editInput.value = todo.title;
+
+		div.appendChild(checkbox);
+		div.appendChild(label);
+		div.appendChild(destroyBtn);
+
+		li.appendChild(div);
+		li.appendChild(editInput);
+		return li;
+	}
+
+	// ── Rendering ──────────────────────────────────────────────────────────
+
+	var currentRoute = '#/';
+
+	function render() {
+		var filtered = getFilteredTodos(currentRoute);
+
+		// Clear existing list
+		todoList.innerHTML = '';
+
+		// Append todo elements
+		for (var i = 0; i < filtered.length; i++) {
+			todoList.appendChild(createTodoElement(filtered[i]));
+		}
+
+		// Show/hide main and footer
+		var hasTodos = todos.length > 0;
+		mainSection.style.display = hasTodos ? '' : 'none';
+		footer.style.display = hasTodos ? '' : 'none';
+
+		// Update count
+		var activeCount = todos.filter(function (t) { return !t.completed; }).length;
+		todoCount.innerHTML = '<strong>' + activeCount + '</strong> ' +
+			(activeCount === 1 ? 'item' : 'items') + ' left';
+
+		// Update toggle-all
+		toggleAllCheckbox.checked = todos.length > 0 && todos.every(function (t) { return t.completed; });
+
+		// Show/hide clear completed
+		var hasCompleted = todos.some(function (t) { return t.completed; });
+		clearCompletedBtn.style.display = hasCompleted ? '' : 'none';
+
+		// Update filter links
+		for (var j = 0; j < filterLinks.length; j++) {
+			var link = filterLinks[j];
+			if (link.getAttribute('href') === currentRoute) {
+				link.classList.add('selected');
+			} else {
+				link.classList.remove('selected');
+			}
+		}
+	}
+
+	// ── Routing ────────────────────────────────────────────────────────────
+
+	function getRoute() {
+		var hash = window.location.hash || '#/';
+		return hash;
+	}
+
+	function onHashChange() {
+		currentRoute = getRoute();
+		render();
+	}
+
+	// ── Event handlers ─────────────────────────────────────────────────────
+
+	// New todo input
+	newTodoInput.addEventListener('keydown', function (e) {
+		if (e.which !== ENTER_KEY) return;
+		var val = newTodoInput.value.trim();
+		if (!val) return;
+		createTodo(val);
+		newTodoInput.value = '';
+		render();
+	});
+
+	// Toggle all
+	toggleAllCheckbox.addEventListener('change', function () {
+		toggleAll(toggleAllCheckbox.checked);
+		render();
+	});
+
+	// Clear completed
+	clearCompletedBtn.addEventListener('click', function () {
+		clearCompleted();
+		render();
+	});
+
+	// Delegated events on the todo list
+	todoList.addEventListener('change', function (e) {
+		// Toggle individual todo
+		if (e.target.classList.contains('toggle')) {
+			var li = e.target.closest('li');
+			var id = parseInt(li.getAttribute('data-id'), 10);
+			toggleTodo(id);
+			render();
+		}
+	});
+
+	todoList.addEventListener('click', function (e) {
+		// Destroy button
+		if (e.target.classList.contains('destroy')) {
+			var li = e.target.closest('li');
+			var id = parseInt(li.getAttribute('data-id'), 10);
+			destroyTodo(id);
+			render();
+		}
+	});
+
+	todoList.addEventListener('dblclick', function (e) {
+		// Activate editing mode
+		if (e.target.tagName === 'LABEL') {
+			var li = e.target.closest('li');
+			li.classList.add('editing');
+			var editInput = li.querySelector('.edit');
+			editInput.value = e.target.textContent;
+			editInput.focus();
+		}
+	});
+
+	todoList.addEventListener('keydown', function (e) {
+		if (!e.target.classList.contains('edit')) return;
+		if (e.which === ENTER_KEY) {
+			e.target.blur();
+		}
+		if (e.which === ESCAPE_KEY) {
+			var li = e.target.closest('li');
+			var id = parseInt(li.getAttribute('data-id'), 10);
+			var todo = todos.find(function (t) { return t.id === id; });
+			if (todo) e.target.value = todo.title;
+			e.target.blur();
+		}
+	});
+
+	todoList.addEventListener('blur', function (e) {
+		if (!e.target.classList.contains('edit')) return;
+		var li = e.target.closest('li');
+		var id = parseInt(li.getAttribute('data-id'), 10);
+		var val = e.target.value.trim();
+		if (val) {
+			updateTodo(id, val);
+		} else {
+			destroyTodo(id);
+		}
+		li.classList.remove('editing');
+		render();
+	}, true);
+
+	// Filter links (handled by delegated click via hash change)
+	for (var i = 0; i < filterLinks.length; i++) {
+		filterLinks[i].addEventListener('click', function () {
+			currentRoute = this.getAttribute('href');
+			render();
+		});
+	}
+
+	// ── Init ───────────────────────────────────────────────────────────────
+
+	load();
+	currentRoute = getRoute();
+	render();
+
+	window.addEventListener('hashchange', onHashChange);
+
+	// Expose internals for testing
+	window.__app = {
+		todos: todos,
+		toggleTodo: toggleTodo,
+		toggleAll: toggleAll,
+		render: render
+	};
+})();
