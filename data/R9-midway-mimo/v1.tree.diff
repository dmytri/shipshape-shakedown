+++ b/features/support/steps.js
@@ -0,0 +1,256 @@
+const { Given, When, Then } = require('@cucumber/cucumber');
+const assert = require('assert');
+
+// ── Helpers ───────────────────────────────────────────────────────────
+
+function todoItems() {
+  return Array.from(this.document.querySelectorAll('.todo-list li'));
+}
+
+function visibleTodoItems() {
+  return todoItems.call(this).filter(
+    (li) => li.style.display !== 'none'
+  );
+}
+
+function nthTodo(n) {
+  return todoItems.call(this)[n - 1];
+}
+
+function todoTitleAt(n) {
+  return nthTodo.call(this, n).querySelector('label').textContent;
+}
+
+// ── Background ────────────────────────────────────────────────────────
+
+Given('the app is loaded', function () {
+  assert.ok(this.document.querySelector('.todoapp'), 'todoapp should exist');
+});
+
+// ── Adding todos ──────────────────────────────────────────────────────
+
+Given('I have added {string}', function (title) {
+  const input = this.document.querySelector('.new-todo');
+  input.value = title;
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, which: 13, bubbles: true }));
+});
+
+When('I enter a new todo {string} and press Enter', function (title) {
+  const input = this.document.querySelector('.new-todo');
+  input.value = title;
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, which: 13, bubbles: true }));
+});
+
+// ── Inspecting state ──────────────────────────────────────────────────
+
+Then('there is {int} todo', function (count) {
+  assert.strictEqual(todoItems.call(this).length, count);
+});
+
+Then('there are {int} todos', function (count) {
+  assert.strictEqual(todoItems.call(this).length, count);
+});
+
+Then('the first todo has title {string}', function (title) {
+  assert.strictEqual(todoTitleAt.call(this, 1), title);
+});
+
+Then('the input is empty', function () {
+  const input = this.document.querySelector('.new-todo');
+  assert.strictEqual(input.value, '');
+});
+
+Then('the main section is hidden', function () {
+  const main = this.document.querySelector('.main');
+  assert.strictEqual(main.style.display, 'none');
+});
+
+Then('the footer is hidden', function () {
+  const footer = this.document.querySelector('.footer');
+  assert.strictEqual(footer.style.display, 'none');
+});
+
+Then('the main section is visible', function () {
+  const main = this.document.querySelector('.main');
+  assert.ok(main.style.display !== 'none');
+});
+
+Then('the footer is visible', function () {
+  const footer = this.document.querySelector('.footer');
+  assert.ok(footer.style.display !== 'none');
+});
+
+// ── Toggle / complete ─────────────────────────────────────────────────
+
+Given('I have completed todo {int}', function (n) {
+  const li = nthTodo.call(this, n);
+  const checkbox = li.querySelector('.toggle');
+  if (!checkbox.checked) {
+    const id = parseInt(li.getAttribute('data-id'), 10);
+    this.window.__app.toggleTodo(id);
+    this.window.__app.render();
+  }
+});
+
+When('I click the toggle for todo {int}', function (n) {
+  const li = nthTodo.call(this, n);
+  const id = parseInt(li.getAttribute('data-id'), 10);
+  this.window.__app.toggleTodo(id);
+  this.window.__app.render();
+});
+
+Then('todo {int} is completed', function (n) {
+  const li = nthTodo.call(this, n);
+  assert.ok(li.classList.contains('completed'), 'todo should have completed class');
+});
+
+Then('todo {int} is not completed', function (n) {
+  const li = nthTodo.call(this, n);
+  assert.ok(!li.classList.contains('completed'), 'todo should not have completed class');
+});
+
+Then('the active count is {int}', function (count) {
+  const strong = this.document.querySelector('.todo-count strong');
+  assert.strictEqual(parseInt(strong.textContent, 10), count);
+});
+
+// ── Toggle all ────────────────────────────────────────────────────────
+
+When('I click toggle-all', function () {
+  const toggleAll = this.document.querySelector('.toggle-all');
+  const newChecked = !toggleAll.checked;
+  toggleAll.checked = newChecked;
+  this.window.__app.toggleAll(newChecked);
+  this.window.__app.render();
+});
+
+Then('all todos are completed', function () {
+  const items = todoItems.call(this);
+  items.forEach((li) => {
+    assert.ok(li.classList.contains('completed'), `todo should be completed: ${li.querySelector('label').textContent}`);
+  });
+});
+
+Then('all todos are active', function () {
+  const items = todoItems.call(this);
+  items.forEach((li) => {
+    assert.ok(!li.classList.contains('completed'), `todo should be active: ${li.querySelector('label').textContent}`);
+  });
+});
+
+Given('all todos are checked', function () {
+  const items = todoItems.call(this);
+  items.forEach((li) => {
+    const id = parseInt(li.getAttribute('data-id'), 10);
+    const cb = li.querySelector('.toggle');
+    if (!cb.checked) {
+      // Use the exposed API to toggle
+      this.window.__app.toggleTodo(id);
+    }
+  });
+  this.window.__app.render();
+});
+
+// ── Destroy ───────────────────────────────────────────────────────────
+
+When('I destroy todo {int}', function (n) {
+  const li = nthTodo.call(this, n);
+  li.querySelector('.destroy').click();
+});
+
+// ── Clear completed ───────────────────────────────────────────────────
+
+When('I click clear-completed', function () {
+  this.document.querySelector('.clear-completed').click();
+});
+
+Then('the clear-completed button is hidden', function () {
+  const btn = this.document.querySelector('.clear-completed');
+  assert.ok(btn.style.display === 'none', 'clear-completed should be hidden');
+});
+
+Then('the clear-completed button is visible', function () {
+  const btn = this.document.querySelector('.clear-completed');
+  assert.ok(btn.style.display !== 'none', 'clear-completed should be visible');
+});
+
+// ── Editing ───────────────────────────────────────────────────────────
+
+When('I double-click todo {int}', function (n) {
+  const li = nthTodo.call(this, n);
+  const label = li.querySelector('label');
+  label.dispatchEvent(new this.window.Event('dblclick', { bubbles: true }));
+});
+
+Then('todo {int} is in editing mode', function (n) {
+  const li = nthTodo.call(this, n);
+  assert.ok(li.classList.contains('editing'), 'todo should have editing class');
+});
+
+Then('todo {int} is not in editing mode', function (n) {
+  const li = nthTodo.call(this, n);
+  assert.ok(!li.classList.contains('editing'), 'todo should not have editing class');
+});
+
+When('I type {string} in the edit field and press Enter', function (title) {
+  const editInput = this.document.querySelector('.todo-list li.editing .edit');
+  editInput.value = title;
+  editInput.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, which: 13, bubbles: true }));
+});
+
+When('I type {string} in the edit field and blur', function (title) {
+  const editInput = this.document.querySelector('.todo-list li.editing .edit');
+  editInput.value = title;
+  editInput.dispatchEvent(new this.window.Event('blur', { bubbles: true }));
+});
+
+When('I clear the edit input and blur', function () {
+  const editInput = this.document.querySelector('.todo-list li.editing .edit');
+  editInput.value = '';
+  editInput.dispatchEvent(new this.window.Event('blur', { bubbles: true }));
+});
+
+When('I type {string} in the edit field and press Escape', function (title) {
+  const editInput = this.document.querySelector('.todo-list li.editing .edit');
+  editInput.value = title;
+  editInput.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Escape', keyCode: 27, which: 27, bubbles: true }));
+});
+
+// ── Counter pluralisation ─────────────────────────────────────────────
+
+Then('the counter text contains {string}', function (text) {
+  const countEl = this.document.querySelector('.todo-count');
+  assert.ok(countEl.textContent.includes(text), `counter should contain "${text}" but was "${countEl.textContent}"`);
+});
+
+// ── Routing ───────────────────────────────────────────────────────────
+
+When('I navigate to {string}', function (hash) {
+  this.navigate(hash);
+});
+
+Then('there is {int} todo visible', function (count) {
+  assert.strictEqual(visibleTodoItems.call(this).length, count);
+});
+
+Then('there are {int} todos visible', function (count) {
+  assert.strictEqual(visibleTodoItems.call(this).length, count);
+});
+
+Then('the first visible todo has title {string}', function (title) {
+  const items = visibleTodoItems.call(this);
+  assert.ok(items.length > 0, 'should have at least one visible todo');
+  assert.strictEqual(items[0].querySelector('label').textContent, title);
+});
+
+Then('the {string} filter link is selected', function (name) {
+  const map = { all: '#/', active: '#/active', completed: '#/completed' };
+  const link = this.document.querySelector(`.filters a[href="${map[name]}"]`);
+  assert.ok(link.classList.contains('selected'), `${name} link should be selected`);
+});
+
+// ── Persistence ───────────────────────────────────────────────────────
+
+When('I reload the app', function () {
+  this.loadApp();
+});
