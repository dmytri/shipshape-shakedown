+// ---- Servable page ----
+
+Given('the project root has an index.html', function () {
+  const fs = require('fs');
+  const path = require('path');
+  const indexPath = path.join(__dirname, '..', '..', 'index.html');
+  assert(fs.existsSync(indexPath), 'Expected index.html at project root');
+});
+
+When('the index.html is loaded in a browser', function () {
+  const fs = require('fs');
+  const path = require('path');
+  const { Window } = require('happy-dom');
+  const indexPath = path.join(__dirname, '..', '..', 'index.html');
+  const html = fs.readFileSync(indexPath, 'utf-8');
+  const win = new Window({ url: 'http://localhost/' });
+  win.document.write(html);
+  win.document.close();
+  const appPath = path.join(__dirname, '..', '..', 'js', 'app.js');
+  if (fs.existsSync(appPath)) {
+    const code = fs.readFileSync(appPath, 'utf-8');
+    try { win.eval(code); } catch (e) { /* verify structural not behavioural */ }
+  }
+  this.window = win;
+  this.document = win.document;
+});
+
+Then('the page has a new-todo input with placeholder {string}', function (expected) {
+  const input = qs(this.document, '.new-todo');
+  assert(input, 'Expected .new-todo input');
+  assert.strictEqual(input.placeholder, expected);
+});
+
+Then('the page has a section with class {string}', function (cls) {
+  const el = qs(this.document, '.' + cls);
+  assert(el, 'Expected element with class "' + cls + '"');
+});
+
+Then('the page has a footer with class {string}', function (cls) {
+  const el = qs(this.document, '.' + cls);
+  assert(el, 'Expected element with class "' + cls + '"');
+});
+
+Then('the page has a script tag loading {string}', function (src) {
+  const scripts = qsa(this.document, 'script[src="' + src + '"]');
+  assert(scripts.length > 0, 'Expected script tag with src="' + src + '"');
+});
+
 Then('{string} is not shown in the todo list', function (text) {
   assert(!Array.from(getTodoItems(this.document)).some(i => getTodoText(i) === text));
 });
