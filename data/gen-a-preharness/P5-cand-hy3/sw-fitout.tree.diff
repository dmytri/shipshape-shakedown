@@ -0,0 +1,262 @@
+#!/usr/bin/env node
+// Shipwright-authored plank join + methodology conformance checker.
+// The one checker Shipwright authors: it reports facts about the code that no
+// runner reports (plank coverage, plank form, provisional drift) and carries
+// the two required methodology conformance checks (watchbill-shape,
+// perturbation-quiescence) plus the two text-pattern plank rules the
+// Verification agreement obligates for a token-search annotation scan.
+//
+// Token-search fallback note (text-search weakness): the annotation scan below
+// finds @planks/@planks-provisional tokens by regex over file text. It can miss
+// a plank hidden inside a multiline string literal or a comment that is not a
+// declaration-adjacent docblock, and it cannot tell whether a token sits in a
+// docblock immediately preceding a declaration. A docblock/parser reader would
+// close that gap; until one is installed this checker reports the join from
+// token search and the two plank rules below keep the contract decidable.
+
+import fs from 'node:fs';
+import path from 'node:path';
+
+const ROOT = process.cwd();
+const RIGGING = path.join(ROOT, 'RIGGING.md');
+
+function fail(msg) {
+  console.error(`plank-join: ${msg}`);
+  process.exit(1);
+}
+
+function readRiggingDirs() {
+  if (!fs.existsSync(RIGGING)) fail('RIGGING.md not found; run fitting out first');
+  const txt = fs.readFileSync(RIGGING, 'utf8');
+  const impl = [];
+  const specs = [];
+  let section = null;
+  for (const line of txt.split('\n')) {
+    if (line.startsWith('## ')) {
+      section = line.slice(3).trim();
+      continue;
+    }
+    if (section !== 'Directories') continue;
+    const m = line.match(/^-\s*(implementation|specs):\s*(.+?)\s*$/);
+    if (m) {
+      for (const v of m[2].split(/\s+/).filter(Boolean)) {
+        (m[1] === 'implementation' ? impl : specs).push(v);
+      }
+    }
+  }
+  return { impl, specs };
+}
+
+function walk(dir) {
+  const out = [];
+  if (!fs.existsSync(dir)) return out;
+  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
+    const p = path.join(dir, e.name);
+    if (e.isDirectory()) out.push(...walk(p));
+    else out.push(p);
+  }
+  return out;
+}
+
+function listFiles(dirs) {
+  const out = [];
+  for (const d of dirs) {
+    const p = path.join(ROOT, d);
+    if (!fs.existsSync(p)) continue;
+    if (fs.statSync(p).isDirectory()) out.push(...walk(p));
+    else out.push(p);
+  }
+  return out;
+}
+
+const PLANK_RE = /@planks(?:-provisional)?\(\s*"([^"]+)"\s*\)/g;
+
+function collectPlanks(files) {
+  const planks = [];
+  for (const f of files) {
+    if (!/\.(js|mjs|cjs|ts|tsx|html|vue|jsx)$/.test(f)) continue;
+    const txt = fs.readFileSync(f, 'utf8');
+    let m;
+    PLANK_RE.lastIndex = 0;
+    while ((m = PLANK_RE.exec(txt))) {
+      const line = txt.slice(0, m.index).split('\n').length;
+      const provisional = m[0].startsWith('@planks-provisional');
+      planks.push({ file: f, line, pattern: m[1], provisional });
+    }
+  }
+  return planks;
+}
+
+function collectStepPatterns(specs) {
+  const patterns = [];
+  for (const f of listFiles(specs)) {
+    if (f.endsWith('.feature')) {
+      const txt = fs.readFileSync(f, 'utf8');
+      for (const line of txt.split('\n')) {
+        const m = line.match(/^\s*(Given|When|Then|And|But)\s+(.+?)\s*$/);
+        if (m) patterns.push({ text: m[2].trim(), file: f, bound: false });
+      }
+    } else if (/\.(js|mjs|cjs|ts)$/.test(f)) {
+      const txt = fs.readFileSync(f, 'utf8');
+      const re = /(Given|When|Then)\(\s*(`[^`]+`|'[^']+'|"[^"]+"|\/.*?\/)\s*\)/g;
+      let m;
+      while ((m = re.exec(txt))) {
+        let p = m[2].replace(/^`|`$|^'|'$|^"|"$|^\/|\/$/g, '');
+        patterns.push({ text: p, file: f, bound: true });
+      }
+    }
+  }
+  return patterns;
+}
+
+function normalize(s) {
+  return s.replace(/\s+/g, ' ').trim();
+}
+
+function patternMatches(plankPat, stepText) {
+  const a = normalize(plankPat);
+  const b = normalize(stepText);
+  if (a === b) return true;
+  try {
+    return new RegExp(plankPat).test(stepText);
+  } catch {
+    return false;
+  }
+}
+
+function scenarioHasCaptain(ref, specs) {
+  // ref form: <spec>.feature:<Scenario Name>
+  const m = ref.match(/^(.+?):(.+)$/);
+  if (!m) return false;
+  const featurePath = path.join(ROOT, m[1]);
+  if (!fs.existsSync(featurePath)) return false;
+  const txt = fs.readFileSync(featurePath, 'utf8');
+  const lines = txt.split('\n');
+  let inTarget = false;
+  for (const line of lines) {
+    const tags = line.match(/^\s*@(\S+)/g);
+    const scen = line.match(/^\s*Scenario:\s*(.+?)\s*$/);
+    if (scen) {
+      inTarget = normalize(scen[1]) === normalize(m[2]);
+      continue;
+    }
+    if (/^\s*(Feature|Background|Rule|Scenario Outline|Examples):/.test(line)) {
+      inTarget = false;
+      continue;
+    }
+    if (inTarget && tags) {
+      if (tags.some((t) => t.trim() === '@captain')) return true;
+    }
+  }
+  return false;
+}
+
+function runJoin() {
+  const { impl, specs } = readRiggingDirs();
+  const planks = collectPlanks(listFiles(impl));
+  const steps = collectStepPatterns(specs);
+  const boundPatterns = steps.filter((s) => s.bound).map((s) => s.text);
+  const violations = [];
+
+  // plank-form: every plank pattern resolves to a current step pattern
+  for (const pk of planks) {
+    if (pk.provisional) {
+      if (!scenarioHasCaptain(pk.pattern, specs)) {
+        violations.push(`provisional plank names a scenario without @captain: ${pk.file}:${pk.line} -> ${pk.pattern}`);
+      }
+    } else if (!steps.some((s) => patternMatches(pk.pattern, s.text))) {
+      violations.push(`plank matches no current step pattern: ${pk.file}:${pk.line} -> "${pk.pattern}"`);
+    }
+  }
+
+  // plank-coverage: every behaviour-bearing (bound) step pattern has a plank
+  for (const bp of boundPatterns) {
+    if (!planks.some((pk) => !pk.provisional && patternMatches(pk.pattern, bp))) {
+      violations.push(`behaviour-bearing step has no plank: "${bp}" (${steps.find((s) => s.text === bp)?.file})`);
+    }
+  }
+
+  const join = {};
+  for (const s of steps) {
+    (join[s.text] ||= { scenarios: [], bound: s.bound });
+    join[s.text].bound = s.bound || join[s.text].bound;
+  }
+  for (const pk of planks) {
+    (join[pk.pattern] ||= { scenarios: [], bound: false, plank: [] });
+    join[pk.pattern].plank = join[pk.pattern].plank || [];
+    join[pk.pattern].plank.push(`${pk.file}:${pk.line}${pk.provisional ? ' (provisional)' : ''}`);
+  }
+
+  console.log(JSON.stringify({ planks: planks.length, stepPatterns: steps.length, bound: boundPatterns.length, join, violations }, null, 2));
+  if (violations.length) fail(`${violations.length} plank-join violation(s)`);
+  console.log('plank-join: clean');
+  process.exit(0);
+}
+
+function checkWatchbillShape() {
+  const f = path.join(ROOT, 'watchbill.json');
+  if (!fs.existsSync(f)) {
+    console.log('watchbill absent: conforms (deck at rest)');
+    process.exit(0);
+  }
+  let data;
+  try {
+    data = JSON.parse(fs.readFileSync(f, 'utf8'));
+  } catch (e) {
+    fail(`watchbill.json is not valid JSON: ${e.message}`);
+  }
+  if (typeof data !== 'object' || data === null || Array.isArray(data)) {
+    fail('watchbill.json must be an object of watch entries');
+  }
+  const tierTags = new Set(['@logic', '@sandbox']);
+  const violations = [];
+  const keys = Object.keys(data);
+  const watchRe = /^watch\d+$/;
+  for (const k of keys) {
+    if (!watchRe.test(k)) {
+      violations.push(`watch entry key "${k}" is not "watchN"`);
+      continue;
+    }
+    const v = data[k];
+    if (typeof v !== 'object' || v === null || Array.isArray(v) || !('scenarios' in v)) {
+      violations.push(`watch "${k}" must be an object with a "scenarios" array`);
+      continue;
+    }
+    if (!Array.isArray(v.scenarios)) {
+      violations.push(`watch "${k}".scenarios must be an array`);
+      continue;
+    }
+    for (const s of v.scenarios) {
+      if (typeof s !== 'string') {
+        violations.push(`watch "${k}" has a non-string scenario entry`);
+        continue;
+      }
+      const isRef = /^[^\s].*\.feature:.*$/.test(s);
+      const isTier = tierTags.has(s);
+      if (!isRef && !isTier) {
+        violations.push(`watch "${k}" entry "${s}" is neither a <spec>.feature:<Scenario> ref nor a tier tag`);
+      }
+    }
+  }
+  if (violations.length) fail(violations.join('; '));
+  console.log('watchbill-shape: conforms');
+  process.exit(0);
+}
+
+function checkPerturbationQuiescence() {
+  const { impl } = readRiggingDirs();
+  const found = [];
+  for (const f of listFiles(impl)) {
+    if (fs.readFileSync(f, 'utf8').includes('PERTURBATION')) found.push(f);
+  }
+  if (found.length) fail(`standing PERTURBATION token in: ${found.join(', ')}`);
+  console.log('perturbation-quiescence: clean');
+  process.exit(0);
+}
+
+const idx = process.argv.indexOf('--check');
+const check = idx >= 0 ? process.argv[idx + 1] : null;
+if (check === 'watchbill-shape') checkWatchbillShape();
+if (check === 'perturbation-quiescence') checkPerturbationQuiescence();
+if (check) fail(`unknown --check value: ${check}`);
+runJoin();
