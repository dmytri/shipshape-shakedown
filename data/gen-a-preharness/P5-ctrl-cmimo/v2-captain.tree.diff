+Feature: Root index.html
+  As a user opening the TodoMVC app in a browser
+  I want an index.html at the project root that loads the app
+  So that the todo app renders and runs when I open the page
+
+  Scenario: Root index.html exists with correct structure and script
+    Given the root index.html exists at the project root
+    Then the root index.html contains a script tag loading "js/app.js"
+    And the root index.html contains the section with class "todoapp"
+    And the root index.html contains an input with class "new-todo"
+    And the root index.html contains a ul with class "todo-list"
diff --git a/features/support/steps.js b/features/support/steps.js
index 1328b68..7b70f04 100644
--- a/features/support/steps.js
+++ b/features/support/steps.js
@@ -267,3 +267,35 @@ Then('the destroy button for todo {string} is visible', function (title) {
 Then('the check passes', function () {
   assert.strictEqual(this._checkResult, true, 'Check should pass');
 });
+
+// --- Root index.html steps ---
+
+Given('the root index.html exists at the project root', function () {
+  const rootPath = path.resolve(__dirname, '../../index.html');
+  assert.ok(fs.existsSync(rootPath), 'index.html must exist at the project root');
+  this._rootHtml = fs.readFileSync(rootPath, 'utf8');
+});
+
+Then('the root index.html contains a script tag loading {string}', function (src) {
+  assert.ok(this._rootHtml, 'Root index.html must be loaded');
+  const pattern = new RegExp('<script[^>]+src=["\']' + src.replace('/', '\/') + '["\']');
+  assert.ok(pattern.test(this._rootHtml), 'Root index.html must contain a script tag loading ' + src);
+});
+
+Then('the root index.html contains the section with class {string}', function (className) {
+  assert.ok(this._rootHtml, 'Root index.html must be loaded');
+  const pattern = new RegExp('<section[^>]+class=["\'][^"]*' + className + '[^"]*["\']');
+  assert.ok(pattern.test(this._rootHtml), 'Root index.html must contain a section with class ' + className);
+});
+
+Then('the root index.html contains an input with class {string}', function (className) {
+  assert.ok(this._rootHtml, 'Root index.html must be loaded');
+  const pattern = new RegExp('<input[^>]+class=["\'][^"]*' + className + '[^"]*["\']');
+  assert.ok(pattern.test(this._rootHtml), 'Root index.html must contain an input with class ' + className);
+});
+
+Then('the root index.html contains a ul with class {string}', function (className) {
+  assert.ok(this._rootHtml, 'Root index.html must be loaded');
+  const pattern = new RegExp('<ul[^>]+class=["\'][^"]*' + className + '[^"]*["\']');
+  assert.ok(pattern.test(this._rootHtml), 'Root index.html must contain a ul with class ' + className);
+});
