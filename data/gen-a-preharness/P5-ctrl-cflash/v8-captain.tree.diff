+When('the URL hash changes to {string}', function (hash) {
+  // Update the window location hash
+  this.window.location.hash = hash;
+  // Dispatch a hashchange event for the production listener
+  const event = new this.window.HashChangeEvent('hashchange', {
+    oldURL: this.window.location.href,
+    newURL: this.window.location.href,
+    bubbles: true
+  });
+  this.window.dispatchEvent(event);
+});
