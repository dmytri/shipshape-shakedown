index 0000000..c28c5f2
--- /dev/null
+++ b/.shipshape/plank-join.mjs
@@ -0,0 +1,251 @@
+#!/usr/bin/env node
+/**
+ * plank-join.mjs
+ *
+ * Joins @planks and @planks-provisional annotations to step-definition patterns
+ * and @captain scenarios. Reddens where:
+ *   1. A plank pattern matches no current step definition.
+ *   2. A behaviour-bearing step definition has no matching plank.
+ *   3. A @planks-provisional names a scenario that no longer carries @captain.
+ *   4. A @planks or @planks-provisional token appears outside a docblock on a declaration.
+ *
+ * Exit codes: 0 = clean, 1 = red findings, 2 = tool error.
+ */
+
+import fs from "fs";
+import path from "path";
+
+const PROJECT_ROOT = process.cwd();
+
+// --- Discover specs and implementation directories from RIGGING.md ---
+function parseRigging() {
+  const riggingPath = path.join(PROJECT_ROOT, "RIGGING.md");
+  if (!fs.existsSync(riggingPath)) {
+    console.error("plank-join: RIGGING.md not found");
+    process.exit(2);
+  }
+  const content = fs.readFileSync(riggingPath, "utf8");
+  const impl = [];
+  const specs = [];
+  const verification = [];
+  let currentSection = null;
+
+  for (const line of content.split("\n")) {
+    const sectionMatch = line.match(/^## (\w+)/);
+    if (sectionMatch) {
+      currentSection = sectionMatch[1];
+      continue;
+    }
+    const itemMatch = line.match(/^- (\w+):\s*(.+)/);
+    if (itemMatch && currentSection === "Directories") {
+      const [, key, value] = itemMatch;
+      const clean = value.trim();
+      if (key === "implementation") impl.push(clean);
+      if (key === "specs") specs.push(clean);
+      if (key === "verification") verification.push(clean);
+    }
+  }
+
+  return { impl, specs, verification };
+}
+
+// --- Discover step-definition patterns from verification support ---
+function discoverStepPatterns(verificationDirs) {
+  const patterns = new Set();
+  for (const dir of verificationDirs) {
+    const absDir = path.join(PROJECT_ROOT, dir);
+    if (!fs.existsSync(absDir)) continue;
+    const files = fs.readdirSync(absDir, { recursive: true });
+    for (const file of files) {
+      if (typeof file !== "string") continue;
+      const abs = path.join(absDir, file);
+      if (!fs.existsSync(abs)) continue;
+      const stat = fs.statSync(abs);
+      if (!stat.isFile()) continue;
+      const ext = path.extname(file);
+      if (ext !== ".js" && ext !== ".ts" && ext !== ".mjs") continue;
+      const src = fs.readFileSync(abs, "utf8");
+      // Match Given/When/Then definitions: .Given("...", .When("...", .Then("..."
+      const re = /\.(?:Given|When|Then)\(\s*["`']([^"`']+)["`']/g;
+      let m;
+      while ((m = re.exec(src)) !== null) {
+        patterns.add(m[1]);
+      }
+    }
+  }
+  return patterns;
+}
+
+// --- Discover @captain scenarios from specs ---
+function discoverCaptainScenarios(specsDirs) {
+  const scenarios = new Set();
+  for (const dir of specsDirs) {
+    const absDir = path.join(PROJECT_ROOT, dir);
+    if (!fs.existsSync(absDir)) continue;
+    const files = fs.readdirSync(absDir, { recursive: true });
+    for (const file of files) {
+      if (typeof file !== "string") continue;
+      if (!file.endsWith(".feature")) continue;
+      const abs = path.join(absDir, file);
+      if (!fs.existsSync(abs)) continue;
+      const src = fs.readFileSync(abs, "utf8");
+      const rel = path.relative(PROJECT_ROOT, abs).replace(/\\/g, "/");
+
+      // Collect all lines, find @captain tags and Scenario keywords
+      const lines = src.split("\n");
+      let captainPending = false;
+
+      for (const line of lines) {
+        const trimmed = line.trim();
+
+        // Tag line: check for @captain
+        if (trimmed.startsWith("@")) {
+          if (/^@captain\b/.test(trimmed)) {
+            captainPending = true;
+          }
+          continue;
+        }
+
+        // Scenario line
+        const scenarioMatch = trimmed.match(/^Scenario(?:\s+Outline)?:\s*(.+)/);
+        if (scenarioMatch) {
+          if (captainPending) {
+            scenarios.add(`${rel}:${scenarioMatch[1].trim()}`);
+          }
+          captainPending = false;
+          continue;
+        }
+
+        // Blank lines or non-tag content: reset pending captain
+        if (trimmed === "" || (!trimmed.startsWith("@"))) {
+          captainPending = false;
+        }
+      }
+    }
+  }
+  return scenarios;
+}
+
+// --- Scan implementation for @planks annotations ---
+function scanPlanks(implDirs) {
+  const planks = []; // { file, line, pattern, type, lineNum }
+
+  for (const dir of implDirs) {
+    const absDir = path.join(PROJECT_ROOT, dir);
+    if (!fs.existsSync(absDir)) continue;
+    const files = fs.readdirSync(absDir, { recursive: true });
+    for (const file of files) {
+      if (typeof file !== "string") continue;
+      const abs = path.join(absDir, file);
+      if (!fs.existsSync(abs)) continue;
+      const stat = fs.statSync(abs);
+      if (!stat.isFile()) continue;
+      const ext = path.extname(file);
+      if (ext !== ".js" && ext !== ".ts" && ext !== ".mjs" && ext !== ".jsx" && ext !== ".tsx") continue;
+
+      const src = fs.readFileSync(abs, "utf8");
+      const lines = src.split("\n");
+      const rel = path.relative(PROJECT_ROOT, abs).replace(/\\/g, "/");
+
+      for (let i = 0; i < lines.length; i++) {
+        const line = lines[i];
+
+        // Check for @planks-provisional outside docblock (line comment)
+        const provLineComment = line.match(/\/\/\s*@planks-provisional\(["']([^"']+)["']\)/);
+        if (provLineComment) {
+          planks.push({ file: rel, line: i + 1, reference: provLineComment[1], type: "provisional", inDocblock: false });
+          continue;
+        }
+
+        // Check for @planks outside docblock (line comment)
+        const planksLineComment = line.match(/\/\/\s*@planks\(["']([^"']+)["']\)/);
+        if (planksLineComment) {
+          planks.push({ file: rel, line: i + 1, pattern: planksLineComment[1], type: "planks", inDocblock: false });
+          continue;
+        }
+
+        // Check for docblock-style planks (/** ... */)
+        const docblockStart = line.match(/\/\*\*/);
+        if (docblockStart) {
+          let j = i;
+          let docblockContent = "";
+          while (j < lines.length) {
+            docblockContent += lines[j] + "\n";
+            if (lines[j].includes("*/")) break;
+            j++;
+          }
+
+          const provMatch = docblockContent.match(/@planks-provisional\(["']([^"']+)["']\)/);
+          if (provMatch) {
+            planks.push({ file: rel, line: i + 1, reference: provMatch[1], type: "provisional", inDocblock: true });
+          }
+
+          const planksMatch = docblockContent.match(/@planks\(["']([^"']+)["']\)/);
+          if (planksMatch) {
+            planks.push({ file: rel, line: i + 1, pattern: planksMatch[1], type: "planks", inDocblock: true });
+          }
+        }
+      }
+    }
+  }
+  return planks;
+}
+
+// --- Main ---
+function main() {
+  const { impl, specs, verification } = parseRigging();
+
+  if (impl.length === 0) {
+    console.log("plank-join: no implementation directories");
+    process.exit(0);
+  }
+
+  const stepPatterns = discoverStepPatterns(verification);
+  const captainScenarios = discoverCaptainScenarios(specs);
+  const planks = scanPlanks(impl);
+
+  const findings = [];
+
+  for (const plank of planks) {
+    if (plank.type === "provisional") {
+      // Check the referenced scenario still has @captain
+      if (!captainScenarios.has(plank.reference)) {
+        findings.push(`MALFORMED-PROVISIONAL ${plank.file}:${plank.line} @planks-provisional("${plank.reference}") references scenario without @captain`);
+      }
+    } else {
+      // Check pattern matches a current step definition
+      if (!stepPatterns.has(plank.pattern)) {
+        findings.push(`STALE-PLANK ${plank.file}:${plank.line} @planks("${plank.pattern}") matches no current step definition`);
+      }
+    }
+  }
+
+  // Check docblock form: planks-provisional must be in a docblock
+  for (const plank of planks) {
+    if (plank.type === "provisional" && !plank.inDocblock) {
+      findings.push(`MALFORMED-PLANK-FORM ${plank.file}:${plank.line} @planks-provisional outside docblock on declaration`);
+    }
+    if (plank.type === "planks" && !plank.inDocblock) {
+      findings.push(`MALFORMED-PLANK-FORM ${plank.file}:${plank.line} @planks outside docblock on declaration`);
+    }
+  }
+
+  // Check coverage: step definitions without planks
+  const plankedPatterns = new Set(planks.filter(p => p.type === "planks").map(p => p.pattern));
+  for (const pattern of stepPatterns) {
+    if (!plankedPatterns.has(pattern)) {
+      findings.push(`UNPLANKED-STEP pattern "${pattern}" has no matching @planks annotation`);
+    }
+  }
+
+  if (findings.length > 0) {
+    console.log("plank-join: " + findings.length + " finding(s)");
+    for (const f of findings) console.log("  " + f);
+    process.exit(1);
+  }
+
+  console.log("plank-join: clean (" + planks.length + " plank(s), " + stepPatterns.size + " pattern(s), " + captainScenarios.size + " @captain scenario(s))");
+  process.exit(0);
+}
+
+main();
diff --git a/.shipshape/verification-conformance-rules.json b/.shipshape/verification-conformance-rules.json
new file mode 100644
index 0000000..97e2aa5
--- /dev/null
+++ b/.shipshape/verification-conformance-rules.json
@@ -0,0 +1,38 @@
+{
+  "rules": [
+    {
+      "id": "plank-form-docblock",
+      "description": "@planks and @planks-provisional must appear in a docblock (/** ... */) immediately preceding a declaration, not as line comments or inline tokens",
+      "pattern": "@planks|@planks-provisional",
+      "engine": "text",
+      "severity": "error"
+    },
+    {
+      "id": "plank-coverage",
+      "description": "Every behaviour-bearing step-definition pattern must have a matching @planks annotation somewhere in the implementation",
+      "join": "plank-join",
+      "severity": "error"
+    },
+    {
+      "id": "no-forbidden-doubles",
+      "description": "Verification support must not use test doubles except where justified inline with @exceptional-double",
+      "pattern": "double|mock|stub|fake|spy|sinon|jest\\.fn|jest\\.spyOn|vi\\.fn|vi\\.spyOn",
+      "exclude": "@exceptional-double",
+      "engine": "text",
+      "severity": "warning"
+    },
+    {
+      "id": "no-guessed-delays",
+      "description": "Step definitions must not use arbitrary timeouts where a signal is observable; use polling with signal observation instead",
+      "pattern": "setTimeout|sleep|delay|wait\\(\\d",
+      "engine": "text",
+      "severity": "warning"
+    },
+    {
+      "id": "step-in-dependency",
+      "description": "Step definitions must not create expensive resources outside the one scenario that asserts them",
+      "join": "plank-join",
+      "severity": "warning"
+    }
+  ]
+}
