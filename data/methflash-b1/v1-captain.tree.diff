+{
+  "watches": [
+    {
+      "name": "Core CRUD",
+      "scenarios": [
+        "todo-management.feature:Create a new todo",
+        "todo-management.feature:Reject empty or whitespace-only todos",
+        "todo-management.feature:Toggle a todo as completed",
+        "todo-management.feature:Toggle a completed todo back to active",
+        "todo-management.feature:Delete a todo"
+      ]
+    },
+    {
+      "name": "Editing",
+      "scenarios": [
+        "todo-management.feature:Activate editing mode on double-click",
+        "todo-management.feature:Save edited todo on Enter",
+        "todo-management.feature:Save edited todo on blur",
+        "todo-management.feature:Destroy todo on empty edit",
+        "todo-management.feature:Discard edit on Escape"
+      ]
+    },
+    {
+      "name": "Bulk Operations & Layout",
+      "scenarios": [
+        "todo-management.feature:Mark all todos as complete",
+        "todo-management.feature:Unmark all todos when toggle-all is unchecked",
+        "todo-management.feature:Hide main and footer when no todos",
+        "todo-management.feature:Show main and footer when todos exist",
+        "todo-management.feature:Clear completed todos",
+        "todo-management.feature:Toggle-all checkbox reflects individual toggles"
+      ]
+    },
+    {
+      "name": "Counters",
+      "scenarios": [
+        "todo-management.feature:Pluralized item count - zero items",
+        "todo-management.feature:Pluralized item count - one item",
+        "todo-management.feature:Pluralized item count - two items"
+      ]
+    },
+    {
+      "name": "Routing",
+      "scenarios": [
+        "routing.feature:Default route is All",
+        "routing.feature:Active filter shows only active todos",
+        "routing.feature:Completed filter shows only completed todos",
+        "routing.feature:Toggle in filtered view hides item"
+      ]
+    },
+    {
+      "name": "Persistence",
+      "scenarios": [
+        "routing.feature:Persist todos to localStorage",
+        "routing.feature:Restore todos from localStorage on reload",
+        "routing.feature:Active filter persists on reload"
+      ]
+    }
+  ]
+}
