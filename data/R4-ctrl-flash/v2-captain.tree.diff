+{
+  "description": "Watchbill for DOM-identity defect. The render() function destroys and recreates <li> nodes on every state change, detaching existing DOM references. Acceptance suite fails with 'element is no longer attached to the DOM'. Fix: mutate existing nodes in-place (toggle class/checkbox) instead of rebuilding the list via innerHTML = ''.",
+  "watches": [
+    {
+      "id": "watch-1-in-place-mutation",
+      "label": "In-place DOM mutation for toggling completion",
+      "scenarios": [
+        "features/dom-identity.feature:Completing a single todo preserves its li element",
+        "features/dom-identity.feature:Un-completing a single todo preserves its li element",
+        "features/dom-identity.feature:Marking all as completed preserves all li elements",
+        "features/dom-identity.feature:Clearing the completed state preserves all li elements"
+      ],
+      "required": [
+        "features/todos.feature:Completing a todo marks it as completed",
+        "features/todos.feature:Completing all todos checks the mark-all checkbox",
+        "features/todos.feature:The mark-all checkbox toggles all todos"
+      ],
+      "notes": "Crew: rewrite render() to assign data-id to each <li>, then reconcile: for existing items update .completed class + .toggle.checked in place; only create/remove <li> for new/deleted items. Remove the PERTURBATION guard when done."
+    }
+  ]
