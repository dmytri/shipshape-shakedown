diff --git a/features/root-page.feature b/features/root-page.feature
new file mode 100644
index 0000000..e9d5b25
--- /dev/null
+++ b/features/root-page.feature
@@ -0,0 +1,16 @@
+Feature: Servable root page
+  As a user opening the app in a real browser
+  I want a functional index.html at the project root
+  So that the TodoMVC app renders and runs without additional build steps
+
+  Scenario: Root index.html contains the TodoMVC application structure
+    Given the root index.html is parsed
+    Then the root page contains a "section.todoapp" element
+    And the root page contains a ".new-todo" input
+    And the root page contains a ".todo-list" element
+    And the root page contains a ".footer" element
+    And the root page contains a ".toggle-all" checkbox
+
+  Scenario: Root index.html loads the application script
+    Given the root index.html is parsed
+    Then the root page loads a script with src "src/app.js"
diff --git a/features/support/steps.js b/features/support/steps.js
index a182ff6..79ac9f0 100644
--- a/features/support/steps.js
+++ b/features/support/steps.js
@@ -1,5 +1,47 @@
 const { Given, When, Then } = require('@cucumber/cucumber');
 const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+
+/* ── root page scenarios ── */
+
+Given('the root index.html is parsed', function () {
+  const { Window } = require('happy-dom');
+  var rootWin = new Window({ url: 'http://localhost:3000/' });
+  var htmlPath = path.join(__dirname, '..', '..', 'index.html');
+  var html = fs.readFileSync(htmlPath, 'utf-8');
+  rootWin.document.body.innerHTML = html;
+  this.rootDocument = rootWin.document;
+  this.rootWindow = rootWin;
+});
+
+Then('the root page contains a {string} element', function (selector) {
+  var el = this.rootDocument.querySelector(selector);
+  assert.ok(el, 'Root page should contain a "' + selector + '" element');
+});
+
+Then('the root page contains a {string} input', function (selector) {
+  var el = this.rootDocument.querySelector(selector);
+  assert.ok(el, 'Root page should contain a "' + selector + '" input');
+  assert.strictEqual(el.tagName.toLowerCase(), 'input',
+    '"' + selector + '" should be an input element');
+});
+
+Then('the root page contains a {string} checkbox', function (selector) {
+  var el = this.rootDocument.querySelector(selector);
+  assert.ok(el, 'Root page should contain a "' + selector + '" element');
+  assert.strictEqual(el.type, 'checkbox',
+    '"' + selector + '" should be a checkbox');
+});
+
+Then('the root page loads a script with src {string}', function (src) {
+  var scripts = this.rootDocument.querySelectorAll('script[src]');
+  var found = false;
+  scripts.forEach(function (s) {
+    if (s.getAttribute('src') === src) found = true;
+  });
+  assert.ok(found, 'Root page should load a script with src="' + src + '"');
+});
 
 /* ── navigation and page lifecycle ── */
 
