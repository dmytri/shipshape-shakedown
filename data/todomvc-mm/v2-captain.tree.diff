+++ b/features/support/steps/assertions.js
@@ -138,6 +138,27 @@ Then('{string} is no longer in editing mode', function (title) {
 	}
 });
 
+Then('the marked row for {string} is still in the document', function (title) {
+	const marked = this.doc.querySelector('[data-identity-marker="' + title + '"]');
+	assert.ok(marked, 'marked row for ' + title + ' is no longer in the document');
+});
+
+Then('the toggle for {string} is hidden', function (title) {
+	const li = this.findTodoByTitle(title);
+	assert.ok(li, title + ' not found');
+	const toggle = li.querySelector('.toggle');
+	assert.ok(toggle, 'toggle for ' + title + ' not found');
+	assert.ok(this.isHidden(toggle), 'toggle for ' + title + ' should be hidden while editing');
+});
+
+Then('the destroy button for {string} is hidden', function (title) {
+	const li = this.findTodoByTitle(title);
+	assert.ok(li, title + ' not found');
+	const btn = li.querySelector('.destroy');
+	assert.ok(btn, 'destroy button for ' + title + ' not found');
+	assert.ok(this.isHidden(btn), 'destroy button for ' + title + ' should be hidden while editing');
+});
+
 Then('the clear completed button is hidden', function () {
 	const btn = this.doc.querySelector('.clear-completed');
 	assert.ok(this.isHidden(btn));
