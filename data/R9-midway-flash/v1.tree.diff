+const { Given, When, Then } = require('@cucumber/cucumber');
+const assert = require('node:assert');
+
+var STORAGE_KEY = 'todos-vanillajs';
+
+// ── Helpers ────────────────────────────────────────────────────────────────────
+
+function qs(doc, sel) {
+  const el = doc.querySelector(sel);
+  if (!el) throw new Error(`querySelector("${sel}") returned null`);
+  return el;
+}
+
+function qsa(doc, sel) { return Array.from(doc.querySelectorAll(sel)); }
+
+function todoItem(doc, text) {
+  const items = qsa(doc, '.todo-list li');
+  return items.find(li => li.querySelector('label')?.textContent?.trim() === text);
+}
+
+function assertTodo(doc, text) {
+  const li = todoItem(doc, text);
+  if (!li) throw new Error(`Expected todo "${text}" to be in the list`);
+  return li;
+}
+
+function assertNoTodo(doc, text) {
+  const li = todoItem(doc, text);
+  if (li) throw new Error(`Expected todo "${text}" NOT to be in the list`);
+}
+
+function triggerKeyboardEvent(el, type, opts = {}) {
+  var win = el.ownerDocument.defaultView || window;
+  var ev = new win.KeyboardEvent(type, { bubbles: true, cancelable: true, key: opts.key || '', keyCode: opts.keyCode || 0, which: opts.which || 0 });
+  el.dispatchEvent(ev);
+}
+
+function triggerClick(el) {
+  var win = el.ownerDocument.defaultView || window;
+  el.dispatchEvent(new win.MouseEvent('click', { bubbles: true, cancelable: true }));
+}
+
+function triggerDblclick(el) {
+  var win = el.ownerDocument.defaultView || window;
+  el.dispatchEvent(new win.MouseEvent('dblclick', { bubbles: true, cancelable: true }));
+}
+
+function triggerInput(el, value) {
+  var win = el.ownerDocument.defaultView || window;
+  el.value = value;
+  el.dispatchEvent(new win.Event('input', { bubbles: true, cancelable: true }));
+}
+
+function triggerBlur(el) {
+  var win = el.ownerDocument.defaultView || window;
+  el.dispatchEvent(new win.FocusEvent('blur', { bubbles: true, cancelable: true }));
+}
+
+function isHidden(el) {
+  if (!el) return true;
+  const style = el.ownerDocument.defaultView.getComputedStyle(el);
+  return style.display === 'none' || style.visibility === 'hidden' || el.hidden === true;
+}
+
+// ── Given ──────────────────────────────────────────────────────────────────────
+
+Given('the app is loaded', function () {
+  // The world.js Before hook already loaded the app.
+  assert.ok(this.document, 'document exists after load');
+  assert.ok(this.window, 'window exists after load');
+});
+
+Given('there are no todos', function () {
+  // App loads fresh; we clear localStorage for safety
+  this.localStorage.removeItem('todos-vanillajs');
+  // Reload to get clean state
+  this.loadApp();
+});
+
+Given('I have a todo {string}', function (text) {
+  this.loadApp();
+  const input = qs(this.document, '.new-todo');
+  input.value = text;
+  triggerKeyboardEvent(input, 'keydown', { key: 'Enter', keyCode: 13, which: 13 });
+});
+
+Given('I have todos {string}, {string}', function (t1, t2) {
+  this.loadApp();
+  const input = qs(this.document, '.new-todo');
+  for (const t of [t1, t2]) {
+    input.value = t;
+    triggerKeyboardEvent(input, 'keydown', { key: 'Enter', keyCode: 13, which: 13 });
+  }
+});
+
+Given('I have todos {string}, {string}, {string}', function (t1, t2, t3) {
+  this.loadApp();
+  const input = qs(this.document, '.new-todo');
+  for (const t of [t1, t2, t3]) {
+    input.value = t;
+    triggerKeyboardEvent(input, 'keydown', { key: 'Enter', keyCode: 13, which: 13 });
+  }
+});
+
+Given('I have a completed todo {string}', function (text) {
+  this.loadApp();
+  const input = qs(this.document, '.new-todo');
+  input.value = text;
+  triggerKeyboardEvent(input, 'keydown', { key: 'Enter', keyCode: 13, which: 13 });
+  const li = assertTodo(this.document, text);
+  triggerClick(qs(li, '.toggle'));
+});
+
+Given('I am editing the todo {string}', function (text) {
+  this.loadApp();
+  const input = qs(this.document, '.new-todo');
+  input.value = text;
+  triggerKeyboardEvent(input, 'keydown', { key: 'Enter', keyCode: 13, which: 13 });
+  const li = assertTodo(this.document, text);
+  triggerDblclick(qs(li, 'label'));
+});
+
+Given('all existing todos are completed', function () {
+  // Do NOT reload — work with existing todos on the current window
+  const items = qsa(this.document, '.todo-list li');
+  if (items.length === 0) {
+    const input = qs(this.document, '.new-todo');
+    input.value = 'default todo';
+    triggerKeyboardEvent(input, 'keydown', { key: 'Enter', keyCode: 13, which: 13 });
+  }
+  triggerClick(qs(this.document, '.toggle-all'));
+});
+
+// ── When ───────────────────────────────────────────────────────────────────────
+
+When('I type {string} into the new-todo input and press Enter', function (text) {
+  const input = qs(this.document, '.new-todo');
+  input.value = text;
+  triggerKeyboardEvent(input, 'keydown', { key: 'Enter', keyCode: 13, which: 13 });
+});
+
+When('I click the toggle checkbox for {string}', function (text) {
+  const li = assertTodo(this.document, text);
+  triggerClick(qs(li, '.toggle'));
+});
+
+When('I click the toggle-all checkbox', function () {
+  triggerClick(qs(this.document, '.toggle-all'));
+});
+
+When('I double-click the label for {string}', function (text) {
+  const li = assertTodo(this.document, text);
+  triggerDblclick(qs(li, 'label'));
+});
+
+When('I change the text to {string} and press Enter', function (text) {
+  const editInput = qs(this.document, '.todo-list li.editing .edit');
+  editInput.value = text;
+  triggerKeyboardEvent(editInput, 'keydown', { key: 'Enter', keyCode: 13, which: 13 });
+});
+
+When('I change the text to {string} and blur', function (text) {
+  const editInput = qs(this.document, '.todo-list li.editing .edit');
+  editInput.value = text;
+  triggerBlur(editInput);
+});
+
+When('I change the text to {string} and press Escape', function (text) {
+  const editInput = qs(this.document, '.todo-list li.editing .edit');
+  editInput.value = text;
+  triggerKeyboardEvent(editInput, 'keydown', { key: 'Escape', keyCode: 27, which: 27 });
+});
+
+When('I clear the text and press Enter', function () {
+  const editInput = qs(this.document, '.todo-list li.editing .edit');
+  editInput.value = '';
+  triggerKeyboardEvent(editInput, 'keydown', { key: 'Enter', keyCode: 13, which: 13 });
+});
+
+When('I click the destroy button for {string}', function (text) {
+  const li = assertTodo(this.document, text);
+  triggerClick(qs(li, '.destroy'));
+});
+
+When('I complete the todo {string}', function (text) {
+  const li = assertTodo(this.document, text);
+  triggerClick(qs(li, '.toggle'));
+});
+
+When('I uncomplete the todo {string}', function (text) {
+  const li = assertTodo(this.document, text);
+  triggerClick(qs(li, '.toggle'));
+});
+
+When('I click {string}', function (buttonText) {
+  if (buttonText === 'Clear completed') {
+    triggerClick(qs(this.document, '.clear-completed'));
+  }
+});
+
+When('I reload the app', function () {
+  // Save the current localStorage data and hash before reloading
+  var savedData = this.localStorage.getItem(STORAGE_KEY);
+  var savedHash = this.window.location.hash || '#/';
+  // Load fresh app (new window with empty localStorage)
+  this.loadApp();
+  // Restore the saved data to the new window's localStorage
+  if (savedData !== null) {
+    this.localStorage.setItem(STORAGE_KEY, savedData);
+  }
+  // Restore the hash
+  this.window.location.hash = savedHash;
+  // Re-initialize the model from the restored localStorage
+  if (this.window.__appModel) {
+    this.window.__appModel.todos = this.window.__appModel.load();
+    this.window.__appView._updateFilter();
+    this.window.__appView.render();
+  }
+});
+
+When('I navigate to {string}', function (hash) {
+  this.navigate(hash);
+});
+
+When('I type {string} into the edit input and press Enter', function (text) {
+  const editInput = qs(this.document, '.todo-list li.editing .edit');
+  editInput.value = text;
+  triggerKeyboardEvent(editInput, 'keydown', { key: 'Enter', keyCode: 13, which: 13 });
+});
+
+// ── Then ───────────────────────────────────────────────────────────────────────
+
+Then('the {string} section is hidden', function (sectionId) {
+  const el = qs(this.document, sectionId);
+  assert.ok(isHidden(el) || el.style.display === 'none', `Expected ${sectionId} to be hidden`);
+});
+
+Then('I see {int} todo(s) in the list', function (count) {
+  const items = qsa(this.document, '.todo-list li');
+  assert.strictEqual(items.length, count, `Expected ${count} todos, found ${items.length}`);
+});
+
+Then('the new-todo input is cleared', function () {
+  assert.strictEqual(qs(this.document, '.new-todo').value, '');
+});
+
+Then('the todo text is {string}', function (text) {
+  const items = qsa(this.document, '.todo-list li');
+  const labels = items.map(li => li.querySelector('label')?.textContent?.trim());
+  assert.ok(labels.includes(text), `Expected a todo with text "${text}" among [${labels.join(', ')}]`);
+});
+
+Then('the todo {string} has class {string}', function (text, className) {
+  const li = assertTodo(this.document, text);
+  assert.ok(li.classList.contains(className), `Expected todo "${text}" to have class "${className}"`);
+});
+
+Then('the todo {string} does not have class {string}', function (text, className) {
+  const li = assertTodo(this.document, text);
+  assert.ok(!li.classList.contains(className), `Expected todo "${text}" NOT to have class "${className}"`);
+});
+
+Then('the toggle checkbox for {string} is checked', function (text) {
+  const li = assertTodo(this.document, text);
+  const cb = qs(li, '.toggle');
+  assert.ok(cb.checked, `Expected toggle for "${text}" to be checked`);
+});
+
+Then('the toggle checkbox for {string} is not checked', function (text) {
+  const li = assertTodo(this.document, text);
+  const cb = qs(li, '.toggle');
+  assert.ok(!cb.checked, `Expected toggle for "${text}" to NOT be checked`);
+});
+
+Then('the toggle-all checkbox is checked', function () {
+  const cb = qs(this.document, '.toggle-all');
+  assert.ok(cb.checked, 'Expected toggle-all to be checked');
+});
+
+Then('the toggle-all checkbox is not checked', function () {
+  const cb = qs(this.document, '.toggle-all');
+  assert.ok(!cb.checked, 'Expected toggle-all to NOT be checked');
+});
+
+Then('all shown todos are completed', function () {
+  const items = qsa(this.document, '.todo-list li');
+  assert.ok(items.length > 0, 'There should be at least one todo');
+  items.forEach(li => {
+    assert.ok(li.classList.contains('completed'), `Expected todo "${li.querySelector('label')?.textContent?.trim()}" to be completed`);
+  });
+});
+
+Then('the edit input for {string} is focused', function (text) {
+  const li = assertTodo(this.document, text);
+  const editInput = qs(li, '.edit');
+  assert.strictEqual(this.document.activeElement, editInput, `Expected edit input for "${text}" to be focused`);
+});
+
+Then('the todo-count shows {string}', function (expected) {
+  const countEl = qs(this.document, '.todo-count');
+  assert.strictEqual(countEl.textContent.trim(), expected);
+});
+
+Then('the clear-completed button is hidden', function () {
+  const btn = qs(this.document, '.clear-completed');
+  assert.ok(isHidden(btn), 'Expected clear-completed to be hidden');
+});
+
+Then('the {string} filter link has class {string}', function (filterName, className) {
+  const links = qsa(this.document, '.filters a');
+  const link = links.find(a => a.textContent.trim() === filterName);
+  if (!link) throw new Error(`No filter link "${filterName}" found`);
+  assert.ok(link.classList.contains(className), `Expected filter "${filterName}" to have class "${className}"`);
+});
+
+Then('the todo {string} is not in the list', function (text) {
+  assertNoTodo(this.document, text);
+});
+
+Then('the new-todo input has focus', function () {
+  const input = qs(this.document, '.new-todo');
+  assert.strictEqual(this.document.activeElement, input, 'Expected new-todo input to be focused');
+});
