+/*global app*/
+'use strict';
+
+var ENTER_KEY = 13;
+var ESCAPE_KEY = 27;
+var STORAGE_KEY = 'todos-vanillajs';
+
+// ── Todo Model ─────────────────────────────────────────────────────────────────
+
+function TodoModel(storageKey) {
+  this.storageKey = storageKey || STORAGE_KEY;
+  this.todos = this.load();
+}
+
+TodoModel.prototype.load = function () {
+  try {
+    var data = localStorage.getItem(this.storageKey);
+    return data ? JSON.parse(data) : [];
+  } catch (e) {
+    return [];
+  }
+};
+
+TodoModel.prototype.save = function () {
+  localStorage.setItem(this.storageKey, JSON.stringify(this.todos));
+};
+
+TodoModel.prototype.nextId = function () {
+  var max = 0;
+  for (var i = 0; i < this.todos.length; i++) {
+    if (this.todos[i].id > max) max = this.todos[i].id;
+  }
+  return max + 1;
+};
+
+TodoModel.prototype.add = function (title) {
+  var todo = {
+    id: this.nextId(),
+    title: title,
+    completed: false
+  };
+  this.todos.push(todo);
+  this.save();
+  return todo;
+};
+
+TodoModel.prototype.findById = function (id) {
+  for (var i = 0; i < this.todos.length; i++) {
+    if (this.todos[i].id === id) return this.todos[i];
+  }
+  return null;
+};
+
+TodoModel.prototype.update = function (id, updates) {
+  var todo = this.findById(id);
+  if (!todo) return;
+  for (var key in updates) {
+    if (updates.hasOwnProperty(key)) {
+      todo[key] = updates[key];
+    }
+  }
+  this.save();
+};
+
+TodoModel.prototype.remove = function (id) {
+  this.todos = this.todos.filter(function (t) { return t.id !== id; });
+  this.save();
+};
+
+TodoModel.prototype.clearCompleted = function () {
+  this.todos = this.todos.filter(function (t) { return !t.completed; });
+  this.save();
+};
+
+TodoModel.prototype.toggleAll = function (checked) {
+  for (var i = 0; i < this.todos.length; i++) {
+    this.todos[i].completed = checked;
+  }
+  this.save();
+};
+
+TodoModel.prototype.getActive = function () {
+  return this.todos.filter(function (t) { return !t.completed; });
+};
+
+TodoModel.prototype.getCompleted = function () {
+  return this.todos.filter(function (t) { return t.completed; });
+};
+
+// ── Todo View ──────────────────────────────────────────────────────────────────
+
+function TodoView(model) {
+  this.model = model;
+  this.todoList = document.querySelector('.todo-list');
+  this.main = document.querySelector('.main');
+  this.footer = document.querySelector('.footer');
+  this.newTodo = document.querySelector('.new-todo');
+  this.toggleAll = document.querySelector('.toggle-all');
+  this.todoCount = document.querySelector('.todo-count');
+  this.clearCompleted = document.querySelector('.clear-completed');
+  this.filters = document.querySelectorAll('.filters a');
+
+  this.currentFilter = 'all';
+
+  this.bindEvents();
+  this.render();
+}
+
+TodoView.prototype.bindEvents = function () {
+  var self = this;
+
+  // New todo: Enter key
+  this.newTodo.addEventListener('keydown', function (e) {
+    if (e.keyCode === ENTER_KEY) {
+      var title = self.newTodo.value.trim();
+      if (title) {
+        self.model.add(title);
+        self.newTodo.value = '';
+        self.render();
+      }
+    }
+  });
+
+  // Toggle all
+  this.toggleAll.addEventListener('change', function () {
+    self.model.toggleAll(self.toggleAll.checked);
+    self.render();
+  });
+
+  // Clear completed
+  this.clearCompleted.addEventListener('click', function () {
+    self.model.clearCompleted();
+    self.render();
+  });
+
+  // Event delegation for todo list items
+  this.todoList.addEventListener('click', function (e) {
+    var li = self._getLi(e.target);
+    if (!li) return;
+
+    // Toggle checkbox
+    if (e.target.classList.contains('toggle')) {
+      var id = parseInt(li.dataset.id, 10);
+      var todo = self.model.findById(id);
+      if (todo) {
+        self.model.update(id, { completed: !todo.completed });
+        self.render();
+      }
+    }
+
+    // Destroy button
+    if (e.target.classList.contains('destroy')) {
+      var id = parseInt(li.dataset.id, 10);
+      self.model.remove(id);
+      self.render();
+    }
+  });
+
+  // Double-click to edit
+  this.todoList.addEventListener('dblclick', function (e) {
+    var label = e.target.closest('label');
+    if (!label) return;
+    var li = label.closest('li');
+    if (!li) return;
+    self._editTodo(li);
+  });
+
+  // Routing
+  window.addEventListener('hashchange', function () {
+    self._updateFilter();
+    self.render();
+  });
+
+  // Initial filter from URL
+  this._updateFilter();
+};
+
+TodoView.prototype._updateFilter = function () {
+  var hash = window.location.hash || '#/';
+  if (hash === '#/' || hash === '' || hash === '#') {
+    this.currentFilter = 'all';
+  } else if (hash === '#/active') {
+    this.currentFilter = 'active';
+  } else if (hash === '#/completed') {
+    this.currentFilter = 'completed';
+  }
+};
+
+TodoView.prototype._getLi = function (el) {
+  while (el && el.tagName !== 'LI') {
+    el = el.parentNode;
+  }
+  return el;
+};
+
+TodoView.prototype._editTodo = function (li) {
+  var self = this;
+  var id = parseInt(li.dataset.id, 10);
+  var todo = this.model.findById(id);
+  if (!todo) return;
+
+  var label = li.querySelector('label');
+  var editInput = li.querySelector('.edit');
+  var originalTitle = todo.title;
+
+  li.classList.add('editing');
+  editInput.value = todo.title;
+  editInput.focus();
+
+  // Save on Enter
+  function onKeydown(e) {
+    if (e.keyCode === ENTER_KEY) {
+      e.preventDefault();
+      editInput.blur();
+    }
+    if (e.keyCode === ESCAPE_KEY) {
+      editInput.value = originalTitle;
+      li.classList.remove('editing');
+      cleanup();
+    }
+  }
+
+  // Save on blur
+  function onBlur() {
+    var title = editInput.value.trim();
+    if (title) {
+      self.model.update(id, { title: title });
+    } else {
+      self.model.remove(id);
+    }
+    li.classList.remove('editing');
+    cleanup();
+    self.render();
+  }
+
+  function cleanup() {
+    editInput.removeEventListener('keydown', onKeydown);
+    editInput.removeEventListener('blur', onBlur);
+  }
+
+  editInput.addEventListener('keydown', onKeydown);
+  editInput.addEventListener('blur', onBlur);
+};
+
+TodoView.prototype._getFilteredTodos = function () {
+  if (this.currentFilter === 'active') {
+    return this.model.getActive();
+  }
+  if (this.currentFilter === 'completed') {
+    return this.model.getCompleted();
+  }
+  return this.model.todos;
+};
+
+TodoView.prototype.render = function () {
+  var filtered = this._getFilteredTodos();
+  var allTodos = this.model.todos;
+  var activeCount = this.model.getActive().length;
+  var completedCount = this.model.getCompleted().length;
+
+  // Render todo list
+  this.todoList.innerHTML = '';
+  for (var i = 0; i < filtered.length; i++) {
+    var todo = filtered[i];
+    var li = document.createElement('li');
+    li.dataset.id = todo.id;
+    if (todo.completed) li.classList.add('completed');
+
+    li.innerHTML =
+      '<div class="view">' +
+        '<input class="toggle" type="checkbox"' + (todo.completed ? ' checked' : '') + '>' +
+        '<label>' + this._escapeHtml(todo.title) + '</label>' +
+        '<button class="destroy"></button>' +
+      '</div>' +
+      '<input class="edit" value="' + this._escapeHtml(todo.title) + '">';
+
+    this.todoList.appendChild(li);
+  }
+
+  // Main visibility
+  this.main.style.display = allTodos.length > 0 ? 'block' : 'none';
+  this.footer.style.display = allTodos.length > 0 ? 'block' : 'none';
+
+  // Toggle-all state
+  this.toggleAll.checked = allTodos.length > 0 && activeCount === 0;
+
+  // Todo count
+  var word = activeCount === 1 ? 'item' : 'items';
+  this.todoCount.innerHTML = '<strong>' + activeCount + '</strong> ' + word + ' left';
+
+  // Clear completed visibility
+  this.clearCompleted.style.display = completedCount > 0 ? 'block' : 'none';
+
+  // Filter selected class
+  for (var j = 0; j < this.filters.length; j++) {
+    var a = this.filters[j];
+    a.classList.remove('selected');
+    var href = a.getAttribute('href');
+    if ((this.currentFilter === 'all' && (href === '#/' || href === '#')) ||
+        (this.currentFilter === 'active' && href === '#/active') ||
+        (this.currentFilter === 'completed' && href === '#/completed')) {
+      a.classList.add('selected');
+    }
+  }
+};
+
+TodoView.prototype._escapeHtml = function (str) {
+  var div = document.createElement('div');
+  div.appendChild(document.createTextNode(str));
+  return div.innerHTML;
+};
+
+// ── Bootstrap ──────────────────────────────────────────────────────────────────
+
+(function () {
+  var model = new TodoModel();
+  var view = new TodoView(model);
+  window.__appModel = model;
+  window.__appView = view;
+})();
