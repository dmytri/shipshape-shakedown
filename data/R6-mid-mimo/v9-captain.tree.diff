+Feature: Browser acceptance defects
+  As a user interacting with the app in a real browser
+  I want the app to handle real browser event sequences correctly
+  So that editing-to-empty and back-button routing work without errors
+
+  Background:
+    Given the app is loaded
+
+  # ── Defect 1: Editing to empty via blur + Enter ────────────────────────
+  # In a real browser, pressing Enter on an empty edit input fires both
+  # a keydown(Enter) event and a blur event (because the input loses
+  # focus during DOM manipulation).  Both handlers call finishEditing()
+  # → destroyTodo() → render().  The first render()'s orphan-removal
+  # loop calls parentNode.removeChild(li), which detaches the input,
+  # firing blur synchronously mid-loop.  The blur handler re-enters
+  # render(), removing the same orphan.  The original loop then tries
+  # removeChild on a node whose parentNode no longer considers it a
+  # child, throwing: "Failed to execute 'removeChild' on 'Node'".
+  #
+  # The in-harness suite dispatches only one event at a time, so the
+  # re-entrant render never occurs and the scenario passes.
+
+  Rule: Editing to empty must not throw when both blur and Enter fire
+
+    Scenario: Clearing edit input via simultaneous blur and Enter destroys the todo without error
+      Given a todo "Buy milk" exists
+      When the user double-clicks the label of todo "Buy milk"
+      And the user clears the edit input and fires blur and Enter together
+      Then the todo "Buy milk" no longer exists
+      And the todo list is empty
+
+    Scenario: Destroying an editing todo clears the editing state
+      Given a todo "Buy milk" exists
+      When the user double-clicks the label of todo "Buy milk"
+      And the user clears the edit input and fires blur and Enter together
+      Then no todo is in editing mode
+
+  # ── Defect 2: Routing — back button after filter clicks ────────────────
+  # The filter click handler calls e.preventDefault() but never updates
+  # window.location.hash.  So clicking filter links does not push
+  # history entries.  When the user presses the browser back button,
+  # history.back() has nothing to go back to — the hash stays the same,
+  # hashchange never fires, and the filter does not change.
+  #
+  # The in-harness suite manually sets the hash via navigate() which
+  # always pushes a history entry, masking the defect.  In a real
+  # browser, clicking a filter link should update the hash so that
+  # history.back() restores the previous filter.
+
+  Rule: Filter links must update the URL hash so back button works
+
+    Scenario: Clicking a filter link updates the hash
+      Given a todo "Buy milk" exists
+      When the user clicks the "Active" filter link
+      Then the window hash is "#/active"
+
+    Scenario: Clicking the All filter link updates the hash
+      Given the following todos exist:
+        | title        | completed |
+        | Buy milk     | false     |
+        | Walk the dog | true      |
+      When the user navigates to "#/active"
+      And the user clicks the "All" filter link
+      Then the window hash is "#/"
+
+    Scenario: Back button after clicking Active filter shows previous view
+      Given the following todos exist:
+        | title        | completed |
+        | Buy milk     | false     |
+        | Walk the dog | true      |
+      When the user clicks the "Active" filter link
+      Then only the todo "Buy milk" is visible
+      When the user presses the browser back button without manual hashchange
+      Then both todos are visible
+
+    Scenario: Back button after clicking Completed filter shows previous view
+      Given the following todos exist:
+        | title        | completed |
+        | Buy milk     | false     |
+        | Walk the dog | true      |
+      When the user clicks the "Completed" filter link
+      Then only the todo "Walk the dog" is visible
+      When the user presses the browser back button without manual hashchange
+      Then both todos are visible
diff --git a/features/support/steps.js b/features/support/steps.js
index 6156352..2442b72 100644
--- a/features/support/steps.js
+++ b/features/support/steps.js
@@ -387,3 +387,49 @@ When('the user presses the browser back button', function () {
   this.window.history.back();
   this.window.dispatchEvent(new this.window.Event('hashchange'));
 });
+
+// ── Browser-acceptance defect steps ──────────────────────────────────────
+
+// Fires blur THEN keydown(Enter) on the edit input, reproducing the real-browser
+// event sequence when a user presses Enter while the input is focused.
+// In a real browser both events fire; the double-destroy causes removeChild to
+// fail. This step lets the in-harness suite exercise the same path.
+When('the user clears the edit input and fires blur and Enter together', function () {
+  const editInput = this.document.querySelector('.todo-list li.editing .edit');
+  editInput.value = '';
+  // Blur fires first in real browsers, then keydown(Enter)
+  editInput.dispatchEvent(new this.window.Event('blur', { bubbles: true }));
+  editInput.dispatchEvent(new this.window.KeyboardEvent('keydown', { keyCode: 13, bubbles: true }));
+});
+
+// Asserts that no <li> in the todo list has the 'editing' class.
+Then('no todo is in editing mode', function () {
+  const editingItems = this.document.querySelectorAll('.todo-list li.editing');
+  expect(editingItems.length).to.equal(0);
+});
+
+// Presses browser back WITHOUT manually dispatching hashchange.
+// In a real browser history.back() fires hashchange synchronously.
+// In happy-dom the hash changes but hashchange fires asynchronously,
+// so the app may not re-render in time — reproducing the real defect.
+When('the user presses the browser back button without manual hashchange', function () {
+  this.window.history.back();
+  // Do NOT dispatch hashchange — let the browser/happy-dom handle it naturally.
+});
+
+// Clicks a filter link by its visible text ("All", "Active", or "Completed").
+When('the user clicks the {string} filter link', function (name) {
+  const links = this.document.querySelectorAll('.filters a');
+  for (const link of links) {
+    if (link.textContent === name) {
+      link.click();
+      return;
+    }
+  }
+  throw new Error(`Filter link "${name}" not found`);
+});
+
+// Asserts the current window.location.hash.
+Then('the window hash is {string}', function (expectedHash) {
+  expect(this.window.location.hash).to.equal(expectedHash);
+});
