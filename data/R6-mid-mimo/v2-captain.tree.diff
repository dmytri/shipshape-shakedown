+
+When('the user remembers the first todo-list li element', function () {
+  const firstLi = this.document.querySelector('.todo-list li');
+  this._rememberedLi = firstLi;
+});
+
+Then('the remembered li element is still in the document', function () {
+  expect(this._rememberedLi).to.not.be.null;
+  expect(this.document.body.contains(this._rememberedLi)).to.be.true;
+});
