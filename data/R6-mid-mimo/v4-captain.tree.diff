+{
+  "base": "HEAD",
+  "watches": [
+    {
+      "name": "dom-identity-conformance",
+      "targets": [
+        "features/dom-identity-conformance.feature: Toggling a single todo preserves the li DOM node identity",
+        "features/dom-identity-conformance.feature: Toggling all todos preserves the li DOM node identity"
+      ],
+      "notes": "New @conformance scenarios. The current render() destroys and recreates all li nodes via innerHTML on every state change, so capturing a list-item reference before a toggle and asserting document.contains() after will fail. Fix the app to mutate existing nodes in place (toggle class, update checkbox.checked) instead of rebuilding the list. These scenarios require two new step definitions: 'the list item references are captured' and 'every captured list item reference is still attached to the document'."
+    },
+    {
+      "name": "existing-lifecycle-behaviour",
+      "targets": [
+        "features/todo-lifecycle.feature: Clicking the checkbox marks a todo as completed",
+        "features/todo-lifecycle.feature: Unchecking a completed todo makes it active again",
+        "features/todo-lifecycle.feature: Toggle-all checks all todos",
+        "features/todo-lifecycle.feature: Toggle-all unchecks when all are already complete"
+      ],
+      "notes": "Existing product scenarios that the external browser acceptance suite fails with 'element has detached from the DOM'. The in-harness suite passes because it re-queries between steps. The dom-identity-conformance fix (mutate nodes in place) resolves these failures as a side effect. No new step definitions needed for these targets."
+    }
+  ]
+}
