+// ── Source-level conformance checks ──────────────────────────────────────
+
+Given('the app source is loaded', function () {
+  const fs = require('node:fs');
+  const path = require('node:path');
+  const appPath = path.resolve(__dirname, '..', '..', 'js', 'app.js');
+  this._appSource = fs.readFileSync(appPath, 'utf8');
+});
+
+Then('the render function contains a parentNode guard in the orphan-removal loop', function () {
+  // The orphan-removal loop in render() must guard against detached nodes.
+  // In a real browser, re-entrant blur during removeChild causes the node
+  // to be detached before the loop reaches it. The guard checks parentNode
+  // before calling removeChild, preventing the NotFoundError.
+  const source = this._appSource;
+  // Find the orphan-removal loop: it iterates existingLis and calls removeChild
+  const hasOrphanLoop = /existingLis\[j\]/.test(source);
+  expect(hasOrphanLoop, 'Source must contain an orphan-removal loop over existingLis').to.be.true;
+  // Extract the orphan-removal loop block (from existingLis[j] to the closing brace)
+  const startIdx = source.indexOf('existingLis[j]');
+  const loopSection = source.substring(startIdx, startIdx + 500);
+  // The guard must CHECK parentNode in a conditional BEFORE removeChild.
+  // A bare `existingLis[j].parentNode.removeChild(...)` is NOT a guard.
+  // We need to find: if (... parentNode ...) { ... removeChild ... }
+  // Split the loop section into lines and check if there's an if-condition referencing parentNode
+  const lines = loopSection.split('\n');
+  let foundGuard = false;
+  for (const line of lines) {
+    // Match an if/while condition that mentions parentNode
+    if (/\bif\s*\(.*parentNode.*\)/.test(line) || /\bwhile\s*\(.*parentNode.*\)/.test(line)) {
+      foundGuard = true;
+      break;
+    }
+  }
+  expect(foundGuard, 'The orphan-removal loop must contain a conditional (if/while) that explicitly tests parentNode before calling removeChild — e.g. if (existingLis[j].parentNode) { existingLis[j].parentNode.removeChild(...) }. A bare parentNode.removeChild without a guard does not prevent NotFoundError during re-entrant blur').to.be.true;
+});
