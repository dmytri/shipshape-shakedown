diff --git a/features/support/steps.js b/features/support/steps.js
index c60bd32..6156352 100644
--- a/features/support/steps.js
+++ b/features/support/steps.js
@@ -328,3 +328,62 @@ Then('the second item in localStorage {string} has id {int}', function (key, id)
   const arr = JSON.parse(stored);
   expect(arr[1].id).to.equal(id);
 });
+
+// ── DOM-identity steps ───────────────────────────────────────────────────
+// These steps hold ACTUAL DOM element references across actions, so they
+// detect the defect where render() destroys and recreates <li> nodes
+// (innerHTML = '') instead of mutating them in place.
+
+When('the user notes the DOM node for todo {string}', function (title) {
+  const labels = this.document.querySelectorAll('.todo-list label');
+  for (const label of labels) {
+    if (label.textContent === title) {
+      this._trackedLi = label.closest('li');
+      return;
+    }
+  }
+  throw new Error(`Todo "${title}" not found in the DOM`);
+});
+
+When('the user notes the first DOM node in the list', function () {
+  const items = this.document.querySelectorAll('.todo-list li');
+  if (items.length === 0) throw new Error('No todo items in the list');
+  this._trackedLi = items[0];
+});
+
+When('the user notes all {int} DOM nodes in the list', function (count) {
+  const items = this.document.querySelectorAll('.todo-list li');
+  if (items.length !== count) throw new Error(`Expected ${count} items, got ${items.length}`);
+  this._trackedLis = Array.from(items);
+});
+
+Then('the tracked DOM node is still the same element', function () {
+  expect(this._trackedLi).to.exist;
+  // Walk up to the parent and check that the tracked node is still a direct child.
+  // If render() destroyed and recreated it, the original reference would be orphaned
+  // and this check would fail.
+  const parent = this._trackedLi.parentNode;
+  expect(parent).to.exist;
+  const stillPresent = Array.from(parent.childNodes).some(child => child === this._trackedLi);
+  expect(stillPresent).to.be.true;
+});
+
+Then('the tracked DOM nodes are still the same elements', function () {
+  expect(this._trackedLis).to.exist;
+  const items = this.document.querySelectorAll('.todo-list li');
+  expect(items.length).to.equal(this._trackedLis.length);
+  for (let i = 0; i < this._trackedLis.length; i++) {
+    const tracked = this._trackedLis[i];
+    const parent = tracked.parentNode;
+    expect(parent).to.exist;
+    const stillPresent = Array.from(parent.childNodes).some(child => child === tracked);
+    expect(stillPresent).to.be.true;
+  }
+});
+
+// ── Routing back-button step ──────────────────────────────────────────────
+
+When('the user presses the browser back button', function () {
+  this.window.history.back();
+  this.window.dispatchEvent(new this.window.Event('hashchange'));
+});
