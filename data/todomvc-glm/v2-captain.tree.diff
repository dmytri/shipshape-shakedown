+  if (!checkbox) {
+    throw new Error('Checkbox should exist');
+  }
+  const computedStyle = window.getComputedStyle(checkbox);
+  if (computedStyle.display !== 'none') {
+    throw new Error('Todo checkbox should be hidden when editing');
+  }
+});
