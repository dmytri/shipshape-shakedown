--- /dev/null
+++ b/specs/support/setup.js
@@ -0,0 +1,193 @@
+const { setWorldConstructor, Before, After } = require('@cucumber/cucumber');
+const { Window } = require('happy-dom');
+const fs = require('fs');
+const path = require('path');
+
+class TodoWorld {
+  constructor() {
+    this.window = null;
+    this.document = null;
+  }
+
+  async openApp() {
+    this.window = new Window({ url: 'http://localhost/' });
+    this.document = this.window.document;
+
+    const htmlPath = path.join(__dirname, '..', '..', 'index.html');
+    const html = fs.readFileSync(htmlPath, 'utf8');
+    
+    // Parse the HTML and set it
+    this.document.write(html);
+    this.document.close();
+
+    // Execute scripts in the window context
+    const scripts = this.document.querySelectorAll('script');
+    for (const script of scripts) {
+      const src = script.getAttribute('src');
+      if (src) {
+        const scriptPath = path.join(__dirname, '..', '..', src);
+        if (fs.existsSync(scriptPath)) {
+          const code = fs.readFileSync(scriptPath, 'utf8');
+          try {
+            this.window.eval(code);
+          } catch (e) {
+            console.error('Script error:', e.message);
+          }
+        }
+      }
+    }
+  }
+
+  addTodo(title) {
+    const input = this.document.querySelector('.new-todo');
+    input.value = title;
+    input.dispatchEvent(new this.window.Event('change'));
+    input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, bubbles: true }));
+  }
+
+  getTodos() {
+    return Array.from(this.document.querySelectorAll('.todo-list li'));
+  }
+
+  getTodoAt(position) {
+    const todos = this.getTodos();
+    return todos[position - 1] || null;
+  }
+
+  toggleTodoAt(position) {
+    const todo = this.getTodoAt(position);
+    if (todo) {
+      const checkbox = todo.querySelector('.toggle');
+      checkbox.dispatchEvent(new this.window.MouseEvent('click', { bubbles: true }));
+    }
+  }
+
+  destroyTodoAt(position) {
+    const todo = this.getTodoAt(position);
+    if (todo) {
+      const destroyBtn = todo.querySelector('.destroy');
+      destroyBtn.dispatchEvent(new this.window.MouseEvent('click', { bubbles: true }));
+    }
+  }
+
+  toggleAllOn() {
+    const toggleAll = this.document.querySelector('#toggle-all');
+    if (!toggleAll.checked) {
+      toggleAll.dispatchEvent(new this.window.MouseEvent('click', { bubbles: true }));
+    }
+  }
+
+  toggleAllOff() {
+    const toggleAll = this.document.querySelector('#toggle-all');
+    if (toggleAll.checked) {
+      toggleAll.dispatchEvent(new this.window.MouseEvent('click', { bubbles: true }));
+    }
+  }
+
+  clearCompleted() {
+    const btn = this.document.querySelector('.clear-completed');
+    if (btn) {
+      btn.dispatchEvent(new this.window.MouseEvent('click', { bubbles: true }));
+    }
+  }
+
+  doubleClickTodoAt(position) {
+    const todo = this.getTodoAt(position);
+    if (todo) {
+      const label = todo.querySelector('label');
+      label.dispatchEvent(new this.window.MouseEvent('dblclick', { bubbles: true }));
+    }
+  }
+
+  typeInEditInput(text) {
+    const editing = this.document.querySelector('.todo-list li.editing');
+    if (editing) {
+      const editInput = editing.querySelector('.edit');
+      editInput.value = text;
+      editInput.dispatchEvent(new this.window.Event('input'));
+    }
+  }
+
+  clearEditInput() {
+    const editing = this.document.querySelector('.todo-list li.editing');
+    if (editing) {
+      const editInput = editing.querySelector('.edit');
+      editInput.value = '';
+      editInput.dispatchEvent(new this.window.Event('input'));
+    }
+  }
+
+  pressEnterInEditInput() {
+    const editing = this.document.querySelector('.todo-list li.editing');
+    if (editing) {
+      const editInput = editing.querySelector('.edit');
+      editInput.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, bubbles: true }));
+    }
+  }
+
+  pressEscapeInEditInput() {
+    const editing = this.document.querySelector('.todo-list li.editing');
+    if (editing) {
+      const editInput = editing.querySelector('.edit');
+      editInput.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Escape', keyCode: 27, bubbles: true }));
+    }
+  }
+
+  blurEditInput() {
+    const editing = this.document.querySelector('.todo-list li.editing');
+    if (editing) {
+      const editInput = editing.querySelector('.edit');
+      editInput.dispatchEvent(new this.window.Event('blur'));
+    }
+  }
+
+  navigateTo(route) {
+    this.window.location.hash = route;
+    this.window.dispatchEvent(new this.window.Event('hashchange'));
+  }
+
+  reload() {
+    // Re-read localStorage and re-render
+    const todos = this.getTodos();
+    todos.forEach(todo => todo.remove());
+    this.window.location.reload();
+  }
+
+  focusInput() {
+    const input = this.document.querySelector('.new-todo');
+    input.focus();
+  }
+
+  typeAndSubmit(text) {
+    const input = this.document.querySelector('.new-todo');
+    input.value = text;
+    input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, bubbles: true }));
+  }
+
+  setLocalStorage(key, todos) {
+    this.window.localStorage.setItem(key, JSON.stringify(todos));
+  }
+
+  getLocalStorage(key) {
+    return this.window.localStorage.getItem(key);
+  }
+
+  clearLocalStorage() {
+    if (this.window) {
+      this.window.localStorage.clear();
+    }
+  }
+}
+
+setWorldConstructor(TodoWorld);
+
+Before(async function () {
+  await this.openApp();
+  this.clearLocalStorage();
+});
+
+After(async function () {
+  if (this.window) {
+    this.window.close();
+  }
+});
diff --git a/specs/support/steps.js b/specs/support/steps.js
new file mode 100644
index 0000000..e7871e3
--- /dev/null
+++ b/specs/support/steps.js
@@ -0,0 +1,243 @@
+const { Given, When, Then, defineParameterType } = require('@cucumber/cucumber');
+const assert = require('assert');
+
+// Define boolean parameter type
+defineParameterType({
+  name: 'boolean',
+  regexp: /true|false/,
+  transformer: s => s === 'true'
+});
+
+// Background
+Given('the TodoMVC app is open', async function () {
+  await this.openApp();
+});
+
+// Given steps
+Given('the todo input is focused', function () {
+  this.focusInput();
+});
+
+Given('the user has added a todo {string}', function (title) {
+  this.addTodo(title);
+});
+
+Given('there are no todos', function () {
+  // No action needed - app starts with no todos
+});
+
+Given('localStorage {string} contains a todo with title {string} and completed {boolean}', function (key, title, completed) {
+  const data = this.getLocalStorage(key);
+  if (data) {
+    // Then context: assert
+    const todos = JSON.parse(data);
+    const found = todos.find(t => t.title === title);
+    assert.ok(found);
+    assert.strictEqual(found.completed, completed);
+  } else {
+    // Given context: set up
+    const todos = [{ id: Date.now(), title, completed }];
+    this.setLocalStorage(key, todos);
+  }
+});
+
+Given('all todos are completed', function () {
+  this.toggleAllOn();
+});
+
+Given('the user is editing the todo at position {int}', function (position) {
+  this.doubleClickTodoAt(position);
+});
+
+Given('the todo at position {int} is completed', function (position) {
+  const todo = this.getTodoAt(position);
+  if (todo && !todo.classList.contains('completed')) {
+    this.toggleTodoAt(position);
+  }
+});
+
+// When steps
+When('the user types {string} and presses Enter', function (text) {
+  this.typeAndSubmit(text);
+});
+
+When('the user adds a todo {string}', function (title) {
+  this.addTodo(title);
+});
+
+When('the user destroys the todo at position {int}', function (position) {
+  this.destroyTodoAt(position);
+});
+
+When('the user toggles the todo at position {int}', function (position) {
+  this.toggleTodoAt(position);
+});
+
+When('the user toggles all todos on', function () {
+  this.toggleAllOn();
+});
+
+When('the user toggles all todos off', function () {
+  this.toggleAllOff();
+});
+
+When('the user clicks clear-completed', function () {
+  this.clearCompleted();
+});
+
+When('the user double-clicks the todo at position {int}', function (position) {
+  this.doubleClickTodoAt(position);
+});
+
+When('the user clears the edit input and types {string}', function (text) {
+  this.clearEditInput();
+  this.typeInEditInput(text);
+});
+
+When('the user presses Enter to confirm', function () {
+  this.pressEnterInEditInput();
+});
+
+When('the user blurs the edit input', function () {
+  this.blurEditInput();
+});
+
+When('the user presses Escape', function () {
+  this.pressEscapeInEditInput();
+});
+
+When('the user clears the edit input', function () {
+  this.clearEditInput();
+});
+
+When('the user navigates to {string}', function (route) {
+  this.navigateTo(route);
+});
+
+When('the app reloads', function () {
+  this.reload();
+});
+
+// Then steps
+Then('the main section is hidden', function () {
+  const main = this.document.querySelector('.main');
+  assert.strictEqual(main.style.display, 'none');
+});
+
+Then('the footer is hidden', function () {
+  const footer = this.document.querySelector('.footer');
+  assert.strictEqual(footer.style.display, 'none');
+});
+
+Then('the todo list contains {int} item(s)', function (count) {
+  const todos = this.getTodos();
+  assert.strictEqual(todos.length, count);
+});
+
+Then('the todo at position {int} has title {string}', function (position, title) {
+  const todo = this.getTodoAt(position);
+  const label = todo.querySelector('label');
+  assert.strictEqual(label.textContent, title);
+});
+
+Then('the todo at position {int} is not completed', function (position) {
+  const todo = this.getTodoAt(position);
+  assert.ok(!todo.classList.contains('completed'));
+});
+
+Then('the todo input is empty', function () {
+  const input = this.document.querySelector('.new-todo');
+  assert.strictEqual(input.value, '');
+});
+
+Then('the main section is visible', function () {
+  const main = this.document.querySelector('.main');
+  assert.notStrictEqual(main.style.display, 'none');
+});
+
+Then('the footer is visible', function () {
+  const footer = this.document.querySelector('.footer');
+  assert.notStrictEqual(footer.style.display, 'none');
+});
+
+Then('the todo at position {int} has class {string}', function (position, className) {
+  const todo = this.getTodoAt(position);
+  assert.ok(todo.classList.contains(className));
+});
+
+Then('the toggle-all checkbox is checked', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  assert.ok(toggleAll.checked);
+});
+
+Then('the toggle-all checkbox is not checked', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  assert.ok(!toggleAll.checked);
+});
+
+Then('the clear-completed button is hidden', function () {
+  const btn = this.document.querySelector('.clear-completed');
+  assert.strictEqual(btn.style.display, 'none');
+});
+
+Then('the clear-completed button is visible', function () {
+  const btn = this.document.querySelector('.clear-completed');
+  assert.notStrictEqual(btn.style.display, 'none');
+});
+
+Then('localStorage contains a key {string}', function (key) {
+  const value = this.getLocalStorage(key);
+  assert.ok(value !== null);
+});
+
+Then('localStorage {string} does not contain a todo with title {string}', function (key, title) {
+  const data = this.getLocalStorage(key);
+  if (data) {
+    const todos = JSON.parse(data);
+    const found = todos.find(t => t.title === title);
+    assert.ok(!found);
+  }
+});
+
+Then('the counter text is {string}', function (text) {
+  const counter = this.document.querySelector('.todo-count');
+  assert.strictEqual(counter.textContent.trim(), text);
+});
+
+Then('the todo list shows {int} visible item(s)', function (count) {
+  const todos = this.getTodos();
+  const visible = todos.filter(t => t.style.display !== 'none');
+  assert.strictEqual(visible.length, count);
+});
+
+Then('the {string} filter link has class {string}', function (filter, className) {
+  const links = this.document.querySelectorAll('.filters a');
+  const link = Array.from(links).find(l => l.textContent === filter);
+  assert.ok(link);
+  assert.ok(link.classList.contains(className));
+});
+
+Then('the visible todo at position {int} has title {string}', function (position, title) {
+  const todos = this.getTodos();
+  const visible = todos.filter(t => t.style.display !== 'none');
+  const todo = visible[position - 1];
+  const label = todo.querySelector('label');
+  assert.strictEqual(label.textContent, title);
+});
+
+Then('the edit input at position {int} has value {string}', function (position, value) {
+  const todo = this.getTodoAt(position);
+  const editInput = todo.querySelector('.edit');
+  assert.strictEqual(editInput.value, value);
+});
+
+Then('the edit input at position {int} is focused', function (position) {
+  const todo = this.getTodoAt(position);
+  const editInput = todo.querySelector('.edit');
+  assert.strictEqual(this.document.activeElement, editInput);
+});
+
+Then('the todo at position {int} does not have class {string}', function (position, className) {
+  const todo = this.getTodoAt(position);
+  assert.ok(!todo.classList.contains(className));
+});
