+++ b/js/app.js
@@ -0,0 +1,270 @@
+(function () {
+  'use strict';
+
+  var ENTER_KEY = 13;
+  var ESCAPE_KEY = 27;
+  var STORAGE_KEY = 'todos-vanillajs';
+
+  var todoList = document.querySelector('.todo-list');
+  var newTodoInput = document.querySelector('.new-todo');
+  var main = document.querySelector('.main');
+  var footer = document.querySelector('.footer');
+  var toggleAll = document.querySelector('#toggle-all');
+  var clearCompleted = document.querySelector('.clear-completed');
+  var todoCount = document.querySelector('.todo-count');
+  var filterLinks = document.querySelectorAll('.filters a');
+
+  var todos = [];
+  var currentFilter = '/';
+
+  function init() {
+    loadTodos();
+    render();
+    setupEventListeners();
+    handleRoute();
+  }
+
+  function loadTodos() {
+    var data = localStorage.getItem(STORAGE_KEY);
+    if (data) {
+      todos = JSON.parse(data);
+    }
+  }
+
+  function saveTodos() {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
+  }
+
+  function addTodo(title) {
+    title = title.trim();
+    if (title === '') {
+      return;
+    }
+    todos.push({
+      id: Date.now(),
+      title: title,
+      completed: false
+    });
+    saveTodos();
+    render();
+  }
+
+  function destroyTodo(id) {
+    todos = todos.filter(function (todo) {
+      return todo.id !== id;
+    });
+    saveTodos();
+    render();
+  }
+
+  function toggleTodo(id) {
+    todos.forEach(function (todo) {
+      if (todo.id === id) {
+        todo.completed = !todo.completed;
+      }
+    });
+    saveTodos();
+    render();
+  }
+
+  function toggleAll() {
+    var allCompleted = todos.every(function (todo) {
+      return todo.completed;
+    });
+    todos.forEach(function (todo) {
+      todo.completed = !allCompleted;
+    });
+    saveTodos();
+    render();
+  }
+
+  function clearCompletedTodos() {
+    todos = todos.filter(function (todo) {
+      return !todo.completed;
+    });
+    saveTodos();
+    render();
+  }
+
+  function updateTodoTitle(id, newTitle) {
+    newTitle = newTitle.trim();
+    if (newTitle === '') {
+      destroyTodo(id);
+      return;
+    }
+    todos.forEach(function (todo) {
+      if (todo.id === id) {
+        todo.title = newTitle;
+      }
+    });
+    saveTodos();
+    render();
+  }
+
+  function getFilteredTodos() {
+    return todos.filter(function (todo) {
+      if (currentFilter === '/active') {
+        return !todo.completed;
+      }
+      if (currentFilter === '/completed') {
+        return todo.completed;
+      }
+      return true;
+    });
+  }
+
+  function render() {
+    var filtered = getFilteredTodos();
+    
+    todoList.innerHTML = '';
+    filtered.forEach(function (todo) {
+      var li = document.createElement('li');
+      li.dataset.id = todo.id;
+      if (todo.completed) {
+        li.classList.add('completed');
+      }
+      
+      li.innerHTML = '<div class="view">' +
+        '<input class="toggle" type="checkbox"' + (todo.completed ? ' checked' : '') + '>' +
+        '<label>' + escapeHtml(todo.title) + '</label>' +
+        '<button class="destroy"></button>' +
+        '</div>' +
+        '<input class="edit" value="' + escapeHtml(todo.title) + '">';
+      
+      todoList.appendChild(li);
+    });
+
+    updateMainVisibility();
+    updateFooterVisibility();
+    updateTodoCount();
+    updateToggleAllState();
+    updateClearCompletedVisibility();
+    updateFilterLinks();
+  }
+
+  function updateMainVisibility() {
+    main.style.display = todos.length === 0 ? 'none' : '';
+  }
+
+  function updateFooterVisibility() {
+    footer.style.display = todos.length === 0 ? 'none' : '';
+  }
+
+  function updateTodoCount() {
+    var activeCount = todos.filter(function (todo) {
+      return !todo.completed;
+    }).length;
+    var plural = activeCount === 1 ? 'item' : 'items';
+    todoCount.innerHTML = '<strong>' + activeCount + '</strong> ' + plural + ' left';
+  }
+
+  function updateToggleAllState() {
+    if (todos.length === 0) {
+      toggleAll.checked = false;
+    } else {
+      toggleAll.checked = todos.every(function (todo) {
+        return todo.completed;
+      });
+    }
+  }
+
+  function updateClearCompletedVisibility() {
+    var hasCompleted = todos.some(function (todo) {
+      return todo.completed;
+    });
+    clearCompleted.style.display = hasCompleted ? '' : 'none';
+  }
+
+  function updateFilterLinks() {
+    filterLinks.forEach(function (link) {
+      var href = link.getAttribute('href');
+      if (href === '#' + currentFilter) {
+        link.classList.add('selected');
+      } else {
+        link.classList.remove('selected');
+      }
+    });
+  }
+
+  function escapeHtml(text) {
+    var div = document.createElement('div');
+    div.appendChild(document.createTextNode(text));
+    return div.innerHTML;
+  }
+
+  function setupEventListeners() {
+    newTodoInput.addEventListener('keydown', function (e) {
+      if (e.keyCode === ENTER_KEY) {
+        addTodo(newTodoInput.value);
+        newTodoInput.value = '';
+      }
+    });
+
+    todoList.addEventListener('click', function (e) {
+      var target = e.target;
+      var li = target.closest('li');
+      var id = parseInt(li.dataset.id);
+      
+      if (target.classList.contains('toggle')) {
+        toggleTodo(id);
+      } else if (target.classList.contains('destroy')) {
+        destroyTodo(id);
+      }
+    });
+
+    todoList.addEventListener('dblclick', function (e) {
+      var target = e.target;
+      if (target.tagName === 'LABEL') {
+        var li = target.closest('li');
+        li.classList.add('editing');
+        var editInput = li.querySelector('.edit');
+        editInput.focus();
+      }
+    });
+
+    todoList.addEventListener('keydown', function (e) {
+      var target = e.target;
+      if (target.classList.contains('edit')) {
+        var li = target.closest('li');
+        var id = parseInt(li.dataset.id);
+        
+        if (e.keyCode === ENTER_KEY) {
+          updateTodoTitle(id, target.value);
+        } else if (e.keyCode === ESCAPE_KEY) {
+          target.value = li.querySelector('label').textContent;
+          li.classList.remove('editing');
+        }
+      }
+    });
+
+    todoList.addEventListener('blur', function (e) {
+      var target = e.target;
+      if (target.classList.contains('edit')) {
+        var li = target.closest('li');
+        var id = parseInt(li.dataset.id);
+        updateTodoTitle(id, target.value);
+        li.classList.remove('editing');
+      }
+    }, true);
+
+    toggleAll.addEventListener('click', function () {
+      toggleAll();
+    });
+
+    clearCompleted.addEventListener('click', function () {
+      clearCompletedTodos();
+    });
+
+    window.addEventListener('hashchange', function () {
+      handleRoute();
+    });
+  }
+
+  function handleRoute() {
+    var hash = window.location.hash || '#/';
+    currentFilter = hash.slice(1) || '/';
+    render();
+  }
+
+  init();
+})();
