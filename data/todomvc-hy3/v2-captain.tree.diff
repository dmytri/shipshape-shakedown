+/**
+ * Builds a list row element for a todo, wiring its event handlers once.
+ * Rows are created once and then kept in place across renders, keyed by todo id.
+ */
+function createRow(todo) {
+  const li = document.createElement('li');
+  li.dataset.id = todo.id;
+
+  const view = document.createElement('div');
+  view.className = 'view';
+  const toggle = document.createElement('input');
+  toggle.className = 'toggle';
+  toggle.type = 'checkbox';
+  const label = document.createElement('label');
+  const destroy = document.createElement('button');
+  destroy.className = 'destroy';
+  view.appendChild(toggle);
+  view.appendChild(label);
+  view.appendChild(destroy);
+
+  const edit = document.createElement('input');
+  edit.className = 'edit';
+
+  li.appendChild(view);
+  li.appendChild(edit);
+
+  toggle.addEventListener('change', () => toggleTodo(todo.id, toggle.checked));
+  label.addEventListener('dblclick', () => {
+    editingId = todo.id;
+    li.classList.add('editing');
+    edit.value = todo.title;
+    edit.focus();
+  });
+  destroy.addEventListener('click', () => {
+    todos = todos.filter((t) => t.id !== todo.id);
+    saveTodos();
+    render();
+  });
+  edit.addEventListener('keydown', (e) => {
+    if (e.key === 'Enter' || e.keyCode === ENTER_KEY) {
+      commitEdit(todo.id, edit.value, false);
+    } else if (e.key === 'Escape') {
+      commitEdit(todo.id, edit.value, true);
+    }
+  });
+  edit.addEventListener('blur', () => commitEdit(todo.id, edit.value, false));
+
+  return li;
+}
+
+/**
+ * Syncs an existing row element to the current model and route state.
+ * The row element itself is preserved; only its contents and state change.
+ */
+function updateRow(li, todo, filter) {
+  li.classList.toggle('completed', todo.completed);
+  li.classList.toggle('editing', editingId === todo.id);
+  li.querySelector('.toggle').checked = todo.completed;
+  li.querySelector('label').textContent = todo.title;
+  if (editingId !== todo.id) {
+    li.querySelector('.edit').value = todo.title;
+  }
+  if (filter === 'active' && todo.completed) li.hidden = true;
+  else if (filter === 'completed' && !todo.completed) li.hidden = true;
+  else li.hidden = false;
+}
