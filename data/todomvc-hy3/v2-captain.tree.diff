diff --git a/css/app.css b/css/app.css
index a167db1..0d1af1d 100644
--- a/css/app.css
+++ b/css/app.css
@@ -1 +1,9 @@
 /* Application-specific style overrides for the TodoMVC app. */
+
+/* While a row is being edited, hide its checkbox and delete (destroy) control
+   so the user only interacts with the edit field. The `.editing` class is set
+   by js/app.js on the row's <li> when the label is double-clicked. */
+.editing .toggle,
+.editing .destroy {
+  display: none;
+}
diff --git a/features/editing-visibility.feature b/features/editing-visibility.feature
new file mode 100644
index 0000000..0a84bd8
--- /dev/null
+++ b/features/editing-visibility.feature
@@ -0,0 +1,15 @@
+Feature: Editing hides the row controls
+  As a real browser user
+  I want a row's checkbox and delete button hidden while I edit its title
+  So that I only interact with the title edit field
+
+  Background:
+    Given the app is loaded with todos:
+      | title   | completed |
+      | EditMe  | false     |
+
+  Scenario: The checkbox and delete button are hidden while editing
+    When the user double-clicks the todo "EditMe"
+    Then the todo "EditMe" is in edit mode
+    And the checkbox for "EditMe" is hidden
+    And the delete button for "EditMe" is hidden
diff --git a/features/row-preservation.feature b/features/row-preservation.feature
new file mode 100644
index 0000000..904b57f
--- /dev/null
+++ b/features/row-preservation.feature
@@ -0,0 +1,21 @@
+Feature: Row preservation on update
+  As a real browser user
+  I want toggling a todo or marking all complete to update the row in place
+  So that the row I clicked is not torn down and rebuilt on every change
+
+  Background:
+    Given the app is loaded with todos:
+      | title   | completed |
+      | First   | false     |
+      | Second  | false     |
+
+  Scenario: Toggling a todo updates its own row in place
+    When the user toggles the todo "First"
+    Then the todo "First" is marked completed
+    And the row for "First" is the same DOM element as before the last change
+
+  Scenario: Marking all complete updates every row in place
+    When the user marks all todos as complete
+    Then every todo is marked completed
+    And the row for "First" is the same DOM element as before the last change
+    And the row for "Second" is the same DOM element as before the last change
