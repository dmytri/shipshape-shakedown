+Then('the label for {string} is hidden', function (title) {
+  const li = this.liByTitle(title);
+  if (!li) throw new Error(`No todo "${title}"`);
+  const display = this.window.getComputedStyle(li.querySelector('label')).display;
+  if (display !== 'none') {
+    throw new Error(`Label for "${title}" is not hidden (display: ${display})`);
+  }
+});
