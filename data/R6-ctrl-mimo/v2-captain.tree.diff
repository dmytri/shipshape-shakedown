diff --git a/features/step_definitions/todomvc.steps.js b/features/step_definitions/todomvc.steps.js
index e79d947..8c3b0b6 100644
--- a/features/step_definitions/todomvc.steps.js
+++ b/features/step_definitions/todomvc.steps.js
@@ -280,3 +280,25 @@ Then('the footer is visible', function () {
     throw new Error('Footer is hidden but expected visible');
   }
 });
+
+When('the user captures the todo list item for {string}', function (title) {
+  // Store a live DOM reference so a later step can verify the element
+  // was not destroyed and recreated by a re-render.
+  const li = this.getTodoLi(title);
+  if (!li) throw new Error(`No todo found for "${title}"`);
+  this._capturedTodoLi = li;
+});
+
+Then('the captured todo list item is still attached to the DOM', function () {
+  if (!this._capturedTodoLi) {
+    throw new Error('No todo list item was captured by a preceding capture step');
+  }
+  if (!this.document.body.contains(this._capturedTodoLi)) {
+    throw new Error(
+      'The captured todo list item was detached from the DOM after re-render. ' +
+      'The app destroyed and recreated DOM nodes instead of updating them in place. ' +
+      'This breaks browser automation tools that hold element references across actions.'
+    );
+  }
+  delete this._capturedTodoLi;
+});
