+  const hash = world.window ? world.window.location.hash : '';
+  // Explicitly sync localStorage to shared storage before dispose
+  if (world.window && world.window.localStorage) {
+    const ls = world.window.localStorage;
+    for (let i = 0; i < ls.length; i++) {
+      const k = ls.key(i);
+      // Access sharedLocalStorage via the world's internal reference
