     });
     this.document = this.window.document;
 
+    // SHARED localStorage: happy-dom creates a new localStorage per Window instance, so
+    // persistence across reloads is broken. Bridge the gap by making the localStorage persist.
+    // Copy shared storage into this window's localStorage BEFORE the app loads, so that
+    // init() -> load() reads the persisted data rather than an empty store.
+    const origLS = this.window.localStorage;
+    for (const k of Object.keys(sharedLocalStorage)) {
+      origLS.setItem(k, sharedLocalStorage[k]);
+    }
+    // Patch setItem and removeItem to sync back to shared storage.
+    // happy-dom localStorage rejects direct property assignment on built-in methods,
+    // so we use Object.defineProperty to intercept calls.
+    const origSetItem = origLS.setItem.bind(origLS);
+    Object.defineProperty(origLS, 'setItem', {
+      value: function(k, v) {
+        sharedLocalStorage[k] = v;
+        origSetItem(k, v);
+      },
+      writable: true,
+      configurable: true
+    });
+    const origRemoveItem = origLS.removeItem.bind(origLS);
+    Object.defineProperty(origLS, 'removeItem', {
+      value: function(k) {
+        delete sharedLocalStorage[k];
+        origRemoveItem(k);
+      },
+      writable: true,
+      configurable: true
+    });
