+++ b/js/app.js
@@ -0,0 +1,315 @@
+(function () {
+  'use strict';
+
+  var STORAGE_KEY = 'todos-vanillajs';
+  var ENTER_KEY = 13;
+  var ESCAPE_KEY = 27;
+
+  var todos = [];
+  var editingId = null;
+
+  var dom = {
+    newTodoInput: null,
+    todoList: null,
+    toggleAll: null,
+    clearCompleted: null,
+    todoCount: null,
+    main: null,
+    footer: null
+  };
+
+  // ---------------------------------------------------------------------------
+  // Storage
+  // ---------------------------------------------------------------------------
+
+  // Storage wrapper that works with both real localStorage and test environments
+  var _storage = {
+    getItem: function(k) {
+      try {
+        return localStorage.getItem(k);
+      } catch(e) {
+        return null;
+      }
+    },
+    setItem: function(k, v) {
+      try {
+        localStorage.setItem(k, v);
+      } catch(e) {
+        // Silently fail in test environments
+      }
+    }
+  };
+
+  function save() {
+    _storage.setItem(STORAGE_KEY, JSON.stringify(todos));
+  }
+
+  function load() {
+    var raw = _storage.getItem(STORAGE_KEY);
+    todos = raw ? JSON.parse(raw) : [];
+  }
+
+  // ---------------------------------------------------------------------------
+  // Todo operations
+  // ---------------------------------------------------------------------------
+
+  /** @planks("the user types {string} in the new todo input and presses Enter") */
+  function addTodo(title) {
+    var trimmed = title.trim();
+    if (!trimmed) return;
+    todos.push({
+      id: Date.now(),
+      title: trimmed,
+      completed: false
+    });
+    save();
+  }
+
+  /** @planks("the user toggles the {string} todo checkbox") */
+  function toggleTodo(id) {
+    for (var i = 0; i < todos.length; i++) {
+      if (todos[i].id === id) {
+        todos[i].completed = !todos[i].completed;
+        break;
+      }
+    }
+    save();
+  }
+
+  /** @planks("the user clicks the toggle all checkbox") */
+  function toggleAll() {
+    var allCompleted = todos.every(function (t) { return t.completed; });
+    todos.forEach(function (t) { t.completed = !allCompleted; });
+    save();
+  }
+
+  /** @planks("the user clears the edit input and presses Enter") */
+  function destroyTodo(id) {
+    todos = todos.filter(function (t) { return t.id !== id; });
+    save();
+  }
+
+  /** @planks("the user types {string} in the edit input and presses Enter") */
+  function editTodo(id, newTitle) {
+    var trimmed = newTitle.trim();
+    if (!trimmed) {
+      destroyTodo(id);
+      return;
+    }
+    for (var i = 0; i < todos.length; i++) {
+      if (todos[i].id === id) {
+        todos[i].title = trimmed;
+        break;
+      }
+    }
+    save();
+  }
+
+  /** @planks("the user clicks the clear completed button") */
+  function clearCompleted() {
+    todos = todos.filter(function (t) { return !t.completed; });
+    save();
+  }
+
+  // ---------------------------------------------------------------------------
+  // Rendering
+  // ---------------------------------------------------------------------------
+
+  function getVisibleTodos() {
+    var hash = window.location.hash || '#/';
+    if (hash === '#/active') {
+      return todos.filter(function (t) { return !t.completed; });
+    } else if (hash === '#/completed') {
+      return todos.filter(function (t) { return t.completed; });
+    }
+    return todos;
+  }
+
+  function render() {
+    var visible = getVisibleTodos();
+    var activeCount = todos.filter(function (t) { return !t.completed; }).length;
+    var completedCount = todos.filter(function (t) { return t.completed; }).length;
+    var totalCount = todos.length;
+
+    // Render todo list
+    dom.todoList.innerHTML = '';
+    visible.forEach(function (todo) {
+      var li = document.createElement('li');
+      li.dataset.id = todo.id;
+      if (todo.completed) li.classList.add('completed');
+      if (editingId === todo.id) li.classList.add('editing');
+
+      li.innerHTML =
+        '<div class="view">' +
+          '<input class="toggle" type="checkbox"' + (todo.completed ? ' checked' : '') + '>' +
+          '<label>' + escapeHtml(todo.title) + '</label>' +
+          '<button class="destroy"></button>' +
+        '</div>' +
+        '<input class="edit" value="' + escapeHtml(todo.title) + '">';
+
+      dom.todoList.appendChild(li);
+    });
+
+    // Counter
+    var itemText = activeCount === 1 ? 'item' : 'items';
+    dom.todoCount.innerHTML = '<strong>' + activeCount + '</strong> ' + itemText + ' left';
+
+    // Toggle all
+    dom.toggleAll.checked = totalCount > 0 && activeCount === 0;
+
+    // Visibility
+    if (totalCount === 0) {
+      dom.main.classList.add('hidden');
+      dom.footer.classList.add('hidden');
+    } else {
+      dom.main.classList.remove('hidden');
+      dom.footer.classList.remove('hidden');
+    }
+
+    // Filter links
+    var hash = window.location.hash || '#/';
+    var links = document.querySelectorAll('.filters a');
+    links.forEach(function (link) {
+      link.classList.remove('selected');
+      if (link.getAttribute('href') === hash) {
+        link.classList.add('selected');
+      }
+    });
+
+    // Clear completed visibility
+    dom.clearCompleted.style.display = completedCount > 0 ? 'block' : 'none';
+  }
+
+  function escapeHtml(str) {
+    var div = document.createElement('div');
+    div.textContent = str;
+    return div.innerHTML;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Event handlers
+  // ---------------------------------------------------------------------------
+
+  function setupEventListeners() {
+    // New todo input
+    dom.newTodoInput.addEventListener('keydown', function (e) {
+      if (e.keyCode === ENTER_KEY) {
+        addTodo(dom.newTodoInput.value);
+        dom.newTodoInput.value = '';
+        render();
+      }
+    });
+
+    // Todo list delegation
+    dom.todoList.addEventListener('change', function (e) {
+      var li = e.target.closest('li');
+      if (!li) return;
+      var id = parseInt(li.dataset.id, 10);
+
+      if (e.target.classList.contains('toggle')) {
+        toggleTodo(id);
+        render();
+      }
+    });
+
+    dom.todoList.addEventListener('click', function (e) {
+      var li = e.target.closest('li');
+      if (!li) return;
+      var id = parseInt(li.dataset.id, 10);
+
+      if (e.target.classList.contains('destroy')) {
+        destroyTodo(id);
+        render();
+      }
+    });
+
+    dom.todoList.addEventListener('dblclick', function (e) {
+      var li = e.target.closest('li');
+      if (!li) return;
+      var id = parseInt(li.dataset.id, 10);
+
+      if (e.target.tagName === 'LABEL') {
+        editingId = id;
+        render();
+        var editInput = li.querySelector('.edit');
+        if (editInput) editInput.focus();
+      }
+    });
+
+    dom.todoList.addEventListener('keydown', function (e) {
+      var li = e.target.closest('li');
+      if (!li) return;
+      var id = parseInt(li.dataset.id, 10);
+
+      if (e.target.classList.contains('edit')) {
+        if (e.keyCode === ENTER_KEY) {
+          editTodo(id, e.target.value);
+          editingId = null;
+          render();
+        } else if (e.keyCode === ESCAPE_KEY) {
+          editingId = null;
+          render();
+        }
+      }
+    });
+
+    dom.todoList.addEventListener('blur', function (e) {
+      if (e.target.classList.contains('edit')) {
+        var li = e.target.closest('li');
+        if (!li) return;
+        var id = parseInt(li.dataset.id, 10);
+        editTodo(id, e.target.value);
+        editingId = null;
+        render();
+      }
+    }, true);
+
+    // Toggle all
+    dom.toggleAll.addEventListener('change', function () {
+      toggleAll();
+      render();
+    });
+
+    // Clear completed
+    dom.clearCompleted.addEventListener('click', function () {
+      clearCompleted();
+      render();
+    });
+
+    // Filter links
+    document.querySelector('.filters').addEventListener('click', function (e) {
+      if (e.target.tagName === 'A') {
+        window.location.hash = e.target.getAttribute('href');
+      }
+    });
+
+    // Hash change
+    window.addEventListener('hashchange', function () {
+      render();
+    });
+  }
+
+  // ---------------------------------------------------------------------------
+  // Init
+  // ---------------------------------------------------------------------------
+
+  function init() {
+    dom.newTodoInput = document.querySelector('.new-todo');
+    dom.todoList = document.querySelector('.todo-list');
+    dom.toggleAll = document.querySelector('.toggle-all');
+    dom.clearCompleted = document.querySelector('.clear-completed');
+    dom.todoCount = document.querySelector('.todo-count');
+    dom.main = document.querySelector('.main');
+    dom.footer = document.querySelector('.footer');
+
+    load();
+    setupEventListeners();
+    render();
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', init);
+  } else {
+    init();
+  }
+})();
