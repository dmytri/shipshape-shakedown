+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>TodoMVC</title>
+  <style>
+    .todoapp { font-family: sans-serif; max-width: 550px; margin: 0 auto; }
+    .header h1 { font-size: 60px; text-align: center; }
+    .new-todo { width: 100%; font-size: 24px; padding: 10px; box-sizing: border-box; }
+    .main { display: block; }
+    .main.hidden { display: none; }
+    .footer { display: block; padding: 10px; text-align: center; }
+    .footer.hidden { display: none; }
+    .todo-list { list-style: none; padding: 0; }
+    .todo-list li { display: flex; align-items: center; padding: 10px; border-bottom: 1px solid #ddd; }
+    .todo-list li.completed label { text-decoration: line-through; }
+    .todo-list li.editing .view { display: none; }
+    .todo-list li.editing .edit { display: block; }
+    .todo-list li .edit { display: none; width: 100%; font-size: 24px; padding: 5px; box-sizing: border-box; }
+    .todo-list li .view { display: flex; align-items: center; width: 100%; }
+    .todo-list li .toggle { margin-right: 10px; }
+    .todo-list li label { flex: 1; }
+    .todo-list li .destroy { background: none; border: none; font-size: 20px; cursor: pointer; }
+    .filters { list-style: none; padding: 0; display: flex; gap: 10px; justify-content: center; }
+    .filters a.selected { border: 1px solid #ce4646; }
+    .clear-completed { margin-top: 10px; }
+    .toggle-all { margin-right: 10px; }
+    .todo-count { font-weight: bold; }
+  </style>
+</head>
+<body>
+  <section class="todoapp">
+    <header class="header">
+      <h1>todos</h1>
+      <input class="new-todo" placeholder="What needs to be done?" autofocus>
+    </header>
+    <section class="main">
+      <input id="toggle-all" class="toggle-all" type="checkbox">
+      <label for="toggle-all">Mark all as complete</label>
+      <ul class="todo-list"></ul>
+    </section>
+    <footer class="footer">
+      <span class="todo-count"><strong>0</strong> item left</span>
+      <ul class="filters">
+        <li><a class="selected" href="#/">All</a></li>
+        <li><a href="#/active">Active</a></li>
+        <li><a href="#/completed">Completed</a></li>
+      </ul>
+      <button class="clear-completed">Clear completed</button>
+    </footer>
+  </section>
+  <script src="js/app.js"></script>
+</body>
+</html>
