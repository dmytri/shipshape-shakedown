--- a/features/support/world.js
+++ b/features/support/world.js
@@ -5,6 +5,9 @@ const { Window } = require('happy-dom');
 
 const ROOT = path.resolve(__dirname, '..', '..');
 
+// Shared localStorage that persists across Window instances
+const sharedLocalStorage = {};
+
 class AppWorld {
   // Load the REAL page and the REAL app. A missing artifact is a loud failure here, not a
   // silently-green suite: the executable tier must exercise the production artifact.
@@ -57,6 +60,26 @@ class AppWorld {
       const next = a.getAttribute('href');
       if (w.location.hash !== next) { w.location.hash = next; w.dispatchEvent(new w.Event('hashchange')); }
     }, true);
+
+    // SHARED localStorage: happy-dom creates a new localStorage per Window instance, so
+    // persistence across reloads is broken. Bridge the gap by making the localStorage persist.
+    // Copy shared storage into this window's localStorage before the app loads
+    const origLS = w.localStorage;
+    for (const k of Object.keys(sharedLocalStorage)) {
+      origLS.setItem(k, sharedLocalStorage[k]);
+    }
+    // Patch setItem and removeItem to sync back to shared storage
+    const origSetItem = origLS.setItem.bind(origLS);
+    origLS.setItem = function(k, v) {
+      sharedLocalStorage[k] = v;
+      origSetItem(k, v);
+    };
+    const origRemoveItem = origLS.removeItem.bind(origLS);
+    origLS.removeItem = function(k) {
+      delete sharedLocalStorage[k];
+      origRemoveItem(k);
+    };
+
     return this.document;
   }
 
@@ -90,6 +113,22 @@ class AppWorld {
 setWorldConstructor(AppWorld);
 
 // Every scenario gets the real app. No scenario can pass without one.
-Before(function () { this.loadApp(); });
-// ...and every scenario gives it back.
-After(async function () { await this.disposeApp(); });
+Before(function () {
+  // Clear shared storage for clean scenario isolation
+  for (const k of Object.keys(sharedLocalStorage)) {
+    delete sharedLocalStorage[k];
+  }
+  this.loadApp();
+});
+
+// Sync localStorage back to shared storage after each scenario, then dispose
+After(async function () {
+  if (this.window && this.window.localStorage) {
+    const ls = this.window.localStorage;
+    for (let i = 0; i < ls.length; i++) {
+      const k = ls.key(i);
+      sharedLocalStorage[k] = ls.getItem(k);
+    }
+  }
+  await this.disposeApp();
+});
