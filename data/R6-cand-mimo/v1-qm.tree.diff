@@ -0,0 +1,436 @@
+const { Given, When, Then } = require('@cucumber/cucumber');
+const { expect } = require('chai');
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+function getNewTodoInput(doc) {
+  return doc.querySelector('.new-todo');
+}
+
+function getTodoItems(doc) {
+  return Array.from(doc.querySelectorAll('.todo-list li'));
+}
+
+function getTodoByTitle(doc, title) {
+  return getTodoItems(doc).find(li => {
+    const label = li.querySelector('label');
+    return label && label.textContent.trim() === title;
+  });
+}
+
+function getToggleAllCheckbox(doc) {
+  return doc.querySelector('.toggle-all');
+}
+
+function getClearCompletedButton(doc) {
+  return doc.querySelector('.clear-completed');
+}
+
+function getEditInput(doc) {
+  return doc.querySelector('.todo-list li.editing .edit');
+}
+
+function getFilterLink(doc, filter) {
+  const links = doc.querySelectorAll('.filters a');
+  return Array.from(links).find(a => a.textContent.trim() === filter);
+}
+
+function getCounterElement(doc) {
+  return doc.querySelector('.todo-count');
+}
+
+function getMainSection(doc) {
+  return doc.querySelector('.main');
+}
+
+function getFooter(doc) {
+  return doc.querySelector('.footer');
+}
+
+function createTodo(doc, title) {
+  const input = getNewTodoInput(doc);
+  input.value = title;
+  const event = new doc.defaultView.KeyboardEvent('keydown', {
+    key: 'Enter',
+    code: 'Enter',
+    keyCode: 13,
+    which: 13,
+    bubbles: true
+  });
+  input.dispatchEvent(event);
+}
+
+function createCompletedTodo(doc, title) {
+  createTodo(doc, title);
+  const todo = getTodoByTitle(doc, title);
+  if (todo) {
+    const checkbox = todo.querySelector('.toggle');
+    checkbox.checked = true;
+    checkbox.dispatchEvent(new doc.defaultView.Event('change', { bubbles: true }));
+  }
+}
+
+function toggleTodo(doc, title) {
+  const todo = getTodoByTitle(doc, title);
+  if (todo) {
+    const checkbox = todo.querySelector('.toggle');
+    checkbox.checked = !checkbox.checked;
+    checkbox.dispatchEvent(new doc.defaultView.Event('change', { bubbles: true }));
+  }
+}
+
+function doubleClickTodoLabel(doc, title) {
+  const todo = getTodoByTitle(doc, title);
+  if (todo) {
+    const label = todo.querySelector('label');
+    label.dispatchEvent(new doc.defaultView.Event('dblclick', { bubbles: true }));
+  }
+}
+
+function typeInEditInput(doc, text) {
+  const input = getEditInput(doc);
+  if (input) {
+    input.value = text;
+    input.dispatchEvent(new doc.defaultView.Event('input', { bubbles: true }));
+  }
+}
+
+function pressEnterOnEditInput(doc) {
+  const input = getEditInput(doc);
+  if (input) {
+    input.dispatchEvent(new doc.defaultView.KeyboardEvent('keydown', {
+      key: 'Enter',
+      code: 'Enter',
+      keyCode: 13,
+      which: 13,
+      bubbles: true
+    }));
+  }
+}
+
+function pressEscapeOnEditInput(doc) {
+  const input = getEditInput(doc);
+  if (input) {
+    input.dispatchEvent(new doc.defaultView.KeyboardEvent('keydown', {
+      key: 'Escape',
+      code: 'Escape',
+      keyCode: 27,
+      which: 27,
+      bubbles: true
+    }));
+  }
+}
+
+function blurEditInput(doc) {
+  const input = getEditInput(doc);
+  if (input) {
+    input.dispatchEvent(new doc.defaultView.Event('blur', { bubbles: true }));
+  }
+}
+
+function clearEditInputAndPressEnter(doc) {
+  const input = getEditInput(doc);
+  if (input) {
+    input.value = '';
+    input.dispatchEvent(new doc.defaultView.Event('input', { bubbles: true }));
+    input.dispatchEvent(new doc.defaultView.KeyboardEvent('keydown', {
+      key: 'Enter',
+      code: 'Enter',
+      keyCode: 13,
+      which: 13,
+      bubbles: true
+    }));
+  }
+}
+
+function clearEditInputAndPressEnterOnTodo(doc, title) {
+  const todo = getTodoByTitle(doc, title);
+  if (todo) {
+    const label = todo.querySelector('label');
+    label.dispatchEvent(new doc.defaultView.Event('dblclick', { bubbles: true }));
+    const input = getEditInput(doc);
+    if (input) {
+      input.value = '';
+      input.dispatchEvent(new doc.defaultView.Event('input', { bubbles: true }));
+      input.dispatchEvent(new doc.defaultView.KeyboardEvent('keydown', {
+        key: 'Enter',
+        code: 'Enter',
+        keyCode: 13,
+        which: 13,
+        bubbles: true
+      }));
+    }
+  }
+}
+
+function clickToggleAll(doc) {
+  const toggleAll = getToggleAllCheckbox(doc);
+  if (toggleAll) {
+    toggleAll.checked = !toggleAll.checked;
+    toggleAll.dispatchEvent(new doc.defaultView.Event('change', { bubbles: true }));
+  }
+}
+
+function clickClearCompleted(doc) {
+  const button = getClearCompletedButton(doc);
+  if (button) {
+    button.click();
+  }
+}
+
+function reloadPage(world) {
+  world.disposeApp();
+  world.loadApp();
+}
+
+// ---------------------------------------------------------------------------
+// Given steps
+// ---------------------------------------------------------------------------
+
+Given('the app is loaded with no todos', function () {
+  // App is already loaded by the Before hook; no todos exist by default
+});
+
+Given('the app has a todo {string}', function (title) {
+  createTodo(this.document, title);
+});
+
+Given('the app has a completed todo {string}', function (title) {
+  createCompletedTodo(this.document, title);
+});
+
+Given('the app has todos {string} and {string}', function (title1, title2) {
+  createTodo(this.document, title1);
+  createTodo(this.document, title2);
+});
+
+Given('the app has completed todos {string} and {string}', function (title1, title2) {
+  createCompletedTodo(this.document, title1);
+  createCompletedTodo(this.document, title2);
+});
+
+Given('the app has a todo {string} and a completed todo {string}', function (activeTitle, completedTitle) {
+  createTodo(this.document, activeTitle);
+  createCompletedTodo(this.document, completedTitle);
+});
+
+Given('the user navigates to {string}', function (hash) {
+  this.navigate(hash);
+  // Manually trigger render after navigation
+  this.window.eval('window.dispatchEvent(new Event("hashchange"))');
+});
+
+// ---------------------------------------------------------------------------
+// When steps
+// ---------------------------------------------------------------------------
+
+When('the user types {string} in the new todo input and presses Enter', function (text) {
+  createTodo(this.document, text);
+});
+
+When('the user toggles the {string} todo checkbox', function (title) {
+  toggleTodo(this.document, title);
+});
+
+When('the user double-clicks the {string} todo label', function (title) {
+  doubleClickTodoLabel(this.document, title);
+});
+
+When('the user types {string} in the edit input and presses Enter', function (text) {
+  typeInEditInput(this.document, text);
+  pressEnterOnEditInput(this.document);
+});
+
+When('the user types {string} in the edit input and blurs', function (text) {
+  typeInEditInput(this.document, text);
+  blurEditInput(this.document);
+});
+
+When('the user types {string} in the edit input and presses Escape', function (text) {
+  typeInEditInput(this.document, text);
+  pressEscapeOnEditInput(this.document);
+});
+
+When('the user clears the edit input and presses Enter', function () {
+  clearEditInputAndPressEnter(this.document);
+});
+
+When('the user clears the edit input and presses Enter on the {string} todo', function (title) {
+  clearEditInputAndPressEnterOnTodo(this.document, title);
+});
+
+When('the user clicks the clear completed button', function () {
+  clickClearCompleted(this.document);
+});
+
+When('the user clicks the toggle all checkbox', function () {
+  clickToggleAll(this.document);
+});
+
+When('the page is reloaded', function () {
+  // Save current localStorage state to shared storage
+  const ls = this.window.localStorage;
+  for (let i = 0; i < ls.length; i++) {
+    const k = ls.key(i);
+    // The sharedLocalStorage is already being synced via the proxy in world.js
+  }
+  // Reload the page - the world.js loadApp will copy sharedLocalStorage to new window
+  reloadPage(this);
+});
+
+// ---------------------------------------------------------------------------
+// Then steps
+// ---------------------------------------------------------------------------
+
+Then('a todo with title {string} appears in the todo list', function (title) {
+  const todo = getTodoByTitle(this.document, title);
+  expect(todo, `Expected todo with title "${title}" to exist`).to.not.be.undefined;
+});
+
+Then('the new todo input is empty', function () {
+  const input = getNewTodoInput(this.document);
+  expect(input.value).to.equal('');
+});
+
+Then('the todo count shows {string}', function (expected) {
+  const counter = getCounterElement(this.document);
+  expect(counter.textContent.trim()).to.equal(expected);
+});
+
+Then('the todo list is empty', function () {
+  const items = getTodoItems(this.document);
+  expect(items).to.have.length(0);
+});
+
+Then('the new todo input has focus', function () {
+  const input = getNewTodoInput(this.document);
+  expect(input === this.document.activeElement).to.be.true;
+});
+
+Then('the todo list shows {int} todos', function (count) {
+  const items = getTodoItems(this.document);
+  expect(items).to.have.length(count);
+});
+
+Then('the {string} todo has class {string}', function (title, className) {
+  const todo = getTodoByTitle(this.document, title);
+  expect(todo, `Expected todo "${title}" to exist`).to.not.be.undefined;
+  expect(todo.classList.contains(className)).to.be.true;
+});
+
+Then('the {string} todo does not have class {string}', function (title, className) {
+  const todo = getTodoByTitle(this.document, title);
+  expect(todo, `Expected todo "${title}" to exist`).to.not.be.undefined;
+  expect(todo.classList.contains(className)).to.be.false;
+});
+
+Then('the {string} todo does not exist', function (title) {
+  const todo = getTodoByTitle(this.document, title);
+  expect(todo).to.be.undefined;
+});
+
+Then('the todo {string} does not exist', function (title) {
+  const todo = getTodoByTitle(this.document, title);
+  expect(todo).to.be.undefined;
+});
+
+Then('the todo {string} is visible', function (title) {
+  const todo = getTodoByTitle(this.document, title);
+  expect(todo, `Expected todo "${title}" to exist`).to.not.be.undefined;
+  const style = this.window.getComputedStyle(todo);
+  expect(style.display).to.not.equal('none');
+});
+
+Then('the todo {string} is not visible', function (title) {
+  const todo = getTodoByTitle(this.document, title);
+  if (todo) {
+    const style = this.window.getComputedStyle(todo);
+    expect(style.display).to.equal('none');
+  }
+});
+
+Then('the clear completed button is hidden', function () {
+  const button = getClearCompletedButton(this.document);
+  const style = this.window.getComputedStyle(button);
+  expect(style.display).to.equal('none');
+});
+
+Then('the clear completed button is visible', function () {
+  const button = getClearCompletedButton(this.document);
+  const style = this.window.getComputedStyle(button);
+  expect(style.display).to.not.equal('none');
+});
+
+Then('the toggle all checkbox is checked', function () {
+  const toggleAll = getToggleAllCheckbox(this.document);
+  expect(toggleAll.checked).to.be.true;
+});
+
+Then('the toggle all checkbox is unchecked', function () {
+  const toggleAll = getToggleAllCheckbox(this.document);
+  expect(toggleAll.checked).to.be.false;
+});
+
+Then('the main section is hidden', function () {
+  const main = getMainSection(this.document);
+  const style = this.window.getComputedStyle(main);
+  expect(style.display).to.equal('none');
+});
+
+Then('the main section is visible', function () {
+  const main = getMainSection(this.document);
+  const style = this.window.getComputedStyle(main);
+  expect(style.display).to.not.equal('none');
+});
+
+Then('the footer is hidden', function () {
+  const footer = getFooter(this.document);
+  const style = this.window.getComputedStyle(footer);
+  expect(style.display).to.equal('none');
+});
+
+Then('the footer is visible', function () {
+  const footer = getFooter(this.document);
+  const style = this.window.getComputedStyle(footer);
+  expect(style.display).to.not.equal('none');
+});
+
+Then('the edit input contains {string}', function (expected) {
+  const input = getEditInput(this.document);
+  expect(input.value).to.equal(expected);
+});
+
+Then('the edit input has focus', function () {
+  const input = getEditInput(this.document);
+  expect(input === this.document.activeElement).to.be.true;
+});
+
+Then('the {string} filter link is selected', function (filter) {
+  const link = getFilterLink(this.document, filter);
+  expect(link, `Expected filter link "${filter}" to exist`).to.not.be.undefined;
+  expect(link.classList.contains('selected')).to.be.true;
+});
+
+Then('all todos have class {string}', function (className) {
+  const items = getTodoItems(this.document);
+  expect(items.length).to.be.greaterThan(0);
+  items.forEach(todo => {
+    expect(todo.classList.contains(className)).to.be.true;
+  });
+});
+
+Then('no todos have class {string}', function (className) {
+  const items = getTodoItems(this.document);
+  items.forEach(todo => {
+    expect(todo.classList.contains(className)).to.be.false;
+  });
+});
+
+Then('localStorage contains a key matching {string}', function (pattern) {
+  const regex = new RegExp(pattern);
+  const keys = Object.keys(this.localStorage);
+  const matchingKey = keys.find(key => regex.test(key));
+  expect(matchingKey, `Expected localStorage to contain a key matching "${pattern}"`).to.not.be.undefined;
+});
