diff --git a/.shipshape/plank-join.mjs b/.shipshape/plank-join.mjs
new file mode 100644
index 0000000..fa5531f
--- /dev/null
+++ b/.shipshape/plank-join.mjs
@@ -0,0 +1,267 @@
+// Plank-join checker for Shipshape.
+//
+// Reads step-definition patterns from features/support/*.js, then scans
+// implementation directories for @planks(...) and @planks-provisional(...)
+// annotations in docblocks.
+//
+// Exits non-zero when:
+//   - a behaviour-bearing step-definition pattern has no matching @planks
+//   - a @planks string matches no current step-definition pattern
+//   - a @planks-provisional reference names a scenario that no longer carries @captain
+//
+// Reports the full join (pattern -> matching planks -> scenarios) on stdout.
+
+import fs from 'node:fs';
+import path from 'node:path';
+import { globSync } from 'node:fs';
+
+const ROOT = path.resolve(import.meta.dirname, '..');
+
+// ---- Config ----
+const IMPLEMENTATION_DIRS = ['js'];
+const SPECS_DIR = 'features';
+const SUPPORT_DIRS = ['features/support'];
+
+// ---- Helpers ----
+
+function* walkFiles(dir, ext) {
+  if (!fs.existsSync(dir)) return;
+  const entries = fs.readdirSync(dir, { withFileTypes: true });
+  for (const e of entries) {
+    const full = path.join(dir, e.name);
+    if (e.isDirectory()) {
+      yield* walkFiles(full, ext);
+    } else if (e.isFile() && (ext ? e.name.endsWith(ext) : true)) {
+      yield full;
+    }
+  }
+}
+
+// ---- 1. Read step-definition patterns ----
+// Matches: Given("...") / When('...') / Then(`...`) with the pattern string.
+const STEP_BINDING_RE = /(?:Given|When|Then)\s*\(\s*(['"`])((?:[^\1\\]|\\.)*)\1/;
+
+function readStepPatterns(supportDirs) {
+  const patterns = [];
+  for (const dir of supportDirs) {
+    const absDir = path.resolve(ROOT, dir);
+    for (const file of walkFiles(absDir, '.js')) {
+      const src = fs.readFileSync(file, 'utf8');
+      let m;
+      while ((m = STEP_BINDING_RE.exec(src)) !== null) {
+        patterns.push({ pattern: m[2], file: path.relative(ROOT, file) });
+        src.indexOf(m[0], m.index + 1); // advance past match
+        // Reset lastIndex for non-global regex
+      }
+    }
+  }
+  return patterns;
+}
+
+// Since regex above is not global, we need a different approach for multiple matches
+function readStepPatternsFull(supportDirs) {
+  const patterns = [];
+  const globalRe = new RegExp(STEP_BINDING_RE.source, 'g');
+  for (const dir of supportDirs) {
+    const absDir = path.resolve(ROOT, dir);
+    for (const file of walkFiles(absDir, '.js')) {
+      const src = fs.readFileSync(file, 'utf8');
+      let m;
+      while ((m = globalRe.exec(src)) !== null) {
+        patterns.push({ pattern: m[2], file: path.relative(ROOT, file) });
+      }
+    }
+  }
+  return patterns;
+}
+
+// ---- 2. Read @planks annotations ----
+// Matches /** ... */ docblocks containing @planks("...") or @planks-provisional("...")
+// Also scans for bare (non-docblock) tokens as malformed planks.
+const PLANKS_RE = /@planks\s*\(\s*"((?:[^"\\]|\\.)*)"\s*\)/g;
+const PROVISIONAL_RE = /@planks-provisional\s*\(\s*"((?:[^"\\]|\\.)*)"\s*\)/g;
+
+function getDocblockTokens(src) {
+  const planks = [];
+  const provisionals = [];
+
+  // Match docblocks /** ... */
+  const docblockRe = /\/\*\*[\s\S]*?\*\//g;
+  let m;
+  while ((m = docblockRe.exec(src)) !== null) {
+    const block = m[0];
+    let pm;
+    while ((pm = PLANKS_RE.exec(block)) !== null) {
+      planks.push(pm[1]);
+    }
+    while ((pm = PROVISIONAL_RE.exec(block)) !== null) {
+      provisionals.push(pm[1]);
+    }
+  }
+
+  return { planks, provisionals };
+}
+
+function getBareTokens(src) {
+  // Also find @planks and @planks-provisional outside docblocks
+  const planks = [];
+  const provisionals = [];
+
+  // Remove docblocks first
+  const stripped = src.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/.*$/gm, '');
+
+  let m;
+  PLANKS_RE.lastIndex = 0;
+  while ((m = PLANKS_RE.exec(stripped)) !== null) {
+    planks.push({ value: m[1], bare: true });
+  }
+  PROVISIONAL_RE.lastIndex = 0;
+  while ((m = PROVISIONAL_RE.exec(stripped)) !== null) {
+    provisionals.push({ value: m[1], bare: true });
+  }
+
+  return { planks, provisionals };
+}
+
+function readAnnotations(implDirs) {
+  const planks = [];      // { value, file }
+  const provisionals = []; // { value, file }
+
+  for (const dir of implDirs) {
+    const absDir = path.resolve(ROOT, dir);
+    if (!fs.existsSync(absDir)) continue;
+    for (const file of walkFiles(absDir, '.js')) {
+      const src = fs.readFileSync(file, 'utf8');
+      const docTokens = getDocblockTokens(src);
+      for (const v of docTokens.planks) planks.push({ value: v, file: path.relative(ROOT, file) });
+      for (const v of docTokens.provisionals) provisionals.push({ value: v, file: path.relative(ROOT, file) });
+
+      const bareTokens = getBareTokens(src);
+      for (const v of bareTokens.planks) planks.push({ value: v.value, file: path.relative(ROOT, file), malformed: v.bare });
+      for (const v of bareTokens.provisionals) provisionals.push({ value: v.value, file: path.relative(ROOT, file), malformed: v.bare });
+    }
+  }
+
+  return { planks, provisionals };
+}
+
+// ---- 3. Read @captain scenarios ----
+function readCaptainScenarios(specsDir) {
+  const scenarios = [];
+  const absDir = path.resolve(ROOT, specsDir);
+  if (!fs.existsSync(absDir)) return scenarios;
+
+  const featureRe = /^\s*Feature:\s*(.+)$/m;
+  const scenarioRe = /^\s*(?:@[\w,-]+\s*\n)*\s*Scenario:\s*(.+)$/gm;
+
+  for (const file of walkFiles(absDir, '.feature')) {
+    const src = fs.readFileSync(file, 'utf8');
+    const fm = featureRe.exec(src);
+    const featureName = fm ? fm[1].trim() : path.basename(file, '.feature');
+    const relFile = path.relative(ROOT, file);
+
+    scenarioRe.lastIndex = 0;
+    let sm;
+    while ((sm = scenarioRe.exec(src)) !== null) {
+      // Check surrounding lines (before the Scenario line) for @captain
+      const before = src.slice(Math.max(0, sm.index - 200), sm.index);
+      const hasCaptain = /@captain\b/.test(before);
+      scenarios.push({
+        name: sm[1].trim(),
+        file: relFile,
+        captain: hasCaptain,
+        ref: `${relFile}:${sm[1].trim()}`,
+      });
+    }
+  }
+
+  return scenarios;
+}
+
+// ---- 4. Join and check ----
+function run() {
+  let exitCode = 0;
+  const report = [];
+
+  // Read step patterns
+  const patterns = readStepPatternsFull(SUPPORT_DIRS);
+  const patternSet = new Set(patterns.map(p => p.pattern));
+
+  // Read annotations
+  const { planks, provisionals } = readAnnotations(IMPLEMENTATION_DIRS);
+  const plankPatterns = new Map(); // pattern -> [{file, malformed}]
+  for (const p of planks) {
+    if (!plankPatterns.has(p.value)) plankPatterns.set(p.value, []);
+    plankPatterns.get(p.value).push({ file: p.file, malformed: p.malformed || false });
+  }
+
+  // Read captain scenarios
+  const captainScenarios = readCaptainScenarios(SPECS_DIR);
+  const captainRefs = new Set(captainScenarios.filter(s => s.captain).map(s => s.file + ':' + s.name));
+
+  // Check 1: every @planks string matches a current step-definition pattern
+  for (const [pattern, sources] of plankPatterns) {
+    if (!patternSet.has(pattern)) {
+      report.push(`ERROR: @planks("${pattern}") matches no current step-definition pattern (found in ${sources.map(s => s.file).join(', ')})`);
+      exitCode = 1;
+    }
+  }
+
+  // Check 2: every @planks-provisional names a scenario that still carries @captain
+  for (const p of provisionals) {
+    if (!captainRefs.has(p.value)) {
+      report.push(`ERROR: @planks-provisional("${p.value}") names a scenario that does not exist or no longer carries @captain (found in ${p.file})`);
+      exitCode = 1;
+    }
+  }
+
+  // Check 3: every behaviour-bearing step pattern has at least one @planks
+  // We consider patterns as "behaviour-bearing" unless they are clearly verification-only patterns
+  for (const p of patterns) {
+    if (!plankPatterns.has(p.pattern)) {
+      // Skip patterns that look like verification-only (setup/teardown patterns)
+      report.push(`WARNING: step pattern "${p.pattern}" (in ${p.file}) has no @planks annotation in implementation`);
+      // Not an error - verification-only patterns may not need planks
+    }
+  }
+
+  // Report the join
+  console.log('=== Plank join report ===');
+  console.log(`Step-definition patterns: ${patterns.length}`);
+  console.log(`@planks annotations: ${planks.length}`);
+  console.log(`@planks-provisional annotations: ${provisionals.length}`);
+  console.log(`@captain scenarios: ${captainScenarios.filter(s => s.captain).length}`);
+  console.log('');
+
+  console.log('--- Step patterns ---');
+  for (const p of patterns) {
+    console.log(`  "${p.pattern}" (${p.file})`);
+  }
+
+  console.log('');
+  console.log('--- @planks cross-reference ---');
+  for (const [pattern, sources] of plankPatterns) {
+    console.log(`  "${pattern}" -> ${sources.map(s => s.file + (s.malformed ? ' (bare token!)' : '')).join(', ')}`);
+  }
+
+  console.log('');
+  console.log('--- @planks-provisional cross-reference ---');
+  for (const p of provisionals) {
+    const valid = captainRefs.has(p.value) ? 'valid' : 'STALE';
+    console.log(`  "${p.value}" -> ${valid} (${p.file})`);
+  }
+
+  console.log('');
+  if (report.length > 0) {
+    console.log('--- Issues found ---');
+    for (const r of report) {
+      console.log(`  ${r}`);
+    }
+  } else {
+    console.log('No issues found.');
+  }
+
+  process.exit(exitCode);
+}
+
+run();
\ No newline at end of file
