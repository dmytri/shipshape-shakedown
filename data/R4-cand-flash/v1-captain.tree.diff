+      "check": "plank-join",
+      "severity": "error"
+    },
+    {
+      "id": "plank-coverage",
+      "description": "Every behaviour-bearing step-definition pattern must have at least one matching @planks annotation in a production seam.",
+      "check": "plank-join",
+      "severity": "warning"
+    },
+    {
+      "id": "watchbill-conformance",
+      "description": "watchbill.json must contain only ordered watch1, watch2, ... objects each with only a scenarios array.",
+      "check": "watchbill-shape",
+      "severity": "error"
+    },
+    {
+      "id": "perturbation-quiescence",
+      "description": "No standing PERTURBATION token in implementation directories outside an uncommitted plant.",
+      "check": "perturbation-scan",
+      "severity": "error"
+    }
+  ]
+}
