+  }
+
+  function render() {
+    const todoList = document.querySelector('.todo-list');
+    const main = document.querySelector('.main');
+    const footer = document.querySelector('.footer');
+    const toggleAll = document.querySelector('#toggle-all');
+    const todoCount = document.querySelector('.todo-count');
+    const clearCompleted = document.querySelector('.clear-completed');
+
+    // Hide main and footer when no todos
+    if (todos.length === 0) {
+      main.style.display = 'none';
+      footer.style.display = 'none';
+      return;
+    }
+
+    main.style.display = '';
+    footer.style.display = '';
+
+    // Filter todos based on current route
+    let filteredTodos = todos;
+    if (currentFilter === '/active') {
+      filteredTodos = todos.filter(todo => !todo.completed);
+    } else if (currentFilter === '/completed') {
+      filteredTodos = todos.filter(todo => todo.completed);
+    }
+
+    // Render todo items
+    todoList.innerHTML = filteredTodos.map(todo => `
+      <li class="${todo.completed ? 'completed' : ''}" data-id="${todo.id}">
+        <div class="view">
+          <input class="toggle" type="checkbox" ${todo.completed ? 'checked' : ''}>
+          <label>${escapeHtml(todo.title)}</label>
+          <button class="destroy"></button>
+        </div>
+        <input class="edit" value="${escapeHtml(todo.title)}">
+      </li>
+    `).join('');
+
+    // Update counter
+    const activeTodos = todos.filter(todo => !todo.completed);
+    const count = activeTodos.length;
+    todoCount.innerHTML = `<strong>${count}</strong> ${count === 1 ? 'item' : 'items'} left`;
+
+    // Update toggle-all
+    toggleAll.checked = todos.length > 0 && activeTodos.length === 0;
+
+    // Show/hide clear completed
+    const completedTodos = todos.filter(todo => todo.completed);
+    clearCompleted.style.display = completedTodos.length > 0 ? '' : 'none';
+
+    // Update filter links
+    document.querySelectorAll('.filters a').forEach(link => {
+      const href = link.getAttribute('href');
+      link.classList.toggle('selected', href === '#' + currentFilter);
+    });
+  }
+
+  function escapeHtml(text) {
+    const div = document.createElement('div');
+    div.textContent = text;
+    return div.innerHTML;
+  }
+
+  function setupEventListeners() {
+    const newTodoInput = document.querySelector('.new-todo');
+    const toggleAll = document.querySelector('#toggle-all');
+    const clearCompleted = document.querySelector('.clear-completed');
+    const todoList = document.querySelector('.todo-list');
+
+    // New todo input
+    newTodoInput.addEventListener('keydown', function(e) {
+      if (e.key === 'Enter' || e.keyCode === 13) {
+        const title = newTodoInput.value.trim();
+        if (title) {
+          todos.push({
+            id: Date.now(),
+            title: title,
+            completed: false
+          });
+          saveTodos();
+          newTodoInput.value = '';
+          render();
+        }
+      }
+    });
+
+    // Toggle all
+    toggleAll.addEventListener('change', function() {
+      const completed = toggleAll.checked;
+      todos.forEach(todo => {
+        todo.completed = completed;
+      });
+      saveTodos();
+      render();
+    });
+
+    // Clear completed
+    clearCompleted.addEventListener('click', function() {
+      todos = todos.filter(todo => !todo.completed);
+      saveTodos();
+      render();
+    });
+
+    // Todo list interactions
+    todoList.addEventListener('click', function(e) {
+      const target = e.target;
+      const li = target.closest('li');
+      if (!li) return;
+      const id = parseInt(li.dataset.id);
+
+      if (target.classList.contains('toggle')) {
+        // Toggle todo completion
+        const todo = todos.find(t => t.id === id);
+        if (todo) {
+          todo.completed = target.checked;
+          saveTodos();
+          render();
+        }
+      } else if (target.classList.contains('destroy')) {
+        // Delete todo
+        todos = todos.filter(t => t.id !== id);
+        saveTodos();
+        render();
+      }
+    });
+
+    // Double-click to edit
+    todoList.addEventListener('dblclick', function(e) {
+      if (e.target.tagName === 'LABEL') {
+        const li = e.target.closest('li');
+        li.classList.add('editing');
+        const editInput = li.querySelector('.edit');
+        editInput.focus();
+      }
+    });
+
+    // Edit input events
+    todoList.addEventListener('keydown', function(e) {
+      if (e.target.classList.contains('edit')) {
+        const li = e.target.closest('li');
+        const id = parseInt(li.dataset.id);
+        
+        if (e.key === 'Enter' || e.keyCode === 13) {
+          saveEdit(id, e.target.value, li);
+        } else if (e.key === 'Escape' || e.keyCode === 27) {
+          li.classList.remove('editing');
+          e.target.value = li.querySelector('label').textContent;
+        }
+      }
+    });
+
+    todoList.addEventListener('blur', function(e) {
+      if (e.target.classList.contains('edit')) {
+        const li = e.target.closest('li');
+        const id = parseInt(li.dataset.id);
+        saveEdit(id, e.target.value, li);
+      }
+    }, true);
+
+    // Hash change for routing
+    window.addEventListener('hashchange', function() {
+      currentFilter = window.location.hash.replace('#', '') || '/';
+      render();
+    });
+
+    // Initialize filter from URL
+    currentFilter = window.location.hash.replace('#', '') || '/';
+  }
+
+  function saveEdit(id, value, li) {
+    const trimmedValue = value.trim();
+    if (trimmedValue) {
+      const todo = todos.find(t => t.id === id);
+      if (todo) {
+        todo.title = trimmedValue;
+        saveTodos();
+      }
+    } else {
+      todos = todos.filter(t => t.id !== id);
+      saveTodos();
+    }
+    li.classList.remove('editing');
+    render();
+  }
+
+// Initialize on DOM ready
+if (typeof document !== 'undefined') {
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', init);
+  } else {
+    init();
+  }
+}
