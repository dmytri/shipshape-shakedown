diff --git a/js/app.js b/js/app.js
index 2d66168..77e2d97 100644
--- a/js/app.js
+++ b/js/app.js
@@ -47,26 +47,60 @@
     var todos = loadTodos();
     var filtered = getFilteredTodos(todos);
 
-    // Clear list
-    todoList.innerHTML = '';
+    // Build a map of existing li elements by data-id
+    var existingLis = {};
+    var existingNodes = todoList.querySelectorAll('li[data-id]');
+    for (var i = 0; i < existingNodes.length; i++) {
+      var el = existingNodes[i];
+      existingLis[el.getAttribute('data-id')] = el;
+    }
 
-    // Render each todo
+    // Update or create each todo's li in place
+    var usedIds = {};
     filtered.forEach(function (todo) {
-      var li = document.createElement('li');
-      li.setAttribute('data-id', todo.id);
-      if (todo.completed) li.classList.add('completed');
-
-      li.innerHTML =
-        '<div class="view">' +
-          '<input class="toggle" type="checkbox"' + (todo.completed ? ' checked' : '') + '>' +
-          '<label>' + escapeHtml(todo.title) + '</label>' +
-          '<button class="destroy"></button>' +
-        '</div>' +
-        '<input class="edit" value="' + escapeHtml(todo.title) + '">';
-
-      todoList.appendChild(li);
+      var id = String(todo.id);
+      usedIds[id] = true;
+      var li = existingLis[id];
+      if (li) {
+        // Update in place
+        if (todo.completed) {
+          li.classList.add('completed');
+        } else {
+          li.classList.remove('completed');
+        }
+        var toggle = li.querySelector('.toggle');
+        toggle.checked = todo.completed;
+        var label = li.querySelector('label');
+        label.textContent = todo.title;
+        var edit = li.querySelector('.edit');
+        edit.value = todo.title;
+      } else {
+        // Create new
+        li = document.createElement('li');
+        li.setAttribute('data-id', id);
+        if (todo.completed) li.classList.add('completed');
+
+        li.innerHTML =
+          '<div class="view">' +
+            '<input class="toggle" type="checkbox"' + (todo.completed ? ' checked' : '') + '>' +
+            '<label>' + escapeHtml(todo.title) + '</label>' +
+            '<button class="destroy"></button>' +
+          '</div>' +
+          '<input class="edit" value="' + escapeHtml(todo.title) + '">';
+
+        todoList.appendChild(li);
+      }
     });
 
+    // Remove li elements that are no longer in the filtered list
+    var children = todoList.querySelectorAll('li[data-id]');
+    for (var j = 0; j < children.length; j++) {
+      var child = children[j];
+      if (!usedIds[child.getAttribute('data-id')]) {
+        todoList.removeChild(child);
+      }
+    }
+
     // Counter
     var activeCount = todos.filter(function (t) { return !t.completed; }).length;
     var pluralized = activeCount === 1 ? 'item' : 'items';
