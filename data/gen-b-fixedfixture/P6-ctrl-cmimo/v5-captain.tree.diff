 });
 
+Then('the toggle checkbox of the todo {string} is not visible', function (title) {
+  const li = todoByTitle(this.document, title);
+  if (!li) throw new Error(`Todo "${title}" not found`);
+  const checkbox = el(li, '.toggle');
+  if (!checkbox) throw new Error(`Todo "${title}" has no toggle checkbox`);
+  // Check visibility via computed style: the CSS rule li.editing .view should
+  // hide the view container, making the checkbox invisible.
+  const win = this.document.defaultView || this.window;
+  const viewDiv = el(li, '.view');
+  if (viewDiv) {
+    const style = win.getComputedStyle(viewDiv);
+    if (style.display !== 'none' && style.visibility !== 'hidden') {
+      throw new Error(
+        `Toggle checkbox of "${title}" is still visible. ` +
+        `The li.editing .view CSS rule must hide the view container during editing.`
+      );
+    }
+  }
+});
+
