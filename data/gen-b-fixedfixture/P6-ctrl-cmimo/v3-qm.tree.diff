--- a/features/support/steps.js
+++ b/features/support/steps.js
@@ -308,6 +308,19 @@ Then('the todo {string} has a destroy button', function (title) {
   }
 });
 
+Then('the view container of the todo {string} is not visible', function (title) {
+  const li = todoByTitle(this.document, title);
+  if (!li) throw new Error(`Todo "${title}" not found`);
+  const view = li.querySelector('.view');
+  if (!view) throw new Error(`Todo "${title}" has no view container`);
+  const style = this.document.defaultView.getComputedStyle(view);
+  if (style.display !== 'none' && !view.classList.contains('hidden')) {
+    if (style.visibility !== 'hidden' && style.opacity !== '0') {
+      throw new Error(`View container of "${title}" is visible`);
+    }
+  }
+});
+
 Then('the edit input of {string} contains {string}', function (title, value) {
   const li = todoByTitle(this.document, title);
   if (!li) throw new Error(`Todo "${title}" not found`);
