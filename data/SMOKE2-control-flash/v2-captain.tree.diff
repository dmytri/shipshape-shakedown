@@ -0,0 +1,302 @@
+(function () {
+  'use strict';
+
+  // ──────────────────────────────────────────────
+  // Model
+  // ──────────────────────────────────────────────
+
+  const STORAGE_KEY = 'todos-todomvc';
+
+  function loadTodos() {
+    try {
+      const data = localStorage.getItem(STORAGE_KEY);
+      return data ? JSON.parse(data) : [];
+    } catch (e) {
+      return [];
+    }
+  }
+
+  function saveTodos(todos) {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
+  }
+
+  function nextId() {
+    const todos = loadTodos();
+    return todos.reduce(function (max, t) { return Math.max(max, t.id); }, 0) + 1;
+  }
+
+  // ──────────────────────────────────────────────
+  // View
+  // ──────────────────────────────────────────────
+
+  var todoList = document.querySelector('.todo-list');
+  var newTodoInput = document.querySelector('.new-todo');
+  var mainSection = document.querySelector('.main');
+  var footerSection = document.querySelector('.footer');
+  var todoCount = document.querySelector('.todo-count');
+  var clearCompletedBtn = document.querySelector('.clear-completed');
+  var toggleAllCheckbox = document.querySelector('.toggle-all');
+  var filterLinks = document.querySelectorAll('.filters a');
+
+  function render() {
+    var todos = loadTodos();
+    var currentFilter = getCurrentFilter();
+    var filteredTodos = filterTodos(todos, currentFilter);
+
+    renderList(filteredTodos);
+    updateMainVisibility(todos);
+    updateFooterVisibility(todos);
+    updateTodoCount(todos);
+    updateClearCompleted(todos);
+    updateToggleAll(todos);
+    updateFilterSelection(currentFilter);
+  }
+
+  function renderList(todos) {
+    todoList.innerHTML = todos.map(function (todo) {
+      return '<li' +
+        (todo.completed ? ' class="completed"' : '') +
+        ' data-id="' + todo.id + '">' +
+        '<div class="view">' +
+        '<input class="toggle" type="checkbox"' + (todo.completed ? ' checked' : '') + '>' +
+        '<label>' + escapeHtml(todo.title) + '</label>' +
+        '<button class="destroy"></button>' +
+        '</div>' +
+        '<input class="edit" value="' + escapeHtml(todo.title) + '">' +
+        '</li>';
+    }).join('');
+  }
+
+  function escapeHtml(text) {
+    var div = document.createElement('div');
+    div.appendChild(document.createTextNode(text));
+    return div.innerHTML;
+  }
+
+  function updateMainVisibility(todos) {
+    mainSection.style.display = todos.length === 0 ? 'none' : '';
+  }
+
+  function updateFooterVisibility(todos) {
+    footerSection.style.display = todos.length === 0 ? 'none' : '';
+  }
+
+  function updateTodoCount(todos) {
+    var activeCount = todos.filter(function (t) { return !t.completed; }).length;
+    var word = activeCount === 1 ? 'item' : 'items';
+    todoCount.innerHTML = '<strong>' + activeCount + '</strong> ' + word + ' left';
+  }
+
+  function updateClearCompleted(todos) {
+    var hasCompleted = todos.some(function (t) { return t.completed; });
+    clearCompletedBtn.style.display = hasCompleted ? '' : 'none';
+  }
+
+  function updateToggleAll(todos) {
+    var activeCount = todos.filter(function (t) { return !t.completed; }).length;
+    toggleAllCheckbox.checked = todos.length > 0 && activeCount === 0;
+  }
+
+  function updateFilterSelection(currentFilter) {
+    filterLinks.forEach(function (link) {
+      var href = link.getAttribute('href');
+      link.classList.toggle('selected', href === currentFilter);
+    });
+  }
+
+  function filterTodos(todos, filter) {
+    switch (filter) {
+      case '#/active': return todos.filter(function (t) { return !t.completed; });
+      case '#/completed': return todos.filter(function (t) { return t.completed; });
+      default: return todos;
+    }
+  }
+
+  function getCurrentFilter() {
+    return window.location.hash || '#/';
+  }
+
+  // ──────────────────────────────────────────────
+  // Events
+  // ──────────────────────────────────────────────
+
+  newTodoInput.addEventListener('keydown', function (e) {
+    if (e.key === 'Enter') {
+      var title = newTodoInput.value.trim();
+      if (title === '') return;
+      var todos = loadTodos();
+      todos.push({ id: nextId(), title: title, completed: false });
+      saveTodos(todos);
+      newTodoInput.value = '';
+      render();
+    }
+  });
+
+  todoList.addEventListener('click', function (e) {
+    var target = e.target;
+    var li = target.closest('li');
+    if (!li) return;
+    var id = parseInt(li.getAttribute('data-id'), 10);
+
+    if (target.classList.contains('toggle')) {
+      var todos = loadTodos();
+      var todo = todos.find(function (t) { return t.id === id; });
+      if (todo) {
+        todo.completed = !todo.completed;
+        saveTodos(todos);
+        // Surgical DOM update: avoid full render() which detaches all <li> elements
+        li.classList.toggle('completed');
+        target.checked = todo.completed;
+        updateTodoCount(todos);
+        updateClearCompleted(todos);
+        updateToggleAll(todos);
+      }
+      return;
+    }
+
+    if (target.classList.contains('destroy')) {
+      var todos = loadTodos();
+      todos = todos.filter(function (t) { return t.id !== id; });
+      saveTodos(todos);
+      // Surgical: remove the li directly then update derived UI
+      li.remove();
+      updateMainVisibility(todos);
+      updateFooterVisibility(todos);
+      updateTodoCount(todos);
+      updateClearCompleted(todos);
+      updateToggleAll(todos);
+    }
+  });
+
+  todoList.addEventListener('dblclick', function (e) {
+    var li = e.target.closest('li');
+    if (!li) return;
+    var editInput = li.querySelector('.edit');
+
+    // Mark editing
+    var currentlyEditing = document.querySelector('.todo-list li.editing');
+    if (currentlyEditing) {
+      finishEdit(currentlyEditing);
+    }
+
+    li.classList.add('editing');
+    editInput.focus();
+    editInput.setSelectionRange(editInput.value.length, editInput.value.length);
+  });
+
+  todoList.addEventListener('keydown', function (e) {
+    if (e.key === 'Enter') {
+      var editingLi = document.querySelector('.todo-list li.editing');
+      if (editingLi) {
+        finishEdit(editingLi);
+      }
+    }
+    if (e.key === 'Escape') {
+      var editingLi = document.querySelector('.todo-list li.editing');
+      if (editingLi) {
+        cancelEdit(editingLi);
+      }
+    }
+  });
+
+  // happy-dom does NOT reliably fire blur events with capture phase, so listen on
+  // focusout which bubbles.
+  todoList.addEventListener('focusout', function (e) {
+    var editInput = e.target;
+    if (editInput.classList.contains('edit')) {
+      var li = editInput.closest('li');
+      if (li) {
+        var title = editInput.value.trim();
+        var id = parseInt(li.getAttribute('data-id'), 10);
+        var todos = loadTodos();
+        var todo = todos.find(function (t) { return t.id === id; });
+        if (!todo) return;
+        if (title === '') {
+          todos = todos.filter(function (t) { return t.id !== id; });
+        } else {
+          todo.title = title;
+        }
+        saveTodos(todos);
+        li.classList.remove('editing');
+        render();
+      }
+    }
+  });
+
+  function finishEdit(li) {
+    var editInput = li.querySelector('.edit');
+    var title = editInput.value.trim();
+    var id = parseInt(li.getAttribute('data-id'), 10);
+
+    var todos = loadTodos();
+    var todo = todos.find(function (t) { return t.id === id; });
+    if (!todo) return;
+
+    if (title === '') {
+      // Destroy the todo
+      todos = todos.filter(function (t) { return t.id !== id; });
+    } else {
+      todo.title = title;
+    }
+    saveTodos(todos);
+    li.classList.remove('editing');
+    render();
+  }
+
+  function cancelEdit(li) {
+    li.classList.remove('editing');
+    // Restore original title by re-rendering
+    render();
+  }
+
+  toggleAllCheckbox.addEventListener('change', function (e) {
+    var todos = loadTodos();
+    var allCompleted = todos.every(function (t) { return t.completed; });
+    todos.forEach(function (t) { t.completed = !allCompleted; });
+    saveTodos(todos);
+    // Surgical DOM update: avoid full render() which detaches all <li> elements
+    todoList.querySelectorAll('li').forEach(function (li) {
+      var liId = parseInt(li.getAttribute('data-id'), 10);
+      var todo = todos.find(function (t) { return t.id === liId; });
+      if (todo) {
+        li.classList.toggle('completed', todo.completed);
+        var cb = li.querySelector('.toggle');
+        if (cb) cb.checked = todo.completed;
+      }
+    });
+    updateTodoCount(todos);
+    updateClearCompleted(todos);
+    updateToggleAll(todos);
+  });
+
+  clearCompletedBtn.addEventListener('click', function () {
+    var todos = loadTodos();
+    var hadCompleted = todos.some(function (t) { return t.completed; });
+    todos = todos.filter(function (t) { return !t.completed; });
+    saveTodos(todos);
+    // Surgical DOM update: remove completed <li> elements instead of full re-render
+    var completedLis = todoList.querySelectorAll('li.completed');
+    completedLis.forEach(function (li) { li.remove(); });
+    updateMainVisibility(todos);
+    updateFooterVisibility(todos);
+    updateTodoCount(todos);
+    updateClearCompleted(todos);
+    updateToggleAll(todos);
+  });
+
+  // ──────────────────────────────────────────────
+  // Routing
+  // ──────────────────────────────────────────────
+
+  window.addEventListener('hashchange', function () {
+    render();
+  });
+
+  // ──────────────────────────────────────────────
+  // Init
+  // ──────────────────────────────────────────────
+
+  render();
+  // Expose for test harness (reload, etc.)
+  window.appRender = render;
+})();
