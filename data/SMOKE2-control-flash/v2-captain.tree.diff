+++ b/features/step_definitions/steps.js
@@ -0,0 +1,501 @@
+const { Given, When, Then, Before } = require('@cucumber/cucumber');
+const assert = require('assert');
+
+// ──────────────────────────────────────────────
+// Helpers
+// ──────────────────────────────────────────────
+
+function getTodoItems(doc) {
+  return Array.from(doc.querySelectorAll('.todo-list li'));
+}
+
+function findTodoItem(doc, title) {
+  return getTodoItems(doc).find(li => li.querySelector('label').textContent.trim() === title);
+}
+
+function getTodoItemByText(doc, text) {
+  return getTodoItems(doc).filter(li => li.querySelector('label').textContent.trim() === text);
+}
+
+function waitFor(fn, timeout=200) {
+  return new Promise((resolve, reject) => {
+    const start = Date.now();
+    function check() {
+      const result = fn();
+      if (result !== undefined) return resolve(result);
+      if (Date.now() - start >= timeout) return reject(new Error('waitFor timeout'));
+      setTimeout(check, 10);
+    }
+    check();
+  });
+}
+
+// ──────────────────────────────────────────────
+// Given steps
+// ──────────────────────────────────────────────
+
+Given('the TodoMVC app is open', function () {
+  // The app is loaded by Before hook in world.js
+});
+
+Given('the app has no todos', function () {
+  const items = getTodoItems(this.document);
+  if (items.length > 0) {
+    // Remove all existing todos from localStorage and reload
+    this.localStorage.clear();
+    this.window.location.reload();
+  }
+});
+
+Given('the input field is focused', function () {
+  const input = this.document.querySelector('.new-todo');
+  input.focus();
+  this.document.activeElement = input;
+});
+
+Given('the todo list contains {string}', function (title) {
+  const input = this.document.querySelector('.new-todo');
+  input.value = title;
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', which: 13, keyCode: 13, bubbles: true }));
+  // Focus back on input after creating
+  input.focus();
+  this.document.activeElement = input;
+});
+
+Given('the todo list contains {string} and {string}', function (title1, title2) {
+  const input = this.document.querySelector('.new-todo');
+  [title1, title2].forEach(t => {
+    input.value = t;
+    input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', which: 13, keyCode: 13, bubbles: true }));
+  });
+  input.focus();
+  this.document.activeElement = input;
+});
+
+Given('the todo list contains {string}, {string}, and {string}', function (title1, title2, title3) {
+  const input = this.document.querySelector('.new-todo');
+  [title1, title2, title3].forEach(t => {
+    input.value = t;
+    input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', which: 13, keyCode: 13, bubbles: true }));
+  });
+  input.focus();
+  this.document.activeElement = input;
+});
+
+Given('the todo list contains a completed todo {string}', function (title) {
+  const input = this.document.querySelector('.new-todo');
+  input.value = title;
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', which: 13, keyCode: 13, bubbles: true }));
+  // Mark as completed
+  const item = findTodoItem(this.document, title);
+  if (item) {
+    item.querySelector('.toggle').click();
+  }
+  input.focus();
+  this.document.activeElement = input;
+});
+
+Given('the app is at the default route', function () {
+  this.navigate('#/');
+});
+
+Given('I am on the {string} route', function (hash) {
+  this.navigate(hash);
+});
+
+
+
+Given('localStorage contains an active todo {string}', function (title) {
+  const data = JSON.parse(this.localStorage.getItem('todos-todomvc') || '[]');
+  data.push({ id: Date.now(), title: title, completed: false });
+  this.localStorage.setItem('todos-todomvc', JSON.stringify(data));
+});
+
+Given('localStorage contains a completed todo {string}', function (title) {
+  const data = JSON.parse(this.localStorage.getItem('todos-todomvc') || '[]');
+  data.push({ id: Date.now(), title: title, completed: true });
+  this.localStorage.setItem('todos-todomvc', JSON.stringify(data));
+});
+
+Given('localStorage contains todos {string} and {string}', function (title1, title2) {
+  const data = JSON.parse(this.localStorage.getItem('todos-todomvc') || '[]');
+  data.push({ id: Date.now() + 1, title: title1, completed: false });
+  data.push({ id: Date.now() + 2, title: title2, completed: false });
+  this.localStorage.setItem('todos-todomvc', JSON.stringify(data));
+});
+
+Given('all todos are marked as completed', function () {
+  const items = getTodoItems(this.document);
+  items.forEach(function(li) {
+    const toggle = li.querySelector('.toggle');
+    if (!toggle.checked) toggle.click();
+  });
+});
+
+Given('localStorage has no todos', function () {
+  this.localStorage.removeItem('todos-todomvc');
+});
+
+// ──────────────────────────────────────────────
+// When steps
+// ──────────────────────────────────────────────
+
+When('I type {string} into the new-todo input', function (text) {
+  const input = this.document.querySelector('.new-todo');
+  input.value = text;
+  input.focus();
+  this.document.activeElement = input;
+});
+
+When('I press Enter', function () {
+  const active = this.document.activeElement;
+  if (active) {
+    active.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', which: 13, keyCode: 13, bubbles: true }));
+  }
+});
+
+When('I press Enter with an empty input', function () {
+  const input = this.document.querySelector('.new-todo');
+  input.value = '';
+  input.focus();
+  this.document.activeElement = input;
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', which: 13, keyCode: 13, bubbles: true }));
+});
+
+When('I click the toggle checkbox on {string}', function (title) {
+  const item = findTodoItem(this.document, title);
+  if (item) {
+    item.querySelector('.toggle').click();
+  } else {
+    throw new Error(`Todo item "${title}" not found`);
+  }
+});
+
+When('I mark {string} as completed', function (title) {
+  // Find the item and click its toggle
+  const item = findTodoItem(this.document, title);
+  if (item) {
+    item.querySelector('.toggle').click();
+  } else {
+    throw new Error(`Todo item "${title}" not found`);
+  }
+});
+
+When('I mark {string} as active', function (title) {
+  // Same as toggling - uncheck completed todo
+  const item = findTodoItem(this.document, title);
+  if (item) {
+    item.querySelector('.toggle').click();
+  } else {
+    throw new Error(`Todo item "${title}" not found`);
+  }
+});
+
+When('I click the {string} filter link', function (filterName) {
+  const links = this.document.querySelectorAll('.filters a');
+  const link = Array.from(links).find(a => a.textContent.trim() === filterName);
+  if (link) {
+    link.click();
+  } else {
+    throw new Error(`Filter link "${filterName}" not found`);
+  }
+});
+
+When('I click the "Mark all as complete" toggle', function () {
+  const toggle = this.document.querySelector('.toggle-all');
+  if (toggle) toggle.click();
+});
+
+When('I click "Clear completed"', function () {
+  const btn = this.document.querySelector('.clear-completed');
+  if (btn) btn.click();
+});
+
+When('I double-click the label of {string}', function (title) {
+  const item = findTodoItem(this.document, title);
+  if (item) {
+    const label = item.querySelector('label');
+    label.dispatchEvent(new this.window.MouseEvent('dblclick', { bubbles: true }));
+  } else {
+    throw new Error(`Todo item "${title}" not found`);
+  }
+});
+
+When('I double-click the label of {string} to edit it', function (title) {
+  const item = findTodoItem(this.document, title);
+  if (item) {
+    const label = item.querySelector('label');
+    label.dispatchEvent(new this.window.MouseEvent('dblclick', { bubbles: true }));
+  } else {
+    throw new Error(`Todo item "${title}" not found`);
+  }
+});
+
+When('I change the value to {string}', function (newValue) {
+  const editInput = this.document.querySelector('.todo-list li.editing .edit');
+  if (editInput) {
+    editInput.value = newValue;
+  } else {
+    throw new Error('No editing input found');
+  }
+});
+
+When('I change the title of {string} to {string}', function (oldTitle, newTitle) {
+  // First double-click to enter edit mode, then change value
+  const item = findTodoItem(this.document, oldTitle);
+  if (item) {
+    const label = item.querySelector('label');
+    label.dispatchEvent(new this.window.MouseEvent('dblclick', { bubbles: true }));
+    // Wait for edit mode
+    const editInput = this.document.querySelector('.todo-list li.editing .edit');
+    if (editInput) {
+      editInput.value = newTitle;
+      editInput.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', which: 13, keyCode: 13, bubbles: true }));
+    }
+  } else {
+    throw new Error(`Todo item "${oldTitle}" not found`);
+  }
+});
+
+When('I blur the edit input', function () {
+  const editInput = this.document.querySelector('.todo-list li.editing .edit');
+  if (editInput) {
+    // Use focusout which bubbles (blur does not), so the app.js listener catches it
+    editInput.dispatchEvent(new this.window.FocusEvent('focusout', { bubbles: true }));
+  }
+});
+
+When('I press Escape', function () {
+  const editInput = this.document.querySelector('.todo-list li.editing .edit');
+  if (editInput) {
+    editInput.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Escape', code: 'Escape', which: 27, keyCode: 27, bubbles: true }));
+  }
+});
+
+When('I reload the app', function () {
+  this.window.location.reload();
+});
+
+When('I navigate to the {string} route', function (hash) {
+  this.navigate(hash);
+});
+
+Given('I navigate to the "#/active" route', function () {
+  this.navigate('#/active');
+});
+
+// ──────────────────────────────────────────────
+// Then steps
+// ──────────────────────────────────────────────
+
+Then('the main section should not be visible', function () {
+  const main = this.document.querySelector('.main');
+  const style = this.window.getComputedStyle(main);
+  assert.strictEqual(style.display, 'none', 'Expected main section to be hidden');
+});
+
+Then('the footer should not be visible', function () {
+  const footer = this.document.querySelector('.footer');
+  const style = this.window.getComputedStyle(footer);
+  assert.strictEqual(style.display, 'none', 'Expected footer to be hidden');
+});
+
+Then('a new todo {string} appears in the list', function (title) {
+  const items = getTodoItems(this.document);
