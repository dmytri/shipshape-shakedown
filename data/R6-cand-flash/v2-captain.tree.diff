new file mode 100644
index 0000000..eea0f94
--- /dev/null
+++ b/assets/toggle-identity-scantling.json
@@ -0,0 +1,15 @@
+{
+  "seam": "toggle-todo",
+  "path": "js/app.js",
+  "contract": "When toggling a todo item's completion state (single toggle, toggle-all, or clear-completed), every <li> element in .todo-list MUST retain its DOM node identity. The implementation MUST NOT replace <li> elements via innerHTML assignment, removeChild/appendChild cycles, or any other operation that causes an existing element to lose its connection to the DOM tree. Instead, the implementation MUST mutate each existing <li> element's classList and its child .toggle input's checked property in place.",
+  "counterexample": "Query .todo-list li before the toggle interaction using document.querySelectorAll. Store a Set of the returned element references keyed by their data-id attribute. Perform the toggle interaction. After the interaction, query .todo-list li again. For every previous element that had a given data-id, the same element reference MUST appear in the post-interaction query at the same index position. A mismatch — the pre-interaction element is not found in the post-interaction list, or its data-id changed — is a counterexample and a violation of this contract.",
+  "affected-seams": [
+    "The 'change' event listener on .toggle checkbox (single todo toggle) — calls store.toggle(id) then render()",
+    "The 'change' event listener on #toggle-all (mark all) — calls store.toggleAll(completed) then render()",
+    "The 'click' event listener on .clear-completed — calls store.clearCompleted() then render()",
+    "The destroy button 'click' handler — calls store.remove(id) then render()",
+    "The new-todo 'keyup' handler — calls store.add(title) then render()",
+    "The finishEdit() function — calls store.remove(id) or store.update(id, title) then render()",
+    "The todo-list filter render triggered by hashchange and initial route() — always calls render()"
+  ]
+}
