diff --git a/features/step_definitions/todomvc.steps.js b/features/step_definitions/todomvc.steps.js
index d88dfdf..d88a961 100644
--- a/features/step_definitions/todomvc.steps.js
+++ b/features/step_definitions/todomvc.steps.js
@@ -1,5 +1,7 @@
 const { Given, When, Then } = require('@cucumber/cucumber');
 const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
 
 // --- Helper functions ---
 
@@ -307,3 +309,33 @@ Then('the {string} filter link is not selected', function (filter) {
   const link = this.document.querySelector(`.filters a[href="${href}"]`);
   assert.ok(!link.classList.contains('selected'), `${filter} filter link should not be selected`);
 });
+
+// --- Servable index.html steps ---
+
+Given('a servable index.html exists at the project root', function () {
+  const rootDir = path.resolve(__dirname, '../..');
+  const indexPath = path.join(rootDir, 'index.html');
+  assert.ok(fs.existsSync(indexPath), 'index.html must exist at project root');
+  this._indexHtml = fs.readFileSync(indexPath, 'utf-8');
+});
+
+Then('the servable page contains the todoapp section', function () {
+  assert.ok(this._indexHtml.includes('class="todoapp"'), 'Page must contain a .todoapp section');
+});
+
+Then('the servable page contains the new-todo input', function () {
+  assert.ok(this._indexHtml.includes('class="new-todo"'), 'Page must contain the new-todo input');
+});
+
+Then('the servable page contains the todo-list', function () {
+  assert.ok(this._indexHtml.includes('class="todo-list"'), 'Page must contain the todo-list');
+});
+
+Then('the servable page contains the footer with filters', function () {
+  assert.ok(this._indexHtml.includes('class="footer"'), 'Page must contain the footer');
+  assert.ok(this._indexHtml.includes('class="filters"'), 'Page must contain the filters');
+});
+
+Then(/^the servable page loads js\/app\.js via a script tag$/, function () {
+  assert.ok(this._indexHtml.includes('src="js/app.js"'), 'Page must load js/app.js via a script tag');
+});
diff --git a/features/todomvc.feature b/features/todomvc.feature
index cdbd40c..c641bf7 100644
--- a/features/todomvc.feature
+++ b/features/todomvc.feature
@@ -6,6 +6,15 @@ Feature: TodoMVC
   Background:
     Given the app is loaded
 
+  @servable
+  Scenario: The servable index.html contains the required app structure
+    Given a servable index.html exists at the project root
+    Then the servable page contains the todoapp section
+    And the servable page contains the new-todo input
+    And the servable page contains the todo-list
+    And the servable page contains the footer with filters
+    And the servable page loads js/app.js via a script tag
+
   Scenario: No todos hides the main section and footer
     Then the main section is not visible
     And the footer is not visible
diff --git a/index.html b/index.html
new file mode 100644
index 0000000..b0e380f
--- /dev/null
+++ b/index.html
@@ -0,0 +1,44 @@
+<!doctype html>
+<html lang="en">
+	<head>
+		<meta charset="utf-8">
+		<meta name="viewport" content="width=device-width, initial-scale=1">
+		<title>TodoMVC</title>
+		<link rel="stylesheet" href="node_modules/todomvc-common/base.css">
+		<link rel="stylesheet" href="node_modules/todomvc-app-css/index.css">
+		<link rel="stylesheet" href="css/app.css">
+	</head>
+	<body>
+		<section class="todoapp">
+			<header class="header">
+				<h1>todos</h1>
+				<input class="new-todo" placeholder="What needs to be done?" autofocus>
+			</header>
+			<section class="main">
+				<input id="toggle-all" class="toggle-all" type="checkbox">
+				<label for="toggle-all">Mark all as complete</label>
+				<ul class="todo-list"></ul>
+			</section>
+			<footer class="footer">
+				<span class="todo-count"><strong>0</strong> item left</span>
+				<ul class="filters">
+					<li>
+						<a class="selected" href="#/">All</a>
+					</li>
+					<li>
+						<a href="#/active">Active</a>
+					</li>
+					<li>
+						<a href="#/completed">Completed</a>
+					</li>
+				</ul>
+				<button class="clear-completed">Clear completed</button>
+			</footer>
+		</section>
+		<footer class="info">
+			<p>Double-click to edit a todo</p>
+		</footer>
+		<script src="node_modules/todomvc-common/base.js"></script>
+		<script src="js/app.js"></script>
+	</body>
+</html>
