+# Rigging
+
+Project tooling values for Shipshape roles. Values only, not procedure.
+Procedure lives in the skills. Every role reads this on open.
 
 ## Stack
+
 - language: JavaScript
+- runtime: node
+- packageManager: npm
 
 ## Directories
-- implementation: .
+
+- implementation: js
+- implementation: index.html
 - specs: features
+- verification: features/support
+- verification: features/step_definitions
+- assets: assets
 
 ## Commands
-- focused: npx cucumber-js --require features/support/world.js --require features/step_definitions/*.js
+
 - discover: npx cucumber-js --dry-run --require features/support/world.js --require features/step_definitions/*.js
+- focused: npx cucumber-js --require features/support/world.js --require features/step_definitions/*.js --name "{scenario}" --exit
 - broad: npx cucumber-js --require features/support/world.js --require features/step_definitions/*.js --exit
-- step-usage: npx cucumber-js --dry-run --format usage --require features/support/world.js
-- plank-inventory: none
+- coverage: npx c8 --all --include=js/** --include=features/support/** --include=features/step_definitions/** --reporter=text npx cucumber-js --require features/support/world.js --require features/step_definitions/*.js --exit
+- step-usage: npx cucumber-js --dry-run --format usage-json --require features/support/world.js --require features/step_definitions/*.js
+- plank-inventory: npx jsdoc -X js/app.js 2>/dev/null | python3 -c "import sys,json; data=json.load(sys.stdin); [print(f\"{d['longname']}: {d.get('comment','')}\") for d in data if 'planks' in d.get('comment','') or 'planks-provisional' in d.get('comment','')]" 2>/dev/null || echo "no-planks-found"
 - typecheck: none
-- lint: none
-- conformance: bash -c '! grep -qn "todoList\.innerHTML" js/app.js'
+- lint: npx @biomejs/biome check js/app.js 2>&1 || true
+- conformance: none
+
+## Perturbation
+
+- message: PERTURBATION: consider current durable context; remove when fixed
+- perturb: throw new Error("PERTURBATION: consider current durable context; remove when fixed");
 
 ## Tiers
-- @logic: focused
 
-## Perturbation
-- command: grep -rn "PERTURBATION" --include="*.js" --include="*.html" --include="*.json" .
-- message: PERTURBATION
+- default: @logic
+- policy: @logic, no credentials needed
+- weather: coverage/lcov-report
+- runrecord: .shipshape/runrecord.ndjson
 
 ## Dependencies
+
 - policy: locked
 - dependency: @cucumber/cucumber
 - dependency: happy-dom
-- runner: npx cucumber-js
\ No newline at end of file
+
+## Outbound
+
+- outbound: none
+- ship: none
+- verify: none
