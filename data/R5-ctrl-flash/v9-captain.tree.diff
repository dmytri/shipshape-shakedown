diff --git a/features/support/conformance-steps.js b/features/support/conformance-steps.js
index 98a429d..43aeb70 100644
--- a/features/support/conformance-steps.js
+++ b/features/support/conformance-steps.js
@@ -285,4 +285,53 @@ Then('the helper passes the useCapture flag to the native addEventListener', fun
     'with {bubbles: true}.\n' +
     'FIX: Change the helper signature to accept and forward a capture parameter: ' +
     'function on(el, evt, fn, capture) { el.addEventListener(evt, fn, capture); }');
+});
+
+// ---------------------------------------------------------------------------
+// Conformance: Re-entrant blur guard in stale-node removal
+// ---------------------------------------------------------------------------
+
+When('I check whether the render function guards removeChild with a parentNode check in the stale-node removal loop', function () {
+  const source = this.appSource;
+  // Find the block in render() where stale items are removed.
+  // The anti-pattern:  for (...) { ... removeChild(...) }  with NO parentNode guard before removeChild.
+  //
+  // The fix is to check parentNode before calling removeChild, so that a re-entrant
+  // call (e.g. blur event during removeChild) that already removed the node does not
+  // cause a NotFoundError.
+  //
+  // Strategy: find the for-loop that iterates over existingItems and calls removeChild.
+  // Then check whether there is a parentNode or parentElement check in the loop body
+  // before the removeChild call.
+  const loopMatch = source.match(/for\s*\(\s*(?:var\s+)?(\w+)\s+in\s+existingItems\s*\)\s*\{([^}]*)\}/);
+  if (!loopMatch) {
+    this.renderGuardsRemoveChild = false;
+    return;
+  }
+  const loopBody = loopMatch[2];
+  const hasRemoveChild = /removeChild\s*\(/.test(loopBody);
+  if (!hasRemoveChild) {
+    this.renderGuardsRemoveChild = true; // no removeChild call → not vulnerable
+    return;
+  }
+  // Check if there's a parentNode or parentElement check before removeChild
+  // Look for: if (...) { ... removeChild(...) }  where the condition mentions parentNode/parentElement
+  // or: var x = ...; if (x.parentNode) { x.parentNode.removeChild(x); }
+  const hasParentGuard = /if\s*\([^)]*parentNode[^)]*\)/.test(loopBody) ||
+                         /if\s*\([^)]*parentElement[^)]*\)/.test(loopBody);
+  this.renderGuardsRemoveChild = hasParentGuard;
+});
+
+Then('the render function guards stale-node removal against re-entrant blur events', function () {
+  assert.ok(this.renderGuardsRemoveChild,
+    'FAIL: In a real browser, calling removeChild on a focused <li> triggers a blur ' +
+    'event synchronously on the edit input. The blur handler (captured on todoList) ' +
+    're-enters editTodo → render, which removes the same <li> again. ' +
+    'When control returns to the outer stale-removal loop, the node is no longer a child ' +
+    'of its parent, and removeChild throws NotFoundError.\n' +
+    'FIX: Guard every removeChild call in the stale-node removal loop with a parentNode check:\n' +
+    '  if (existingItems[id].parentNode) {\n' +
+    '    existingItems[id].parentNode.removeChild(existingItems[id]);\n' +
+    '  }\n' +
+    'This makes the operation idempotent under re-entrant blur.');
 });
