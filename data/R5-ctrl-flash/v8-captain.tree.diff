index 15b95ca..98a429d 100644
--- a/features/support/conformance-steps.js
+++ b/features/support/conformance-steps.js
@@ -224,4 +224,65 @@ Then('the render function reuses existing list-item elements for items that are
     'FIX: In the stale-removal loop, only `delete` items that are NOT in the filtered ' +
     'todo set. Keep items that should be preserved in the map so they can be reused ' +
     'and mutated in place instead of being recreated.');
+});
+
+// ---------------------------------------------------------------------------
+// Conformance: Event binding helper passes useCapture flag
+// ---------------------------------------------------------------------------
+
+Given('the project has an event binding helper function', function () {
+  const appPath = path.join(ROOT, 'js', 'app.js');
+  assert.ok(fs.existsSync(appPath), 'js/app.js not found');
+  const source = fs.readFileSync(appPath, 'utf8');
+  this.appSource = source;
+  // Check that a helper named 'on' exists and wraps addEventListener
+  const hasOnHelper = /function\s+on\s*\(/.test(source);
+  const hasAddEventListener = /addEventListener\s*\(/.test(source);
+  assert.ok(hasOnHelper && hasAddEventListener,
+    'Expected an event binding helper function that wraps addEventListener');
+});
+
+When('I check whether the helper passes the useCapture argument to addEventListener', function () {
+  const source = this.appSource;
+  // Detect whether the 'on' helper passes a capture flag to addEventListener.
+  //
+  // The BUG: function on(el, evt, fn) { el.addEventListener(evt, fn); }
+  // The `on` helper takes only 3 params and addEventListener has only 2 args,
+  // so the 4th useCapture argument is silently dropped.
+  //
+  // The FIX: function on(el, evt, fn, capture) { el.addEventListener(evt, fn, capture); }
+  // The helper takes a 4th param and addEventListener receives 3 args.
+  //
+  // Strategy: extract the function body of the `on` helper and check whether
+  // addEventListener is called with exactly 2 arguments (bug) or 3+ (fixed).
+  const onMatch = source.match(/function\s+on\s*\(([^)]*)\)\s*\{([^}]*)\}/);
+  if (!onMatch) {
+    this.onHelperHasCapture = false;
+    return;
+  }
+  const onBody = onMatch[2];
+  // Find addEventListener call inside the on body
+  const addEventListenerCall = onBody.match(/addEventListener\s*\(([^)]*)\)/);
+  if (!addEventListenerCall) {
+    this.onHelperHasCapture = false;
+    return;
+  }
+  const args = addEventListenerCall[1].split(',').map(function (a) { return a.trim(); });
+  // If addEventListener has 3 args, the third is the capture flag.
+  // If only 2 args, the capture flag is not passed.
+  this.onHelperHasCapture = args.length >= 3;
+});
+
+Then('the helper passes the useCapture flag to the native addEventListener', function () {
+  assert.ok(this.onHelperHasCapture,
+    'FAIL: The event binding helper function does NOT pass the useCapture/' +
+    'options argument to the native addEventListener. ' +
+    'The helper wraps addEventListener with only 2 arguments (event, handler), ' +
+    'silently dropping any capture flag the caller provides. ' +
+    'In a real browser, delegated handlers on non-bubbling events such as ' +
+    '"blur" never fire because the capture flag is lost. ' +
+    'The harness does not catch this because it dispatches synthetic events ' +
+    'with {bubbles: true}.\n' +
+    'FIX: Change the helper signature to accept and forward a capture parameter: ' +
+    'function on(el, evt, fn, capture) { el.addEventListener(evt, fn, capture); }');
 });
