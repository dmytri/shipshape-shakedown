+- In `editTodo`, add a check at the top to return early if the todo no longer exists:
   ```javascript
-  if (existingItems[id].parentNode) {
-    existingItems[id].parentNode.removeChild(existingItems[id]);
+  function editTodo(id, newTitle) {
+    var todo = findTodo(id);
+    if (!todo) return;  // already removed — no-op under re-entrant blur
+    newTitle = newTitle.trim();
+    if (!newTitle) {
+      removeTodo(id);
+      return;
+    }
+    todo.title = newTitle;
+    store.save(todos);
+    render();
   }
   ```
