diff --git a/features/support/conformance-steps.js b/features/support/conformance-steps.js
index 7b4919b..15b95ca 100644
--- a/features/support/conformance-steps.js
+++ b/features/support/conformance-steps.js
@@ -150,4 +150,78 @@ Then('a completion toggle does not rebuild the list via innerHTML', function ()
     'FIX: When toggling completion, mutate the existing <li> node in place: ' +
     'add/remove the "completed" class on the parent <li>, toggle the checkbox .checked property, ' +
     'rather than calling render() which rebuilds the entire list.');
+});
+
+// ---------------------------------------------------------------------------
+// Conformance: Unconditional removeChild anti-pattern
+// ---------------------------------------------------------------------------
+
+When('I check whether the render function removes all existing list-item children unconditionally', function () {
+  const source = this.appSource;
+  // Detect the anti-pattern where ALL existing <li> children are removed from the DOM
+  // in a loop that has NO conditional guard (no if-statement before removeChild).
+  //
+  // The bug: for (var id in existingItems) {
+  //           existingItems[id].parentNode.removeChild(existingItems[id]);
+  //           delete existingItems[id];
+  //         }
+  //
+  // This removes EVERY child node unconditionally, even ones that should be kept.
+  //
+  // Look for a loop body that calls removeChild without a preceding if.
+  // We match:  for (...) {  ... removeChild( ...
+  // where there is NO 'if' keyword between '{' and 'removeChild'.
+  const unconditionaRemovePattern = /for\s*\([^{]*\)\s*\{[^{}]*removeChild\s*\(/s;
+  this.hasUnconditionalRemoveAll = unconditionaRemovePattern.test(source);
+});
+
+Then('the render function does not remove existing list-item children unless they are stale', function () {
+  assert.ok(!this.hasUnconditionalRemoveAll,
+    'FAIL: The render function removes ALL existing <li> children unconditionally. ' +
+    'This detaches every existing DOM node, causing Cypress "element detached from DOM" errors. ' +
+    'The code iterates over all existing list items and calls removeChild on each ' +
+    'without checking whether the item is still in the filtered todo list. ' +
+    'FIX: Only remove child nodes whose data-id is NOT in the current filtered set; ' +
+    'keep and mutate the rest in place (toggle class, update .checked, change textContent).');
+});
+
+// ---------------------------------------------------------------------------
+// Conformance: Always-creates-new-li anti-pattern
+// ---------------------------------------------------------------------------
+
+When('I check whether the render function creates new list-item elements for items that already exist', function () {
+  const source = this.appSource;
+  // Detect the anti-pattern where the render function deletes ALL items from the
+  // existing-items tracking map (using `delete existingItems[id]` in a loop) BEFORE
+  // the reuse loop runs. This means the `existingItems[t.id]` lookup always returns
+  // undefined, and createElement('li') is ALWAYS called — the reuse branch is dead code.
+  //
+  // The buggy pattern:
+  //   for (var id in existingItems) {
+  //     existingItems[id].parentNode.removeChild(existingItems[id]);
+  //     delete existingItems[id];   // map emptied
+  //   }
+  //   for (var i = ...) {
+  //     var li = existingItems[t.id]; // always undefined
+  //     if (li) { ... reuse ... }     // dead code
+  //     else { createElement('li') ... } // always runs
+  //   }
+  //
+  // We detect: a loop that calls `delete` on existingItems entries, destroying the
+  // tracking map, combined with createElement('li') later on.
+  const hasDeleteFromMap = /delete\s+existingItems\[/.test(source);
+  const hasCreateLi = /createElement\s*\(\s*['"]li['"]\s*\)/.test(source);
+  // Fail if the map is cleared by delete AND new li elements are created
+  // (meaning the reuse lookup can never succeed).
+  this.alwaysCreatesNewLis = hasDeleteFromMap && hasCreateLi;
+});
+
+Then('the render function reuses existing list-item elements for items that are already in the DOM', function () {
+  assert.ok(!this.alwaysCreatesNewLis,
+    'FAIL: The render function deletes all items from the existing-items tracking map ' +
+    'before the reuse loop, so existingItems[t.id] always returns undefined. ' +
+    'createElement("li") is always called — the reuse/update branch is dead code. ' +
+    'FIX: In the stale-removal loop, only `delete` items that are NOT in the filtered ' +
+    'todo set. Keep items that should be preserved in the map so they can be reused ' +
+    'and mutated in place instead of being recreated.');
 });
