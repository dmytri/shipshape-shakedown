diff --git a/features/support/conformance-steps.js b/features/support/conformance-steps.js
index 7b4919b..95bdcbc 100644
--- a/features/support/conformance-steps.js
+++ b/features/support/conformance-steps.js
@@ -150,4 +150,107 @@ Then('a completion toggle does not rebuild the list via innerHTML', function ()
     'FIX: When toggling completion, mutate the existing <li> node in place: ' +
     'add/remove the "completed" class on the parent <li>, toggle the checkbox .checked property, ' +
     'rather than calling render() which rebuilds the entire list.');
+});
+
+// ---------------------------------------------------------------------------
+// Conformance: DOM identity — strong checks (source analysis)
+// ---------------------------------------------------------------------------
+
+When('I check whether the render function removes every child <li> before recreating them', function () {
+  const source = this.appSource;
+  // Detect the pattern where a loop over collected items unconditionally
+  // calls removeChild on every one.  The bug is:
+  //   for (var id in existingItems) {
+  //     existingItems[id].parentNode.removeChild(existingItems[id]);
+  //     delete existingItems[id];
+  //   }
+  // This removes ALL children, not only those absent from the filtered list.
+  // After the delete loop, existingItems is empty, so every item is recreated.
+  const hasRemoveChildLoop = (
+    /for\s*\([^)]*\bin\b[^)]*\)[^;]*removeChild/.test(source) ||
+    /removeChild\([^)]+\)\s*;\s*\n\s*delete/.test(source)
+  );
+  // Also check whether createElement appears after removeChild in render()
+  const hasCreateElementAfterRemove = (
+    /removeChild[^]*createElement/.test(source)
+  );
+  // Check if render() has an unconditional remove of all items followed by recreation
+  this.removesAllChildrenAndRecreates = hasRemoveChildLoop && hasCreateElementAfterRemove;
+});
+
+Then('the render function preserves existing <li> elements across state changes', function () {
+  assert.ok(!this.removesAllChildrenAndRecreates,
+    'FAIL: The render function removes ALL existing <li> elements from the DOM ' +
+    'before recreating them on every state change.  This is equivalent to an innerHTML rebuild ' +
+    'and destroys every browser-held element reference, causing Cypress ' +
+    '"element detached from DOM" errors.  ' +
+    'FIX: The stale-node removal loop must only remove <li> nodes whose IDs are ' +
+    'NOT present in the current filtered list, and the update loop must reuse existing nodes ' +
+    'in place by mutating classList, .checked, and textContent.');
+});
+
+When('I check whether a completion toggle rebuilds the list by detaching all nodes', function () {
+  const source = this.appSource;
+  // The render() function is called after every toggle.  If render() itself
+  // removes all children before recreating them, every toggle detaches all
+  // existing <li> nodes regardless of whether innerHTML is used.
+  // Check that the source has a toggle function AND it calls render() —
+  // the actual function name is toggleTodo in the current code.
+  const hasToggleFunction = /function\s+toggle/i.test(source);
+  const callsRenderFromToggle = /toggle[^}]*render\s*\(/.test(source);
+  // Check for the removeChild-all pattern inside the render function area
+  const hasRemoveChildAll = (
+    /for\s*\([^)]*\bin\b[^)]*\)[^;]*removeChild/.test(source) ||
+    /removeChild\([^)]+\)\s*;\s*\n\s*delete/.test(source)
+  );
+  this.toggleDetachesNodes = hasToggleFunction && callsRenderFromToggle && hasRemoveChildAll;
+});
+
+Then('a completion toggle does not detach and recreate any <li> elements', function () {
+  assert.ok(!this.toggleDetachesNodes,
+    'FAIL: A completion toggle causes a full detach-and-recreate cycle of all <li> ' +
+    'elements.  Even without innerHTML, the render() function removes every existing child ' +
+    'from the DOM and creates new nodes, invalidating all browser-held references.  ' +
+    'FIX: The stale-node removal loop must filter by the current filtered list, and the update ' +
+    'loop must reuse existing <li> nodes by mutating them in place.');
+});
+
+// ---------------------------------------------------------------------------
+// Conformance: DOM identity — runtime checks (real element identity)
+// ---------------------------------------------------------------------------
+
+When('I capture the dataset.id of every todo-list li', function () {
+  this.capturedLiRefs = [];
+  const items = Array.from(this.document.querySelectorAll('.todo-list li'));
+  for (var i = 0; i < items.length; i++) {
+    this.capturedLiRefs.push({ ref: items[i], id: items[i].dataset.id });
+  }
+  assert.ok(this.capturedLiRefs.length > 0,
+    'Expected at least one todo-list li to capture');
+});
+
+Then('every original todo-list li remains in the DOM with its dataset.id unchanged', function () {
+  assert.ok(Array.isArray(this.capturedLiRefs) && this.capturedLiRefs.length > 0,
+    'No captured element references — did the previous step run?');
+  const currentItems = Array.from(this.document.querySelectorAll('.todo-list li'));
+  assert.strictEqual(currentItems.length, this.capturedLiRefs.length,
+    'Expected same number of todo-list li elements after state change. ' +
+    'Count changed from ' + this.capturedLiRefs.length + ' to ' + currentItems.length + '. ' +
+    'This indicates nodes were removed and recreated rather than mutated in place.');
+  for (var i = 0; i < this.capturedLiRefs.length; i++) {
+    // Check element REFERENCE identity: the same object must still be in the DOM.
+    // If render() removed all children and created new ones, the old references
+    // will point to detached nodes and will NOT match any current DOM node.
+    const stillInDom = currentItems.indexOf(this.capturedLiRefs[i].ref) !== -1;
+    assert.ok(stillInDom,
+      'The <li> element at index ' + i + ' (id=' + this.capturedLiRefs[i].id + ') ' +
+      'was DESTROYED and replaced with a new element after the state change. ' +
+      'In a real browser, the old reference would be "detached from DOM". ' +
+      'FIX: The render() function must mutate existing <li> elements in place ' +
+      'instead of calling removeChild on all of them and creating new ones.');
+    // Also verify the dataset.id is still correct on the surviving element
+    assert.strictEqual(this.capturedLiRefs[i].ref.dataset.id, this.capturedLiRefs[i].id,
+      'dataset.id on the surviving element at index ' + i + ' changed from "' +
+      this.capturedLiRefs[i].id + '" to "' + this.capturedLiRefs[i].ref.dataset.id + '".');
+  }
 });
