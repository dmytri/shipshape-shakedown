+const { setWorldConstructor, setDefaultTimeout } = require('@cucumber/cucumber');
+const { Window } = require('happy-dom');
+const fs = require('fs');
+const path = require('path');
+
+const HTML_TEMPLATE = `<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Template • TodoMVC</title>
+  </head>
+  <body>
+    <section class="todoapp">
+      <header class="header">
+        <h1>todos</h1>
+        <input class="new-todo" placeholder="What needs to be done?" autofocus>
+      </header>
+      <section class="main" style="display:none">
+        <input id="toggle-all" class="toggle-all" type="checkbox">
+        <label for="toggle-all">Mark all as complete</label>
+        <ul class="todo-list"></ul>
+      </section>
+      <footer class="footer" style="display:none">
+        <span class="todo-count"><strong>0</strong> item left</span>
+        <ul class="filters">
+          <li><a class="selected" href="#/">All</a></li>
+          <li><a href="#/active">Active</a></li>
+          <li><a href="#/completed">Completed</a></li>
+        </ul>
+        <button class="clear-completed" style="display:none">Clear completed</button>
+      </footer>
+    </section>
+  </body>
+</html>`;
+
+class TodoWorld {
+  constructor() {
+    this.window = null;
+    this._savedStorage = null;
+    this.reset();
+  }
+
+  reset() {
+    // Save localStorage before creating a new window
+    if (this.window) {
+      this._savedStorage = {};
+      for (var i = 0; i < this.window.localStorage.length; i++) {
+        var key = this.window.localStorage.key(i);
+        this._savedStorage[key] = this.window.localStorage.getItem(key);
+      }
+    }
+
+    this.window = new Window();
+    const document = this.window.document;
+    document.write(HTML_TEMPLATE);
+    document.close();
+
+    // Restore localStorage from previous window
+    if (this._savedStorage) {
+      for (var key in this._savedStorage) {
+        if (this._savedStorage.hasOwnProperty(key)) {
+          this.window.localStorage.setItem(key, this._savedStorage[key]);
+        }
+      }
+    }
+
+    // Load production code
+    var appJsPath = path.join(__dirname, '..', '..', 'js', 'app.js');
+    try {
+      var appCode = fs.readFileSync(appJsPath, 'utf8');
+      this.window.eval(appCode);
+    } catch (e) {
+      console.error('Failed to load app.js:', e.message);
+    }
+  }
+
+  get document() {
+    return this.window.document;
+  }
+
+  /**
+   * Helper: create a todo item as a DOM element and add it to the list.
+   * Returns the created <li> element.
+   */
+  addTodo(title, completed = false) {
+    const doc = this.document;
+    const li = doc.createElement('li');
+    if (completed) {
+      li.classList.add('completed');
+    }
+    li.dataset.id = Date.now() + '-' + Math.random().toString(36).slice(2, 8);
+
+    const view = doc.createElement('div');
+    view.classList.add('view');
+
+    const toggle = doc.createElement('input');
+    toggle.classList.add('toggle');
+    toggle.type = 'checkbox';
+    if (completed) {
+      toggle.checked = true;
+    }
+
+    const label = doc.createElement('label');
+    label.textContent = title;
+
+    const destroy = doc.createElement('button');
+    destroy.classList.add('destroy');
+
+    view.appendChild(toggle);
+    view.appendChild(label);
+    view.appendChild(destroy);
+    li.appendChild(view);
+
+    const editInput = doc.createElement('input');
+    editInput.classList.add('edit');
+    editInput.value = title;
+    li.appendChild(editInput);
+
+    const list = doc.querySelector('.todo-list');
+    list.appendChild(li);
+
+    this._updateMainFooterVisibility();
+    this._updateToggleAll();
+    this._updateTodoCount();
+    this._updateClearCompleted();
+    return li;
+  }
+
+  /**
+   * Remove all todos from the DOM.
+   */
+  clearTodos() {
+    const list = this.document.querySelector('.todo-list');
+    list.innerHTML = '';
+    this._updateMainFooterVisibility();
+    this._updateToggleAll();
+    this._updateTodoCount();
+    this._updateClearCompleted();
+  }
+
+  /**
+   * Get the number of todo items in the list.
+   */
+  getTodoCount() {
+    return this.document.querySelectorAll('.todo-list > li').length;
+  }
+
+  /**
+   * Get the number of active (non-completed) items.
+   */
+  getActiveCount() {
+    return this.document.querySelectorAll('.todo-list > li:not(.completed)').length;
+  }
+
+  /**
+   * Get the number of completed items.
+   */
+  getCompletedCount() {
+    return this.document.querySelectorAll('.todo-list > li.completed').length;
+  }
+
+  /**
+   * Show/hide main and footer based on whether there are any todos.
+   */
+  _updateMainFooterVisibility() {
+    const main = this.document.querySelector('.main');
+    const footer = this.document.querySelector('.footer');
+    const hasTodos = this.getTodoCount() > 0;
+    main.style.display = hasTodos ? '' : 'none';
+    footer.style.display = hasTodos ? '' : 'none';
+  }
+
+  /**
+   * Update the toggle-all checkbox state.
+   */
+  _updateToggleAll() {
+    const toggleAll = this.document.querySelector('.toggle-all');
+    const total = this.getTodoCount();
+    const completed = this.getCompletedCount();
+    if (total > 0) {
+      toggleAll.checked = total === completed;
+    } else {
+      toggleAll.checked = false;
+    }
+  }
+
+  /**
+   * Update the todo-count display.
+   */
+  _updateTodoCount() {
+    const count = this.getActiveCount();
+    const strong = this.document.querySelector('.todo-count strong');
+    strong.textContent = String(count);
+    const suffix = count === 1 ? 'item' : 'items';
+    const textNode = this.document.querySelector('.todo-count');
+    // Keep the text node after <strong>
+    const textContent = textNode.childNodes[1];
+    if (textContent) {
+      textContent.textContent = ` ${suffix} left`;
+    }
+  }
+
+  /**
+   * Show/hide the clear-completed button.
+   */
+  _updateClearCompleted() {
+    const btn = this.document.querySelector('.clear-completed');
+    btn.style.display = this.getCompletedCount() > 0 ? '' : 'none';
+  }
+
+  /**
+   * Get the currently visible (non-hidden) items, respecting filter.
+   */
+  getVisibleItems() {
+    const items = this.document.querySelectorAll('.todo-list > li');
+    const filter = this._getActiveFilter();
+    return Array.from(items).filter(li => {
+      if (filter === 'all') return true;
+      if (filter === 'active') return !li.classList.contains('completed');
+      if (filter === 'completed') return li.classList.contains('completed');
+      return true;
+    });
+  }
+
+  /**
+   * Get the active filter (all, active, completed).
+   */
+  _getActiveFilter() {
+    const selected = this.document.querySelector('.filters a.selected');
+    if (!selected) return 'all';
+    const href = selected.getAttribute('href');
+    if (href === '#/active') return 'active';
+    if (href === '#/completed') return 'completed';
+    return 'all';
+  }
+
+  /**
+   * Apply a filter (all, active, completed).
+   */
+  setFilter(filter) {
+    const links = this.document.querySelectorAll('.filters a');
+    links.forEach(a => {
+      const href = a.getAttribute('href');
+      let match = false;
+      if (filter === 'all' && (href === '#/' || href === '#/all')) match = true;
+      else if (filter === 'active' && href === '#/active') match = true;
+      else if (filter === 'completed' && href === '#/completed') match = true;
+      a.classList.toggle('selected', match);
+    });
+    // Save filter to localStorage so it persists on reload
+    const selected = this.document.querySelector('.filters a.selected');
+    if (selected) {
+      this.window.localStorage.setItem('todos-todomvc-filter', selected.getAttribute('href'));
+    }
+  }
+}
