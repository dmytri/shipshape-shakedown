+const { Given, When, Then, Before, setWorldConstructor } = require('@cucumber/cucumber');
+const { Window } = require('happy-dom');
+const fs = require('fs');
+const path = require('path');
+
+function CustomWorld({ attach, parameters }) {
+  this.attach = attach;
+  this.parameters = parameters;
+  this.window = null;
+  this.document = null;
+}
+setWorldConstructor(CustomWorld);
+
+function findTodo(doc, title) {
+  const list = doc.querySelector('.todo-list');
+  if (!list) return null;
+  return Array.from(list.querySelectorAll('li')).find(li => {
+    const label = li.querySelector('label');
+    return label && label.textContent.trim() === title;
+  });
+}
+
+function getVisibleTodos(doc) {
+  const list = doc.querySelector('.todo-list');
+  if (!list) return [];
+  return Array.from(list.querySelectorAll('li')).filter(li => li.style.display !== 'none');
+}
+
+function getTodos(doc) {
+  const list = doc.querySelector('.todo-list');
+  return list ? Array.from(list.querySelectorAll('li')) : [];
+}
+
+Before(function () {
+  const win = new Window();
+  const doc = win.document;
+  const htmlPath = path.join(__dirname, '..', '..', 'index.html');
+  try {
+    const html = fs.readFileSync(htmlPath, 'utf8');
+    doc.write(html);
+  } catch (e) {
+    doc.write('<!DOCTYPE html><html><body><p>Error</p></body></html>');
+  }
+  doc.close();
+  this.window = win;
+  this.document = doc;
+  global.window = win;
+  global.document = doc;
+  global.localStorage = win.localStorage;
+  global.location = win.location;
+  const appJsPath = path.join(__dirname, '..', '..', 'js', 'app.js');
+  try {
+    const appCode = fs.readFileSync(appJsPath, 'utf8');
+    new Function('window', 'document', 'localStorage', appCode)(win, doc, win.localStorage);
+  } catch (e) {}
+});
+
+function seedTodos(doc, win, items) {
+  win.localStorage.setItem('todos-vanillajs', JSON.stringify(items));
+  const appJsPath = path.join(__dirname, '..', '..', 'js', 'app.js');
+  try {
+    const appCode = fs.readFileSync(appJsPath, 'utf8');
+    new Function('window', 'document', 'localStorage', appCode)(win, doc, win.localStorage);
+  } catch (e) {}
+}
+
+function makeItems(titles, completedTitles) {
+  const completed = completedTitles || [];
+  return titles.map((title, i) => ({
+    id: String(i + 1), title: title, completed: completed.includes(title)
+  }));
+}
+
+// ----- Given -----
+Given('the TodoMVC app is loaded', function () {});
+Given('the todo list is empty', function () { this.window.localStorage.removeItem('todos-vanillajs'); });
+Given('the todo list has an item {string}', function (title) { seedTodos(this.document, this.window, makeItems([title])); });
+Given('the todo list has an item {string} that is not completed', function (title) { seedTodos(this.document, this.window, makeItems([title])); });
+Given('the todo list has a completed item {string}', function (title) { seedTodos(this.document, this.window, makeItems([title], [title])); });
+Given('the todo list has items {string}', function (list) { seedTodos(this.document, this.window, makeItems(list.split(', ').map(s => s.trim()))); });
+Given('the todo list has items {string}, {string}', function (i1, i2) { seedTodos(this.document, this.window, makeItems([i1, i2])); });
+Given('the todo list has items {string}, {string}, {string}', function (i1, i2, i3) { seedTodos(this.document, this.window, makeItems([i1, i2, i3])); });
+Given('{string} is completed', function (title) {
+  const items = JSON.parse(this.window.localStorage.getItem('todos-vanillajs') || '[]');
+  items.forEach(t => { if (t.title === title) t.completed = true; });
+  seedTodos(this.document, this.window, items);
+});
+Given('{string} is not completed', function (title) {
+  const items = JSON.parse(this.window.localStorage.getItem('todos-vanillajs') || '[]');
+  items.forEach(t => { if (t.title === title) t.completed = false; });
+  seedTodos(this.document, this.window, items);
+});
+Given('all todos are completed', function () {
+  const items = JSON.parse(this.window.localStorage.getItem('todos-vanillajs') || '[]');
+  items.forEach(t => { t.completed = true; });
+  seedTodos(this.document, this.window, items);
+});
+Given('the todo list has 1 active item {string}', function (title) { seedTodos(this.document, this.window, makeItems([title])); });
+Given('the active filter is selected', function () {
+  this.window.location.hash = '#/active';
+  this.window.dispatchEvent(new this.window.Event('hashchange'));
+});
+Given('the completed filter is selected', function () {
+  this.window.location.hash = '#/completed';
+  this.window.dispatchEvent(new this.window.Event('hashchange'));
+});
+Given('localStorage has a saved todo with title {string} that is not completed', function (title) {
+  this.window.localStorage.setItem('todos-vanillajs', JSON.stringify(makeItems([title])));
+});
+
+// ----- When -----
+When('the user types {string} into the new-todo input and presses Enter', function (text) {
+  const input = this.document.querySelector('.new-todo');
+  if (!input) return;
+  input.value = text;
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13 }));
+});
+When('the user clicks the toggle checkbox for {string}', function (title) {
+  const item = findTodo(this.document, title);
+  if (!item) return;
+  const toggle = item.querySelector('.toggle');
+  if (toggle) toggle.click();
+});
+When('the user clicks the destroy button for {string}', function (title) {
+  const item = findTodo(this.document, title);
+  if (!item) return;
+  const destroy = item.querySelector('.destroy');
+  if (destroy) destroy.click();
+});
+When('the user clicks the toggle-all checkbox', function () {
+  const toggleAll = this.document.querySelector('.toggle-all');
+  if (toggleAll) toggleAll.click();
+});
+When('the user completes {string}', function (title) {
+  const item = findTodo(this.document, title);
+  if (!item) return;
+  const toggle = item.querySelector('.toggle');
+  if (toggle) toggle.click();
+});
+When('the user uncompletes {string}', function (title) {
+  const item = findTodo(this.document, title);
+  if (!item) return;
+  const toggle = item.querySelector('.toggle');
+  if (toggle) toggle.click();
+});
+When('the user clicks the "Clear completed" button', function () {
+  const btn = this.document.querySelector('.clear-completed');
+  if (btn) btn.click();
+});
+When('the user deletes {string}', function (title) {
+  const item = findTodo(this.document, title);
+  if (!item) return;
+  const destroy = item.querySelector('.destroy');
+  if (destroy) destroy.click();
+});
+When('the user double-clicks the label for {string}', function (title) {
+  const item = findTodo(this.document, title);
+  if (!item) return;
+  const label = item.querySelector('label');
+  if (label) {
+    label.dispatchEvent(new this.window.MouseEvent('dblclick', { bubbles: true }));
+  }
+});
+When('the user types {string} into the edit input and presses Enter', function (text) {
+  const item = getTodos(this.document).find(li => li.classList.contains('editing'));
+  if (!item) return;
+  const input = item.querySelector('.edit');
+  if (!input) return;
+  input.value = text;
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13 }));
+});
+When('the user types {string} into the edit input and presses Tab', function (text) {
+  const item = getTodos(this.document).find(li => li.classList.contains('editing'));
+  if (!item) return;
+  const input = item.querySelector('.edit');
+  if (!input) return;
+  input.value = text;
+  input.dispatchEvent(new this.window.FocusEvent('blur'));
+});
+When('the user types {string} into the edit input and presses Escape', function (text) {
+  const item = getTodos(this.document).find(li => li.classList.contains('editing'));
+  if (!item) return;
+  const input = item.querySelector('.edit');
+  if (!input) return;
+  input.value = text;
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Escape', keyCode: 27 }));
+});
+When('the user clears the edit input and presses Enter', function () {
+  const item = getTodos(this.document).find(li => li.classList.contains('editing'));
+  if (!item) return;
+  const input = item.querySelector('.edit');
+  if (!input) return;
+  input.value = '';
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13 }));
+});
+When('the user clicks the {string} filter link', function (filter) {
+  const map = { 'All': '#/', 'Active': '#/active', 'Completed': '#/completed' };
+  const href = map[filter];
+  if (href) {
+    const link = this.document.querySelector('.filters a[href="' + href + '"]');
+    if (link) link.click();
+  }
+});
+When('the app loads with the default route', function () {
+  this.window.location.hash = '#/';
+  this.window.dispatchEvent(new this.window.Event('hashchange'));
+});
+When('the URL hash is set to {string}', function (hash) {
+  this.window.location.hash = hash;
+  this.window.dispatchEvent(new this.window.Event('hashchange'));
+});
+When('the app is reloaded', function () {
+  const list = this.document.querySelector('.todo-list');
+  if (list) list.innerHTML = '';
+  const filter = this.window.location.hash.replace('#/', '') || 'all';
+  const appJsPath = path.join(__dirname, '..', '..', 'js', 'app.js');
+  try {
+    const appCode = fs.readFileSync(appJsPath, 'utf8');
+    new Function('window', 'document', 'localStorage', appCode)(
+      this.window, this.document, this.window.localStorage
+    );
+    if (filter !== 'all') {
+      this.window.location.hash = '#/' + filter;
+      this.window.dispatchEvent(new this.window.Event('hashchange'));
+    }
+  } catch (e) {}
+});
+
+// ----- Then -----
+Then('the todo list shows {int} item with the title {string}', function (count, title) {
+  const items = getVisibleTodos(this.document);
+  if (items.length !== count) throw new Error('Expected ' + count + ' items, got ' + items.length);
+  const label = items[0].querySelector('label');
+  if (!label || label.textContent.trim() !== title) throw new Error('Expected "' + title + '"');
+});
+Then('the new-todo input is cleared', function () {
+  const input = this.document.querySelector('.new-todo');
+  if (input && input.value !== '') throw new Error('Input not empty');
+});
+Then('the todo list shows {int} item {string}', function (count, title) {
+  const items = getVisibleTodos(this.document);
+  if (items.length !== count) throw new Error('Expected ' + count + ' items, got ' + items.length);
+  if (title) {
+    const found = items.some(li => { const l = li.querySelector('label'); return l && l.textContent.trim() === title; });
+    if (!found) throw new Error('Item "' + title + '" not found');
+  }
+});
+Then('the todo list shows {int} item', function (count) {
+  const items = getVisibleTodos(this.document);
+  if (items.length !== count) throw new Error('Expected ' + count + ' items, got ' + items.length);
+});
+Then('the todo list shows {int} items', function (count) {
+  const items = getVisibleTodos(this.document);
+  if (items.length !== count) throw new Error('Expected ' + count + ' items, got ' + items.length);
+});
+Then('the todo list remains empty', function () {
+  if (getVisibleTodos(this.document).length !== 0) throw new Error('Expected 0 items');
+});
+Then('the item {string} has the completed class', function (title) {
+  const item = findTodo(this.document, title);
+  if (!item) throw new Error('Item "' + title + '" not found');
+  if (!item.classList.contains('completed')) throw new Error('Item "' + title + '" missing completed class');
+});
+Then('the item {string} does not have the completed class', function (title) {
+  const item = findTodo(this.document, title);
+  if (!item) throw new Error('Item "' + title + '" not found');
+  if (item.classList.contains('completed')) throw new Error('Item "' + title + '" has completed class');
+});
+Then('its toggle checkbox is checked', function () {
+  const items = getTodos(this.document);
+  const toggle = items[items.length - 1]?.querySelector('.toggle');
+  if (!toggle || !toggle.checked) throw new Error('Toggle not checked');
+});
+Then('its toggle checkbox is not checked', function () {
+  const items = getTodos(this.document);
+  const toggle = items[items.length - 1]?.querySelector('.toggle');
+  if (toggle && toggle.checked) throw new Error('Toggle is checked');
+});
+Then('every todo item has the completed class', function () {
+  const items = getTodos(this.document);
+  if (items.length > 0 && !items.every(li => li.classList.contains('completed'))) throw new Error('Not all completed');
+});
+Then('no todo item has the completed class', function () {
+  if (getTodos(this.document).some(li => li.classList.contains('completed'))) throw new Error('Some items completed');
+});
+Then('the toggle-all checkbox is not checked', function () {
+  const ta = this.document.querySelector('.toggle-all');
+  if (ta && ta.checked) throw new Error('Toggle-all is checked');
+});
+Then('the toggle-all checkbox is checked', function () {
+  const ta = this.document.querySelector('.toggle-all');
+  if (!ta || !ta.checked) throw new Error('Toggle-all is not checked');
+});
+Then('the item {string} has the editing class', function (title) {
+  const item = findTodo(this.document, title);
+  if (!item) throw new Error('Item "' + title + '" not found');
+  if (!item.classList.contains('editing')) throw new Error('Item "' + title + '" missing editing class');
+});
+Then('its edit input is focused', function () {});
+Then('the item {string} does not appear in the todo list', function (title) {
+  if (findTodo(this.document, title)) throw new Error('Item "' + title + '" still appears');
+});
+Then('the todo list shows {string}', function (title) {
+  const items = getVisibleTodos(this.document);
+  if (items.length !== 1) throw new Error('Expected 1 item, got ' + items.length);
+  const l = items[0].querySelector('label');
+  if (!l || l.textContent.trim() !== title) throw new Error('Expected "' + title + '"');
+});
+Then('the todo list shows {string} unchanged', function (title) {
+  if (!findTodo(this.document, title)) throw new Error('Item "' + title + '" not found');
+});
+Then('the item {string} does not have the editing class', function (title) {
+  const item = findTodo(this.document, title);
+  if (item && item.classList.contains('editing')) throw new Error('Item "' + title + '" has editing class');
+});
+Then('the todo list contains {string}', function (title) { if (!findTodo(this.document, title)) throw new Error('Not found'); });
+Then('the todo list does not contain {string}', function (title) { if (findTodo(this.document, title)) throw new Error('Found'); });
+Then('the "Clear completed" button is not visible', function () {
+  const btn = this.document.querySelector('.clear-completed');
+  if (btn && btn.style.display !== 'none') throw new Error('Clear completed button is visible');
+});
+Then('the "Clear completed" button is visible', function () {
+  const btn = this.document.querySelector('.clear-completed');
+  if (!btn || btn.style.display === 'none') throw new Error('Clear completed button is not visible');
+});
+Then('the todo-count shows {string}', function (text) {
+  const el = this.document.querySelector('.todo-count');
+  if (!el) throw new Error('Todo count not found');
+  if (el.textContent.trim() !== text) throw new Error('Expected "' + text + '", got "' + el.textContent.trim() + '"');
+});
+Then('the {string} filter link has the selected class', function (name) {
+  const map = { 'All': '#/', 'Active': '#/active', 'Completed': '#/completed' };
+  const href = map[name];
+  if (!href) throw new Error('Unknown filter: ' + name);
+  const link = this.document.querySelector('.filters a[href="' + href + '"]');
+  if (!link) throw new Error('Filter link not found');
+  if (!link.classList.contains('selected')) throw new Error('Filter link "' + name + '" not selected');
+});
+Then('the {string} filter link does not have the selected class', function (name) {
+  const map = { 'All': '#/', 'Active': '#/active', 'Completed': '#/completed' };
+  const href = map[name];
+  if (!href) return;
+  const link = this.document.querySelector('.filters a[href="' + href + '"]');
+  if (link && link.classList.contains('selected')) throw new Error('Filter link "' + name + '" has selected');
+});
+Then('localStorage has a key matching {string} with an entry for {string}', function (prefix, title) {
+  const keys = Object.keys(this.window.localStorage);
+  const key = keys.find(k => k.startsWith(prefix));
+  if (!key) throw new Error('No key matching "' + prefix + '"');
+  const data = JSON.parse(this.window.localStorage.getItem(key));
+  if (!data.some(item => item.title === title)) throw new Error('Entry for "' + title + '" not found');
+});
+Then('localStorage does not contain an entry for {string}', function (title) {
+  const keys = Object.keys(this.window.localStorage);
+  const key = keys.find(k => k.startsWith('todos-'));
+  if (key) {
+    const data = JSON.parse(this.window.localStorage.getItem(key));
+    if (data.some(item => item.title === title)) throw new Error('Entry for "' + title + '" found');
+  }
+});
+Then('the localStorage entry for {string} contains an object with keys {string}, {string}, and {string}', function (prefix, k1, k2, k3) {
+  const keys = Object.keys(this.window.localStorage);
+  const key = keys.find(k => k.startsWith(prefix));
+  if (!key) throw new Error('No key matching "' + prefix + '"');
+  const data = JSON.parse(this.window.localStorage.getItem(key));
+  if (!Array.isArray(data) || data.length === 0) throw new Error('No items in localStorage');
+  const item = data[0];
+  if (item[k1] === undefined) throw new Error('Missing key "' + k1 + '"');
+  if (item[k2] === undefined) throw new Error('Missing key "' + k2 + '"');
+  if (item[k3] === undefined) throw new Error('Missing key "' + k3 + '"');
+});
+
+Then('{string} has the completed class', function (title) {
+  const item = findTodo(this.document, title);
+  if (!item) throw new Error('Item "' + title + '" not found');
+  if (!item.classList.contains('completed')) throw new Error('Item "' + title + '" missing completed class');
+});
