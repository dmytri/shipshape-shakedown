+(function (window, document, localStorage) {
+  'use strict';
+
+  var ENTER_KEY = 13;
+  var ESCAPE_KEY = 27;
+  var STORAGE_KEY = 'todos-vanillajs';
+
+  var todoApp = {
+    todos: [],
+    filter: 'all',
+
+    init: function () {
+      this.bindEvents();
+      this.loadFromStorage();
+      this.render();
+      this.setRoute();
+    },
+
+    bindEvents: function () {
+      var self = this;
+      var newTodo = document.querySelector('.new-todo');
+      var toggleAll = document.querySelector('.toggle-all');
+      var clearBtn = document.querySelector('.clear-completed');
+      var filters = document.querySelectorAll('.filters a');
+
+      newTodo.addEventListener('keydown', function (e) {
+        if (e.keyCode === ENTER_KEY) {
+          self.addTodo(this.value);
+        }
+      });
+
+      toggleAll.addEventListener('change', function () {
+        self.toggleAll(this.checked);
+      });
+
+      clearBtn.addEventListener('click', function () {
+        self.clearCompleted();
+      });
+
+      filters.forEach(function (a) {
+        a.addEventListener('click', function (e) {
+          e.preventDefault();
+          var hash = this.getAttribute('href').replace('#/', '') || 'all';
+          self.setFilter(hash);
+        });
+      });
+
+      document.querySelector('.todo-list').addEventListener('click', function (e) {
+        var target = e.target;
+        var li = target.closest('li');
+        if (!li) return;
+        var title = li.querySelector('label').textContent.trim();
+
+        if (target.classList.contains('toggle')) {
+          self.toggleComplete(title);
+        } else if (target.classList.contains('destroy')) {
+          self.deleteTodo(title);
+        }
+      });
+
+      document.querySelector('.todo-list').addEventListener('dblclick', function (e) {
