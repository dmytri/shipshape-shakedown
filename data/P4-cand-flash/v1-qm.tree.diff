diff --git a/features/support/when-steps.js b/features/support/when-steps.js
new file mode 100644
index 0000000..1cdacea
--- /dev/null
+++ b/features/support/when-steps.js
@@ -0,0 +1,242 @@
+const { When } = require('@cucumber/cucumber');
+const { findTodoLi, fireEvent } = require('./helpers');
+
+When('the user types {string} into the new-todo input', async function (text) {
+  const input = this.query('.new-todo');
+  if (input) {
+    input.value = text;
