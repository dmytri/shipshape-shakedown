diff --git a/features/support/helpers.js b/features/support/helpers.js
new file mode 100644
index 0000000..2558e45
--- /dev/null
+++ b/features/support/helpers.js
@@ -0,0 +1,16 @@
+function findTodoLi(world, title) {
+  const labels = world.queryAll('.todo-list li label');
+  for (const label of labels) {
+    if (label.textContent.trim() === title) {
+      return label.closest('li');
+    }
+  }
+  return null;
+}
+
+function fireEvent(world, el, eventName, options = {}) {
+  const event = new world.window.Event(eventName, { bubbles: true, cancelable: true, ...options });
+  el.dispatchEvent(event);
+}
+
+module.exports = { findTodoLi, fireEvent };
