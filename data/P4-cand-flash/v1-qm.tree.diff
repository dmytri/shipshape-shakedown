+const { Then } = require('@cucumber/cucumber');
+const { findTodoLi } = require('./helpers');
+
+function resolveSelector(sel) {
+  if (sel.startsWith('#')) {
+    return `${sel}, .${sel.slice(1)}`;
+  }
+  return sel;
+}
+
+function getVisibleCount(world) {
+  const items = world.queryAll('.todo-list li');
+  let count = 0;
+  for (const li of items) {
+    const style = world.window.getComputedStyle(li);
+    if (style.display !== 'none' && li.style.display !== 'none') {
+      count++;
+    }
+  }
+  return count;
+}
+
+function getVisibleLabels(world) {
+  const items = world.queryAll('.todo-list li');
+  const labels = [];
+  for (const li of items) {
+    const style = world.window.getComputedStyle(li);
+    if (style.display !== 'none' && li.style.display !== 'none') {
+      const label = li.querySelector('label');
+      if (label) labels.push(label.textContent.trim());
+    }
+  }
+  return labels;
+}
+
+// ============================================================
+// Section visibility
+// ============================================================
+Then('the {string} section is not visible', async function (sectionId) {
+  const selector = resolveSelector(sectionId);
+  const el = this.query(selector);
+  if (!el) throw new Error(`Section ${sectionId} not found`);
+  const style = this.window.getComputedStyle(el);
+  if (style.display !== 'none' && el.style.display !== 'none') {
+    throw new Error(`Expected ${sectionId} to be hidden but is visible`);
+  }
+});
+
+Then('the {string} section is visible', async function (sectionId) {
+  const selector = resolveSelector(sectionId);
+  const el = this.query(selector);
+  if (!el) throw new Error(`Section ${sectionId} not found`);
+  const style = this.window.getComputedStyle(el);
+  const isHidden = style.display === 'none' || el.style.display === 'none';
+  if (isHidden) {
+    throw new Error(`Expected ${sectionId} to be visible but is hidden`);
+  }
+});
+
+// ============================================================
+// Todo list presence
+// ============================================================
+Then('a new todo with the title {string} appears in the list', async function (title) {
+  const li = findTodoLi(this, title);
+  if (!li) throw new Error(`Todo "${title}" not found in list`);
+});
+
+Then('the new-todo input is cleared', async function () {
+  const input = this.query('.new-todo');
+  if (!input) throw new Error('New todo input not found');
+  if (input.value !== '') {
+    throw new Error(`Expected input to be cleared but got "${input.value}"`);
+  }
+});
+
+Then('no new todo is added to the list', async function () {
+  // App starts with empty list; check no NEW item was added
+  const items = this.queryAll('.todo-list li');
+  if (items.length !== 0) {
+    throw new Error(`Expected no items, but found ${items.length}`);
+  }
+});
+
+// ============================================================
+// Todo item state
+// ============================================================
+Then('the todo {string} has the {string} class on its list item', async function (title, className) {
+  const li = findTodoLi(this, title);
+  if (!li) throw new Error(`Todo "${title}" not found`);
+  if (!li.classList.contains(className)) {
+    throw new Error(`Todo "${title}" does not have class "${className}"`);
+  }
+});
+
+Then('{string} has the {string} class on its list item', async function (title, className) {
+  const li = findTodoLi(this, title);
+  if (!li) throw new Error(`Todo "${title}" not found`);
+  if (!li.classList.contains(className)) {
+    throw new Error(`Todo "${title}" does not have class "${className}"`);
+  }
+});
+
+Then('the todo {string} does not have the {string} class on its list item', async function (title, className) {
+  const li = findTodoLi(this, title);
+  if (!li) throw new Error(`Todo "${title}" not found`);
+  if (li.classList.contains(className)) {
+    throw new Error(`Todo "${title}" has class "${className}" but should not`);
+  }
+});
+
+Then('{string} does not have the {string} class', async function (title, className) {
+  const li = findTodoLi(this, title);
+  if (!li) throw new Error(`Todo "${title}" not found`);
+  if (li.classList.contains(className)) {
+    throw new Error(`Todo "${title}" has class "${className}" but should not`);
+  }
+});
+
+Then('each todo has the {string} class on its list item', async function (className) {
+  const items = this.queryAll('.todo-list li');
+  if (items.length === 0) throw new Error('No todos found');
+  for (const li of items) {
+    if (!li.classList.contains(className)) {
+      const label = li.querySelector('label');
+      throw new Error(`Todo "${label ? label.textContent : 'unknown'}" missing class "${className}"`);
+    }
+  }
+});
+
+Then('no todo has the {string} class', async function (className) {
+  const items = this.queryAll('.todo-list li');
+  for (const li of items) {
+    if (li.classList.contains(className)) {
+      const label = li.querySelector('label');
+      throw new Error(`Todo "${label ? label.textContent : 'unknown'}" has class "${className}" but should not`);
+    }
+  }
+});
+
+// ============================================================
+// Checkbox state
+// ============================================================
+Then('the {string} checkbox is checked', async function (checkboxId) {
+  const cb = this.query(`#${checkboxId}`);
+  if (!cb) throw new Error(`Checkbox #${checkboxId} not found`);
+  if (!cb.checked) throw new Error(`Expected checkbox #${checkboxId} to be checked`);
+});
+
+Then('the {string} checkbox is unchecked', async function (checkboxId) {
+  const cb = this.query(`#${checkboxId}`);
+  if (!cb) throw new Error(`Checkbox #${checkboxId} not found`);
+  if (cb.checked) throw new Error(`Expected checkbox #${checkboxId} to be unchecked`);
+});
+
+Then('the {string} checkbox is not checked', async function (checkboxId) {
+  const cb = this.query(`#${checkboxId}`);
+  if (!cb) throw new Error(`Checkbox #${checkboxId} not found`);
+  if (cb.checked) throw new Error(`Expected checkbox #${checkboxId} to not be checked`);
+});
+
+// ============================================================
+// List content
+// ============================================================
+Then('the todo list contains exactly {string}', async function (title) {
+  const items = this.queryAll('.todo-list li');
+  if (items.length !== 1) {
+    throw new Error(`Expected exactly 1 todo, found ${items.length}`);
+  }
+  const label = items[0].querySelector('label');
+  if (!label || label.textContent.trim() !== title) {
+    throw new Error(`Expected todo title "${title}" but got "${label ? label.textContent.trim() : 'none'}"`);
+  }
+});
+
+Then('the todo list is empty', async function () {
+  const items = this.queryAll('.todo-list li');
+  if (items.length !== 0) {
+    throw new Error(`Expected todo list to be empty but found ${items.length} items`);
+  }
+});
+
+// ============================================================
+// Button visibility
+// ============================================================
+Then('the {string} button is hidden', async function (buttonName) {
+  let btn;
+  if (buttonName === 'Clear completed') btn = this.query('.clear-completed');
+  if (!btn) throw new Error(`Button "${buttonName}" not found`);
+  const style = this.window.getComputedStyle(btn);
+  if (style.display !== 'none' && btn.style.display !== 'none') {
+    throw new Error(`Expected "${buttonName}" button to be hidden`);
+  }
+});
+
+Then('the {string} button is not visible', async function (buttonName) {
+  let btn;
+  if (buttonName === 'Clear completed') btn = this.query('.clear-completed');
+  if (!btn) throw new Error(`Button "${buttonName}" not found`);
+  const style = this.window.getComputedStyle(btn);
+  if (style.display !== 'none' && btn.style.display !== 'none') {
+    throw new Error(`Expected "${buttonName}" button not to be visible`);
+  }
+});
+
+// ============================================================
+// Counter
+// ============================================================
+Then('the todo-count displays {string}', async function (expectedHtml) {
+  const countEl = this.query('.todo-count');
+  if (!countEl) throw new Error('todo-count element not found');
+  const actualHtml = countEl.innerHTML.trim();
+  if (actualHtml !== expectedHtml) {
+    throw new Error(`Expected todo-count innerHTML "${expectedHtml}" but got "${actualHtml}"`);
+  }
+});
+
+// ============================================================
+// Editing
+// ============================================================
+Then("the todo's list item has the {string} class", async function (className) {
+  const editing = this.query(`.todo-list li.${className}`);
+  if (!editing) {
+    throw new Error(`No list item with class "${className}" found`);
+  }
+});
+
+Then('the edit input is focused and contains the title {string}', async function (title) {
+  const editInput = this.query('.todo-list li.editing .edit');
+  if (!editInput) throw new Error('No edit input found in editing mode');
+  if (this.document.activeElement !== editInput) {
+    throw new Error('Edit input is not focused');
+  }
+  if (editInput.value !== title) {
+    throw new Error(`Expected edit input to contain "${title}" but got "${editInput.value}"`);
+  }
+});
+
+Then('the todo title is {string}', async function (expectedTitle) {
+  const labels = this.queryAll('.todo-list li label');
+  for (const label of labels) {
+    if (label.textContent.trim() === expectedTitle) {
+      return;
+    }
+  }
+  throw new Error(`Todo with title "${expectedTitle}" not found`);
+});
+
+Then("the todo's list item does not have the {string} class", async function (className) {
+  const items = this.queryAll(`.todo-list li.${className}`);
+  if (items.length > 0) {
+    throw new Error(`Expected no items with class "${className}" but found ${items.length}`);
+  }
+});
+
+Then('the todo title remains {string}', async function (expectedTitle) {
+  const labels = this.queryAll('.todo-list li label');
+  for (const label of labels) {
+    if (label.textContent.trim() === expectedTitle) {
+      return;
+    }
+  }
+  throw new Error(`Todo with title "${expectedTitle}" not found`);
+});
+
+Then('no list item has the {string} class', async function (className) {
+  const items = this.queryAll(`.todo-list li.${className}`);
+  if (items.length > 0) {
+    throw new Error(`Expected no items with class "${className}" but found ${items.length}`);
+  }
+});
+
+// ============================================================
+// Filtering
+// ============================================================
+Then('the todo list shows {int} items', async function (count) {
+  const c = getVisibleCount(this);
+  if (c !== count) {
+    throw new Error(`Expected ${count} visible items but found ${c}`);
+  }
+});
+
+Then('the todo list shows {int} item', async function (count) {
+  const c = getVisibleCount(this);
+  if (c !== count) {
+    throw new Error(`Expected ${count} visible items but found ${c}`);
+  }
+});
+
+Then('the {string} filter link has the {string} class', async function (filterName, className) {
+  const filters = this.queryAll('.filters a');
+  let href;
+  if (filterName === 'All') href = '#/';
+  else if (filterName === 'Active') href = '#/active';
+  else if (filterName === 'Completed') href = '#/completed';
+  let found = false;
+  for (const a of filters) {
+    if (a.getAttribute('href') === href) {
+      if (a.classList.contains(className)) {
+        found = true;
+      } else {
+        throw new Error(`Filter "${filterName}" link does not have class "${className}"`);
+      }
+    }
+  }
+  if (!found) throw new Error(`Filter "${filterName}" link not found`);
+});
+
+Then('the items are {string} and {string}', async function (item1, item2) {
+  const labels = getVisibleLabels(this);
+  const expected = [item1, item2];
+  if (JSON.stringify(labels) !== JSON.stringify(expected)) {
+    throw new Error(`Expected visible items [${expected}] but got [${labels}]`);
+  }
+});
+
+Then('the item is {string}', async function (item) {
+  const labels = getVisibleLabels(this);
+  if (labels.length !== 1 || labels[0] !== item) {
+    throw new Error(`Expected single visible item "${item}" but got [${labels}]`);
+  }
+});
+
+Then('the todo {string} is removed from the visible list', async function (title) {
+  const li = findTodoLi(this, title);
+  if (!li) return; // already removed
+  const style = this.window.getComputedStyle(li);
+  if (style.display !== 'none' && li.style.display !== 'none') {
+    throw new Error(`Todo "${title}" is still visible`);
+  }
+});
+
+Then('the visible list shows only {string}', async function (item) {
+  const labels = getVisibleLabels(this);
+  if (labels.length !== 1 || labels[0] !== item) {
+    throw new Error(`Expected visible list to show only "${item}" but got [${labels}]`);
+  }
+});
+
+Then('the todo list shows only {string}', async function (item) {
+  const labels = getVisibleLabels(this);
+  if (labels.length !== 1 || labels[0] !== item) {
+    throw new Error(`Expected todo list to show only "${item}" but got [${labels}]`);
+  }
+});
+
+Then('the visible list shows no items', async function () {
+  const c = getVisibleCount(this);
+  if (c !== 0) {
+    throw new Error(`Expected no visible items but found ${c}`);
+  }
+});
+
+Then('the todo list shows only {string} and {string}', async function (item1, item2) {
+  const labels = getVisibleLabels(this);
+  const expected = [item1, item2];
+  if (JSON.stringify(labels) !== JSON.stringify(expected)) {
+    throw new Error(`Expected visible items [${expected}] but got [${labels}]`);
+  }
+});
