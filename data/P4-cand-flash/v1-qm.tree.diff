+const { Given } = require('@cucumber/cucumber');
+const { findTodoLi, fireEvent } = require('./helpers');
+
+// ============================================================
+// Background
+// ============================================================
+Given('the app is loaded in a browser', async function () {
+  // Handled by world.js Before hook
+});
+
+// ============================================================
+// Given steps for todo management
+// ============================================================
+Given('no todos exist', async function () {
+  const list = this.query('.todo-list');
+  if (list) list.innerHTML = '';
+  this._hideMainAndFooter();
+  this._updateCounter();
+  const toggleAll = this.query('.toggle-all');
+  if (toggleAll) toggleAll.checked = false;
+});
+
+Given('the input field is focused', async function () {
+  const input = this.query('.new-todo');
+  if (input) input.focus();
+});
+
+Given('the todo list contains {string}', async function (title) {
+  await this._setupTodoList([title]);
+});
+
+Given('the todo list contains {string}, {string}', async function (title1, title2) {
+  await this._setupTodoList([title1, title2]);
+});
+
+Given('the todo list contains {string} and {string}', async function (title1, title2) {
+  await this._setupTodoList([title1, title2]);
+});
+
+Given('the todo list contains {string}, {string}, and {string}', async function (t1, t2, t3) {
+  await this._setupTodoList([t1, t2, t3]);
+});
+
+Given('the todo list contains a completed todo {string}', async function (title) {
+  const list = this.query('.todo-list');
+  if (!list) return;
+  list.innerHTML = '';
+  const main = this.query('.main');
+  if (main) main.style.display = '';
+  const footer = this.query('.footer');
+  if (footer) footer.style.display = '';
+
+  const li = this.document.createElement('li');
+  li.className = 'completed';
+  li.innerHTML = `<div class="view">
+    <input class="toggle" type="checkbox" checked>
+    <label>${title}</label>
+    <button class="destroy"></button>
+  </div>
+  <input class="edit" value="${title}">`;
+  list.appendChild(li);
+  this._updateCounter();
+});
+
+Given('all todos are completed', async function () {
+  const items = this.queryAll('.todo-list li');
+  for (const li of items) {
+    li.classList.add('completed');
+    const toggle = li.querySelector('.toggle');
+    if (toggle) toggle.checked = true;
+  }
+  const toggleAll = this.query('.toggle-all');
+  if (toggleAll) toggleAll.checked = true;
+  this._updateCounter();
+});
+
+Given('{string} and {string} are completed', async function (t1, t2) {
+  for (const t of [t1, t2]) {
+    const li = findTodoLi(this, t);
+    if (li) {
+      li.classList.add('completed');
+      const toggle = li.querySelector('.toggle');
+      if (toggle) toggle.checked = true;
+    }
+  }
+  this._updateCounter();
+});
+
+Given('no todos are completed', async function () {
+  const items = this.queryAll('.todo-list li');
+  for (const li of items) {
+    li.classList.remove('completed');
+    const toggle = li.querySelector('.toggle');
+    if (toggle) toggle.checked = false;
+  }
+  this._updateCounter();
+});
