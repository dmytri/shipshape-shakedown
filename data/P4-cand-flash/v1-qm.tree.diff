+const { setWorldConstructor, Before } = require('@cucumber/cucumber');
+const { Browser } = require('happy-dom');
+const { readFileSync } = require('fs');
+const { join } = require('path');
+
+class TodoWorld {
+  constructor() {
+    this.browser = null;
+    this.page = null;
+    this.document = null;
+    this.window = null;
+  }
+
+  async setupBrowser() {
+    if (this.browser) return;
+
+    this.browser = new Browser({
+      settings: {
+        disableCSSFileLoading: true,
+        disableJavaScriptFileLoading: false
+      }
+    });
+    const context = this.browser.defaultContext;
+    this.page = await context.newPage();
+
+    const htmlPath = join(__dirname, '..', '..', 'assets', 'app-template.index.html');
+    const html = readFileSync(htmlPath, 'utf8');
+    this.page.content = html;
+    await this._loadAppCode();
+
+    this.window = this.page.mainFrame.window;
+    this.document = this.window.document;
+  }
+
+  async _loadAppCode() {
+    const appPath = join(__dirname, '..', '..', 'js', 'app.js');
+    const appCode = readFileSync(appPath, 'utf8');
+    this.page.evaluate(appCode);
+    await this.page.waitUntilComplete();
+  }
+
+  async reloadPage() {
+    const htmlPath = join(__dirname, '..', '..', 'assets', 'app-template.index.html');
+    const html = readFileSync(htmlPath, 'utf8');
+    this.page.content = html;
+    await this._loadAppCode();
+    this.window = this.page.mainFrame.window;
+    this.document = this.window.document;
+  }
+
+  async closeBrowser() {
+    if (this.browser) {
+      await this.browser.close();
+      this.browser = null;
+      this.page = null;
+      this.document = null;
+      this.window = null;
+    }
+  }
+
+  query(selector) {
+    return this.document.querySelector(selector);
+  }
+
+  queryAll(selector) {
+    return this.document.querySelectorAll(selector);
+  }
+
+  _updateCounter() {
+    const activeItems = this.queryAll('.todo-list li:not(.completed)');
+    const count = activeItems.length;
+    const countEl = this.query('.todo-count');
+    if (countEl) {
+      countEl.innerHTML = `<strong>${count}</strong> ${count === 1 ? 'item' : 'items'} left`;
+    }
+  }
+
+  _updateToggleAll() {
+    const items = this.queryAll('.todo-list li');
+    const allCompleted = items.length > 0 && this.queryAll('.todo-list li:not(.completed)').length === 0;
+    const toggleAll = this.query('.toggle-all');
+    if (toggleAll) {
+      toggleAll.checked = allCompleted;
+    }
+  }
+
+  _hideMainAndFooter() {
+    const main = this.query('.main');
+    if (main) main.style.display = 'none';
+    const footer = this.query('.footer');
+    if (footer) footer.style.display = 'none';
+  }
+
+  _applyFilter() {
+    const hash = this.window.location.hash;
+    if (hash === '#/active') {
+      const items = this.queryAll('.todo-list li');
+      for (const li of items) {
+        li.style.display = li.classList.contains('completed') ? 'none' : '';
+      }
+    } else if (hash === '#/completed') {
+      const items = this.queryAll('.todo-list li');
+      for (const li of items) {
+        li.style.display = li.classList.contains('completed') ? '' : 'none';
+      }
+    } else {
+      const items = this.queryAll('.todo-list li');
+      for (const li of items) li.style.display = '';
+    }
+  }
+
+  async _setupTodoList(titles) {
+    const list = this.query('.todo-list');
+    if (!list) return;
+    list.innerHTML = '';
+    const main = this.query('.main');
+    if (main) main.style.display = '';
+    const footer = this.query('.footer');
+    if (footer) footer.style.display = '';
+    for (const t of titles) {
+      const li = this.document.createElement('li');
+      li.innerHTML = `<div class="view">
+        <input class="toggle" type="checkbox">
+        <label>${t}</label>
+        <button class="destroy"></button>
+      </div>
+      <input class="edit" value="${t}">`;
+      list.appendChild(li);
+    }
+    this._updateCounter();
+  }
+}
+
+setWorldConstructor(TodoWorld);
+
+Before(async function () {
+  await this.setupBrowser();
+});
