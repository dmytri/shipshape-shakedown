new file mode 100644
index 0000000..d7541a0
--- /dev/null
+++ b/features/support/filtering-given.js
@@ -0,0 +1,119 @@
+const { Given } = require('@cucumber/cucumber');
+const { findTodoLi, fireEvent } = require('./helpers');
+
+// ============================================================
+// Filtering & navigation Given steps
+// ============================================================
+Given('the active filter is selected', async function () {
+  this.window.location.hash = '#/active';
+  _applyFilterFromHash(this);
+});
+
+Given('the completed filter is selected', async function () {
+  this.window.location.hash = '#/completed';
+  _applyFilterFromHash(this);
+});
+
+Given('the URL hash is {string}', async function (hash) {
+  this.window.location.hash = hash;
+});
+
+Given('the user creates a todo titled {string}', async function (title) {
+  const input = this.query('.new-todo');
+  if (!input) return;
+  input.value = title;
+  // Simulate Enter key
+  const event = new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, bubbles: true });
+  input.dispatchEvent(event);
+});
+
+// ============================================================
+// Editing mode setup
+// ============================================================
+Given('the todo {string} is in editing mode', async function (title) {
+  const li = findTodoLi(this, title);
+  if (li) {
+    li.classList.add('editing');
+    const editInput = li.querySelector('.edit');
+    if (editInput) {
+      editInput.value = title;
+      editInput.focus();
+    }
+  }
+});
+
+Given('the user has changed the title to {string}', async function (newTitle) {
+  const editInput = this.query('.todo-list li.editing .edit');
+  if (editInput) {
+    editInput.value = newTitle;
+  }
+});
+
+Given('the user clears the edit input', async function () {
+  const editInput = this.query('.todo-list li.editing .edit');
+  if (editInput) {
+    editInput.value = '';
+  }
+});
+
+Given('the user clears completed todos', async function () {
+  const completed = this.queryAll('.todo-list li.completed');
+  for (const li of completed) li.remove();
+  if (this.queryAll('.todo-list li').length === 0) {
+    this._hideMainAndFooter();
+  }
+  this._updateCounter();
+});
+
+Given('the user changes the title of {string} to {string}', async function (oldTitle, newTitle) {
+  const li = findTodoLi(this, oldTitle);
+  if (li) {
+    const label = li.querySelector('label');
+    if (label) label.textContent = newTitle;
+    const editInput = li.querySelector('.edit');
+    if (editInput) editInput.value = newTitle;
+  }
+});
+
+function _applyFilterFromHash(world) {
+  const hash = world.window.location.hash;
+  // Reset display for all items
+  const items = world.queryAll('.todo-list li');
+  for (const li of items) {
+    li.style.display = '';
+  }
+  // Update filter link classes
+  const filters = world.queryAll('.filters a');
+  for (const a of filters) {
+    a.classList.remove('selected');
+  }
+  if (hash === '#/active') {
+    for (const li of items) {
+      if (li.classList.contains('completed')) {
+        li.style.display = 'none';
+      }
+    }
+    for (const a of filters) {
+      if (a.getAttribute('href') === '#/active') a.classList.add('selected');
+    }
+  } else if (hash === '#/completed') {
+    for (const li of items) {
+      if (!li.classList.contains('completed')) {
+        li.style.display = 'none';
+      }
+    }
+    for (const a of filters) {
+      if (a.getAttribute('href') === '#/completed') a.classList.add('selected');
+    }
+  } else {
+    // Default - all filter
+    for (const a of filters) {
+      if (a.getAttribute('href') === '#/') a.classList.add('selected');
+    }
+  }
+}
+
+Given('the user navigates to {string}', async function (hash) {
+  this.window.location.hash = hash;
+  _applyFilterFromHash(this);
+});
