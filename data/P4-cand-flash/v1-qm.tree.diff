+/* @planks("the app is loaded in a browser") */
+
+(function () {
+  'use strict';
+
+  var STORAGE_KEY = 'todos-vanillajs';
+
+  function loadTodos() {
+    try {
+      return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
+    } catch (e) {
+      return [];
+    }
+  }
+
+  function saveTodos(todos) {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
+  }
+
+  function getTodoStateFromDOM() {
+    var items = document.querySelectorAll('.todo-list li');
+    var todos = [];
+    for (var i = 0; i < items.length; i++) {
+      var li = items[i];
+      var label = li.querySelector('label');
+      var toggle = li.querySelector('.toggle');
+      if (label) {
+        todos.push({
+          title: label.textContent.trim(),
+          completed: li.classList.contains('completed')
+        });
+      }
+    }
+    return todos;
+  }
+
+  function renderTodos(todos) {
+    var list = document.querySelector('.todo-list');
+    if (!list) return;
+    list.innerHTML = '';
+    var filteredTodos = getFilteredTodos(todos);
+    for (var i = 0; i < filteredTodos.length; i++) {
+      var todo = filteredTodos[i];
+      var li = document.createElement('li');
+      if (todo.completed) li.classList.add('completed');
+      li.innerHTML =
+        '<div class="view">' +
+          '<input class="toggle" type="checkbox"' + (todo.completed ? ' checked' : '') + '>' +
+          '<label>' + todo.title.replace(/</g, '&lt;') + '</label>' +
+          '<button class="destroy"></button>' +
+        '</div>' +
+        '<input class="edit" value="' + todo.title.replace(/</g, '&lt;').replace(/"/g, '&quot;') + '">';
+      list.appendChild(li);
+    }
+    updateUIState(todos);
+  }
+
+  function getFilteredTodos(todos) {
+    var hash = window.location.hash || '#/';
+    if (hash === '#/active') {
+      return todos.filter(function (t) { return !t.completed; });
+    } else if (hash === '#/completed') {
+      return todos.filter(function (t) { return t.completed; });
+    }
+    return todos;
+  }
+
+  function updateUIState(todos) {
+    var main = document.querySelector('.main');
+    var footer = document.querySelector('.footer');
+    var clearBtn = document.querySelector('.clear-completed');
+    var todoCount = document.querySelector('.todo-count');
+    var toggleAll = document.querySelector('.toggle-all');
+
+    var hasTodos = todos.length > 0;
+    var completedCount = 0;
+    var activeCount = 0;
+    for (var i = 0; i < todos.length; i++) {
+      if (todos[i].completed) completedCount++;
+      else activeCount++;
+    }
+
+    if (main) main.style.display = hasTodos ? '' : 'none';
+    if (footer) footer.style.display = hasTodos ? '' : 'none';
+    if (clearBtn) clearBtn.style.display = completedCount > 0 ? '' : 'none';
+    if (todoCount) {
+      todoCount.innerHTML = '<strong>' + activeCount + '</strong> ' +
+        (activeCount === 1 ? 'item' : 'items') + ' left';
+    }
+    if (toggleAll) {
+      toggleAll.checked = hasTodos && completedCount === todos.length;
+    }
+
+    var filters = document.querySelectorAll('.filters a');
+    for (var j = 0; j < filters.length; j++) {
+      filters[j].classList.remove('selected');
+    }
+    var hash = window.location.hash || '#/';
+    var defaultHash = hash || '#/';
+    for (var k = 0; k < filters.length; k++) {
+      if (filters[k].getAttribute('href') === defaultHash) {
+        filters[k].classList.add('selected');
+      }
+    }
+  }
+
+  function syncState() {
+    var todos = getTodoStateFromDOM();
+    saveTodos(todos);
+    updateUIState(todos);
+  }
+
+  function init() {
+    var savedTodos = loadTodos();
+    if (savedTodos.length > 0) {
+      renderTodos(savedTodos);
+    } else {
+      // Clear template sample items
+      var list = document.querySelector('.todo-list');
+      if (list) list.innerHTML = '';
+      updateUIState([]);
+    }
+
+    // MutationObserver to detect DOM changes and sync to localStorage
+    var todoList = document.querySelector('.todo-list');
+    var todoapp = document.querySelector('.todoapp');
+    if (todoList) {
+      var observer = new MutationObserver(function () {
+        var todos = getTodoStateFromDOM();
+        saveTodos(todos);
+        updateUIState(todos);
+      });
+      observer.observe(todoList, {
+        childList: true,
+        subtree: true,
+        attributes: true,
+        attributeFilter: ['class']
+      });
+    }
+
+    // New todo input: Enter key
+    var newTodo = document.querySelector('.new-todo');
+    if (newTodo) {
+      newTodo.addEventListener('keydown', function (e) {
+        if (e.key === 'Enter' || e.keyCode === 13) {
+          var value = this.value.trim();
+          if (value === '') return;
+          var list = document.querySelector('.todo-list');
+          if (!list) return;
+          var li = document.createElement('li');
+          li.innerHTML =
+            '<div class="view">' +
+              '<input class="toggle" type="checkbox">' +
+              '<label>' + value.replace(/</g, '&lt;') + '</label>' +
+              '<button class="destroy"></button>' +
+            '</div>' +
+            '<input class="edit" value="' + value.replace(/</g, '&lt;').replace(/"/g, '&quot;') + '">';
+          list.appendChild(li);
+          this.value = '';
+          // Observer fires automatically
+        }
+      });
+    }
+
+    // Hash change
+    window.addEventListener('hashchange', function () {
+      var todos = loadTodos();
+      renderTodos(todos);
+    });
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', init);
+  } else {
+    init();
+  }
+})();
