+Then(
+  'the toggle control for todo {string} is not visible',
+  function (title) {
+    const li = todoWithTitle.call(this, title);
+    if (!li) throw new Error(`No todo found with title "${title}"`);
+    const viewDiv = li.querySelector('.view');
+    if (!viewDiv) throw new Error(`No .view div found for todo "${title}"`);
+    const style = this.window.getComputedStyle(viewDiv);
+    if (style.display !== 'none') {
+      throw new Error(
+        `Expected .view for todo "${title}" to be hidden (display: none) but found display: ${style.display}`
+      );
+    }
+  }
+);
+
+Then('all todo nodes remain the same DOM objects', function () {
+  if (!this._savedNodeRefs) throw new Error('No saved nodes to compare');
+  var currentNodes = todoItems.call(this);
+  if (this._savedNodeRefs.length !== currentNodes.length) {
+    throw new Error(
+      `Expected ${this._savedNodeRefs.length} nodes but found ${currentNodes.length}`
+    );
+  }
+  for (var i = 0; i < this._savedNodeRefs.length; i++) {
+    if (this._savedNodeRefs[i] !== currentNodes[i]) {
+      throw new Error(
+        `Node at position ${i} was destroyed and recreated (DOM identity changed)`
+      );
+    }
+  }
+});
