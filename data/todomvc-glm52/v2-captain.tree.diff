+// --- Row identity (stable rows across state changes) ---
+
+Given('I note the row element of the todo {string}', function (title) {
+  if (!this._notedRows) this._notedRows = {};
+  this._notedRows[title] = this.liFor(title);
+});
+
+Then('the todo {string} is in the same row element noted before', function (title) {
+  const noted = this._notedRows && this._notedRows[title];
+  assert(noted, 'no noted row element for "' + title + '"');
+  const current = this.liFor(title);
+  assert(
+    current === noted,
+    'row for "' + title + '" is a different element than the one noted before'
+  );
+});
+
+// --- Editing visibility ---
+
+Then('the toggle of the todo {string} is hidden', function (title) {
+  this.injectAppCss();
+  const toggle = this.liFor(title).querySelector('.toggle');
+  assert(toggle, 'no toggle for "' + title + '"');
+  assert.strictEqual(
+    this.window.getComputedStyle(toggle).display,
+    'none',
+    'toggle of "' + title + '" is not hidden by CSS'
+  );
+});
+
+Then('the destroy button of the todo {string} is hidden', function (title) {
+  this.injectAppCss();
+  const destroy = this.liFor(title).querySelector('.destroy');
+  assert(destroy, 'no destroy button for "' + title + '"');
+  assert.strictEqual(
+    this.window.getComputedStyle(destroy).display,
+    'none',
+    'destroy button of "' + title + '" is not hidden by CSS'
+  );
+});
+
 // --- Assertions: localStorage persistence ---
 
 Then('localStorage holds the key {string}', function (key) {
