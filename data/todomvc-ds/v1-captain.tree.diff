+{
+  "meta": {
+    "description": "Voyage 1: Build TodoMVC with vanilla JavaScript, localStorage persistence, and hash routing.",
+    "spec": "assets/app-spec.md",
+    "template": "assets/app-template.index.html"
+  },
+  "watches": [
+    {
+      "name": "01-bootstrap-structure",
+      "scenarios": [
+        "features/todo-management.feature:The main and footer sections are hidden when there are no todos"
+      ],
+      "target": "Create the index.html from template, css/app.css, and the js/app.js scaffold so the app renders with no todos and main/footer hidden."
+    },
+    {
+      "name": "02-create-todos",
+      "scenarios": [
+        "features/todo-management.feature:A user creates a new todo",
+        "features/todo-management.feature:A user cannot create an empty todo",
+        "features/todo-management.feature:Multiple todos are appended in order"
+      ],
+      "target": "Implement the new-todo input: capture Enter, trim, ignore empty, append to list, clear input."
+    },
+    {
+      "name": "03-toggle-complete",
+      "scenarios": [
+        "features/todo-management.feature:A user marks a single todo as completed",
+        "features/todo-management.feature:A user unmarks a completed todo",
+        "features/todo-management.feature:Mark all todos as completed",
+        "features/todo-management.feature:Toggle-all unchecks when all items are individually unchecked",
+        "features/todo-management.feature:Toggle-all checkbox updates when individual todos change"
+      ],
+      "target": "Implement per-item toggle, toggle-all, and cross-state sync between toggle-all and individual checkboxes."
+    },
+    {
+      "name": "04-clear-completed",
+      "scenarios": [
+        "features/todo-management.feature:Clear completed button removes completed todos",
+        "features/todo-management.feature:Clear completed button is hidden when no todos are completed",
+        "features/todo-management.feature:Clear completed button appears when a todo is completed"
+      ],
+      "target": "Implement clear-completed button: remove completed todos, show/hide based on completed count."
+    },
+    {
+      "name": "05-counter",
+      "scenarios": [
+        "features/todo-management.feature:Counter shows the number of active todos",
+        "features/todo-management.feature:Counter shows singular 'item' for one active todo",
+        "features/todo-management.feature:Counter shows '0 items left' when all todos are completed"
+      ],
+      "target": "Implement the todo-count display with correct pluralization and active count."
+    },
+    {
+      "name": "06-editing",
+      "scenarios": [
+        "features/todo-management.feature:A user enters edit mode by double-clicking a todo label",
+        "features/todo-management.feature:A user saves an edit by pressing Enter",
+        "features/todo-management.feature:A user saves an edit on blur",
+        "features/todo-management.feature:A user discards an edit by pressing Escape",
+        "features/todo-management.feature:A trimmed empty edit destroys the todo"
+      ],
+      "target": "Implement inline editing: double-click to enter, save on Enter/blur, discard on Escape, destroy on empty."
+    },
+    {
+      "name": "07-destroy",
+      "scenarios": [
+        "features/todo-management.feature:A user removes a todo by clicking the destroy button"
+      ],
+      "target": "Implement the destroy button on each todo item."
+    },
+    {
+      "name": "08-routing",
+      "scenarios": [
+        "features/todo-management.feature:The default route shows all todos",
+        "features/todo-management.feature:The active route shows only active todos",
+        "features/todo-management.feature:The completed route shows only completed todos",
+        "features/todo-management.feature:An item completed while in a filtered view is hidden",
+        "features/todo-management.feature:The selected filter is persisted on reload"
+      ],
+      "target": "Implement hash routing: #/ (all), #/active, #/completed with filter-link selection and list filtering."
+    },
+    {
+      "name": "09-persistence",
+      "scenarios": [
+        "features/todo-management.feature:Todos persist across page reloads",
+        "features/todo-management.feature:Completed state persists across reloads"
+      ],
+      "target": "Implement localStorage persistence with key 'todos-vanillajs', storing title/id/completed per item. Editing mode is not persisted."
+    }
+  ]
+}
