+const { setWorldConstructor } = require('@cucumber/cucumber');
+const { Window } = require('happy-dom');
+const fs = require('fs');
+const path = require('path');
+
+const HTML_TEMPLATE = fs.readFileSync(
+  path.join(__dirname, '..', '..', 'assets', 'app-template.index.html'),
+  'utf8'
+);
+
+class TodoWorld {
+  constructor() {
+    this.window = null;
+    this.document = null;
+    this.appScript = null;
+  }
+
+  setupWindow() {
+    if (this.window) {
+      this.window.close();
+    }
+
+    // Set up a base URL so relative paths resolve
+    const window = new Window({
+      url: 'http://localhost:3000/',
+      settings: {
+        fetch: {
+          disableSameOriginPolicy: true,
+        },
+      },
+    });
+
+    window.document.write(HTML_TEMPLATE);
+    window.document.close();
+
+    this.window = window;
+    this.document = window.document;
+  }
+
+  loadApp() {
+    // Load the app script - this registers on window.app or similar
+    try {
+      const appPath = path.join(__dirname, '..', '..', 'js', 'app.js');
+      if (fs.existsSync(appPath)) {
+        const appCode = fs.readFileSync(appPath, 'utf8');
+        this.window.eval(appCode);
+      }
+    } catch (e) {
+      // App not yet implemented - scenarios will fail red
+    }
+  }
+
+  getTodoList() {
+    const list = this.document.querySelector('.todo-list');
+    if (!list) return [];
+    return Array.from(list.children).filter(li => li.style.display !== 'none');
+  }
+
+  getVisibleTodos() {
+    return this.getTodoList().filter(li => {
+      // Items hidden by routing should have display:none
+      return !li.style.display || li.style.display !== 'none';
+    });
+  }
+
+  getTodoByTitle(title) {
+    return this.getVisibleTodos().find(li => {
+      const label = li.querySelector('label');
+      return label && label.textContent.trim() === title;
+    });
+  }
+
+  findTodoByTitle(title) {
+    // Search all items including hidden ones
+    const allItems = Array.from(this.document.querySelectorAll('.todo-list li'));
+    return allItems.find(li => {
+      const label = li.querySelector('label');
+      return label && label.textContent.trim() === title;
+    });
+  }
+
+  getTodoCount() {
+    return this.getVisibleTodos().length;
+  }
+
+  getTodoCountText() {
+    const el = this.document.querySelector('.todo-count');
+    return el ? el.textContent.trim() : '';
+  }
+
+  getNewTodoInput() {
+    return this.document.querySelector('.new-todo');
+  }
+
+  getEditInput(title) {
+    const todo = this.findTodoByTitle(title);
+    return todo ? todo.querySelector('.edit') : null;
+  }
+
+  getToggleCheckbox(title) {
+    const todo = this.findTodoByTitle(title);
+    return todo ? todo.querySelector('.toggle') : null;
+  }
+
+  getDestroyButton(title) {
+    const todo = this.findTodoByTitle(title);
+    return todo ? todo.querySelector('.destroy') : null;
+  }
+
+  getToggleAllCheckbox() {
+    return this.document.querySelector('#toggle-all');
+  }
+
+  getClearCompletedButton() {
+    return this.document.querySelector('.clear-completed');
+  }
+
+  getFilterLink(name) {
+    const links = this.document.querySelectorAll('.filters a');
+    return Array.from(links).find(a => a.textContent.trim() === name);
+  }
+
+  getMainSection() {
+    return this.document.querySelector('.main');
+  }
+
+  getFooterSection() {
+    return this.document.querySelector('.footer');
+  }
+
+  triggerEvent(el, eventName, options = {}) {
+    const event = this.window.document.createEvent('Event');
+    event.initEvent(eventName, true, true);
+    if (typeof options.keyCode !== 'undefined') {
+      event.keyCode = options.keyCode;
+    }
+    if (typeof options.key !== 'undefined') {
+      event.key = options.key;
+    }
+    el.dispatchEvent(event);
+  }
+
+  setHash(hash) {
+    this.window.location.hash = hash;
+    this.window.dispatchEvent(new this.window.Event('hashchange'));
+  }
+
+  getLocalStorage() {
+    return this.window.localStorage;
+  }
+
+  reloadPage() {
+    // Store localStorage state before reload
+    const storedData = {};
+    for (let i = 0; i < this.window.localStorage.length; i++) {
+      const key = this.window.localStorage.key(i);
+      storedData[key] = this.window.localStorage.getItem(key);
+    }
+
+    // Rebuild the window
+    this.setupWindow();
+
+    // Restore localStorage
+    for (const [key, value] of Object.entries(storedData)) {
+      this.window.localStorage.setItem(key, value);
+    }
+
+    // Reload the app
+    this.loadApp();
+  }
+
+  setLocalStorage(key, value) {
+    this.window.localStorage.setItem(key, value);
+  }
+
+  getLocalStorageKey(key) {
+    return this.window.localStorage.getItem(key);
+  }
+
+  getTodoFromStorage(title) {
+    for (let i = 0; i < this.window.localStorage.length; i++) {
+      const key = this.window.localStorage.key(i);
+      if (key.startsWith('todos-')) {
+        try {
+          const data = JSON.parse(this.window.localStorage.getItem(key));
+          if (Array.isArray(data)) {
+            return data.find(t => t && t.title === title);
+          }
+        } catch (e) {}
+      }
+    }
+    return null;
+  }
+
+  getTodosFromStorage() {
+    for (let i = 0; i < this.window.localStorage.length; i++) {
+      const key = this.window.localStorage.key(i);
+      if (key.startsWith('todos-')) {
+        try {
+          const data = JSON.parse(this.window.localStorage.getItem(key));
+          if (Array.isArray(data)) {
+            return data;
+          }
+        } catch (e) {}
+      }
+    }
+    return [];
+  }
+}
+
+setWorldConstructor(TodoWorld);
