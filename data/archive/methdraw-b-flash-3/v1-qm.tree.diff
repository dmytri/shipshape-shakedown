+ * @planks("the route is {string}")
+ * @planks("the filter link for {string} has class {string}")
+ * @planks("the filter link for {string} does not have class {string}")
+ * @planks("the toggle-all checkbox is checked")
+ * @planks("the toggle-all checkbox is not checked")
+ * @planks("I click the toggle-all checkbox")
+ * @planks("localStorage contains a todo with title {string} and completed false")
+ * @planks("localStorage contains a todo with title {string} and completed true")
+ * @planks("localStorage does not contain a todo with title {string}")
+ * @planks("localStorage has a key starting with {string}")
+ * @planks("localStorage has a stored todo with title {string} and completed false")
+ * @planks("Todos are restored from localStorage on page load")
+ * @planks("Editing mode is not persisted")
+ * @planks("Active filter persists on reload")
+ * @planks("Completed filter persists on reload")
+ * @planks("Mark all as complete marks every todo done")
+ * @planks("Toggle all from checked state marks every todo active")
+ */
+(function () {
+  'use strict';
+
+  var ENTER_KEY = 13;
+  var ESCAPE_KEY = 27;
+
+  var STORAGE_KEY = 'todos-vanilla';
+
+  var todoList = [];
+  var filter = 'all';
+
+  var newTodoInput = document.querySelector('.new-todo');
+  var todoListEl = document.querySelector('.todo-list');
+  var mainEl = document.querySelector('.main');
+  var footerEl = document.querySelector('.footer');
+  var todoCountEl = document.querySelector('.todo-count');
+  var clearCompletedBtn = document.querySelector('.clear-completed');
+  var toggleAllCheckbox = document.querySelector('#toggle-all');
+  var filterLinks = document.querySelectorAll('.filters a');
+
+  // Add ids for scenario selectors
+  if (mainEl) mainEl.id = 'main';
+  if (footerEl) footerEl.id = 'footer';
+
+  function loadTodos() {
+    try {
+      var stored = localStorage.getItem(STORAGE_KEY);
+      if (stored) {
+        todoList = JSON.parse(stored);
+      } else {
+        todoList = [];
+      }
+      var storedFilter = localStorage.getItem(STORAGE_KEY + ':filter');
+      if (storedFilter === 'active' || storedFilter === 'completed') {
+        filter = storedFilter;
+      } else {
+        filter = 'all';
+      }
+    } catch (e) {
+      todoList = [];
+      filter = 'all';
+    }
+  }
+
+  function saveTodos() {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(todoList));
+  }
+
+  function getFilteredTodos() {
+    if (filter === 'active') {
+      return todoList.filter(function (t) { return !t.completed; });
+    }
+    if (filter === 'completed') {
+      return todoList.filter(function (t) { return t.completed; });
+    }
+    return todoList;
+  }
+
+  function getActiveCount() {
+    return todoList.filter(function (t) { return !t.completed; }).length;
+  }
+
+  function getCompletedCount() {
+    return todoList.filter(function (t) { return t.completed; }).length;
+  }
+
+  function pluralize(count) {
+    return count === 1 ? 'item' : 'items';
+  }
+
+  function render() {
+    var filtered = getFilteredTodos();
+
+    // Update todo list
+    todoListEl.innerHTML = '';
+    filtered.forEach(function (todo) {
+      var li = document.createElement('li');
+      if (todo.completed) {
+        li.className = 'completed';
+      }
+
+      var viewDiv = document.createElement('div');
+      viewDiv.className = 'view';
+
+      var toggleCheckbox = document.createElement('input');
+      toggleCheckbox.className = 'toggle';
+      toggleCheckbox.type = 'checkbox';
+      toggleCheckbox.checked = todo.completed;
+      toggleCheckbox.addEventListener('change', function () {
+        todo.completed = toggleCheckbox.checked;
+        saveTodos();
+        render();
+      });
+
+      var label = document.createElement('label');
+      label.textContent = todo.title;
+      label.addEventListener('dblclick', function () {
+        editTodo(li, todo, label);
+      });
+
+      var destroyBtn = document.createElement('button');
+      destroyBtn.className = 'destroy';
+      destroyBtn.addEventListener('click', function () {
+        var idx = todoList.indexOf(todo);
+        if (idx !== -1) {
+          todoList.splice(idx, 1);
+          saveTodos();
+          render();
+        }
+      });
+
+      viewDiv.appendChild(toggleCheckbox);
+      viewDiv.appendChild(label);
+      viewDiv.appendChild(destroyBtn);
+
+      var editInput = document.createElement('input');
+      editInput.className = 'edit';
+      editInput.value = todo.title;
+
+      li.appendChild(viewDiv);
+      li.appendChild(editInput);
+      todoListEl.appendChild(li);
+    });
+
+    // Update toggle-all
+    var totalCount = todoList.length;
+    var completedCount = getCompletedCount();
+    toggleAllCheckbox.checked = totalCount > 0 && completedCount === totalCount;
+
+    // Update count
+    var activeCount = getActiveCount();
+    todoCountEl.innerHTML = '<strong>' + activeCount + '</strong> ' + pluralize(activeCount) + ' left';
+
+    // Show/hide main and footer
+    var hasTodos = todoList.length > 0;
+    mainEl.style.display = hasTodos ? 'block' : 'none';
+    footerEl.style.display = hasTodos ? 'block' : 'none';
+
+    // Show/hide clear-completed
+    clearCompletedBtn.style.display = completedCount > 0 ? 'block' : 'none';
+
+    // Update filter link classes
+    filterLinks.forEach(function (link) {
+      var href = link.getAttribute('href');
+      if ((filter === 'all' && href === '#/') ||
+          (filter === 'active' && href === '#/active') ||
+          (filter === 'completed' && href === '#/completed')) {
+        link.className = 'selected';
+      } else {
+        link.className = '';
+      }
+    });
+  }
+
+  function editTodo(li, todo, label) {
+    li.className = 'editing';
+    var editInput = li.querySelector('.edit');
+
+    function commitEdit() {
+      var val = editInput.value.trim();
+      if (val === '') {
+        var idx = todoList.indexOf(todo);
+        if (idx !== -1) {
+          todoList.splice(idx, 1);
+        }
+      } else {
+        todo.title = val;
+      }
+      saveTodos();
+      render();
+    }
+
+    function cancelEdit() {
+      render();
+    }
+
+    editInput.focus();
+    editInput.value = todo.title;
+
+    var onBlur = function () {
+      onBlurCleanup();
+      commitEdit();
+    };
+
+    function onBlurCleanup() {
+      editInput.removeEventListener('blur', onBlur);
+      editInput.removeEventListener('keydown', onKeydown);
+    }
+
+    function onKeydown(e) {
+      if (e.keyCode === ENTER_KEY) {
+        onBlurCleanup();
+        commitEdit();
+      } else if (e.keyCode === ESCAPE_KEY) {
+        onBlurCleanup();
+        cancelEdit();
+      }
+    }
+
+    editInput.addEventListener('blur', onBlur);
+    editInput.addEventListener('keydown', onKeydown);
+  }
+
+  function addTodo(title) {
+    title = title.trim();
+    if (title === '') return;
+    todoList.push({
+      id: Date.now(),
+      title: title,
+      completed: false
+    });
+    saveTodos();
+    render();
+  }
+
+  // Event listeners
+  newTodoInput.addEventListener('keyup', function (e) {
+    if (e.keyCode === ENTER_KEY) {
+      addTodo(newTodoInput.value);
+      newTodoInput.value = '';
+    }
+  });
+
+  toggleAllCheckbox.addEventListener('change', function () {
+    var checked = toggleAllCheckbox.checked;
+    todoList.forEach(function (t) { t.completed = checked; });
+    saveTodos();
+    render();
+  });
+
+  clearCompletedBtn.addEventListener('click', function () {
+    todoList = todoList.filter(function (t) { return !t.completed; });
+    saveTodos();
+    render();
+  });
+
+  // Routing
+  function handleHashChange() {
+    var hash = window.location.hash;
+    if (hash === '#/active') {
+      filter = 'active';
+    } else if (hash === '#/completed') {
+      filter = 'completed';
+    } else {
+      // On empty hash, restore persisted filter
+      var storedFilter = localStorage.getItem(STORAGE_KEY + ':filter');
+      if (storedFilter === 'active' || storedFilter === 'completed') {
+        filter = storedFilter;
+        // Set the hash to match the persisted filter
+        window.location.hash = filter === 'active' ? '#/active' : '#/completed';
+      } else {
+        filter = 'all';
+      }
+    }
+    localStorage.setItem(STORAGE_KEY + ':filter', filter);
+    render();
+  }
+
+  window.addEventListener('hashchange', handleHashChange);
+
+  // Initialize
+  loadTodos();
+  
+  // Ensure localStorage key exists even when empty
+  if (!localStorage.getItem(STORAGE_KEY)) {
+    saveTodos();
+  }
+  
+  // Focus input for autofocus scenario
+  newTodoInput.focus();
+  
+  handleHashChange();
+})();
