@@ -0,0 +1,383 @@
+const { Given, When, Then } = require('@cucumber/cucumber');
+const assert = require('assert');
+
+// ============ Given Steps ============
+
+Given('the page is loaded', function () {
+  assert.ok(this.document, 'Document must exist after page load');
+});
+
+Given('the todo list is empty', function () {
+  const todos = this.getTodoList();
+  assert.equal(todos.length, 0, 'Expected todo list to be empty');
+});
+
+Given('I create a todo with text {string}', function (title) {
+  const input = this.getNewTodoInput();
+  input.value = title;
+  this.triggerEvent(input, 'keyup', { keyCode: 13, key: 'Enter' });
+  const event = this.window.document.createEvent('Event');
+  event.initEvent('change', true, true);
+  input.dispatchEvent(event);
+});
+
+Given('I click the toggle checkbox for {string}', function (title) {
+  const checkbox = this.getToggleCheckbox(title);
+  assert.ok(checkbox, `Toggle checkbox for "${title}" not found`);
+  checkbox.click();
+});
+
+Given('I click the toggle-all checkbox', function () {
+  const checkbox = this.getToggleAllCheckbox();
+  assert.ok(checkbox, 'Toggle-all checkbox not found');
+  checkbox.click();
+});
+
+Given('I click {string}', function (text) {
+  const clearBtn = this.getClearCompletedButton();
+  if (clearBtn && clearBtn.textContent.trim() === text) {
+    clearBtn.click();
+    return;
+  }
+  const buttons = this.document.querySelectorAll('button');
+  const btn = Array.from(buttons).find(b => b.textContent.trim() === text);
+  assert.ok(btn, `Button with text "${text}" not found`);
+  btn.click();
+});
+
+Given('the route is {string}', function (route) {
+  this.setHash(route);
+});
+
+Given('localStorage has a stored todo with title {string} and completed false', function (title) {
+  let todosKey = null;
+  for (let i = 0; i < this.window.localStorage.length; i++) {
+    const key = this.window.localStorage.key(i);
+    if (key.startsWith('todos-')) {
+      todosKey = key;
+      break;
+    }
+  }
+  if (!todosKey) {
+    todosKey = 'todos-vanilla';
+  }
+  const todos = JSON.parse(this.window.localStorage.getItem(todosKey) || '[]');
+  todos.push({ id: Date.now(), title, completed: false });
+  this.window.localStorage.setItem(todosKey, JSON.stringify(todos));
+});
+
+// ============ When Steps ============
+
+When('I type {string} into the new-todo input', function (text) {
+  const input = this.getNewTodoInput();
+  assert.ok(input, 'New todo input not found');
+  input.value = text;
+  this.triggerEvent(input, 'input', {});
+});
+
+When('I press Enter', function () {
+  const input = this.getNewTodoInput();
+  assert.ok(input, 'New todo input not found');
+  this.triggerEvent(input, 'keydown', { keyCode: 13, key: 'Enter' });
+  this.triggerEvent(input, 'keyup', { keyCode: 13, key: 'Enter' });
+  this.triggerEvent(input, 'change', {});
+});
+
+When('I click the destroy button for {string}', function (title) {
+  const btn = this.getDestroyButton(title);
+  assert.ok(btn, `Destroy button for "${title}" not found`);
+  btn.click();
+});
+
+When('I double-click the label for {string}', function (title) {
+  const todo = this.findTodoByTitle(title);
+  assert.ok(todo, `Todo with title "${title}" not found`);
+  const label = todo.querySelector('label');
+  assert.ok(label, `Label for "${title}" not found`);
+  this.triggerEvent(label, 'dblclick', {});
+});
+
+When('I change the edit input to {string}', function (value) {
+  const editingItem = this.document.querySelector('.todo-list li.editing');
+  assert.ok(editingItem, 'No item in editing mode');
+  const editInput = editingItem.querySelector('.edit');
+  assert.ok(editInput, 'Edit input not found on editing item');
+  editInput.value = value;
+  this.triggerEvent(editInput, 'input', {});
+  this.triggerEvent(editInput, 'focus', {});
+});
+
+When('the edit input loses focus', function () {
+  const editingItem = this.document.querySelector('.todo-list li.editing');
+  assert.ok(editingItem, 'No item in editing mode');
+  const editInput = editingItem.querySelector('.edit');
+  assert.ok(editInput, 'Edit input not found');
+  this.triggerEvent(editInput, 'blur', {});
+});
+
+When('I press Enter in the edit input', function () {
+  const editingItem = this.document.querySelector('.todo-list li.editing');
+  assert.ok(editingItem, 'No item in editing mode');
+  const editInput = editingItem.querySelector('.edit');
+  assert.ok(editInput, 'Edit input not found');
+  this.triggerEvent(editInput, 'keydown', { keyCode: 13, key: 'Enter' });
+  this.triggerEvent(editInput, 'keyup', { keyCode: 13, key: 'Enter' });
+});
+
+When('I press Escape in the edit input', function () {
+  const editingItem = this.document.querySelector('.todo-list li.editing');
+  assert.ok(editingItem, 'No item in editing mode');
+  const editInput = editingItem.querySelector('.edit');
+  assert.ok(editInput, 'Edit input not found');
+  this.triggerEvent(editInput, 'keydown', { keyCode: 27, key: 'Escape' });
+  this.triggerEvent(editInput, 'keyup', { keyCode: 27, key: 'Escape' });
+});
+
+When('the page is reloaded', function () {
+  this.reloadPage();
+});
+
+// ============ Then Steps ============
+
+Then('{string} is not visible', function (selector) {
+  const el = this.document.querySelector(selector);
+  if (!el) {
+    return;
+  }
+  const style = this.window.getComputedStyle(el);
+  assert.equal(
+    style.display,
+    'none',
+    `Expected "${selector}" to be hidden, but display is "${style.display}"`
+  );
+});
+
+Then('{string} is visible', function (selector) {
+  const el = this.document.querySelector(selector);
+  assert.ok(el, `Expected "${selector}" to be visible, but element not found`);
+  const style = this.window.getComputedStyle(el);
+  assert.notEqual(
+    style.display,
+    'none',
+    `Expected "${selector}" to be visible, but display is "none"`
+  );
+});
+
+Then('the todo list contains {int} item', function (count) {
+  assert.equal(this.getTodoCount(), count, `Expected ${count} item(s) in todo list`);
+});
+
+Then('the todo list contains {int} items', function (count) {
+  assert.equal(this.getTodoCount(), count, `Expected ${count} item(s) in todo list`);
+});
+
+Then('the new item has title {string}', function (title) {
+  const todo = this.getTodoByTitle(title);
+  assert.ok(todo, `New item with title "${title}" not found`);
+});
+
+Then('the new item is not completed', function () {
+  const visibleTodos = this.getVisibleTodos();
+  assert.ok(visibleTodos.length > 0, 'No items to check');
+  const lastItem = visibleTodos[visibleTodos.length - 1];
+  assert.ok(
+    !lastItem.classList.contains('completed'),
+    'Item should not have completed class'
+  );
+});
+
+Then('the new-todo input is cleared', function () {
+  const input = this.getNewTodoInput();
+  assert.equal(input.value, '', 'Expected new-todo input to be cleared');
+});
+
+Then('the new-todo input has focus', function () {
+  const input = this.getNewTodoInput();
+  assert.ok(input, 'New-todo input not found');
+  assert.equal(
+    this.document.activeElement,
+    input,
+    'Expected new-todo input to be focused'
+  );
+});
+
+Then('the item {string} has class {string}', function (title, className) {
+  const todo = this.findTodoByTitle(title);
+  assert.ok(todo, `Todo with title "${title}" not found`);
+  assert.ok(
+    todo.classList.contains(className),
+    `Expected "${title}" to have class "${className}", got classes: ${Array.from(todo.classList).join(', ')}`
+  );
+});
+
+Then('the item {string} does not have class {string}', function (title, className) {
+  const todo = this.findTodoByTitle(title);
+  assert.ok(todo, `Todo with title "${title}" not found`);
+  assert.ok(
+    !todo.classList.contains(className),
+    `Expected "${title}" to NOT have class "${className}"`
+  );
+});
+
+Then('the toggle checkbox for {string} is checked', function (title) {
+  const checkbox = this.getToggleCheckbox(title);
+  assert.ok(checkbox, `Toggle checkbox for "${title}" not found`);
+  assert.ok(checkbox.checked, `Expected checkbox for "${title}" to be checked`);
+});
+
+Then('the toggle checkbox for {string} is not checked', function (title) {
+  const checkbox = this.getToggleCheckbox(title);
+  assert.ok(checkbox, `Toggle checkbox for "${title}" not found`);
+  assert.ok(!checkbox.checked, `Expected checkbox for "${title}" to not be checked`);
+});
+
+Then('the todo-count text is {string}', function (expected) {
+  assert.equal(this.getTodoCountText(), expected, 'Todo-count text does not match');
+});
+
+Then('the remaining item has title {string}', function (title) {
+  const todo = this.getTodoByTitle(title);
+  assert.ok(todo, `Remaining item with title "${title}" not found`);
+});
+
+Then('the remaining item is completed', function () {
+  const visibleTodos = this.getVisibleTodos();
+  assert.ok(visibleTodos.length > 0, 'No items to check');
+  const lastItem = visibleTodos[visibleTodos.length - 1];
+  assert.ok(
+    lastItem.classList.contains('completed'),
+    'Remaining item should have completed class'
+  );
+});
+
+Then('the clear-completed button is not visible', function () {
+  const btn = this.getClearCompletedButton();
+  if (!btn) {
+    return;
+  }
+  const style = this.window.getComputedStyle(btn);
+  if (style.display === 'none') {
+    return;
+  }
+  const footer = this.document.querySelector('.footer');
+  if (footer) {
+    const footerStyle = this.window.getComputedStyle(footer);
+    if (footerStyle.display === 'none') {
+      return;
+    }
+  }
+  assert.fail('Expected clear-completed button to be hidden');
+});
+
+Then('the clear-completed button is visible', function () {
+  const btn = this.getClearCompletedButton();
+  assert.ok(btn, 'Clear-completed button not found in DOM');
+  const style = this.window.getComputedStyle(btn);
+  assert.notEqual(style.display, 'none', 'Expected clear-completed button to be visible');
+});
+
+Then('the edit input for {string} is focused', function (title) {
+  const editInput = this.getEditInput(title);
+  assert.ok(editInput, `Edit input for "${title}" not found`);
+  assert.equal(
+    this.document.activeElement,
+    editInput,
+    `Expected edit input for "${title}" to be focused`
+  );
+});
+
+Then('the edit input for {string} contains {string}', function (title, value) {
+  const editInput = this.getEditInput(title);
+  assert.ok(editInput, `Edit input for "${title}" not found`);
+  assert.equal(editInput.value, value, `Edit input should contain "${value}"`);
+});
+
+Then('the edit input for {string} is not visible', function (title) {
+  const todo = this.findTodoByTitle(title);
+  if (!todo) {
+    return;
+  }
+  const editInput = todo.querySelector('.edit');
+  if (!editInput) {
+    return;
+  }
+  assert.ok(
+    !todo.classList.contains('editing'),
+    `Expected "${title}" to not be in editing mode`
+  );
+});
+
+Then('the item {string} does not exist', function (title) {
+  const todo = this.findTodoByTitle(title);
+  assert.ok(!todo, `Expected item "${title}" to not exist`);
+});
+
+Then('the item {string} has title {string}', function (title, expectedTitle) {
+  const todo = this.findTodoByTitle(title);
+  assert.ok(todo, `Todo with title "${title}" not found`);
+  const label = todo.querySelector('label');
+  assert.ok(label, `Label for "${title}" not found`);
+  assert.equal(label.textContent.trim(), expectedTitle, 'Title mismatch');
+});
+
+Then('localStorage contains a todo with title {string} and completed false', function (title) {
+  const todos = this.getTodosFromStorage();
+  const todo = todos.find(t => t && t.title === title);
+  assert.ok(todo, `Todo "${title}" not found in localStorage`);
+  assert.equal(todo.completed, false, `Expected "${title}" to have completed=false`);
+});
+
+Then('localStorage contains a todo with title {string} and completed true', function (title) {
+  const todos = this.getTodosFromStorage();
+  const todo = todos.find(t => t && t.title === title);
+  assert.ok(todo, `Todo "${title}" not found in localStorage`);
+  assert.equal(todo.completed, true, `Expected "${title}" to have completed=true`);
+});
+
+Then('localStorage does not contain a todo with title {string}', function (title) {
+  const todos = this.getTodosFromStorage();
+  const todo = todos.find(t => t && t.title === title);
+  assert.ok(!todo, `Todo "${title}" should not be in localStorage`);
+});
+
+Then('localStorage has a key starting with {string}', function (prefix) {
+  let found = false;
+  for (let i = 0; i < this.window.localStorage.length; i++) {
+    const key = this.window.localStorage.key(i);
+    if (key.startsWith(prefix)) {
+      found = true;
+      break;
+    }
+  }
+  assert.ok(found, `Expected localStorage key starting with "${prefix}"`);
+});
+
+Then('the filter link for {string} has class {string}', function (linkName, className) {
+  const link = this.getFilterLink(linkName);
+  assert.ok(link, `Filter link "${linkName}" not found`);
+  assert.ok(
+    link.classList.contains(className),
+    `Expected filter link "${linkName}" to have class "${className}"`
+  );
+});
+
+Then('the filter link for {string} does not have class {string}', function (linkName, className) {
+  const link = this.getFilterLink(linkName);
+  assert.ok(link, `Filter link "${linkName}" not found`);
+  assert.ok(
+    !link.classList.contains(className),
+    `Expected filter link "${linkName}" to NOT have class "${className}"`
+  );
+});
+
+Then('the toggle-all checkbox is checked', function () {
+  const checkbox = this.getToggleAllCheckbox();
+  assert.ok(checkbox, 'Toggle-all checkbox not found');
+  assert.ok(checkbox.checked, 'Expected toggle-all checkbox to be checked');
+});
+
+Then('the toggle-all checkbox is not checked', function () {
+  const checkbox = this.getToggleAllCheckbox();
+  assert.ok(checkbox, 'Toggle-all checkbox not found');
+  assert.ok(!checkbox.checked, 'Expected toggle-all checkbox to not be checked');
+});
