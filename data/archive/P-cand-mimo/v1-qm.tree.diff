+/* global exports */
+(function () {
+  'use strict';
+
+  var STORAGE_KEY = 'todos-todomvc';
+
+  function TodoApp() {
+    this.todos = [];
+    this.currentFilter = 'all';
+    this.init();
+  }
+
+  TodoApp.prototype = {
+    init: function () {
+      this.load();
+      this.bindEvents();
+      this.render();
+    },
+
+    load: function () {
+      var stored = localStorage.getItem(STORAGE_KEY);
+      this.todos = stored ? JSON.parse(stored) : [];
+    },
+
+    save: function () {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(this.todos));
+    },
+
+    bindEvents: function () {
+      var self = this;
+      var newTodo = document.querySelector('.new-todo');
+      var toggleAll = document.querySelector('.toggle-all');
+      var clearCompleted = document.querySelector('.clear-completed');
+      var todoList = document.querySelector('.todo-list');
+      var filters = document.querySelector('.filters');
+
+      newTodo.addEventListener('keydown', function (e) {
+        if (e.key === 'Enter' || e.keyCode === 13) {
+          self.addTodo(newTodo.value);
+          newTodo.value = '';
+        }
+      });
+
+      toggleAll.addEventListener('change', function () {
+        self.toggleAll(toggleAll.checked);
+      });
+
+      clearCompleted.addEventListener('click', function () {
+        self.clearCompleted();
+      });
+
+      todoList.addEventListener('click', function (e) {
+        var target = e.target;
+        var li = target.closest('li');
+        if (!li) return;
+        var index = self.getTodoIndex(li);
+
+        if (target.classList.contains('toggle')) {
+          self.toggleTodo(index);
+        } else if (target.classList.contains('destroy')) {
+          self.deleteTodo(index);
+        }
+      });
+
+      todoList.addEventListener('dblclick', function (e) {
+        var target = e.target;
+        if (target.tagName === 'LABEL') {
+          var li = target.closest('li');
+          if (li) {
+            self.startEditing(li);
+          }
+        }
+      });
+
+      todoList.addEventListener('keydown', function (e) {
+        var target = e.target;
+        if (target.classList.contains('edit')) {
+          if (e.key === 'Enter' || e.keyCode === 13) {
+            self.saveEdit(target);
+          } else if (e.key === 'Escape' || e.keyCode === 27) {
+            self.cancelEdit(target);
+          }
+        }
+      });
+
+      todoList.addEventListener('blur', function (e) {
+        var target = e.target;
+        if (target.classList.contains('edit')) {
+          self.saveEdit(target);
+        }
+      }, true);
+
+      filters.addEventListener('click', function (e) {
+        var target = e.target;
+        if (target.tagName === 'A') {
+          self.setFilter(target.getAttribute('href'));
+        }
+      });
+
+      window.addEventListener('hashchange', function () {
+        self.setFilterFromHash();
+      });
+
+      this.setFilterFromHash();
+    },
+
+    setFilterFromHash: function () {
+      var hash = window.location.hash || '#/';
+      this.setFilter(hash);
+    },
+
+    setFilter: function (hash) {
+      var filter = 'all';
+      if (hash.indexOf('#/active') !== -1) {
+        filter = 'active';
+      } else if (hash.indexOf('#/completed') !== -1) {
+        filter = 'completed';
+      }
+      this.currentFilter = filter;
+      this.render();
+    },
+
+    addTodo: function (title) {
+      var trimmed = title.trim();
+      if (!trimmed) return;
+      this.todos.push({
+        id: Date.now(),
+        title: trimmed,
+        completed: false
+      });
+      this.save();
+      this.render();
+    },
+
+    toggleTodo: function (index) {
+      if (index >= 0 && index < this.todos.length) {
+        this.todos[index].completed = !this.todos[index].completed;
+        this.save();
+        this.render();
+      }
+    },
+
+    deleteTodo: function (index) {
+      if (index >= 0 && index < this.todos.length) {
+        this.todos.splice(index, 1);
+        this.save();
+        this.render();
+      }
+    },
+
+    toggleAll: function (completed) {
+      for (var i = 0; i < this.todos.length; i++) {
+        this.todos[i].completed = completed;
+      }
+      this.save();
+      this.render();
+    },
+
+    clearCompleted: function () {
+      this.todos = this.todos.filter(function (todo) {
+        return !todo.completed;
+      });
+      this.save();
+      this.render();
+    },
+
+    startEditing: function (li) {
+      li.classList.add('editing');
+      var input = li.querySelector('.edit');
+      input.focus();
+    },
+
+    saveEdit: function (input) {
+      var li = input.closest('li');
+      if (!li || !li.classList.contains('editing')) return;
+      var index = this.getTodoIndex(li);
+      var value = input.value.trim();
+      if (value) {
+        this.todos[index].title = value;
+        this.save();
+        this.render();
+      } else {
+        this.deleteTodo(index);
+      }
+    },
+
+    cancelEdit: function (input) {
+      var li = input.closest('li');
+      if (li) {
+        li.classList.remove('editing');
+        var index = this.getTodoIndex(li);
+        input.value = this.todos[index].title;
+      }
+    },
+
+    getTodoIndex: function (li) {
+      var items = document.querySelectorAll('.todo-list li');
+      for (var i = 0; i < items.length; i++) {
+        if (items[i] === li) return i;
+      }
+      return -1;
+    },
+
+    getFilteredTodos: function () {
+      var filter = this.currentFilter;
+      return this.todos.filter(function (todo) {
+        if (filter === 'active') return !todo.completed;
+        if (filter === 'completed') return todo.completed;
+        return true;
+      });
+    },
+
+    render: function () {
+      var todoList = document.querySelector('.todo-list');
+      var filtered = this.getFilteredTodos();
+      var html = '';
+
+      for (var i = 0; i < filtered.length; i++) {
+        var todo = filtered[i];
+        var completedClass = todo.completed ? ' completed' : '';
+        html += '<li class="' + completedClass + '">';
+        html += '<div class="view">';
+        html += '<input class="toggle" type="checkbox"' + (todo.completed ? ' checked' : '') + '>';
+        html += '<label>' + this.escapeHtml(todo.title) + '</label>';
+        html += '<button class="destroy"></button>';
+        html += '</div>';
+        html += '<input class="edit" value="' + this.escapeHtml(todo.title) + '">';
+        html += '</li>';
+      }
+
+      todoList.innerHTML = html;
+
+      var main = document.querySelector('.main');
+      var footer = document.querySelector('.footer');
+      var toggleAll = document.querySelector('.toggle-all');
+      var activeCount = this.todos.filter(function (t) { return !t.completed; }).length;
+      var completedCount = this.todos.filter(function (t) { return t.completed; }).length;
+
+      if (this.todos.length === 0) {
+        main.style.display = 'none';
+        footer.style.display = 'none';
+      } else {
