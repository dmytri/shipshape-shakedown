@@ -0,0 +1,319 @@
+const { Given, When, Then } = require('@cucumber/cucumber');
+const assert = require('assert/strict');
+const fs = require('fs');
+const path = require('path');
+const { Window } = require('happy-dom');
+
+function createTodo(doc, win, title) {
+  const input = doc.querySelector('.new-todo');
+  input.value = title;
+  input.dispatchEvent(new win.Event('input', { bubbles: true }));
+  const event = new win.KeyboardEvent('keydown', {
+    key: 'Enter',
+    keyCode: 13,
+    which: 13,
+    bubbles: true
+  });
+  input.dispatchEvent(event);
+}
+
+function clickToggleForTodo(doc, index) {
+  const items = doc.querySelectorAll('.todo-list li');
+  const item = items[index];
+  if (item) {
+    const toggle = item.querySelector('.toggle');
+    toggle.click();
+  }
+}
+
+function isHidden(doc, el) {
+  if (!el) return true;
+  const style = doc.defaultView.getComputedStyle(el);
+  return style.display === 'none' || el.offsetParent === null;
+}
+
+function isVisible(doc, el) {
+  if (!el) return false;
+  const style = doc.defaultView.getComputedStyle(el);
+  return style.display !== 'none' && el.offsetParent !== null;
+}
+
+// --- GIVEN ---
+
+Given('the todo app is loaded', function () {
+  // App is loaded in Before hook
+});
+
+Given('a todo {string} exists', function (title) {
+  createTodo(this.document, this.window, title);
+});
+
+Given('a completed todo {string} exists', function (title) {
+  createTodo(this.document, this.window, title);
+  const toggle = this.document.querySelector('.todo-list li .toggle');
+  if (toggle) toggle.click();
+});
+
+// --- WHEN ---
+
+When('the user types {string} in the new todo input', function (text) {
+  const input = this.document.querySelector('.new-todo');
+  input.value = text;
+  input.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+});
+
+When('the user presses Enter', function () {
+  const input = this.document.querySelector('.new-todo');
+  const event = new this.window.KeyboardEvent('keydown', {
+    key: 'Enter',
+    keyCode: 13,
+    which: 13,
+    bubbles: true
+  });
+  input.dispatchEvent(event);
+});
+
+When('the user clicks the toggle checkbox of the first todo', function () {
+  clickToggleForTodo(this.document, 0);
+});
+
+When('the user clicks the toggle checkbox of the second todo', function () {
+  clickToggleForTodo(this.document, 1);
+});
+
+When('the user double-clicks the label of the first todo', function () {
+  const label = this.document.querySelector('.todo-list li:first-child label');
+  const event = new this.window.MouseEvent('dblclick', { bubbles: true });
+  label.dispatchEvent(event);
+});
+
+When('the user types {string} in the edit input of the first todo', function (text) {
+  const input = this.document.querySelector('.todo-list li:first-child .edit');
+  input.value = text;
+  input.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+});
+
+When('the user presses Escape', function () {
+  const input = this.document.querySelector('.todo-list li:first-child .edit');
+  if (!input) {
+    const editing = this.document.querySelector('.todo-list li.editing .edit');
+    if (editing) {
+      const event = new this.window.KeyboardEvent('keydown', {
+        key: 'Escape',
+        keyCode: 27,
+        which: 27,
+        bubbles: true
+      });
+      editing.dispatchEvent(event);
+    }
+  } else {
+    const event = new this.window.KeyboardEvent('keydown', {
+      key: 'Escape',
+      keyCode: 27,
+      which: 27,
+      bubbles: true
+    });
+    input.dispatchEvent(event);
+  }
+});
+
+When('the user clears the edit input of the first todo', function () {
+  const input = this.document.querySelector('.todo-list li:first-child .edit');
+  input.value = '';
+  input.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+});
+
+When('the edit input of the first todo loses focus', function () {
+  const input = this.document.querySelector('.todo-list li:first-child .edit');
+  input.blur();
+});
+
+When('the user clicks the destroy button of the first todo', function () {
+  const btn = this.document.querySelector('.todo-list li:first-child .destroy');
+  btn.click();
+});
+
+When('the user clicks the toggle-all checkbox', function () {
+  const toggle = this.document.querySelector('.toggle-all');
+  toggle.click();
+});
+
+When('the user clicks the {string} button', function (buttonText) {
+  if (buttonText === 'Clear completed') {
+    this.document.querySelector('.clear-completed').click();
+  }
+});
+
+When('the user clicks the {string} filter', function (filterName) {
+  const links = this.document.querySelectorAll('.filters li a');
+  for (const link of links) {
+    if (link.textContent === filterName) {
+      link.click();
+      break;
+    }
+  }
+});
+
+When('the user navigates to {string}', function (hash) {
+  this.window.location.hash = hash.replace('#', '/');
+  const event = new this.window.Event('hashchange', { bubbles: true });
+  this.window.dispatchEvent(event);
+});
+
+When('the page is reloaded', function () {
+  const htmlPath = path.resolve(__dirname, '../../index.html');
+  const html = fs.readFileSync(htmlPath, 'utf8');
+  const stored = this.window.localStorage.getItem('todos-todomvc');
+
+  this.window.close();
+  this.window = new Window({
+    url: this.window.location.href || 'http://localhost/',
+    pretendToBeVisual: true
+  });
+
+  this.window.localStorage.setItem('todos-todomvc', stored);
+
+  this.document = this.window.document;
+  this.document.open();
+  this.document.write(html);
+  this.document.close();
+
+  const appPath = path.resolve(__dirname, '../../js/app.js');
+  const appCode = fs.readFileSync(appPath, 'utf8');
+  const scriptEl = this.document.createElement('script');
+  scriptEl.textContent = appCode;
+  this.document.body.appendChild(scriptEl);
+});
+
+// --- THEN ---
+
+Then('the todo list contains {int} item(s)', function (count) {
+  const items = this.document.querySelectorAll('.todo-list li');
+  assert.equal(items.length, count);
+});
+
+Then('the first todo has title {string}', function (title) {
+  const label = this.document.querySelector('.todo-list li:first-child label');
+  assert.equal(label.textContent, title);
+});
+
+Then('the second todo has title {string}', function (title) {
+  const label = this.document.querySelector('.todo-list li:nth-child(2) label');
+  assert.equal(label.textContent, title);
+});
+
+Then('the first todo is completed', function () {
+  const li = this.document.querySelector('.todo-list li:first-child');
+  assert.ok(li.classList.contains('completed'), 'Expected first todo to have class "completed"');
+  const checkbox = li.querySelector('.toggle');
+  assert.ok(checkbox.checked, 'Expected first todo checkbox to be checked');
+});
+
+Then('the first todo is not completed', function () {
+  const li = this.document.querySelector('.todo-list li:first-child');
+  assert.ok(!li.classList.contains('completed'), 'Expected first todo to not have class "completed"');
+  const checkbox = li.querySelector('.toggle');
+  assert.ok(!checkbox.checked, 'Expected first todo checkbox to not be checked');
+});
+
+Then('the first todo element has class {string}', function (cls) {
+  const li = this.document.querySelector('.todo-list li:first-child');
+  assert.ok(li.classList.contains(cls), `Expected first todo to have class "${cls}"`);
+});
+
+Then('the first todo element does not have class {string}', function (cls) {
+  const li = this.document.querySelector('.todo-list li:first-child');
+  assert.ok(!li.classList.contains(cls), `Expected first todo to not have class "${cls}"`);
+});
+
+Then('the new todo input is empty', function () {
+  const input = this.document.querySelector('.new-todo');
+  assert.equal(input.value, '');
+});
+
+Then('the edit input of the first todo has value {string}', function (value) {
+  const input = this.document.querySelector('.todo-list li:first-child .edit');
+  assert.equal(input.value, value);
+});
+
+Then('the edit input of the first todo is focused', function () {
+  const input = this.document.querySelector('.todo-list li:first-child .edit');
+  const active = this.document.activeElement || this.window.document.activeElement;
+  assert.equal(active, input, 'Expected edit input to be focused');
+});
+
+Then('the toggle-all checkbox is checked', function () {
+  const toggle = this.document.querySelector('.toggle-all');
+  assert.ok(toggle.checked, 'Expected toggle-all to be checked');
+});
+
+Then('the toggle-all checkbox is not checked', function () {
+  const toggle = this.document.querySelector('.toggle-all');
+  assert.ok(!toggle.checked, 'Expected toggle-all to not be checked');
+});
+
+Then('all todos are completed', function () {
+  const items = this.document.querySelectorAll('.todo-list li');
+  for (const item of items) {
+    assert.ok(item.classList.contains('completed'), 'Expected all todos to be completed');
+  }
+});
+
+Then('all todos are not completed', function () {
+  const items = this.document.querySelectorAll('.todo-list li');
+  for (const item of items) {
+    assert.ok(!item.classList.contains('completed'), 'Expected all todos to not be completed');
+  }
+});
+
+Then('the {string} button is hidden', function (buttonName) {
+  if (buttonName === 'Clear completed') {
+    const el = this.document.querySelector('.clear-completed');
+    assert.ok(!el || isHidden(this.document, el), 'Expected Clear completed button to be hidden');
+  }
+});
+
+Then('the {string} button is visible', function (buttonName) {
+  if (buttonName === 'Clear completed') {
+    const el = this.document.querySelector('.clear-completed');
+    assert.ok(el && isVisible(this.document, el), 'Expected Clear completed button to be visible');
+  }
+});
+
+Then('the counter shows {string}', function (text) {
+  const counter = this.document.querySelector('.todo-count');
+  assert.ok(counter.textContent.includes(text), `Expected counter to contain "${text}", got "${counter.textContent}"`);
+});
+
+Then('the main section is hidden', function () {
+  const main = this.document.querySelector('.main');
+  assert.ok(isHidden(this.document, main), 'Expected main section to be hidden');
+});
+
+Then('the main section is visible', function () {
+  const main = this.document.querySelector('.main');
+  assert.ok(isVisible(this.document, main), 'Expected main section to be visible');
+});
+
+Then('the footer is hidden', function () {
+  const footer = this.document.querySelector('.footer');
+  assert.ok(isHidden(this.document, footer), 'Expected footer to be hidden');
+});
+
+Then('the footer is visible', function () {
+  const footer = this.document.querySelector('.footer');
+  assert.ok(isVisible(this.document, footer), 'Expected footer to be visible');
+});
+
+Then('the {string} filter is selected', function (filterName) {
+  const links = this.document.querySelectorAll('.filters li a');
+  for (const link of links) {
+    if (link.textContent === filterName) {
+      assert.ok(link.classList.contains('selected'), `Expected "${filterName}" filter to be selected`);
+    }
+  }
+});
+
+Then('localStorage contains key {string}', function (key) {
+  assert.ok(this.window.localStorage.getItem(key) !== null, `Expected localStorage to contain key "${key}"`);
+});
