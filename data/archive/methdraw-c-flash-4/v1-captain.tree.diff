+{
+  "watches": [
+    {
+      "id": "watch-1-init",
+      "description": "HTML template, CSS, empty state, new-todo input, initial render",
+      "scenarios": [
+        "features/todo-core.feature:Scenario: Hide main and footer when no todos",
+        "features/todo-core.feature:Scenario: Create a todo",
+        "features/todo-core.feature:Scenario: Trim whitespace from new todo",
+        "features/todo-core.feature:Scenario: Ignore empty todo",
+        "features/todo-core.feature:Scenario: Ignore whitespace-only todo",
+        "features/todo-core.feature:Scenario: new-todo input is autofocused on load"
+      ]
+    },
+    {
+      "id": "watch-2-toggle",
+      "description": "Toggle individual and mark-all",
+      "scenarios": [
+        "features/todo-core.feature:Scenario: Toggle a single todo",
+        "features/todo-core.feature:Scenario: Mark all as complete",
+        "features/todo-core.feature:Scenario: Toggle-all reflects individual state",
+        "features/todo-core.feature:Scenario: Toggle-all checks when all are complete"
+      ]
+    },
+    {
+      "id": "watch-3-delete",
+      "description": "Delete todo",
+      "scenarios": [
+        "features/todo-core.feature:Scenario: Delete a todo via destroy button"
+      ]
+    },
+    {
+      "id": "watch-4-counter",
+      "description": "Todo counter and clear-completed",
+      "scenarios": [
+        "features/todo-core.feature:Scenario: Display active count with singular",
+        "features/todo-core.feature:Scenario: Display active count with plural",
+        "features/todo-core.feature:Scenario: Display zero active count",
+        "features/todo-core.feature:Scenario: Clear completed removes done todos",
+        "features/todo-core.feature:Scenario: Hide clear-completed when none completed",
+        "features/todo-core.feature:Scenario: Clear completed toggles toggle-all unchecked"
+      ]
+    },
+    {
+      "id": "watch-5-editing",
+      "description": "Editing mode",
+      "scenarios": [
+        "features/todo-core.feature:Scenario: Double-click activates editing mode",
+        "features/todo-core.feature:Scenario: Save edit on Enter",
+        "features/todo-core.feature:Scenario: Save edit on blur",
+        "features/todo-core.feature:Scenario: Trim edit input",
+        "features/todo-core.feature:Scenario: Destroy todo when edit is empty",
+        "features/todo-core.feature:Scenario: Destroy todo when edit is whitespace",
+        "features/todo-core.feature:Scenario: Cancel edit with Escape"
+      ]
+    },
+    {
+      "id": "watch-6-routing",
+      "description": "URL routing and filtering",
+      "scenarios": [
+        "features/routing.feature:Scenario: All route shows every todo",
+        "features/routing.feature:Scenario: Active route shows only incomplete todos",
+        "features/routing.feature:Scenario: Completed route shows only done todos",
+        "features/routing.feature:Scenario: Completing a todo while on active filter hides it",
+        "features/routing.feature:Scenario: Un-completing a todo while on completed filter hides it",
+        "features/routing.feature:Scenario: Active filter persists on page reload",
+        "features/routing.feature:Scenario: Clear completed removes done todos from completed view"
+      ]
+    },
+    {
+      "id": "watch-7-persistence",
+      "description": "localStorage persistence",
+      "scenarios": [
+        "features/persistence.feature:Scenario: Todos persist after page reload",
+        "features/persistence.feature:Scenario: localStorage uses correct key and format",
+        "features/persistence.feature:Scenario: Editing state is not persisted",
+        "features/persistence.feature:Scenario: localStorage clears when all todos are deleted"
+      ]
+    }
+  ]
