+/**
+ * TodoMVC app implementation.
+ * Vanilla JS, no framework. Persists to localStorage.
+ */
+(function () {
+  "use strict";
+
+  var STORAGE_KEY = "todos-shakedown";
+  var todos = [];
+  var currentFilter = "/";
+
+  // ---------------------------------------------------------------------------
+  // Persistence
+  // ---------------------------------------------------------------------------
+
+  function save() {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
+  }
+
+  function load() {
+    try {
+      todos = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
+    } catch {
+      todos = [];
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Rendering
+  // ---------------------------------------------------------------------------
+
+  function getFilteredTodos() {
+    return todos.filter(function (t) {
+      if (currentFilter === "/active") return !t.completed;
+      if (currentFilter === "/completed") return t.completed;
+      return true;
+    });
+  }
+
+  function render() {
+    var todoList = document.querySelector(".todo-list");
+    var main = document.querySelector(".main");
+    var footer = document.querySelector(".footer");
+    var toggleAll = document.querySelector("#toggle-all");
+    var counter = document.querySelector(".todo-count");
+    var clearBtn = document.querySelector(".clear-completed");
+
+    // Clear the list
+    todoList.innerHTML = "";
+
+    // Filter links
+    var links = document.querySelectorAll(".filters a");
+    links.forEach(function (link) {
+      var href = link.getAttribute("href") || "";
+      var filter = href.replace("#", "") || "/";
+      if (filter === currentFilter) {
+        link.classList.add("selected");
+      } else {
+        link.classList.remove("selected");
+      }
+    });
+
+    if (todos.length === 0) {
+      main.style.display = "none";
+      footer.style.display = "none";
+      return;
+    }
+
+    main.style.display = "";
+    footer.style.display = "";
+
+    var visible = getFilteredTodos();
+    visible.forEach(function (todo) {
+      var li = document.createElement("li");
+      li.dataset.id = todo.id;
+      if (todo.completed) li.classList.add("completed");
+
+      var viewDiv = document.createElement("div");
+      viewDiv.className = "view";
+
+      var checkbox = document.createElement("input");
+      checkbox.className = "toggle";
+      checkbox.type = "checkbox";
+      checkbox.checked = todo.completed;
+
+      var label = document.createElement("label");
+      label.textContent = todo.title;
+
+      var destroyBtn = document.createElement("button");
+      destroyBtn.className = "destroy";
+
+      viewDiv.appendChild(checkbox);
+      viewDiv.appendChild(label);
+      viewDiv.appendChild(destroyBtn);
+
+      var editInput = document.createElement("input");
+      editInput.className = "edit";
+      editInput.value = todo.title;
+
+      li.appendChild(viewDiv);
+      li.appendChild(editInput);
+      todoList.appendChild(li);
+    });
+
+    // Counter
+    var activeCount = todos.filter(function (t) { return !t.completed; }).length;
+    var itemWord = activeCount === 1 ? "item" : "items";
+    counter.innerHTML = "<strong>" + activeCount + "</strong> " + itemWord + " left";
+
+    // Toggle-all state
+    var allCompleted = todos.length > 0 && todos.every(function (t) { return t.completed; });
+    toggleAll.checked = allCompleted;
+
+    // Clear-completed visibility
+    var hasCompleted = todos.some(function (t) { return t.completed; });
+    clearBtn.style.display = hasCompleted ? "" : "none";
+  }
+
+  // ---------------------------------------------------------------------------
+  // Todo operations
+  // ---------------------------------------------------------------------------
+
+  function addTodo(title) {
+    title = title.trim();
+    if (!title) return;
+    todos.push({ id: Date.now(), title: title, completed: false });
+    save();
+    render();
+  }
+
+  function toggleTodo(id) {
+    var todo = todos.find(function (t) { return t.id === id; });
+    if (todo) {
+      todo.completed = !todo.completed;
+      save();
+      render();
+    }
+  }
+
+  function toggleAll() {
+    var allCompleted = todos.every(function (t) { return t.completed; });
+    todos.forEach(function (t) { t.completed = !allCompleted; });
+    save();
+    render();
+  }
+
+  function deleteTodo(id) {
+    todos = todos.filter(function (t) { return t.id !== id; });
+    save();
+    render();
+  }
+
+  function editTodo(id, newTitle) {
+    newTitle = newTitle.trim();
+    if (!newTitle) {
+      deleteTodo(id);
+      return;
+    }
+    var todo = todos.find(function (t) { return t.id === id; });
+    if (todo) {
+      todo.title = newTitle;
+      save();
+      render();
+    }
+  }
+
+  function clearCompleted() {
+    todos = todos.filter(function (t) { return !t.completed; });
+    save();
+    render();
+  }
+
+  // ---------------------------------------------------------------------------
+  // Event delegation
+  // ---------------------------------------------------------------------------
+
+  function getTodoId(li) {
+    return parseInt(li.dataset.id, 10);
+  }
+
+  // New todo input
+  document.querySelector(".new-todo").addEventListener("keydown", function (e) {
+    if (e.key === "Enter" || e.keyCode === 13) {
+      addTodo(this.value);
+      this.value = "";
+    }
+  });
+
+  // Todo list delegation
+  document.querySelector(".todo-list").addEventListener("click", function (e) {
+    var li = e.target.closest("li");
+    if (!li) return;
+    var id = getTodoId(li);
+
+    if (e.target.classList.contains("toggle")) {
+      toggleTodo(id);
+    } else if (e.target.classList.contains("destroy")) {
+      deleteTodo(id);
+    }
+  });
+
+  // Double-click to edit
+  document.querySelector(".todo-list").addEventListener("dblclick", function (e) {
+    if (e.target.tagName === "LABEL") {
+      var li = e.target.closest("li");
+      if (li) {
+        li.classList.add("editing");
+        var editInput = li.querySelector(".edit");
+        if (editInput) editInput.focus();
+      }
+    }
+  });
+
+  // Edit input events (Enter, Escape, blur)
+  document.querySelector(".todo-list").addEventListener("keydown", function (e) {
+    if (e.target.classList.contains("edit")) {
+      var li = e.target.closest("li");
+      var id = getTodoId(li);
+
+      if (e.key === "Enter" || e.keyCode === 13) {
+        editTodo(id, e.target.value);
+      } else if (e.key === "Escape" || e.keyCode === 27) {
+        li.classList.remove("editing");
+        render();
+      }
+    }
+  });
+
+  document.querySelector(".todo-list").addEventListener("blur", function (e) {
+    if (e.target.classList.contains("edit")) {
+      var li = e.target.closest("li");
+      var id = getTodoId(li);
+      editTodo(id, e.target.value);
+    }
+  }, true);
+
+  // Toggle-all
+  document.querySelector("#toggle-all").addEventListener("click", function () {
+    toggleAll();
+  });
+
+  // Clear completed
+  document.querySelector(".clear-completed").addEventListener("click", function () {
+    clearCompleted();
+  });
+
+  // Routing
+  function onHashChange() {
+    var hash = window.location.hash || "#/";
+    currentFilter = hash.replace("#", "") || "/";
+    render();
+  }
+
+  window.addEventListener("hashchange", onHashChange);
+
+  // Hover to show destroy button (CSS handles this normally, but in happy-dom
+  // we add the class on mouseenter)
+  document.querySelector(".todo-list").addEventListener("mouseenter", function (e) {
+    var li = e.target.closest("li");
+    if (li) li.classList.add("hover");
+  }, true);
+
+  // ---------------------------------------------------------------------------
+  // Init
+  // ---------------------------------------------------------------------------
+
+  load();
+  onHashChange();
+  render();
+
+  // Auto-focus the new-todo input
+  var newTodoInput = document.querySelector(".new-todo");
+  if (newTodoInput) newTodoInput.focus();
+})();
