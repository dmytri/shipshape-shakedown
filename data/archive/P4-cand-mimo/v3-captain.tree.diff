+/**
+ * Shared World for TodoMVC step definitions.
+ * Uses happy-dom to simulate a browser environment.
+ */
+
+import { Window } from "happy-dom";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+const PROJECT_ROOT = join(import.meta.dirname, "..", "..");
+const TODO_APP_HTML_PATH = join(PROJECT_ROOT, "index.html");
+const APP_JS_PATH = join(PROJECT_ROOT, "js", "app.js");
+
+export class TodoWorld {
+  constructor() {
+    this.window = null;
+    this.document = null;
+  }
+
+  async loadApp() {
+    let html;
+    try {
+      html = readFileSync(TODO_APP_HTML_PATH, "utf-8");
+    } catch {
+      html = createMinimalAppHtml();
+    }
+    this.window = new Window({ url: "http://localhost/", contentType: "text/html", runScripts: "dangerously" });
+    this.document = this.window.document;
+    this.window.document.write(html);
+    this.window.document.close();
+    // Inject CSS for destroy button hover behavior
+    const style = this.document.createElement("style");
+    style.textContent = `.todo-list li .destroy { display: none; } .todo-list li:hover .destroy, .todo-list li.hover .destroy { display: block; }`;
+    this.document.head.appendChild(style);
+    // Execute app.js via eval since document.write doesn't run scripts
+    try {
+      const appJs = readFileSync(APP_JS_PATH, "utf-8");
+      this.window.eval(appJs);
+    } catch { /* app.js may not exist yet */ }
+    await new Promise((r) => setTimeout(r, 50));
+  }
+
+  async reloadApp() {
+    const data = {};
+    if (this.window?.localStorage) {
+      for (let i = 0; i < this.window.localStorage.length; i++) {
+        const key = this.window.localStorage.key(i);
+        data[key] = this.window.localStorage.getItem(key);
+      }
+    }
+    let html;
+    try {
+      html = readFileSync(TODO_APP_HTML_PATH, "utf-8");
+    } catch {
+      html = createMinimalAppHtml();
+    }
+    this.window = new Window({ url: "http://localhost/", contentType: "text/html", runScripts: "dangerously" });
+    this.document = this.window.document;
+    this.window.document.write(html);
+    this.window.document.close();
+    // Inject CSS for destroy button hover behavior
+    const style = this.document.createElement("style");
+    style.textContent = `.todo-list li .destroy { display: none; } .todo-list li:hover .destroy, .todo-list li.hover .destroy { display: block; }`;
+    this.document.head.appendChild(style);
+    // Execute app.js via eval
+    try {
+      const appJs = readFileSync(APP_JS_PATH, "utf-8");
+      this.window.eval(appJs);
+    } catch { /* app.js may not exist yet */ }
+    if (this.window.localStorage) {
+      for (const [key, value] of Object.entries(data)) {
+        this.window.localStorage.setItem(key, value);
+      }
+    }
+    await new Promise((r) => setTimeout(r, 50));
+  }
+
+  navigateTo(route) {
+    this.window.location.hash = route;
+    this.window.dispatchEvent(new this.window.Event("hashchange"));
+  }
+
+  getTodoItems() {
+    return Array.from(this.document.querySelectorAll(".todo-list li"));
+  }
+
+  getTodoAt(position) {
+    return this.getTodoItems()[position - 1];
+  }
+
+  getVisibleTodoItems() {
+    return this.getTodoItems().filter((item) => {
+      const style = this.window.getComputedStyle(item);
+      return style.display !== "none";
+    });
+  }
+
+  typeAndSubmit(text) {
+    const input = this.document.querySelector(".new-todo");
+    input.value = text;
+    input.dispatchEvent(new this.window.Event("input", { bubbles: true }));
+    input.dispatchEvent(
+      new this.window.KeyboardEvent("keydown", { key: "Enter", keyCode: 13, bubbles: true })
+    );
+  }
+
+  createTodo(title) {
+    this.typeAndSubmit(title);
+  }
+
+  createCompletedTodo(title) {
+    this.createTodo(title);
+    const items = this.getTodoItems();
+    const last = items[items.length - 1];
+    if (last) {
+      const cb = last.querySelector(".toggle");
+      if (cb) cb.click();
+    }
+  }
+
+  doubleClickTodoLabel(position) {
+    const item = this.getTodoAt(position);
+    if (item) {
+      const label = item.querySelector("label");
+      if (label) label.dispatchEvent(new this.window.Event("dblclick", { bubbles: true }));
+    }
+  }
+
+  changeEditInput(position, newValue, action) {
+    const item = this.getTodoAt(position);
+    if (!item) return;
+    const editInput = item.querySelector(".edit");
+    if (!editInput) return;
+    editInput.focus();
+    editInput.value = newValue;
+    editInput.dispatchEvent(new this.window.Event("input", { bubbles: true }));
+    if (action === "Enter") {
+      editInput.dispatchEvent(
+        new this.window.KeyboardEvent("keydown", { key: "Enter", keyCode: 13, bubbles: true })
+      );
+    } else if (action === "Escape") {
+      editInput.dispatchEvent(
+        new this.window.KeyboardEvent("keydown", { key: "Escape", keyCode: 27, bubbles: true })
+      );
+    } else if (action === "blur") {
+      editInput.dispatchEvent(new this.window.Event("blur", { bubbles: true }));
+    }
+  }
+
+  clearEditInput(position) {
+    const item = this.getTodoAt(position);
+    if (!item) return;
+    const editInput = item.querySelector(".edit");
+    if (!editInput) return;
+    editInput.focus();
+    editInput.value = "";
+    editInput.dispatchEvent(new this.window.Event("input", { bubbles: true }));
+    editInput.dispatchEvent(
+      new this.window.KeyboardEvent("keydown", { key: "Enter", keyCode: 13, bubbles: true })
+    );
+  }
+
+  clickToggle(position) {
+    const item = this.getTodoAt(position);
+    if (item) {
+      const cb = item.querySelector(".toggle");
+      if (cb) cb.click();
+    }
+  }
+
+  hoverTodo(position) {
+    const item = this.getTodoAt(position);
+    if (item) {
+      item.dispatchEvent(new this.window.Event("mouseenter", { bubbles: true }));
+      item.dispatchEvent(new this.window.Event("mouseover", { bubbles: true }));
+      item.classList.add("hover");
+    }
+  }
+
+  clickDestroy(position) {
+    const item = this.getTodoAt(position);
+    if (item) {
+      const btn = item.querySelector(".destroy");
+      if (btn) btn.click();
+    }
+  }
+
+  clickToggleAll() {
+    const toggleAll = this.document.querySelector("#toggle-all");
+    if (toggleAll) toggleAll.click();
+  }
+
+  clickClearCompleted() {
+    const btn = this.document.querySelector(".clear-completed");
+    if (btn) btn.click();
+  }
+
+  getCounterText() {
+    const counter = this.document.querySelector(".todo-count");
+    return counter ? counter.textContent.trim() : "";
+  }
+
+  getMainSection() {
+    return this.document.querySelector(".main");
+  }
+
+  getFooter() {
+    return this.document.querySelector(".footer");
+  }
+
+  isDestroyVisible(position) {
+    const item = this.getTodoAt(position);
+    if (!item) return false;
+    const btn = item.querySelector(".destroy");
+    if (!btn) return false;
+    const style = this.window.getComputedStyle(btn);
+    return style.display !== "none" && style.visibility !== "hidden";
+  }
+
+  isClearCompletedVisible() {
+    const btn = this.document.querySelector(".clear-completed");
+    if (!btn) return false;
+    const style = this.window.getComputedStyle(btn);
+    return style.display !== "none" && style.visibility !== "hidden";
+  }
+}
+
+function createMinimalAppHtml() {
+  return `<!DOCTYPE html>
+<html lang="en">
+<head><meta charset="utf-8"><title>TodoMVC</title></head>
+<body>
+  <section class="todoapp">
+    <header class="header">
+      <h1>todos</h1>
+      <input class="new-todo" placeholder="What needs to be done?" autofocus>
+    </header>
+    <section class="main">
+      <input id="toggle-all" class="toggle-all" type="checkbox">
+      <label for="toggle-all">Mark all as complete</label>
+      <ul class="todo-list"></ul>
+    </section>
+    <footer class="footer">
+      <span class="todo-count"><strong>0</strong> items left</span>
+      <ul class="filters">
+        <li><a class="selected" href="#/">All</a></li>
+        <li><a href="#/active">Active</a></li>
+        <li><a href="#/completed">Completed</a></li>
+      </ul>
+      <button class="clear-completed">Clear completed</button>
+    </footer>
+  </section>
+  <script src="js/app.js"></script>
+</body>
+</html>`;
+}
