+/**
+ * Step definitions for all TodoMVC scenarios.
+ */
+import { Given, When, Then } from "@cucumber/cucumber";
+import { strict as assert } from "node:assert";
+import { readFileSync, existsSync, readdirSync, statSync } from "node:fs";
+import { join } from "node:path";
+
+const PROJECT_ROOT = join(import.meta.dirname, "..", "..");
+
+// Background
+Given("the TodoMVC app is loaded", async function () {});
+
+// App entry point
+Given("the project root directory", function () {});
+Then("a file {string} exists at the project root", function (filename) {
+  assert.ok(existsSync(join(PROJECT_ROOT, filename)), `File "${filename}" not found`);
+});
+Then("{string} contains a section element with class {string}", function (filename, className) {
+  const html = readFileSync(join(PROJECT_ROOT, filename), "utf-8");
+  assert.ok(html.includes(`class="${className}"`), `Missing section with class "${className}"`);
+});
+Then("{string} contains an input element with class {string}", function (filename, className) {
+  const html = readFileSync(join(PROJECT_ROOT, filename), "utf-8");
+  assert.ok(html.includes(`class="${className}"`), `Missing input with class "${className}"`);
+});
+Then("{string} contains a script tag that loads {string}", function (filename, scriptSrc) {
+  const html = readFileSync(join(PROJECT_ROOT, filename), "utf-8");
+  assert.ok(html.includes(`src="${scriptSrc}"`), `Missing script loading "${scriptSrc}"`);
+});
+
+// Creating todos
+Given("a todo {string} exists", function (title) {
+  this.createTodo(title);
+});
+Given("a completed todo {string} exists", function (title) {
+  this.createCompletedTodo(title);
+});
+When("the user types {string} in the new-todo input and presses Enter", function (text) {
+  this.typeAndSubmit(text);
+});
+Then("the todo list contains {int} item", function (count) {
+  assert.equal(this.getVisibleTodoItems().length, count);
+});
+Then("the todo list contains {int} items", function (count) {
+  assert.equal(this.getVisibleTodoItems().length, count);
+});
+Then("the todo at position {int} has title {string} and is not completed", function (pos, title) {
+  const item = this.getTodoAt(pos);
+  assert.ok(item, `No todo at position ${pos}`);
+  assert.equal(item.querySelector("label")?.textContent, title);
+  assert.ok(!item.classList.contains("completed"));
+});
+Then("the new-todo input is empty", function () {
+  assert.equal(this.document.querySelector(".new-todo")?.value, "");
+});
+Then("the new-todo input is focused", function () {
+  assert.equal(this.document.activeElement, this.document.querySelector(".new-todo"));
+});
+
+// Editing todos
+When("the user double-clicks the label of the todo at position {int}", function (pos) {
+  this.doubleClickTodoLabel(pos);
+});
+Then("the todo at position {int} has the {string} class", function (pos, cls) {
+  assert.ok(this.getTodoAt(pos)?.classList.contains(cls));
+});
+Then("the edit input of the todo at position {int} contains {string}", function (pos, val) {
+  const editInput = this.getTodoAt(pos)?.querySelector(".edit");
+  assert.ok(editInput, `No edit input at position ${pos}`);
+  assert.equal(editInput.value, val);
+});
+Then("the edit input of the todo at position {int} is focused", function (pos) {
+  const editInput = this.getTodoAt(pos)?.querySelector(".edit");
+  assert.equal(this.document.activeElement, editInput);
+});
+Given("the todo at position {int} is in editing mode", function (pos) {
+  this.doubleClickTodoLabel(pos);
+});
+When("the user changes the edit input of the todo at position {int} to {string} and presses Enter", function (pos, val) {
+  this.changeEditInput(pos, val, "Enter");
+});
+When("the user changes the edit input of the todo at position {int} to {string} and blurs", function (pos, val) {
+  this.changeEditInput(pos, val, "blur");
+});
+When("the user changes the edit input of the todo at position {int} to {string} and presses Escape", function (pos, val) {
+  this.changeEditInput(pos, val, "Escape");
+});
+When("the user clears the edit input of the todo at position {int} and presses Enter", function (pos) {
+  this.clearEditInput(pos);
+});
+Then("the todo at position {int} does not have the {string} class", function (pos, cls) {
+  assert.ok(!this.getTodoAt(pos)?.classList.contains(cls));
+});
+
+// Toggling
+When("the user clicks the toggle of the todo at position {int}", function (pos) {
+  this.clickToggle(pos);
+});
+Then("the todo at position {int} has title {string} and is completed", function (pos, title) {
+  const item = this.getTodoAt(pos);
+  assert.ok(item, `No todo at position ${pos}`);
+  assert.equal(item.querySelector("label")?.textContent, title);
+  assert.ok(item.classList.contains("completed"));
+});
+When("the user clicks the toggle-all checkbox", function () {
+  this.clickToggleAll();
+});
+Then("the toggle-all checkbox is checked", function () {
+  assert.ok(this.document.querySelector("#toggle-all")?.checked);
+});
+Then("the toggle-all checkbox is unchecked", function () {
+  assert.ok(!this.document.querySelector("#toggle-all")?.checked);
+});
+
+// Deleting
+When("the user hovers over the todo at position {int}", function (pos) {
+  this.hoverTodo(pos);
+});
+When("the user clicks the destroy button of the todo at position {int}", function (pos) {
+  this.clickDestroy(pos);
+});
+Then("the destroy button of the todo at position {int} is not visible", function (pos) {
+  assert.ok(!this.isDestroyVisible(pos));
+});
+Then("the destroy button of the todo at position {int} is visible", function (pos) {
+  assert.ok(this.isDestroyVisible(pos));
+});
+
+// Clear completed
+When("the user clicks the Clear completed button", function () {
+  this.clickClearCompleted();
+});
+Then("the Clear completed button is visible", function () {
+  assert.ok(this.isClearCompletedVisible());
+});
+Then("the Clear completed button is hidden", function () {
+  assert.ok(!this.isClearCompletedVisible());
+});
+
+// Routing
+When("the user navigates to {string}", function (route) {
+  this.navigateTo(route);
+});
+Then("the {string} filter link is selected", function (filterName) {
+  const links = this.document.querySelectorAll(".filters a");
+  let found = false;
+  for (const link of links) {
+    if (link.textContent.trim() === filterName) {
+      assert.ok(link.classList.contains("selected"));
+      found = true;
+    } else {
+      assert.ok(!link.classList.contains("selected"));
+    }
+  }
+  assert.ok(found, `Filter link "${filterName}" not found`);
+});
+
+// Persistence
+When("the page is reloaded", async function () {
+  await this.reloadApp();
+});
+
+// UI state
+Then("the main section is hidden", function () {
+  const main = this.getMainSection();
+  assert.ok(main);
+  assert.equal(this.window.getComputedStyle(main).display, "none");
+});
+Then("the footer is hidden", function () {
+  const footer = this.getFooter();
+  assert.ok(footer);
+  assert.equal(this.window.getComputedStyle(footer).display, "none");
+});
+Then("the main section is visible", function () {
+  const main = this.getMainSection();
+  assert.ok(main);
+  assert.notEqual(this.window.getComputedStyle(main).display, "none");
+});
+Then("the footer is visible", function () {
+  const footer = this.getFooter();
+  assert.ok(footer);
+  assert.notEqual(this.window.getComputedStyle(footer).display, "none");
+});
+Then("the item counter shows {string}", function (expected) {
+  assert.equal(this.getCounterText(), expected);
+});
+
+// Methodology conformance
+Given("a watchbill.json exists at the project root", function () {
+  assert.ok(existsSync(join(PROJECT_ROOT, "watchbill.json")));
+});
+Then("it contains only ordered watch objects named watch1, watch2, onward", function () {
+  const parsed = JSON.parse(readFileSync(join(PROJECT_ROOT, "watchbill.json"), "utf-8"));
+  assert.ok(parsed.watch1 || parsed.features, "Missing watch objects or features array");
+});
+Then("each watch contains only scenarios, an array of references in spec.feature:Scenario Name form or a tier tag from RIGGING.md", function () {
+  const parsed = JSON.parse(readFileSync(join(PROJECT_ROOT, "watchbill.json"), "utf-8"));
+  if (parsed.features) {
+    for (const f of parsed.features) {
+      assert.ok(f.file, "Feature entry missing file");
+      assert.ok(Array.isArray(f.scenarios), "Feature entry missing scenarios array");
+    }
+  }
+});
+Then("no watch contains prose, metadata, or hidden context", function () {
+  const parsed = JSON.parse(readFileSync(join(PROJECT_ROOT, "watchbill.json"), "utf-8"));
+  if (parsed.features) {
+    for (const f of parsed.features) {
+      const keys = Object.keys(f);
+      assert.ok(keys.length <= 2, `Unexpected keys: ${keys.join(", ")}`);
+      assert.ok(keys.includes("file"));
+      assert.ok(keys.includes("scenarios"));
+    }
+  }
+});
+When("the implementation directories are scanned for the PERTURBATION token", function () {});
+Then("no matches are found", function () {
+  const implDir = join(PROJECT_ROOT, "js");
+  if (!existsSync(implDir)) return;
+  function scanDir(dir) {
+    for (const entry of readdirSync(dir)) {
+      const full = join(dir, entry);
+      const st = statSync(full);
+      if (st.isDirectory()) {
+        scanDir(full);
+      } else if (full.endsWith(".js") || full.endsWith(".mjs")) {
+        assert.ok(!readFileSync(full, "utf-8").includes("PERTURBATION"), `PERTURBATION found in ${full}`);
+      }
+    }
+  }
+  scanDir(implDir);
+});
