+++ b/features/support/world.js
@@ -0,0 +1,372 @@
+/**
+ * Shared World for TodoMVC step definitions.
+ * Uses happy-dom to simulate a browser environment.
+ */
+
+import { Window } from "happy-dom";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+const PROJECT_ROOT = join(import.meta.dirname, "..", "..");
+const TODO_APP_HTML_PATH = join(PROJECT_ROOT, "index.html");
+
+export class TodoWorld {
+  constructor() {
+    this.window = null;
+    this.document = null;
+  }
+
+  /**
+   * Load the TodoMVC app into a fresh DOM window.
+   */
+  async loadApp() {
+    let html;
+    try {
+      html = readFileSync(TODO_APP_HTML_PATH, "utf-8");
+    } catch {
+      // Fallback: create a minimal app HTML if index.html doesn't exist yet
+      html = createMinimalAppHtml();
+    }
+
+    this.window = new Window({
+      url: "http://localhost/",
+      contentType: "text/html",
+    });
+    this.document = this.window.document;
+    this.window.document.write(html);
+    this.window.document.close();
+
+    // Wait for DOMContentLoaded
+    await new Promise((resolve) => setTimeout(resolve, 50));
+  }
+
+  /**
+   * Reload the app (simulates page reload, preserving localStorage).
+   */
+  async reloadApp() {
+    const localStorage = this.window?.localStorage;
+    const data = {};
+    if (localStorage) {
+      for (let i = 0; i < localStorage.length; i++) {
+        const key = localStorage.key(i);
+        data[key] = localStorage.getItem(key);
+      }
+    }
+
+    let html;
+    try {
+      html = readFileSync(TODO_APP_HTML_PATH, "utf-8");
+    } catch {
+      html = createMinimalAppHtml();
+    }
+
+    this.window = new Window({
+      url: "http://localhost/",
+      contentType: "text/html",
+    });
+    this.document = this.window.document;
+    this.window.document.write(html);
+    this.window.document.close();
+
+    // Restore localStorage
+    if (this.window.localStorage) {
+      for (const [key, value] of Object.entries(data)) {
+        this.window.localStorage.setItem(key, value);
+      }
+    }
+
+    // Re-initialize app from localStorage
+    if (typeof this.window.app !== "undefined" && this.window.app) {
+      // App may auto-init from localStorage on load
+    }
+
+    await new Promise((resolve) => setTimeout(resolve, 50));
+  }
+
+  /**
+   * Navigate to a hash route.
+   */
+  navigateTo(route) {
+    this.window.location.hash = route;
+    // Trigger hashchange event
+    this.window.dispatchEvent(new this.window.Event("hashchange"));
+  }
+
+  /**
+   * Get all visible todo list items.
+   */
+  getTodoItems() {
+    const items = this.document.querySelectorAll(".todo-list li");
+    return Array.from(items);
+  }
+
+  /**
+   * Get todo item at 1-based position (as specified in scenarios).
+   */
+  getTodoAt(position) {
+    const items = this.getTodoItems();
+    return items[position - 1];
+  }
+
+  /**
+   * Get visible (non-hidden) todo items for the current route filter.
+   */
+  getVisibleTodoItems() {
+    const items = this.getTodoItems();
+    return items.filter((item) => {
+      const style = this.window.getComputedStyle(item);
+      return style.display !== "none";
+    });
+  }
+
+  /**
+   * Type text into the new-todo input and press Enter.
+   */
+  typeAndSubmit(text) {
+    const input = this.document.querySelector(".new-todo");
+    input.value = text;
+    input.dispatchEvent(new this.window.Event("input", { bubbles: true }));
+    // Simulate Enter key
+    const enterEvent = new this.window.KeyboardEvent("keydown", {
+      key: "Enter",
+      keyCode: 13,
+      bubbles: true,
+    });
+    input.dispatchEvent(enterEvent);
+  }
+
+  /**
+   * Create a todo by typing and submitting.
+   */
+  createTodo(title) {
+    this.typeAndSubmit(title);
+  }
+
+  /**
+   * Create a completed todo.
+   */
+  createCompletedTodo(title) {
+    this.createTodo(title);
+    const items = this.getTodoItems();
+    const lastItem = items[items.length - 1];
+    if (lastItem) {
+      const checkbox = lastItem.querySelector(".toggle");
+      if (checkbox) {
+        checkbox.click();
+      }
+    }
+  }
+
+  /**
+   * Double-click a todo label to enter editing mode.
+   */
+  doubleClickTodoLabel(position) {
+    const item = this.getTodoAt(position);
+    if (item) {
+      const label = item.querySelector("label");
+      if (label) {
+        const dblClickEvent = new this.window.Event("dblclick", { bubbles: true });
+        label.dispatchEvent(dblClickEvent);
+      }
+    }
+  }
+
+  /**
+   * Change the edit input value and trigger an action (Enter, Escape, or blur).
+   */
+  changeEditInput(position, newValue, action) {
+    const item = this.getTodoAt(position);
+    if (item) {
+      const editInput = item.querySelector(".edit");
+      if (editInput) {
+        // Focus the edit input first
+        editInput.focus();
+        editInput.value = newValue;
+        editInput.dispatchEvent(new this.window.Event("input", { bubbles: true }));
+
+        if (action === "Enter") {
+          const enterEvent = new this.window.KeyboardEvent("keydown", {
+            key: "Enter",
+            keyCode: 13,
+            bubbles: true,
+          });
+          editInput.dispatchEvent(enterEvent);
+        } else if (action === "Escape") {
+          const escapeEvent = new this.window.KeyboardEvent("keydown", {
+            key: "Escape",
+            keyCode: 27,
+            bubbles: true,
+          });
+          editInput.dispatchEvent(escapeEvent);
+        } else if (action === "blur") {
+          editInput.dispatchEvent(new this.window.Event("blur", { bubbles: true }));
+        }
+      }
+    }
+  }
+
+  /**
+   * Clear the edit input and press Enter (deletes the todo).
+   */
+  clearEditInput(position) {
+    const item = this.getTodoAt(position);
+    if (item) {
+      const editInput = item.querySelector(".edit");
+      if (editInput) {
+        editInput.focus();
+        editInput.value = "";
+        editInput.dispatchEvent(new this.window.Event("input", { bubbles: true }));
+        const enterEvent = new this.window.KeyboardEvent("keydown", {
+          key: "Enter",
+          keyCode: 13,
+          bubbles: true,
+        });
+        editInput.dispatchEvent(enterEvent);
+      }
+    }
+  }
+
+  /**
+   * Click the toggle checkbox of a todo at a position.
+   */
+  clickToggle(position) {
+    const item = this.getTodoAt(position);
+    if (item) {
+      const checkbox = item.querySelector(".toggle");
+      if (checkbox) {
+        checkbox.click();
+      }
+    }
+  }
+
+  /**
+   * Hover over a todo item.
+   */
+  hoverTodo(position) {
+    const item = this.getTodoAt(position);
+    if (item) {
+      item.dispatchEvent(new this.window.Event("mouseenter", { bubbles: true }));
+      item.dispatchEvent(new this.window.Event("mouseover", { bubbles: true }));
+      // Simulate CSS :hover by adding a class
+      item.classList.add("hover");
+    }
+  }
+
+  /**
+   * Click the destroy button of a todo at a position.
+   */
+  clickDestroy(position) {
+    const item = this.getTodoAt(position);
+    if (item) {
+      const destroyBtn = item.querySelector(".destroy");
+      if (destroyBtn) {
+        destroyBtn.click();
+      }
+    }
+  }
+
+  /**
+   * Click the toggle-all checkbox.
+   */
+  clickToggleAll() {
+    const toggleAll = this.document.querySelector("#toggle-all");
+    if (toggleAll) {
+      toggleAll.click();
+    }
+  }
+
+  /**
+   * Click the Clear completed button.
+   */
+  clickClearCompleted() {
+    const clearBtn = this.document.querySelector(".clear-completed");
+    if (clearBtn) {
+      clearBtn.click();
+    }
+  }
+
+  /**
+   * Get the counter text.
+   */
+  getCounterText() {
+    const counter = this.document.querySelector(".todo-count");
+    return counter ? counter.textContent.trim() : "";
+  }
+
+  /**
+   * Get the main section element.
+   */
+  getMainSection() {
+    return this.document.querySelector(".main");
+  }
+
+  /**
+   * Get the footer element.
+   */
+  getFooter() {
+    return this.document.querySelector(".footer");
+  }
+
+  /**
+   * Check if the destroy button is visible (has hover state).
+   */
+  isDestroyVisible(position) {
+    const item = this.getTodoAt(position);
+    if (!item) return false;
+    const destroyBtn = item.querySelector(".destroy");
+    if (!destroyBtn) return false;
+    const style = this.window.getComputedStyle(destroyBtn);
+    return style.display !== "none" && style.visibility !== "hidden";
+  }
+
+  /**
+   * Check if the Clear completed button is visible.
+   */
+  isClearCompletedVisible() {
+    const btn = this.document.querySelector(".clear-completed");
+    if (!btn) return false;
+    const style = this.window.getComputedStyle(btn);
+    return style.display !== "none" && style.visibility !== "hidden";
+  }
+}
+
+/**
+ * Create a minimal TodoMVC app HTML for testing.
+ * This is used when index.html doesn't exist yet.
+ */
+function createMinimalAppHtml() {
+  return `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>TodoMVC</title>
+</head>
+<body>
+  <section class="todoapp">
+    <header class="header">
+      <h1>todos</h1>
+      <input class="new-todo" placeholder="What needs to be done?" autofocus>
+    </header>
+    <section class="main">
+      <input id="toggle-all" class="toggle-all" type="checkbox">
+      <label for="toggle-all">Mark all as complete</label>
+      <ul class="todo-list"></ul>
+    </section>
+    <footer class="footer">
+      <span class="todo-count"><strong>0</strong> items left</span>
+      <ul class="filters">
+        <li><a class="selected" href="#/">All</a></li>
+        <li><a href="#/active">Active</a></li>
+        <li><a href="#/completed">Completed</a></li>
+      </ul>
+      <button class="clear-completed">Clear completed</button>
+    </footer>
+  </section>
+  <footer class="info">
+    <p>Double-click to edit a todo</p>
+  </footer>
+  <script src="js/app.js"></script>
+</body>
+</html>`;
+}
