+  /**
+   * Check whether a todo is visible under the current filter.
+   */
+  function isTodoVisible(todo) {
+    if (currentFilter === 'active') return !todo.completed;
+    if (currentFilter === 'completed') return todo.completed;
+    return true;
+  }
+
+  /**
+   * Create a <li> element for a todo.
+   */
+  function createTodoLi(todo) {
+    var li = document.createElement('li');
+    li.setAttribute('data-id', todo.id);
+    if (todo.completed) li.classList.add('completed');
+
+    li.innerHTML =
+      '<div class="view">' +
+        '<input class="toggle" type="checkbox"' + (todo.completed ? ' checked' : '') + '>' +
+        '<label>' + escapeHtml(todo.title) + '</label>' +
+        '<button class="destroy"></button>' +
+      '</div>' +
+      '<input class="edit" value="' + escapeHtml(todo.title) + '">';
+
+    return li;
+  }
+
+  // --- Render ---
+  /**
+   * Update header/footer state without rebuilding the list.
+   */
+  function updateHeaderFooter() {
+    // Main section visibility
+    var hasTodos = todos.length > 0;
+    mainSection.style.display = hasTodos ? 'block' : 'none';
+    footer.style.display = hasTodos ? 'block' : 'none';
+
+    // Toggle all state
+    var allCompleted = todos.length > 0 && todos.every(function (t) { return t.completed; });
+    toggleAllCheckbox.checked = allCompleted;
+
+    // Counter
+    var activeCount = todos.filter(function (t) { return !t.completed; }).length;
+    var pluralized = activeCount === 1 ? 'item left' : 'items left';
+    todoCount.innerHTML = '<strong>' + activeCount + '</strong> ' + pluralized;
+
+    // Clear completed visibility
+    var hasCompleted = todos.some(function (t) { return t.completed; });
+    clearCompletedBtn.style.display = hasCompleted ? 'block' : 'none';
+  }
+
+  /**
+   * Render the full application state to the DOM.
+   * @planks("the app is loaded in the browser")
+   */
+  function render() {
+    var filtered = todos.filter(function (todo) {
+      if (currentFilter === 'active') return !todo.completed;
+      if (currentFilter === 'completed') return todo.completed;
+      return true;
+    });
+
+    // Clear list
+    todoList.innerHTML = '';
+
+    // Build items
+    filtered.forEach(function (todo) {
+      todoList.appendChild(createTodoLi(todo));
+    });
+
+    // Update header/footer
+    updateHeaderFooter();
+
+    // Filter selection
+    filterLinks.forEach(function (link) {
+      link.classList.remove('selected');
+    });
+    var filterHash = currentFilter === 'active' ? '#/active' : currentFilter === 'completed' ? '#/completed' : '#/';
+    filterLinks.forEach(function (link) {
+      if (link.getAttribute('href') === filterHash) {
+        link.classList.add('selected');
+      }
+    });
+  }
+
