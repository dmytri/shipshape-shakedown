@@ -0,0 +1,56 @@
+const assert = require('assert');
+const { Window } = require('happy-dom');
+const fs = require('fs');
+const path = require('path');
+
+const HTML_TEMPLATE = '<!doctype html><html lang="en"><head><meta charset="utf-8"></head><body><section class="todoapp"><header class="header"><h1>todos</h1><input class="new-todo" placeholder="What needs to be done?" autofocus></header><section class="main"><input id="toggle-all" class="toggle-all" type="checkbox"><label for="toggle-all">Mark all as complete</label><ul class="todo-list"></ul></section><footer class="footer"><span class="todo-count"><strong>0</strong> item left</span><ul class="filters"><li><a class="selected" href="#/">All</a></li><li><a href="#/active">Active</a></li><li><a href="#/completed">Completed</a></li></ul><button class="clear-completed">Clear completed</button></footer></section></body></html>';
+
+function qs(doc, sel) { return doc.querySelector(sel); }
+function qsa(doc, sel) { return doc.querySelectorAll(sel); }
+function setInputValue(input, value) {
+  input.value = value;
+  input.dispatchEvent(new input.ownerDocument.defaultView.Event('input', { bubbles: true }));
+}
+function pressKey(input, key) {
+  const ev = new input.ownerDocument.defaultView.KeyboardEvent('keydown', { key, bubbles: true, cancelable: true });
+  input.dispatchEvent(ev);
+}
+function dblclick(el) {
+  el.dispatchEvent(new el.ownerDocument.defaultView.MouseEvent('dblclick', { bubbles: true, cancelable: true }));
+}
+
+function createFreshWindow() {
+  const win = new Window({ url: 'http://localhost/' });
+  win.document.write(HTML_TEMPLATE);
+  win.document.close();
+  win.localStorage.clear();
+  const appPath = path.join(__dirname, 'js', 'app.js');
+  if (fs.existsSync(appPath)) {
+    const code = fs.readFileSync(appPath, 'utf-8');
+    try { win.eval(code); } catch (e) { console.error('App load error:', e.message); }
+  }
+  return win;
+}
+
+console.log('=== Test 1: Simple dblclick ===');
+const win = createFreshWindow();
+
+// Create a todo
+const input = qs(win.document, '.new-todo');
+setInputValue(input, 'Buy milk');
+pressKey(input, 'Enter');
+console.log('Todos after add:', qsa(win.document, '.todo-list li').length);
+
+// Dblclick
+const label = qs(win.document, '.todo-list li .view label');
+console.log('About to dblclick on:', label.textContent);
+dblclick(label);
+console.log('After dblclick');
+console.log('Editing class:', qs(win.document, '.todo-list li').classList.contains('editing'));
+
+// Check focus
+const editInput = qs(win.document, '.todo-list li .edit');
+console.log('Edit input exists:', !!editInput);
+console.log('Edit input value:', editInput ? editInput.value : 'N/A');
+console.log('activeElement is edit?', win.document.activeElement === editInput);
+console.log('=== Test 1 completed successfully ===');
