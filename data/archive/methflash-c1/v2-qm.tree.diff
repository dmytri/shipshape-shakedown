+const { Window } = require('happy-dom');
+const fs = require('fs');
+const path = require('path');
+
+const HTML_TEMPLATE = '<!doctype html><html lang="en"><head><meta charset="utf-8"></head><body><section class="todoapp"><header class="header"><h1>todos</h1><input class="new-todo" placeholder="What needs to be done?" autofocus></header><section class="main"><input id="toggle-all" class="toggle-all" type="checkbox"><label for="toggle-all">Mark all as complete</label><ul class="todo-list"></ul></section><footer class="footer"><span class="todo-count"><strong>0</strong> item left</span><ul class="filters"><li><a class="selected" href="#/">All</a></li><li><a href="#/active">Active</a></li><li><a href="#/completed">Completed</a></li></ul><button class="clear-completed">Clear completed</button></footer></section></body></html>';
+
+function qs(doc, sel) { return doc.querySelector(sel); }
+
+function pressKey(input, key) {
+  input.dispatchEvent(new input.ownerDocument.defaultView.KeyboardEvent('keydown', { key, bubbles: true, cancelable: true }));
+}
+
+// Create window and load app
+const win = new Window({ url: 'http://localhost/' });
+win.document.write(HTML_TEMPLATE);
+win.document.close();
+win.localStorage.clear();
+const appCode = fs.readFileSync(path.join('/home/exedev/shipshape-shakedown/.eval-scratch/methflash-c1/sim', 'js', 'app.js'), 'utf-8');
+win.eval(appCode);
+
+// Create a todo
+const input = qs(win.document, '.new-todo');
+input.value = 'Buy milk';
+pressKey(input, 'Enter');
+console.log('Todos:', win.document.querySelectorAll('.todo-list li').length);
+
+// Instead of dispatching dblclick, simulate what the dblclick handler does:
+// Find the li, set editingId, call render, focus edit input
+const li = win.document.querySelector('.todo-list li');
+const id = Number(li.getAttribute('data-id'));
+console.log('Todo ID:', id);
+
+// Simulate what dblclick handler does
+// Just call the same steps directly:
+const label = qs(win.document, '.todo-list li .view label');
+console.log('Label:', label.textContent);
+
+// Dispatch dblclick - but wrap in try/catch to see if it errors
+console.log('Dispatching dblclick...');
+try {
+  label.dispatchEvent(new win.MouseEvent('dblclick', { bubbles: true, cancelable: true }));
+  console.log('dblclick dispatched successfully');
+} catch (e) {
+  console.error('Error during dblclick:', e.message);
+}
+
+console.log('After dblclick');
+console.log('Editing:', win.document.querySelector('.todo-list li').classList.contains('editing'));
+console.log('Edit input:', !!qs(win.document, '.todo-list li .edit'));
+console.log('Done');
