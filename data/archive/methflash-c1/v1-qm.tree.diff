@@ -0,0 +1,78 @@
+const { Window } = require('happy-dom');
+const { setWorldConstructor, Before } = require('@cucumber/cucumber');
+const fs = require('fs');
+const path = require('path');
+
+const HTML_TEMPLATE = `<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Template • TodoMVC</title>
+</head>
+<body>
+  <section class="todoapp">
+    <header class="header">
+      <h1>todos</h1>
+      <input class="new-todo" placeholder="What needs to be done?" autofocus>
+    </header>
+    <section class="main">
+      <input id="toggle-all" class="toggle-all" type="checkbox">
+      <label for="toggle-all">Mark all as complete</label>
+      <ul class="todo-list"></ul>
+    </section>
+    <footer class="footer">
+      <span class="todo-count"><strong>0</strong> item left</span>
+      <ul class="filters">
+        <li><a class="selected" href="#/">All</a></li>
+        <li><a href="#/active">Active</a></li>
+        <li><a href="#/completed">Completed</a></li>
+      </ul>
+      <button class="clear-completed">Clear completed</button>
+    </footer>
+  </section>
+  <footer class="info">
+    <p>Double-click to edit a todo</p>
+  </footer>
+</body>
+</html>`;
+
+function TodoWorld() {
+  this.window = null;
+  this.document = null;
+}
+
+function createFreshWindow() {
+  const win = new Window({ url: 'http://localhost/' });
+  win.document.write(HTML_TEMPLATE);
+  win.document.close();
+  win.localStorage.clear();
+  // Load and eval app JS
+  const appPath = path.join(__dirname, '..', '..', 'js', 'app.js');
+  if (fs.existsSync(appPath)) {
+    const code = fs.readFileSync(appPath, 'utf-8');
+    try {
+      win.eval(code);
+    } catch (e) {
+      // app code not ready yet, step defs will handle
+    }
+  }
+  return win;
+}
+
+Before(function () {
+  const win = createFreshWindow();
+  this.window = win;
+  this.document = win.document;
+});
+
+// Reset world without fresh window - just clear state and re-eval
+function resetWorld(win) {
+  // The IIFE uses var at window scope; re-eval resets state.
+  // Instead, just re-create the window fresh.
+  const fresh = createFreshWindow();
+  // Preserve any localStorage we want to keep happens via getItem before call
+  return fresh;
+}
+
+setWorldConstructor(TodoWorld);
