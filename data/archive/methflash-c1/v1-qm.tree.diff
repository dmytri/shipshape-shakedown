+++ b/js/app.js
@@ -0,0 +1,290 @@
+/**
+ * @planks("the app is loaded")
+ * @planks("I type {string} into the new-todo input and press Enter")
+ * @planks("I click the toggle checkbox on the todo")
+ * @planks("I click the destroy button on the todo")
+ * @planks("I double-click the label of the todo")
+ * @planks("I click the toggle-all checkbox")
+ * @planks("I click the toggle checkbox on {string}")
+ * @planks("I click the clear-completed button")
+ * @planks("I create the following todos:")
+ * @planks("I clear the edit input and type {string}")
+ * @planks("I clear the edit input and type {string} and press Enter in the edit input")
+ * @planks("I clear the edit input and press Enter in the edit input")
+ * @planks("I clear the edit input and type {string} and press Escape")
+ * @planks("the edit input loses focus")
+ * @planks("I double-click the label of {string}")
+ * @planks("the app is reloaded")
+ * @planks("I navigate to the {string} route")
+ * @planks("the URL hash is {string}")
+ */
+(function () {
+  'use strict';
+
+  var STORAGE_KEY = 'todos-todomvc';
+  var ENTER_KEY = 13;
+  var ESCAPE_KEY = 27;
+
+  var todoApp = document.querySelector('.todoapp');
+  var main = todoApp.querySelector('.main');
+  var footer = todoApp.querySelector('.footer');
+  var newTodo = todoApp.querySelector('.new-todo');
+  var todoList = todoApp.querySelector('.todo-list');
+  var toggleAll = todoApp.querySelector('#toggle-all');
+  var todoCount = todoApp.querySelector('.todo-count');
+  var clearCompleted = todoApp.querySelector('.clear-completed');
+  var filters = todoApp.querySelectorAll('.filters a');
+
+  var todos = [];
+  var currentFilter = 'all';
+  var editingId = null;
+
+  function loadTodos() {
+    try {
+      var data = localStorage.getItem(STORAGE_KEY);
+      if (data) {
+        todos = JSON.parse(data);
+      } else {
+        todos = [];
+      }
+    } catch (e) {
+      todos = [];
+    }
+  }
+
+  function saveTodos() {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
+  }
+
+  function getFilteredTodos() {
+    switch (currentFilter) {
+      case 'active': return todos.filter(function (t) { return !t.completed; });
+      case 'completed': return todos.filter(function (t) { return t.completed; });
+      default: return todos;
+    }
+  }
+
+  function getActiveCount() {
+    return todos.filter(function (t) { return !t.completed; }).length;
+  }
+
+  function getCompletedCount() {
+    return todos.filter(function (t) { return t.completed; }).length;
+  }
+
+  function escapeHtml(str) {
+    var div = document.createElement('div');
+    div.appendChild(document.createTextNode(str));
+    return div.innerHTML;
+  }
+
+  function render() {
+    var filtered = getFilteredTodos();
+    var activeCount = getActiveCount();
+    var completedCount = getCompletedCount();
+
+    // Toggle visibility of main and footer
+    var hasTodos = todos.length > 0;
+    main.hidden = !hasTodos;
+    footer.hidden = !hasTodos;
+
+    // Render todo list
+    todoList.innerHTML = '';
+    filtered.forEach(function (todo) {
+      var li = document.createElement('li');
+      if (todo.completed) li.classList.add('completed');
+      if (todo.id === editingId) li.classList.add('editing');
+
+      li.setAttribute('data-id', todo.id);
+
+      li.innerHTML =
+        '<div class="view">' +
+          '<input class="toggle" type="checkbox" ' + (todo.completed ? 'checked' : '') + '>' +
+          '<label>' + escapeHtml(todo.title) + '</label>' +
+          '<button class="destroy"></button>' +
+        '</div>' +
+        '<input class="edit" value="' + escapeHtml(todo.title) + '">';
+
+      todoList.appendChild(li);
+    });
+
+    // Update count
+    var itemWord = activeCount === 1 ? 'item' : 'items';
+    todoCount.innerHTML = '<strong>' + activeCount + '</strong> ' + itemWord + ' left';
+
+    // Update toggle-all
+    toggleAll.checked = activeCount === 0 && todos.length > 0;
+
+    // Show/hide clear-completed
+    clearCompleted.hidden = completedCount === 0;
+
+    // Update filter links
+    filters.forEach(function (a) {
+      var href = a.getAttribute('href');
+      if (href === '#/' + (currentFilter === 'all' ? '' : currentFilter)) {
+        a.classList.add('selected');
+      } else {
+        a.classList.remove('selected');
+      }
+    });
+  }
+
+  function addTodo(title) {
+    var trimmed = title.trim();
+    if (!trimmed) return;
+    todos.push({
+      id: Date.now() + Math.random(),
+      title: trimmed,
+      completed: false
+    });
+    saveTodos();
+    render();
+  }
+
+  function removeTodo(id) {
+    todos = todos.filter(function (t) { return t.id !== id; });
+    saveTodos();
+    render();
+  }
+
+  function toggleTodo(id) {
+    todos.forEach(function (t) {
+      if (t.id === id) t.completed = !t.completed;
+    });
+    saveTodos();
+    render();
+  }
+
+  function setTodoTitle(id, title) {
+    var trimmed = title.trim();
+    if (!trimmed) {
+      removeTodo(id);
+      return;
+    }
+    todos.forEach(function (t) {
+      if (t.id === id) t.title = trimmed;
+    });
+    saveTodos();
+    render();
+  }
+
+  function toggleAllFn() {
+    var activeCount = getActiveCount();
+    var allCompleted = activeCount === 0;
+    todos.forEach(function (t) {
+      t.completed = !allCompleted;
+    });
+    saveTodos();
+    render();
+  }
+
+  function clearCompletedTodos() {
+    todos = todos.filter(function (t) { return !t.completed; });
+    saveTodos();
+    render();
+  }
+
+  function setFilter(filter) {
+    currentFilter = filter;
+    render();
+  }
+
+  function getIdFromChild(el) {
+    var li = el.closest ? el.closest('li') : el.parentNode;
+    while (li && li.tagName !== 'LI') li = li.parentNode;
+    if (li) return Number(li.getAttribute('data-id'));
+    return null;
+  }
+
+  // --- Event handlers ---
+
+  newTodo.addEventListener('keydown', function (e) {
+    if (e.key === 'Enter' || e.keyCode === ENTER_KEY) {
+      addTodo(newTodo.value);
+      newTodo.value = '';
+    }
+  });
+
+  todoList.addEventListener('click', function (e) {
+    var target = e.target;
+    if (target.classList.contains('toggle')) {
+      var id = getIdFromChild(target);
+      if (id !== null) toggleTodo(id);
+    } else if (target.classList.contains('destroy')) {
+      var id = getIdFromChild(target);
+      if (id !== null) removeTodo(id);
+    }
+  });
+
+  todoList.addEventListener('dblclick', function (e) {
+    var label = e.target;
+    if (label.tagName === 'LABEL') {
+      var li = label.closest ? label.closest('li') : label.parentNode;
+      while (li && li.tagName !== 'LI') li = li.parentNode;
+      if (li) {
+        var id = Number(li.getAttribute('data-id'));
