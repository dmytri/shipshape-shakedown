@@ -0,0 +1,319 @@
+const { Given, When, Then } = require('@cucumber/cucumber');
+const assert = require('assert');
+
+function qs(doc, sel) { return doc.querySelector(sel); }
+function qsa(doc, sel) { return doc.querySelectorAll(sel); }
+
+function setInputValue(input, value) {
+  input.value = value;
+  input.dispatchEvent(new input.ownerDocument.defaultView.Event('input', { bubbles: true }));
+}
+
+function pressKey(input, key) {
+  const ev = new input.ownerDocument.defaultView.KeyboardEvent('keydown', { key, bubbles: true, cancelable: true });
+  const prevented = !input.dispatchEvent(ev);
+  if (!prevented && key === 'Enter') {
+    const changeEv = new input.ownerDocument.defaultView.Event('change', { bubbles: true });
+    input.dispatchEvent(changeEv);
+  }
+  if (key === 'Escape') {
+    new input.ownerDocument.defaultView.KeyboardEvent('keyup', { key, bubbles: true });
+  }
+}
+
+function click(el) {
+  el.dispatchEvent(new el.ownerDocument.defaultView.MouseEvent('click', { bubbles: true, cancelable: true }));
+}
+
+function dblclick(el) {
+  el.dispatchEvent(new el.ownerDocument.defaultView.MouseEvent('dblclick', { bubbles: true, cancelable: true }));
+}
+
+function triggerBlur(el) {
+  el.dispatchEvent(new el.ownerDocument.defaultView.FocusEvent('blur', { bubbles: true }));
+}
+
+function getTodoItems(doc) { return qsa(doc, '.todo-list li'); }
+
+function getTodoText(item) {
+  const label = qs(item, 'label') || qs(item, '.view label');
+  return label ? label.textContent.trim() : '';
+}
+
+// ---- Shared ----
+
+Given('the app is loaded', function () {
+  // Create fresh window with app JS loaded
+  const { Window } = require('happy-dom');
+  const fs = require('fs');
+  const path = require('path');
+  const win = new Window({ url: 'http://localhost/' });
+  const html = '<!doctype html><html lang="en"><head><meta charset="utf-8"></head><body><section class="todoapp"><header class="header"><h1>todos</h1><input class="new-todo" placeholder="What needs to be done?" autofocus></header><section class="main"><input id="toggle-all" class="toggle-all" type="checkbox"><label for="toggle-all">Mark all as complete</label><ul class="todo-list"></ul></section><footer class="footer"><span class="todo-count"><strong>0</strong> item left</span><ul class="filters"><li><a class="selected" href="#/">All</a></li><li><a href="#/active">Active</a></li><li><a href="#/completed">Completed</a></li></ul><button class="clear-completed">Clear completed</button></footer></section></body></html>';
+  win.document.write(html);
+  win.document.close();
+  win.localStorage.clear();
+  const appPath = path.join(__dirname, '..', '..', 'js', 'app.js');
+  if (fs.existsSync(appPath)) {
+    const code = fs.readFileSync(appPath, 'utf-8');
+    try { win.eval(code); } catch (e) { /* app code not ready */ }
+  }
+  this.window = win;
+  this.document = win.document;
+});
+
+Given('the input field shows {string}', function (expected) {
+  assert.strictEqual(qs(this.document, '.new-todo').placeholder, expected);
+});
+
+When('I type {string} into the new-todo input and press Enter', function (text) {
+  const input = qs(this.document, '.new-todo');
+  setInputValue(input, text);
+  pressKey(input, 'Enter');
+});
+
+Then('the todo list shows an item with the text {string}', function (text) {
+  assert(Array.from(getTodoItems(this.document)).some(i => getTodoText(i) === text));
+});
+
+Then('the input field is cleared', function () {
+  assert.strictEqual(qs(this.document, '.new-todo').value, '');
+});
+
+Then('no new item is added to the list', function () {
+  assert.strictEqual(getTodoItems(this.document).length, 0);
+});
+
+Given('there are no todos', function () {
+  assert.strictEqual(getTodoItems(this.document).length, 0);
+  this.window.localStorage.removeItem('todos-todomvc');
+});
+
+Then('the section with class {string} is not visible', function (cls) {
+  const el = qs(this.document, '.' + cls);
+  if (el) assert(el.hidden || el.getBoundingClientRect().height === 0);
+});
+
+Then('the footer is not visible', function () {
+  const el = qs(this.document, '.footer');
+  if (el) assert(el.hidden || el.getBoundingClientRect().height === 0);
+});
+
+Then('the section with class {string} is visible', function (cls) {
+  const el = qs(this.document, '.' + cls);
+  assert(el);
+  assert(!el.hidden);
+});
+
+Then('the footer is visible', function () {
+  const el = qs(this.document, '.footer');
+  assert(el);
+  assert(!el.hidden);
+});
+
+When('I click the toggle checkbox on the todo', function () {
+  click(qs(this.document, '.todo-list li .toggle'));
+});
+
+Then('the todo item receives the class {string}', function (cls) {
+  assert(getTodoItems(this.document)[0].classList.contains(cls));
+});
+
+Then('its toggle checkbox becomes checked', function () {
+  assert(qs(this.document, '.todo-list li .toggle').checked);
+});
+
+When('I click the destroy button on the todo', function () {
+  click(qs(this.document, '.todo-list li .destroy'));
+});
+
+Then('the todo is removed from the list', function () {
+  assert.strictEqual(getTodoItems(this.document).length, 0);
+});
+
+Given('I create the following todos:', function (dt) {
+  for (const r of dt.raw()) {
+    if (r[0]) {
+      const input = qs(this.document, '.new-todo');
+      setInputValue(input, r[0]);
+      pressKey(input, 'Enter');
+    }
+  }
+});
+
+When('I click the toggle-all checkbox', function () {
+  click(qs(this.document, '#toggle-all'));
+});
+
+Then('all todos have the class {string}', function (cls) {
+  assert(Array.from(getTodoItems(this.document)).every(i => i.classList.contains(cls)));
+});
+
+Then('the toggle-all checkbox is checked', function () {
+  assert(qs(this.document, '#toggle-all').checked);
+});
+
+Then('the toggle-all checkbox is not checked', function () {
+  assert(!qs(this.document, '#toggle-all').checked);
+});
+
+When('I click the toggle checkbox on {string}', function (text) {
+  const items = getTodoItems(this.document);
+  const item = Array.from(items).find(i => getTodoText(i) === text);
+  click(qs(item, '.toggle'));
+});
+
+When('I click the clear-completed button', function () {
+  click(qs(this.document, '.clear-completed'));
+});
+
+Then('the todo-count shows {string}', function (html) {
+  assert.strictEqual(qs(this.document, '.todo-count').innerHTML.trim(), html);
+});
+
+Then('the todo list shows only {string}', function (text) {
+  const items = getTodoItems(this.document);
+  assert.strictEqual(items.length, 1);
+  assert.strictEqual(getTodoText(items[0]), text);
+});
+
+Then('the clear-completed button is hidden', function () {
+  const btn = qs(this.document, '.clear-completed');
+  if (btn) assert(btn.hidden);
+});
+
+When('I double-click the label of the todo', function () {
+  dblclick(qs(this.document, '.todo-list li .view label'));
+});
+
+Then('the edit input is focused', function () {
+  const editInput = qs(this.document, '.todo-list li .edit');
+  assert(editInput, 'Expected an edit input');
+  // activeElement may not be supported in happy-dom, just check the input exists
+  if (this.document.activeElement) {
+    assert.strictEqual(this.document.activeElement, editInput);
+  }
+});
+
+// ---- Editing ----
+
+Given('the edit input shows {string}', function (val) {
+  assert.strictEqual(qs(this.document, '.todo-list li .edit').value, val);
+});
+
+When('I clear the edit input and type {string}', function (text) {
+  const ei = qs(this.document, '.todo-list li .edit');
+  ei.value = '';
+  setInputValue(ei, text);
+});
+
+When('the edit input loses focus', function () {
+  triggerBlur(qs(this.document, '.todo-list li .edit'));
+});
+
+Then('the todo label shows {string}', function (text) {
+  assert.strictEqual(qs(this.document, '.todo-list li .view label').textContent.trim(), text);
+});
+
+Then('the {string} class is removed from the todo item', function (cls) {
+  assert(!Array.from(getTodoItems(this.document)).some(i => i.classList.contains(cls)));
+});
+
+When('I clear the edit input and type {string} and press Enter in the edit input', function (text) {
+  const ei = qs(this.document, '.todo-list li .edit');
+  ei.value = '';
+  setInputValue(ei, text);
+  pressKey(ei, 'Enter');
+});
+
+When('I clear the edit input and press Enter in the edit input', function () {
+  const ei = qs(this.document, '.todo-list li .edit');
+  ei.value = '';
+  pressKey(ei, 'Enter');
+});
+
+When('I clear the edit input and type {string} and press Escape', function (text) {
+  const ei = qs(this.document, '.todo-list li .edit');
+  el.value = '';
+  setInputValue(ei, text);
+  pressKey(ei, 'Escape');
+});
+
+// ---- Persistence ----
+
+When('the app is reloaded', function () {
+  // Save localStorage before creating fresh window
+  const saved = this.window.localStorage.getItem('todos-todomvc');
+  const fs = require('fs');
+  const path = require('path');
+  const { Window } = require('happy-dom');
+  const win = new Window({ url: 'http://localhost/' });
+  const html = '<!doctype html><html lang="en"><head><meta charset="utf-8"></head><body><section class="todoapp"><header class="header"><h1>todos</h1><input class="new-todo" placeholder="What needs to be done?" autofocus></header><section class="main"><input id="toggle-all" class="toggle-all" type="checkbox"><label for="toggle-all">Mark all as complete</label><ul class="todo-list"></ul></section><footer class="footer"><span class="todo-count"><strong>0</strong> item left</span><ul class="filters"><li><a class="selected" href="#/">All</a></li><li><a href="#/active">Active</a></li><li><a href="#/completed">Completed</a></li></ul><button class="clear-completed">Clear completed</button></footer></section></body></html>';
+  win.document.write(html);
+  win.document.close();
+  if (saved) win.localStorage.setItem('todos-todomvc', saved);
+  const appPath = path.join(__dirname, '..', '..', 'js', 'app.js');
+  if (fs.existsSync(appPath)) {
+    const code = fs.readFileSync(appPath, 'utf-8');
+    try { win.eval(code); } catch (e) { /* app code not ready */ }
+  }
+  this.window = win;
+  this.document = win.document;
+});
+
+Then('the todo list shows {int} items', function (count) {
+  assert.strictEqual(getTodoItems(this.document).length, count);
+});
+
+Then('the todo list shows {string}', function (text) {
+  assert(Array.from(getTodoItems(this.document)).some(i => getTodoText(i) === text));
+});
+
+Then('{string} has the class {string}', function (todoText, cls) {
+  const items = getTodoItems(this.document);
+  const item = Array.from(items).find(i => getTodoText(i) === todoText);
+  assert(item.classList.contains(cls));
+});
+
+When('I double-click the label of {string}', function (text) {
+  const items = getTodoItems(this.document);
+  const item = Array.from(items).find(i => getTodoText(i) === text);
+  dblclick(qs(item, '.view label'));
+});
+
+Given('I navigate to the {string} route', function (route) {
+  this.window.location.hash = route;
+  this.window.dispatchEvent(new this.window.HashChangeEvent('hashchange', {
+    oldURL: this.window.location.href,
+    newURL: this.window.location.href
+  }));
+});
+
+Then('the {string} filter link has the {string} class', function (filterText, cls) {
+  const links = qsa(this.document, '.filters a');
+  const link = Array.from(links).find(l => l.textContent.trim() === filterText);
+  assert(link.classList.contains(cls));
+});
+
+Then('no todo item has the {string} class', function (cls) {
+  assert(!Array.from(getTodoItems(this.document)).some(i => i.classList.contains(cls)));
+});
+
+Given('the URL hash is {string}', function (hash) {
+  this.window.location.hash = hash;
+  this.window.dispatchEvent(new this.window.HashChangeEvent('hashchange', {
+    oldURL: this.window.location.href,
+    newURL: this.window.location.href
+  }));
+});
+
+Then('the todo list does not include {string}', function (text) {
+  assert(!Array.from(getTodoItems(this.document)).some(i => getTodoText(i) === text));
+});
+
+Then('the todo list shows {int} item', function (count) {
+  assert.strictEqual(getTodoItems(this.document).length, count);
+});
+
+Then('{string} is not shown in the todo list', function (text) {
+  assert(!Array.from(getTodoItems(this.document)).some(i => getTodoText(i) === text));
+});
