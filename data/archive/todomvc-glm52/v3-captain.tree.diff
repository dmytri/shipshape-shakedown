+  // True when `el` or any ancestor is hidden via CSS `display: none`. A
+  // `display:none` ancestor means the subtree is not rendered, even though
+  // `getComputedStyle(child).display` keeps the child's own resolved value.
+  isHiddenByCss(el) {
+    let node = el;
+    while (node && node.nodeType === 1) {
+      if (this.window.getComputedStyle(node).display === 'none') {
+        return true;
+      }
+      node = node.parentElement;
+    }
+    return false;
+  }
