+const { Given, When, Then } = require('@cucumber/cucumber');
+const assert = require('assert');
+
+// Background: the TodoMVC app is open
+Given('the TodoMVC app is open', function () {
+  this.openApp();
+});
+
+// Setup: user has created a todo
+Given('the user has created a todo {string}', function (title) {
+  this.createTodo(title);
+});
+
+// Setup: user has created multiple todos
+Given('the user has created todos {string} and {string}', function (title1, title2) {
+  this.createTodo(title1);
+  this.createTodo(title2);
+});
+
+// Setup: user has toggled a todo
+Given('the user has toggled the todo at position {int}', function (pos) {
+  const todo = this.getTodoAtPosition(pos);
+  const checkbox = todo.querySelector('.toggle');
+  checkbox.click();
+});
+
+// Navigation
+When('the user navigates to {string}', function (hash) {
+  this.window.location.hash = hash;
+});
+
+// Create todo by typing and pressing Enter
+When('the user types {string} in the new-todo input and presses Enter', function (text) {
+  const input = this.document.querySelector('.new-todo');
+  input.value = text;
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13 }));
+});
+
+// Double-click todo
+When('the user double-clicks the todo at position {int}', function (pos) {
+  const todo = this.getTodoAtPosition(pos);
+  const label = todo.querySelector('label');
+  label.dispatchEvent(new this.window.Event('dblclick'));
+});
+
+// Edit: type in edit input and press Enter
+When('the user types {string} in the edit input at position {int} and presses Enter', function (text, pos) {
+  const todo = this.getTodoAtPosition(pos);
+  const editInput = todo.querySelector('.edit');
+  editInput.value = text;
+  editInput.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13 }));
+});
+
+// Edit: type in edit input and blur
+When('the user types {string} in the edit input at position {int} and blurs', function (text, pos) {
+  const todo = this.getTodoAtPosition(pos);
+  const editInput = todo.querySelector('.edit');
+  editInput.value = text;
+  editInput.dispatchEvent(new this.window.Event('blur'));
+});
+
+// Edit: type in edit input and press Escape
+When('the user types {string} in the edit input at position {int} and presses Escape', function (text, pos) {
+  const todo = this.getTodoAtPosition(pos);
+  const editInput = todo.querySelector('.edit');
+  editInput.value = text;
+  editInput.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Escape', keyCode: 27 }));
+});
+
+// Edit: clear edit input and press Enter
+When('the user clears the edit input at position {int} and presses Enter', function (pos) {
+  const todo = this.getTodoAtPosition(pos);
+  const editInput = todo.querySelector('.edit');
+  editInput.value = '';
+  editInput.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13 }));
+});
+
+// Toggle a todo
+When('the user toggles the todo at position {int}', function (pos) {
+  const todo = this.getTodoAtPosition(pos);
+  const checkbox = todo.querySelector('.toggle');
+  checkbox.click();
+});
+
+// Toggle all
+When('the user toggles the toggle-all checkbox', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  toggleAll.click();
+});
+
+// Click button
+When('the user clicks the {string} button', function (buttonText) {
+  const buttons = Array.from(this.document.querySelectorAll('button'));
+  const btn = buttons.find(b => b.textContent.trim() === buttonText);
+  btn.click();
+});
+
+// Page reload
+When('the page reloads', function () {
+  const html = this.document.documentElement.outerHTML;
+  const url = this.window.location.href;
+  this.window = new (require('happy-dom').Window)({ url });
+  this.document = this.window.document;
+  this.document.open();
+  this.document.write(html);
+  this.document.close();
+});
+
+// Assertions: new-todo input focused
+Then('the new-todo input is focused', function () {
+  const input = this.document.querySelector('.new-todo');
+  assert.strictEqual(this.document.activeElement, input);
+});
+
+// Assertions: main section visibility
+Then('the main section is hidden', function () {
+  const main = this.document.querySelector('.main');
+  const style = this.window.getComputedStyle(main);
+  assert.strictEqual(style.display, 'none');
+});
+
+Then('the main section is visible', function () {
+  const main = this.document.querySelector('.main');
+  const style = this.window.getComputedStyle(main);
+  assert.notStrictEqual(style.display, 'none');
+});
+
+// Assertions: footer section visibility
+Then('the footer section is hidden', function () {
+  const footer = this.document.querySelector('.footer');
+  const style = this.window.getComputedStyle(footer);
+  assert.strictEqual(style.display, 'none');
+});
+
+Then('the footer section is visible', function () {
+  const footer = this.document.querySelector('.footer');
+  const style = this.window.getComputedStyle(footer);
+  assert.notStrictEqual(style.display, 'none');
+});
+
+// Assertions: todo list count
+Then('the todo list contains {int} item(s)', function (count) {
+  const items = this.getTodoItems();
+  assert.strictEqual(items.length, count);
+});
+
+Then('the todo list displays {int} item(s)', function (count) {
+  const items = this.getVisibleTodoItems();
+  assert.strictEqual(items.length, count);
+});
+
+// Assertions: todo title
+Then('the todo at position {int} has title {string}', function (pos, title) {
+  const todo = this.getTodoAtPosition(pos);
+  const label = todo.querySelector('label');
+  assert.strictEqual(label.textContent, title);
+});
+
+// Assertions: todo completion state
+Then('the todo at position {int} is completed', function (pos) {
+  const todo = this.getTodoAtPosition(pos);
+  assert.ok(todo.classList.contains('completed'));
+});
+
+Then('the todo at position {int} is not completed', function (pos) {
+  const todo = this.getTodoAtPosition(pos);
+  assert.ok(!todo.classList.contains('completed'));
+});
+
+// Assertions: editing class
+Then('the todo at position {int} has the editing class', function (pos) {
+  const todo = this.getTodoAtPosition(pos);
+  assert.ok(todo.classList.contains('editing'));
+});
+
+Then('the todo at position {int} does not have the editing class', function (pos) {
+  const todo = this.getTodoAtPosition(pos);
+  assert.ok(!todo.classList.contains('editing'));
+});
+
+// Assertions: edit input
+Then('the edit input at position {int} contains {string}', function (pos, text) {
+  const todo = this.getTodoAtPosition(pos);
+  const editInput = todo.querySelector('.edit');
+  assert.strictEqual(editInput.value, text);
+});
+
+Then('the edit input at position {int} is focused', function (pos) {
+  const todo = this.getTodoAtPosition(pos);
+  const editInput = todo.querySelector('.edit');
+  assert.strictEqual(this.document.activeElement, editInput);
+});
+
+// Assertions: new-todo input empty
+Then('the new-todo input is empty', function () {
+  const input = this.document.querySelector('.new-todo');
+  assert.strictEqual(input.value, '');
+});
+
+// Assertions: active count
+Then('the active count displays {string}', function (text) {
+  const count = this.document.querySelector('.todo-count');
+  assert.strictEqual(count.textContent.trim(), text);
+});
+
+// Assertions: toggle-all checkbox
+Then('the toggle-all checkbox is checked', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  assert.ok(toggleAll.checked);
+});
+
+Then('the toggle-all checkbox is not checked', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  assert.ok(!toggleAll.checked);
+});
+
+// Assertions: filter link selected
+Then('the {string} filter link is selected', function (filterName) {
+  const links = Array.from(this.document.querySelectorAll('.filters a'));
+  const link = links.find(a => a.textContent.trim() === filterName);
+  assert.ok(link.classList.contains('selected'));
+});
+
+// Assertions: clear completed button
+Then('the "Clear completed" button is hidden', function () {
+  const btn = this.document.querySelector('.clear-completed');
+  const style = this.window.getComputedStyle(btn);
+  assert.strictEqual(style.display, 'none');
+});
+
+Then('the "Clear completed" button is visible', function () {
+  const btn = this.document.querySelector('.clear-completed');
+  const style = this.window.getComputedStyle(btn);
+  assert.notStrictEqual(style.display, 'none');
+});
+
+// Assertions: visible todo title
+Then('the visible todo has title {string}', function (title) {
+  const items = this.getVisibleTodoItems();
+  const found = items.some(item => {
+    const label = item.querySelector('label');
+    return label.textContent === title;
+  });
+  assert.ok(found, `No visible todo with title "${title}"`);
+});
