+const { setWorldConstructor, World } = require('@cucumber/cucumber');
+const { Window } = require('happy-dom');
+const fs = require('fs');
+const path = require('path');
+
+class TodoWorld extends World {
+  constructor(options) {
+    super(options);
+    this.window = null;
+    this.document = null;
+  }
+
+  openApp() {
+    // Close previous window if any
+    this.closeWindow();
+    
+    const htmlPath = path.resolve(__dirname, '../../index.html');
+    let html = fs.readFileSync(htmlPath, 'utf8');
+    // Strip external resource references to avoid socket leaks
+    html = html.replace(/<link[^>]*>/g, '');
+    html = html.replace(/<script[^>]*>[\s\S]*?<\/script>/g, '');
+    this.window = new Window({ url: 'http://localhost/' });
+    this.document = this.window.document;
+    this.document.open();
+    this.document.write(html);
+    this.document.close();
+  }
+
+  closeWindow() {
+    if (this.window) {
+      try {
+        // Destroy all child nodes to release references
+        while (this.document && this.document.documentElement) {
+          this.document.documentElement.remove();
+        }
+        this.window.close();
+      } catch (e) {}
+      this.window = null;
+      this.document = null;
+    }
+  }
+
+  getTodoItems() {
+    return Array.from(this.document.querySelectorAll('.todo-list li'));
+  }
+
+  getVisibleTodoItems() {
+    return this.getTodoItems().filter(li => {
+      const style = this.window.getComputedStyle(li);
+      return style.display !== 'none';
+    });
+  }
+
+  getTodoAtPosition(pos) {
+    const items = this.getTodoItems();
+    return items[pos - 1] || null;
+  }
+
+  createTodo(title) {
+    const input = this.document.querySelector('.new-todo');
+    input.value = title;
+    input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13 }));
+  }
+}
+
+setWorldConstructor(TodoWorld);
