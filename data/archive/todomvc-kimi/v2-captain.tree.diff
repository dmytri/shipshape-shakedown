+	assert.ok(this.notedRow, 'expected a noted row');
+	const li = this.findItem(title);
+	assert.ok(li, 'expected a todo titled ' + title);
+	assert.ok(li === this.notedRow, 'expected the row for ' + title + ' to be updated in place, not rebuilt');
+});
+
+Then('the toggle control for {string} is hidden', function (title) {
+	const li = this.findItem(title);
+	assert.ok(li, 'expected a todo titled ' + title);
+	const toggle = li.querySelector('.toggle');
+	assert.equal(this.window.getComputedStyle(toggle).display, 'none', 'expected the toggle for ' + title + ' to be hidden');
+});
+
+Then('the destroy control for {string} is hidden', function (title) {
+	const li = this.findItem(title);
+	assert.ok(li, 'expected a todo titled ' + title);
+	const destroy = li.querySelector('.destroy');
+	assert.equal(this.window.getComputedStyle(destroy).display, 'none', 'expected the destroy control for ' + title + ' to be hidden');
+});
