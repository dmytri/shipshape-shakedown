+++ b/watchbill.json
@@ -0,0 +1,28 @@
+{
+  "watch1": {
+    "scenarios": [
+      "features/managing-todos.feature:An empty todo list hides the list section and the footer",
+      "features/managing-todos.feature:Submitting a new todo appends it and clears the input",
+      "features/managing-todos.feature:A blank title is not added",
+      "features/managing-todos.feature:Whitespace around a new title is trimmed",
+      "features/managing-todos.feature:Completing a todo marks it completed",
+      "features/managing-todos.feature:The counter pluralizes the item count",
+      "features/managing-todos.feature:Marking all todos as complete completes every todo",
+      "features/managing-todos.feature:Uncompleting one todo unchecks the mark-all control",
+      "features/managing-todos.feature:Editing a todo saves the new title",
+      "features/managing-todos.feature:Editing a todo to a blank title destroys it",
+      "features/managing-todos.feature:Escape during editing discards the change",
+      "features/managing-todos.feature:Destroying a todo removes it",
+      "features/managing-todos.feature:Clear completed removes only completed todos",
+      "features/managing-todos.feature:The clear completed control hides when no todo is completed",
+      "features/persistence.feature:Todos and their completion state survive a reload",
+      "features/persistence.feature:Stored todos use the todos-vanillajs key with id, title, and completed fields",
+      "features/persistence.feature:Editing mode is not persisted",
+      "features/routing.feature:The default route shows every todo",
+      "features/routing.feature:The active route shows only active todos",
+      "features/routing.feature:The completed route shows only completed todos",
+      "features/routing.feature:Completing a todo on the active route hides it",
+      "features/routing.feature:The active filter survives a reload"
+    ]
+  }
+}
