+const { setWorldConstructor, Before, After } = require('@cucumber/cucumber');
+const { Window } = require('happy-dom');
+const fs = require('fs');
+const path = require('path');
+
+class TodoWorld {
+  constructor() {
+    this.window = null;
+    this.document = null;
+  }
+
+  async setupDOM() {
+    const window = new Window({
+      url: 'http://localhost/',
+      width: 1024,
+      height: 768,
+    });
+    const document = window.document;
+
+    document.write(`
+      <!doctype html>
+      <html lang="en">
+        <head>
+          <meta charset="utf-8">
+          <meta name="viewport" content="width=device-width, initial-scale=1">
+          <title>TodoMVC</title>
+        </head>
+        <body>
+          <section class="todoapp">
+            <header class="header">
+              <h1>todos</h1>
+              <input class="new-todo" placeholder="What needs to be done?" autofocus>
+            </header>
+            <section class="main">
+              <input id="toggle-all" class="toggle-all" type="checkbox">
+              <label for="toggle-all">Mark all as complete</label>
+              <ul class="todo-list"></ul>
+            </section>
+            <footer class="footer">
+              <span class="todo-count"><strong>0</strong> item left</span>
+              <ul class="filters">
+                <li><a class="selected" href="#/">All</a></li>
+                <li><a href="#/active">Active</a></li>
+                <li><a href="#/completed">Completed</a></li>
+              </ul>
+              <button class="clear-completed">Clear completed</button>
+            </footer>
+          </section>
+        </body>
+      </html>
+    `);
+
+    this.window = window;
+    this.document = document;
+
+    // Load and execute app.js in the window context
+    const appJsPath = path.join(__dirname, '..', '..', 'js', 'app.js');
+    if (fs.existsSync(appJsPath)) {
+      const appJsCode = fs.readFileSync(appJsPath, 'utf8');
+      window.eval(appJsCode);
+    }
+  }
+
+  async resetState() {
+    if (this.window) {
+      this.window.localStorage.clear();
+      this.window.close();
+    }
+    await this.setupDOM();
+  }
+
+  typeInto(element, text) {
+    element.value = text;
+    element.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+  }
+
+  pressKey(element, key) {
+    var keyCode = key === 'Enter' ? 13 : key === 'Escape' ? 27 : 0;
+    var event = new this.window.KeyboardEvent('keydown', {
+      key: key,
+      keyCode: keyCode,
+      which: keyCode,
+      bubbles: true,
+    });
+    element.dispatchEvent(event);
+  }
+
+  click(element) {
+    element.dispatchEvent(new this.window.MouseEvent('click', { bubbles: true }));
+  }
+
+  doubleClick(element) {
+    element.dispatchEvent(new this.window.MouseEvent('dblclick', { bubbles: true }));
+  }
+
+  findTodoLi(title) {
+    var labels = this.document.querySelectorAll('.todo-list li .view label');
+    for (var i = 0; i < labels.length; i++) {
+      if (labels[i].textContent.trim() === title) {
+        return labels[i].closest('li');
+      }
+    }
+    return null;
+  }
+}
