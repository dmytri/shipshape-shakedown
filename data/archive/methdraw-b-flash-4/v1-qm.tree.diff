+++ b/features/step_definitions/when_steps.js
@@ -0,0 +1,162 @@
+const { When } = require('@cucumber/cucumber');
+const fs = require('fs');
+const path = require('path');
+
+When('the user types {string} into the new-todo input', async function (text) {
+  const input = this.document.querySelector('.new-todo');
+  this.typeInto(input, text);
+});
+
+When('presses Enter', async function () {
+  // Use the active element (edit input) or fall back to new-todo input
+  var target = this.document.activeElement;
+  if (!target || target === this.document.body) {
+    target = this.document.querySelector('.new-todo');
+  }
+  if (target) {
+    this.pressKey(target, 'Enter');
+  }
+});
+
+When('the user clicks the checkbox on the {string} todo', async function (title) {
+  const li = this.findTodoLi(title);
+  if (li) {
+    const checkbox = li.querySelector('.toggle');
+    this.click(checkbox);
+  }
+});
+
+When('the user hovers over the {string} todo', async function (title) {
+  const li = this.findTodoLi(title);
+  if (li) {
+    li.dispatchEvent(new this.window.MouseEvent('mouseenter', { bubbles: true }));
+  }
+});
+
+When('the user clicks the toggle-all checkbox', async function () {
+  const toggleAll = this.document.querySelector('.toggle-all');
+  this.click(toggleAll);
+});
+
+When('the user clicks the toggle-all checkbox again', async function () {
+  const toggleAll = this.document.querySelector('.toggle-all');
+  this.click(toggleAll);
+});
+
+When('the user clicks the checkbox on {string}', async function (title) {
+  const li = this.findTodoLi(title);
+  if (li) {
+    const checkbox = li.querySelector('.toggle');
+    this.click(checkbox);
+  }
+});
+
+When('the user clicks the {string} button', async function (buttonText) {
+  if (buttonText === 'Clear completed') {
+    const btn = this.document.querySelector('.clear-completed');
+    this.click(btn);
+  }
+});
+
+When('the user clicks the destroy button on {string}', async function (title) {
+  const li = this.findTodoLi(title);
+  if (li) {
+    const destroyBtn = li.querySelector('.destroy');
+    this.click(destroyBtn);
+  }
+});
+
+When('the user views the footer', async function () {
+  // No action needed - just verifying state
+});
+
+When('the user marks {string} as completed', async function (title) {
+  const li = this.findTodoLi(title);
+  if (li) {
+    const checkbox = li.querySelector('.toggle');
+    if (!checkbox.checked) {
+      this.click(checkbox);
+    }
+  }
+});
+
+When('the user double-clicks the label of {string}', async function (title) {
+  const li = this.findTodoLi(title);
+  if (li) {
+    const label = li.querySelector('.view label');
+    this.doubleClick(label);
+  }
+});
+
+When('the user changes the value to {string}', async function (newValue) {
+  const editInput = this.document.querySelector('.todo-list li.editing .edit');
+  if (editInput) {
+    editInput.value = newValue;
+    editInput.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+  }
+});
+
+When('the edit input loses focus', async function () {
+  const editInput = this.document.querySelector('.todo-list li.editing .edit');
+  if (editInput) {
+    editInput.dispatchEvent(new this.window.FocusEvent('blur', { bubbles: true }));
+  }
+});
+
+When('presses Escape', async function () {
+  var target = this.document.activeElement;
+  if (!target || target === this.document.body) {
+    target = this.document.querySelector('.new-todo');
+  }
+  if (target) {
+    this.pressKey(target, 'Escape');
+  }
+});
+
+When('the page is reloaded', async function () {
+  // Persist all localStorage data across window close/recreate
+  var win = this.window;
+  var storedKeys = Object.keys(win.localStorage);
+  var storedData = {};
+  storedKeys.forEach(function (k) { storedData[k] = win.localStorage.getItem(k); });
+  this.window.close();
+  // Manually set up new window with stored data before app.js loads
+  var Window = require('happy-dom').Window;
+  var newWin = new Window({ url: 'http://localhost/', width: 1024, height: 768 });
+  var doc = newWin.document;
+  doc.write('<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>TodoMVC</title></head><body><section class="todoapp"><header class="header"><h1>todos</h1><input class="new-todo" placeholder="What needs to be done?" autofocus></header><section class="main"><input id="toggle-all" class="toggle-all" type="checkbox"><label for="toggle-all">Mark all as complete</label><ul class="todo-list"></ul></section><footer class="footer"><span class="todo-count"><strong>0</strong> item left</span><ul class="filters"><li><a class="selected" href="#/">All</a></li><li><a href="#/active">Active</a></li><li><a href="#/completed">Completed</a></li></ul><button class="clear-completed">Clear completed</button></footer></section></body></html>');
+  // Restore all stored data
+  Object.keys(storedData).forEach(function (k) {
+    newWin.localStorage.setItem(k, storedData[k]);
+  });
+  // Now load app.js
+  var appJsPath = path.join(__dirname, '..', '..', 'js', 'app.js');
+  if (fs.existsSync(appJsPath)) {
+    newWin.eval(fs.readFileSync(appJsPath, 'utf8'));
+  }
+  this.window = newWin;
+  this.document = doc;
+});
+
+When('the URL hash is {string}', async function (hash) {
+  this.window.location.hash = hash;
+  this.window.dispatchEvent(new this.window.HashChangeEvent('hashchange', { oldURL: '#/', newURL: hash }));
+});
+
+When('the user clicks the {string} filter link', async function (filterName) {
+  const filterMap = { 'All': '#/', 'Active': '#/active', 'Completed': '#/completed' };
+  const hash = filterMap[filterName];
+  if (hash) {
+    const link = this.document.querySelector('a[href="' + hash + '"]');
+    if (link) {
+      this.click(link);
+      // Update the URL hash (happy-dom doesn't navigate on anchor click)
+      this.window.location.hash = hash;
+      this.window.dispatchEvent(new this.window.HashChangeEvent('hashchange', { oldURL: '#/', newURL: hash }));
+    }
+  }
+});
+
+When('the user inspects localStorage', async function () {
+  // Nothing to do - check localStorage in Then step
+});
