+const { Given } = require('@cucumber/cucumber');
+
+Given('the app is freshly loaded with no todos', async function () {
+  await this.resetState();
+});
+
+Given('the app has a todo item {string}', async function (title) {
+  await this.resetState();
+  const input = this.document.querySelector('.new-todo');
+  this.typeInto(input, title);
+  this.pressKey(input, 'Enter');
+});
+
+Given('the app has a completed todo item {string}', async function (title) {
+  await this.resetState();
+  const input = this.document.querySelector('.new-todo');
+  this.typeInto(input, title);
+  this.pressKey(input, 'Enter');
+  // Wait a tick, then click the checkbox
+  const li = this.findTodoLi(title);
+  if (li) {
+    const checkbox = li.querySelector('.toggle');
+    this.click(checkbox);
+  }
+});
+
+Given('the app has todo items {string} and {string}', async function (title1, title2) {
+  await this.resetState();
+  const input = this.document.querySelector('.new-todo');
+  this.typeInto(input, title1);
+  this.pressKey(input, 'Enter');
+  this.typeInto(input, title2);
+  this.pressKey(input, 'Enter');
+});
+
+Given('the app has todo items {string}, {string}, and {string}', async function (title1, title2, title3) {
+  await this.resetState();
+  const input = this.document.querySelector('.new-todo');
+  this.typeInto(input, title1);
+  this.pressKey(input, 'Enter');
+  this.typeInto(input, title2);
+  this.pressKey(input, 'Enter');
+  this.typeInto(input, title3);
+  this.pressKey(input, 'Enter');
+});
+
+Given('the app has a completed todo item {string} and an active todo {string}', async function (completedTitle, activeTitle) {
+  await this.resetState();
+  const input = this.document.querySelector('.new-todo');
+  this.typeInto(input, completedTitle);
+  this.pressKey(input, 'Enter');
+  this.typeInto(input, activeTitle);
+  this.pressKey(input, 'Enter');
+  // Mark the first as completed
+  const li = this.findTodoLi(completedTitle);
+  if (li) {
+    const checkbox = li.querySelector('.toggle');
+    this.click(checkbox);
+  }
+});
+
+Given('the app has an active todo item {string}', async function (title) {
+  await this.resetState();
+  const input = this.document.querySelector('.new-todo');
+  this.typeInto(input, title);
+  this.pressKey(input, 'Enter');
+});
+
+Given('the app has completed todo items {string} and {string}', async function (title1, title2) {
+  await this.resetState();
+  const input = this.document.querySelector('.new-todo');
+  this.typeInto(input, title1);
+  this.pressKey(input, 'Enter');
+  this.typeInto(input, title2);
+  this.pressKey(input, 'Enter');
+  // Mark both as completed
+  let li = this.findTodoLi(title1);
+  if (li) {
+    this.click(li.querySelector('.toggle'));
+  }
+  li = this.findTodoLi(title2);
+  if (li) {
+    this.click(li.querySelector('.toggle'));
+  }
+});
+
+Given('the app has both active and completed todos', async function () {
+  await this.resetState();
+  const input = this.document.querySelector('.new-todo');
+  this.typeInto(input, 'Buy milk');
+  this.pressKey(input, 'Enter');
+  this.typeInto(input, 'Paint fence');
+  this.pressKey(input, 'Enter');
+  const li = this.findTodoLi('Paint fence');
+  if (li) {
+    this.click(li.querySelector('.toggle'));
+  }
+});
+
+Given('the app is on the All route', async function () {
+  await this.resetState();
+});
+
+Given('the app is on the Active route', async function () {
+  await this.resetState();
+  const link = this.document.querySelector('a[href="#/active"]');
+  if (link) {
+    this.click(link);
+  }
+});
+
+Given('the app is on the Active route with todos {string} and {string} where {string} is completed', async function (activeTitle, completedTitle, completedArg) {
+  await this.resetState();
+  const input = this.document.querySelector('.new-todo');
+  this.typeInto(input, activeTitle);
+  this.pressKey(input, 'Enter');
+  this.typeInto(input, completedTitle);
+  this.pressKey(input, 'Enter');
+  const li = this.findTodoLi(completedTitle);
+  if (li) {
+    this.click(li.querySelector('.toggle'));
+  }
+  const link = this.document.querySelector('a[href="#/active"]');
+  if (link) {
+    this.click(link);
+  }
+});
+
+Given('the app has an active todo {string} and a completed todo {string}', async function (activeTitle, completedTitle) {
+  await this.resetState();
+  const input = this.document.querySelector('.new-todo');
+  this.typeInto(input, activeTitle);
+  this.pressKey(input, 'Enter');
+  this.typeInto(input, completedTitle);
+  this.pressKey(input, 'Enter');
+  const li = this.findTodoLi(completedTitle);
+  if (li) {
+    this.click(li.querySelector('.toggle'));
+  }
+});
+
+Given('the app is editing the todo {string}', async function (title) {
+  await this.resetState();
+  const input = this.document.querySelector('.new-todo');
+  this.typeInto(input, title);
+  this.pressKey(input, 'Enter');
+  const li = this.findTodoLi(title);
+  if (li) {
+    const label = li.querySelector('.view label');
+    this.doubleClick(label);
