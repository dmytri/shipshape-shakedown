+const { Then } = require('@cucumber/cucumber');
+const assert = require('assert');
+
+Then('the main section is not visible', async function () {
+  const main = this.document.querySelector('.main');
+  assert.strictEqual(main.style.display, 'none', 'Expected main section to be hidden');
+});
+
+Then('the footer is not visible', async function () {
+  const footer = this.document.querySelector('.footer');
+  assert.strictEqual(footer.style.display, 'none', 'Expected footer to be hidden');
+});
+
+Then('a new todo item appears in the list with the title {string}', async function (expectedTitle) {
+  const items = this.document.querySelectorAll('.todo-list li');
+  assert.ok(items.length > 0, 'Expected at least one todo item');
+  const lastItem = items[items.length - 1];
+  const label = lastItem.querySelector('.view label');
+  assert.strictEqual(label.textContent.trim(), expectedTitle, 'Expected todo title "' + expectedTitle + '"');
+});
+
+Then('the new-todo input is cleared', async function () {
+  const input = this.document.querySelector('.new-todo');
+  assert.strictEqual(input.value, '', 'Expected new-todo input to be cleared');
+});
+
+Then('no new todo item is created', async function () {
+  const items = this.document.querySelectorAll('.todo-list li');
+  assert.strictEqual(items.length, 0, 'Expected no todo items to be created');
+});
+
+Then('the {string} todo has the class {string}', async function (title, className) {
+  const li = this.findTodoLi(title);
+  assert.ok(li, 'Todo with title "' + title + '" not found');
+  assert.ok(li.classList.contains(className), 'Expected ' + title + ' to have class "' + className + '"');
+});
+
+Then('its checkbox is checked', async function () {
+  const checkedCheckbox = this.document.querySelector('.todo-list li .toggle:checked');
+  assert.ok(checkedCheckbox, 'Expected checkbox to be checked');
+});
+
+Then('its checkbox is not checked', async function () {
+  const uncheckedCheckbox = this.document.querySelector('.todo-list li .toggle:not(:checked)');
+  assert.ok(uncheckedCheckbox, 'Expected checkbox to be unchecked');
+});
+
+Then('the destroy button on the {string} todo is visible', async function (title) {
+  const li = this.findTodoLi(title);
+  assert.ok(li, 'Todo with title "' + title + '" not found');
+  const destroyBtn = li.querySelector('.destroy');
+  assert.ok(destroyBtn.style.display !== 'none', 'Expected destroy button to be visible for "' + title + '"');
+});
+
+Then('every todo item has the class {string}', async function (className) {
+  const items = this.document.querySelectorAll('.todo-list li');
+  assert.ok(items.length > 0, 'Expected at least one todo item');
+  items.forEach(li => {
+    assert.ok(li.classList.contains(className), 'Expected todo item to have class "' + className + '"');
+  });
+});
+
+Then('the toggle-all checkbox is checked', async function () {
+  const toggleAll = this.document.querySelector('.toggle-all');
+  assert.strictEqual(toggleAll.checked, true, 'Expected toggle-all to be checked');
+});
+
+Then('the toggle-all checkbox is not checked', async function () {
+  const toggleAll = this.document.querySelector('.toggle-all');
+  assert.strictEqual(toggleAll.checked, false, 'Expected toggle-all to be unchecked');
+});
+
+Then('no todo item has the class {string}', async function (className) {
+  const items = this.document.querySelectorAll('.todo-list li');
+  items.forEach(li => {
+    assert.ok(!li.classList.contains(className), 'Expected todo item to not have class "' + className + '"');
+  });
+});
+
+Then('the {string} todo is removed from the list', async function (title) {
+  const li = this.findTodoLi(title);
+  assert.strictEqual(li, null, 'Todo "' + title + '" should have been removed');
+});
+
+Then('the {string} todo remains in the list', async function (title) {
+  const li = this.findTodoLi(title);
+  assert.ok(li, 'Todo "' + title + '" should remain in the list');
+});
+
+Then('the {string} button is not visible', async function (buttonText) {
+  if (buttonText === 'Clear completed') {
+    const btn = this.document.querySelector('.clear-completed');
+    assert.strictEqual(btn.style.display, 'none', 'Expected Clear completed button to be hidden');
+  }
+});
+
+Then('the todo-count displays {string} item left', async function (expectedCount) {
+  const count = this.document.querySelector('.todo-count');
+  assert.ok(count.textContent.includes(expectedCount), 'Expected todo-count to contain "' + expectedCount + '"');
+  assert.ok(count.textContent.includes('item'), 'Expected singular "item"');
+});
+
+Then('the todo-count displays {string} items left', async function (expectedCount) {
+  const count = this.document.querySelector('.todo-count');
+  assert.ok(count.textContent.includes(expectedCount), 'Expected todo-count to contain "' + expectedCount + '"');
+  assert.ok(count.textContent.includes('items'), 'Expected plural "items"');
+});
+
+Then('the {string} todo appears in the list', async function (title) {
+  const li = this.findTodoLi(title);
+  assert.ok(li, 'Todo "' + title + '" should appear in the list');
+});
+
+Then('the todo item does not have the class {string}', async function (className) {
+  const items = this.document.querySelectorAll('.todo-list li');
+  items.forEach(li => {
+    assert.ok(!li.classList.contains(className), 'Expected todo item to not have class "' + className + '"');
+  });
+});
+
+Then('the {string} todo does not have the class {string}', async function (title, className) {
+  const li = this.findTodoLi(title);
+  if (li) {
+    assert.ok(!li.classList.contains(className), 'Expected ' + title + ' to not have class "' + className + '"');
+  }
+});
+
+Then('the todo item has the class {string}', async function (className) {
+  const items = this.document.querySelectorAll('.todo-list li');
+  const foundItem = Array.from(items).find(li => li.classList.contains(className));
+  assert.ok(foundItem, 'Expected a todo item with class "' + className + '"');
+});
+
+Then('the edit input is focused and contains the text {string}', async function (expectedText) {
+  const editingLi = this.document.querySelector('.todo-list li.editing');
+  assert.ok(editingLi, 'Expected an item in editing mode');
+  const editInput = editingLi.querySelector('.edit');
+  assert.strictEqual(editInput.value, expectedText, 'Expected edit input to contain "' + expectedText + '"');
+  assert.strictEqual(this.document.activeElement, editInput, 'Expected edit input to be focused');
+});
+
+Then('the todo item displays the title {string}', async function (expectedTitle) {
+  const li = this.findTodoLi(expectedTitle);
+  assert.ok(li, 'Expected a todo with title "' + expectedTitle + '"');
+});
+
+Then('the {string} filter link has the {string} class', async function (filterName, className) {
+  const filterMap = { 'All': '#/', 'Active': '#/active', 'Completed': '#/completed' };
+  const hash = filterMap[filterName];
+  const link = this.document.querySelector('a[href="' + hash + '"]');
+  assert.ok(link, 'Filter link for "' + filterName + '" not found');
+  assert.ok(link.classList.contains(className), 'Expected ' + filterName + ' link to have class "' + className + '"');
+});
+
+Then('the {string} filter link does not have the {string} class', async function (filterName, className) {
+  const filterMap = { 'All': '#/', 'Active': '#/active', 'Completed': '#/completed' };
+  const hash = filterMap[filterName];
+  const link = this.document.querySelector('a[href="' + hash + '"]');
+  if (link) {
+    assert.ok(!link.classList.contains(className), 'Expected ' + filterName + ' link to not have class "' + className + '"');
+  }
+});
+
+Then('all todos are shown in the list', async function () {
+  const items = this.document.querySelectorAll('.todo-list li');
+  // There should be at least some items when filter shows all
+  assert.ok(items.length > 0, 'Expected some todos to be shown');
+});
+
+Then('only {string} is shown in the list', async function (title) {
+  const items = this.document.querySelectorAll('.todo-list li');
+  assert.strictEqual(items.length, 1, 'Expected exactly one todo in list');
+  const label = items[0].querySelector('.view label');
+  assert.strictEqual(label.textContent.trim(), title, 'Expected todo "' + title + '"');
+});
+
+Then('{string} is not shown', async function (title) {
+  const li = this.findTodoLi(title);
+  assert.strictEqual(li, null, 'Todo "' + title + '" should not be shown');
+});
+
+Then('only active todos are shown', async function () {
+  const items = this.document.querySelectorAll('.todo-list li');
+  for (const li of items) {
+    assert.ok(!li.classList.contains('completed'), 'Expected only active todos');
+  }
+});
+
+Then('{string} is removed from the visible list', async function (title) {
+  const li = this.findTodoLi(title);
+  assert.strictEqual(li, null, 'Todo "' + title + '" should have been removed from visible list');
+});
+
+Then('{string} is not shown either', async function (title) {
+  const li = this.findTodoLi(title);
+  assert.strictEqual(li, null, 'Todo "' + title + '" should not be shown');
+});
+
+Then('the storage key {string} exists with valid todo data', async function (key) {
+  const stored = this.window.localStorage.getItem(key);
+  assert.ok(stored !== null, 'Expected localStorage key "' + key + '" to exist');
+  const data = JSON.parse(stored);
+  assert.ok(Array.isArray(data), 'Expected stored data to be an array');
+  assert.ok(data.length > 0, 'Expected stored data to have at least one todo');
+  assert.ok(typeof data[0].title === 'string', 'Expected todo items to have a title');
+  assert.ok('completed' in data[0], 'Expected todo items to have a completed field');
+});
