+      var todo = todos.filter(function (t) { return t.title === title; })[0];
+      if (!todo) return;
+
+      if (activeRoute === 'active' && todo.completed) {
+        li.style.display = 'none';
+      } else if (activeRoute === 'completed' && !todo.completed) {
+        li.style.display = 'none';
+      } else {
+        li.style.display = '';
+      }
+    });
+  }
+
+  function escapeHtml(str) {
+    var div = document.createElement('div');
+    div.appendChild(document.createTextNode(str));
