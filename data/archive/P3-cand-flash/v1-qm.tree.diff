+      if (main) main.style.display = 'block';
+      if (footer) footer.style.display = 'block';
+    }
+
+    // Toggle-all
+    if (toggleAll) {
+      toggleAll.checked = todos.length > 0 && getActiveCount() === 0;
+    }
+
+    // Todo count
+    if (todoCount) {
+      var count = getActiveCount();
