+        }
+      });
+
+      // Event delegation for edit input
+      todoList.addEventListener('keydown', function (e) {
+        var editingLi = todoList.querySelector('li.editing');
+        if (!editingLi) return;
+        var editInput = editingLi.querySelector('.edit');
+        if (!editInput) return;
+
+        if (e.keyCode === ENTER_KEY) {
+          var newTitle = editInput.value.trim();
+          var label = editingLi.querySelector('label');
+          var oldTitle = label ? label.textContent.trim() : '';
+          var todo = todos.filter(function (t) { return t.title === oldTitle; })[0];
+          if (!todo) return;
+
+          if (newTitle) {
+            updateTodo(todo.id, newTitle);
