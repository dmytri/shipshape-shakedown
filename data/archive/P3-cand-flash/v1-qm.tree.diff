+
+    // Filter links
+    var filters = document.querySelectorAll('.filters a');
+    filters.forEach(function (a) {
+      a.addEventListener('click', function (e) {
+        e.preventDefault();
+        var route = a.getAttribute('href').replace('#/', '') || 'all';
+        activeRoute = route;
+        persistFilter(route);
+        render();
+      });
+    });
+
+    // Hash change
+    window.addEventListener('hashchange', function () {
+      var hash = window.location.hash.replace('#/', '') || 'all';
+      activeRoute = hash;
+      persistFilter(hash);
+      render();
+    });
+
+    // Load event
+    window.addEventListener('load', function () {
+      loadTodos();
+      render();
+    });
+  }
+
+  // --- Filter persistence ---
+  function persistFilter(route) {
+    try {
+      localStorage.setItem(STORAGE_KEY + '-filter', route);
+    } catch (e) {}
+  }
+
+  function getPersistedFilter() {
+    try {
+      var filter = localStorage.getItem(STORAGE_KEY + '-filter');
