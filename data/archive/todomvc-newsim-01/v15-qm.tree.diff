+// --- Editing position preservation steps (todo-editing.feature) ---
+
+Given('the todos {string}, {string}, {string} exist', function (t1, t2, t3) {
+  var stored = JSON.stringify([
+    { id: Date.now() + Math.random(), title: t1, completed: false },
+    { id: Date.now() + Math.random(), title: t2, completed: false },
+    { id: Date.now() + Math.random(), title: t3, completed: false }
+  ]);
+  this.localStorage.setItem('todos-vanilla', stored);
+  this.window.location.hash = '';
+  this._appLoaded = false;
+  this.loadApp();
+});
+
+When('the user edits the second todo to {string}', function (newTitle) {
+  var items = this.document.querySelectorAll('.todo-list li');
+  if (items.length < 2) {
+    throw new Error('Need at least 2 todos, found ' + items.length);
+  }
+  var secondLi = items[1];
+  var label = secondLi.querySelector('label');
+  if (!label) {
+    throw new Error('Second todo has no label');
+  }
+  // Double-click to enter edit mode
+  var dblclickEvent = new this.window.MouseEvent('dblclick', { bubbles: true });
+  label.dispatchEvent(dblclickEvent);
+  // Find the edit input and change it
+  var editInput = secondLi.querySelector('.edit');
+  if (!editInput) {
+    throw new Error('Edit input not found on second todo');
+  }
+  editInput.value = newTitle;
+  // Press Enter to commit
+  var enterEvent = new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13 });
+  editInput.dispatchEvent(enterEvent);
+});
+
+Then('the todos are, in order, {string}, {string}, {string}', function (t1, t2, t3) {
+  var items = this.document.querySelectorAll('.todo-list li');
+  var titles = [];
+  for (var i = 0; i < items.length; i++) {
+    var label = items[i].querySelector('label');
+    if (label) {
+      titles.push(label.textContent.trim());
+    }
+  }
+  var expected = [t1, t2, t3];
+  if (titles.length !== expected.length) {
+    throw new Error('Expected ' + expected.length + ' todos, got ' + titles.length + ': ' + titles.join(', '));
+  }
+  for (var j = 0; j < expected.length; j++) {
+    if (titles[j] !== expected[j]) {
+      throw new Error('Expected todos [' + expected.join(', ') + '], got [' + titles.join(', ') + ']');
+    }
+  }
+});
+
