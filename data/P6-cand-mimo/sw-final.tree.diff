+#!/usr/bin/env node
+/**
+ * plank-join.js — checks plank conformance.
+ *
+ * 1. Every @planks string is a current step-definition pattern.
+ * 2. Every @planks-provisional reference names a scenario that still carries @captain.
+ * 3. Every action step (When) whose pattern exercises production code has a matching
+ *    plank or provisional plank on some production seam.
+ *
+ * Given/Then steps and verification-only steps are excluded: Given sets up state,
+ * Then asserts, and neither typically planked seams. Verification-only steps read
+ * source files or scan directories without exercising app behaviour.
+ *
+ * Exit 0 on clean, exit 1 on violations.
+ */
+const fs = require('node:fs');
+const path = require('node:path');
+
+const ROOT = path.resolve(__dirname, '..');
+const IMPL_DIRS = ['js'];
+const SPECS_DIR = path.join(ROOT, 'features');
+const STEPS_DIR = path.join(SPECS_DIR, 'step_definitions');
+
+// Step definitions that do NOT planked seams:
+// - Verification-only (read source, scan directories, inspect files)
+// - Given-only steps (set up state, don't exercise production seams)
+// - Then-only steps (assert DOM state, don't exercise production seams)
+// These are excluded from the UNPLANKED_STEP check.
+const NON_SEAM_PATTERNS = new Set([
+  // Verification-only
+  'the app source {string}',
+  'the edit event handling code is inspected',
+  'the blur handler for edit inputs contains a guard that prevents calling editTodo when the keydown handler has already processed the same edit action',
+  'the file {string} is read',
+  'the implementation directories are scanned for {string}',
+  'every top-level key matches the pattern {string}',
+  'each watch contains a {string} array',
+  'each scenario reference matches the repo-root-relative {string} pattern',
+  'no standing {string} token exists in committed production code',
+  // Given-only (state setup)
+  'the app is loaded with no existing todos',
+  'the app is reloaded',
+  // Then-only (assertions)
+  'a todo {string} appears in the list',
+  'the new-todo input is empty',
+  'the todo count shows {string}',
+  'no todos exist',
+  'the todo list shows {int} todos',
+  'the first todo is marked completed',
+  'the first todo is not marked completed',
+  'the todo list shows {int} todo',
+  'the remaining todo is {string}',
+  'the {string} button is hidden',
+  'all todos are marked completed',
+  'no todos are marked completed',
+  'the toggle-all checkbox is not checked',
+  'the main section is hidden',
+  'the footer is hidden',
+  'the main section is visible',
+  'the footer is visible',
+  'the {string} filter is selected',
+  'the new-todo input is focused',
+  // Given setup steps
+  'the second todo DOM node is captured',
+  // Then assertion steps
+  'the second todo DOM node is unchanged',
+]);
+
+// Steps that ARE action steps (exercise production seams) and should planked.
+// This is the complement: When steps not in NON_SEAM_PATTERNS.
+// We classify by reading the step definitions and checking the keyword context.
+
+// --- Collect step-definition patterns with their keyword ---
+function collectStepDefinitions() {
+  const steps = []; // { pattern, keyword, file, line }
+  const files = fs.readdirSync(STEPS_DIR).filter(f => f.endsWith('.js'));
+  for (const file of files) {
+    const content = fs.readFileSync(path.join(STEPS_DIR, file), 'utf8');
+    const lines = content.split('\n');
+    for (let i = 0; i < lines.length; i++) {
+      const m = lines[i].match(/(Given|When|Then)\(\s*['"`]([^'"`]+)['"`]/);
+      if (m) {
+        steps.push({ keyword: m[1], pattern: m[2], file, line: i + 1 });
+      }
+    }
+  }
+  return steps;
+}
+
+// --- Collect @planks and @planks-provisional from implementation ---
+function collectPlanks() {
+  const planks = [];
+  const provisionals = [];
+  const files = [];
+  for (const dir of IMPL_DIRS) {
+    const dirPath = path.join(ROOT, dir);
+    if (!fs.existsSync(dirPath)) continue;
+    const entries = fs.readdirSync(dirPath, { recursive: true });
+    for (const entry of entries) {
+      const fp = path.join(dirPath, entry);
+      if (!fs.statSync(fp).isFile()) continue;
+      if (!fp.endsWith('.js') && !fp.endsWith('.ts')) continue;
+      files.push(fp);
+    }
+  }
+  for (const file of files) {
+    const lines = fs.readFileSync(file, 'utf8').split('\n');
+    for (let i = 0; i < lines.length; i++) {
+      const line = lines[i];
+      const plankMatch = line.match(/@planks\(\s*["']([^"']+)["']\s*\)/);
+      if (plankMatch) {
+        planks.push({ file: path.relative(ROOT, file), line: i + 1, pattern: plankMatch[1] });
+      }
+      const provMatch = line.match(/@planks-provisional\(\s*["']([^"']+)["']\s*\)/);
+      if (provMatch) {
+        provisionals.push({ file: path.relative(ROOT, file), line: i + 1, ref: provMatch[1] });
+      }
+    }
+  }
+  return { planks, provisionals };
+}
+
+// --- Collect @captain scenarios from specs ---
+function collectCaptainScenarios() {
+  const scenarios = [];
+  const files = fs.readdirSync(SPECS_DIR).filter(f => f.endsWith('.feature'));
+  for (const file of files) {
+    const content = fs.readFileSync(path.join(SPECS_DIR, file), 'utf8');
+    const featureName = file.replace('.feature', '');
+    const lines = content.split('\n');
+    let scenarioName = null;
+    let hasCaptain = false;
+    for (const line of lines) {
+      const scenarioMatch = line.match(/^\s*Scenario(?:\s+Outline)?:\s*(.+)/);
+      if (scenarioMatch) {
+        if (scenarioName && hasCaptain) {
+          scenarios.push({ feature: featureName, name: scenarioName });
+        }
+        scenarioName = scenarioMatch[1].trim();
+        hasCaptain = false;
+      }
+      if (line.includes('@captain')) {
+        hasCaptain = true;
+      }
+    }
+    if (scenarioName && hasCaptain) {
+      scenarios.push({ feature: featureName, name: scenarioName });
+    }
+  }
+  return scenarios;
+}
+
+// --- Main check ---
+const stepDefs = collectStepDefinitions();
+const { planks, provisionals } = collectPlanks();
+const captainScenarios = collectCaptainScenarios();
+const violations = [];
+
+// Check 1: Every @planks pattern matches a step-definition pattern
+const stepPatterns = stepDefs.map(s => s.pattern);
+for (const plank of planks) {
+  if (!stepPatterns.includes(plank.pattern)) {
+    violations.push(`STALE_PLANK: ${plank.file}:${plank.line} @planks("${plank.pattern}") matches no step-definition pattern`);
+  }
+}
+
+// Check 2: Every @planks-provisional ref names a @captain scenario
+for (const prov of provisionals) {
+  const colonIdx = prov.ref.indexOf(':');
+  if (colonIdx === -1) {
+    violations.push(`MALFORMED_PROVISIONAL: ${prov.file}:${prov.line} @planks-provisional("${prov.ref}") — expected "feature.feature:Scenario Name"`);
+    continue;
+  }
+  const featureFile = prov.ref.substring(0, colonIdx);
+  const scenarioName = prov.ref.substring(colonIdx + 1);
+  const featureStem = path.basename(featureFile, '.feature');
+  const found = captainScenarios.find(s => s.feature === featureStem && s.name === scenarioName);
+  if (!found) {
+    violations.push(`STALE_PROVISIONAL: ${prov.file}:${prov.line} @planks-provisional("${prov.ref}") — scenario not found or not @captain`);
+  }
+}
+
+// Check 3: Every When step (action) whose pattern exercises production code has a plank
+const allPlankPatterns = new Set(planks.map(p => p.pattern));
+const whenSteps = stepDefs.filter(s => s.keyword === 'When');
+const uncoveredWhenSteps = whenSteps.filter(s => {
+  if (allPlankPatterns.has(s.pattern)) return false;
+  if (NON_SEAM_PATTERNS.has(s.pattern)) return false;
+  return true;
+});
+for (const step of uncoveredWhenSteps) {
+  violations.push(`UNPLANKED_ACTION: ${step.file}:${step.line} When pattern "${step.pattern}" has no matching @planks or @planks-provisional`);
+}
+
+// --- Report ---
+if (violations.length === 0) {
+  console.log('plank-join: clean — ' + planks.length + ' planks, ' + provisionals.length + ' provisionals, ' + stepDefs.length + ' step defs, ' + captainScenarios.length + ' @captain scenarios');
+  process.exit(0);
+} else {
+  console.error('plank-join: ' + violations.length + ' violation(s):');
+  for (const v of violations) {
+    console.error('  ' + v);
+  }
+  process.exit(1);
+}
