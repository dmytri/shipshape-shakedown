diff --git a/features/step_definitions/methodology.steps.js b/features/step_definitions/methodology.steps.js
new file mode 100644
index 0000000..cdadc41
--- /dev/null
+++ b/features/step_definitions/methodology.steps.js
@@ -0,0 +1,89 @@
+const fs = require('node:fs');
+const path = require('node:path');
+const { Given, When, Then } = require('@cucumber/cucumber');
+const { expect } = require('chai');
+
+const ROOT = path.resolve(__dirname, '..', '..');
+
+// --- Filter routing steps ---
+
+// Uses the existing step pattern from todos.steps.js:
+// When('the user navigates to {string}', ...)
+// The @captain scenarios in filter-routing.feature use this pattern.
+
+// --- Methodology conformance steps ---
+
+Given('the file {string} is read', function (filePath) {
+  const fullPath = path.resolve(ROOT, filePath);
+  try {
+    this.methodologyData = JSON.parse(fs.readFileSync(fullPath, 'utf8'));
+    this.methodologyFileExists = true;
+  } catch (e) {
+    this.methodologyFileExists = false;
+    this.methodologyData = null;
+  }
+});
+
+Then('every top-level key matches the pattern {string}', function (pattern) {
+  if (!this.methodologyFileExists) {
+    // Absent watchbill conforms: absence is the deck at rest.
+    return;
+  }
+  const regex = new RegExp('^' + pattern.replace('{int}', '\\d+') + '$');
+  for (const key of Object.keys(this.methodologyData)) {
+    expect(key).to.match(regex);
+  }
+});
+
+Then('each watch contains a {string} array', function (key) {
+  if (!this.methodologyFileExists) return;
+  for (const [watchName, watch] of Object.entries(this.methodologyData)) {
+    expect(watch).to.have.property(key);
+    expect(watch[key]).to.be.an('array');
+  }
+});
+
+Then('each scenario reference matches the repo-root-relative {string} pattern', function (_pattern) {
+  if (!this.methodologyFileExists) return;
+  const refRegex = /^features\/.+\.feature:.+$/;
+  for (const [watchName, watch] of Object.entries(this.methodologyData)) {
+    for (const ref of watch.scenarios) {
+      // Tier tags are also valid (e.g., "@logic")
+      if (ref.startsWith('@')) continue;
+      expect(ref).to.match(refRegex);
+    }
+  }
+});
+
+// --- Perturbation quiescence steps ---
+
+Given('the implementation directories are scanned for {string}', function (token) {
+  this.perturbationToken = token;
+  this.perturbationHits = [];
+  const implDirs = ['js', 'css'];
+  for (const dir of implDirs) {
+    const dirPath = path.join(ROOT, dir);
+    if (!fs.existsSync(dirPath)) continue;
+    const files = fs.readdirSync(dirPath, { recursive: true });
+    for (const file of files) {
+      const filePath = path.join(dirPath, file);
+      if (!fs.statSync(filePath).isFile()) continue;
+      const content = fs.readFileSync(filePath, 'utf8');
+      if (content.includes(token)) {
+        this.perturbationHits.push(filePath);
+      }
+    }
+  }
+  // Also check index.html in root
+  const indexFile = path.join(ROOT, 'index.html');
+  if (fs.existsSync(indexFile)) {
+    const content = fs.readFileSync(indexFile, 'utf8');
+    if (content.includes(token)) {
+      this.perturbationHits.push(indexFile);
+    }
+  }
+});
+
+Then('no standing {string} token exists in committed production code', function (_token) {
+  expect(this.perturbationHits).to.deep.equal([]);
+});
