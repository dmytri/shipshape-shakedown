new file mode 100644
index 0000000..a38e303
--- /dev/null
+++ b/features/rendering.feature
@@ -0,0 +1,16 @@
+Feature: DOM identity preservation
+  As a user interacting with the todo list
+  I want the app to update existing elements in place when toggling state
+  So that the list remains stable and does not flicker or lose focus
+
+  Background:
+    Given the app is loaded with no existing todos
+
+  Rule: Toggling a todo preserves its DOM node identity
+
+    Scenario: Toggling a todo updates the existing element in place
+      Given the user has added a todo "Buy milk"
+      And the user has added a todo "Walk dog"
+      And the second todo DOM node is captured
+      When the user toggles the first todo
+      Then the second todo DOM node is unchanged
diff --git a/js/app.js b/js/app.js
