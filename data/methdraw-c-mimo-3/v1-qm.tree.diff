+const { World, setWorldConstructor } = require('@cucumber/cucumber');
+const { Window } = require('happy-dom');
+const path = require('path');
+const fs = require('fs');
+
+class TodoWorld extends World {
+  constructor(options) {
+    super(options);
+    this.window = null;
+    this.document = null;
+    this.appHtml = null;
+  }
+
+  async loadApp() {
+    const htmlPath = path.resolve(__dirname, '../../index.html');
+    this.appHtml = fs.readFileSync(htmlPath, 'utf-8');
+    this.window = new Window({ url: 'http://localhost' });
+    this.document = this.window.document;
+    this.document.documentElement.innerHTML = this.appHtml
+      .replace(/<!doctype[^>]*>/i, '')
+      .replace(/<html[^>]*>/i, '')
+      .replace(/<\/html>/i, '');
+    this._loadScripts();
+    await this._waitForApp();
+  }
+
+  _loadScripts() {
+    const scripts = this.document.querySelectorAll('script[src]');
+    scripts.forEach((script) => {
+      const src = script.getAttribute('src');
+      if (src && !src.startsWith('http')) {
+        const scriptPath = path.resolve(__dirname, '../../', src);
+        if (fs.existsSync(scriptPath)) {
+          const code = fs.readFileSync(scriptPath, 'utf-8');
+          this.window.eval(code);
+        }
+      }
+    });
+  }
+
+  async _waitForApp() {
+    this.document.dispatchEvent(new this.window.Event('DOMContentLoaded'));
+    await new Promise((resolve) => setTimeout(resolve, 100));
+  }
+
+  getNewTodoInput() {
+    return this.document.querySelector('.new-todo');
+  }
+
+  getTodoItems() {
+    return Array.from(this.document.querySelectorAll('.todo-list li'));
+  }
+
+  getTodoItem(position) {
+    const items = this.getTodoItems();
+    return items[position - 1] || null;
+  }
+
+  async typeInNewTodo(text) {
+    const input = this.getNewTodoInput();
+    input.value = text;
+    input.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+    const event = new this.window.KeyboardEvent('keydown', {
+      key: 'Enter',
+      keyCode: 13,
+      bubbles: true,
+    });
+    input.dispatchEvent(event);
+    await new Promise((r) => setTimeout(r, 50));
+  }
+
+  async toggleTodo(position) {
+    const item = this.getTodoItem(position);
+    if (item) {
+      const checkbox = item.querySelector('.toggle');
+      checkbox.click();
+      await new Promise((r) => setTimeout(r, 50));
+    }
+  }
+
+  async doubleClickLabel(position) {
+    const item = this.getTodoItem(position);
+    if (item) {
+      const label = item.querySelector('label');
+      label.dispatchEvent(new this.window.MouseEvent('dblclick', { bubbles: true }));
+      await new Promise((r) => setTimeout(r, 50));
+    }
+  }
+
+  async hoverTodo(position) {
+    const item = this.getTodoItem(position);
+    if (item) {
+      item.dispatchEvent(new this.window.MouseEvent('mouseenter', { bubbles: true }));
+      await new Promise((r) => setTimeout(r, 50));
+    }
+  }
+
+  async clickDestroy(position) {
+    const item = this.getTodoItem(position);
+    if (item) {
+      const btn = item.querySelector('.destroy');
+      btn.click();
+      await new Promise((r) => setTimeout(r, 50));
+    }
+  }
+
+  async editTodo(text, action) {
+    const editingItem = this.document.querySelector('.todo-list li.editing');
+    if (editingItem) {
+      const editInput = editingItem.querySelector('.edit');
+      editInput.value = text;
+      editInput.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+      if (action === 'Enter') {
+        const event = new this.window.KeyboardEvent('keydown', {
+          key: 'Enter',
+          keyCode: 13,
+          bubbles: true,
+        });
+        editInput.dispatchEvent(event);
+      } else if (action === 'Escape') {
+        const event = new this.window.KeyboardEvent('keydown', {
+          key: 'Escape',
+          keyCode: 27,
+          bubbles: true,
+        });
+        editInput.dispatchEvent(event);
+      } else if (action === 'blur') {
+        editInput.dispatchEvent(new this.window.Event('blur', { bubbles: true }));
+      }
+      await new Promise((r) => setTimeout(r, 50));
+    }
+  }
+
+  async clearEditAndType(text, action) {
+    const editingItem = this.document.querySelector('.todo-list li.editing');
+    if (editingItem) {
+      const editInput = editingItem.querySelector('.edit');
+      editInput.value = '';
+      editInput.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+      if (text) {
+        editInput.value = text;
+        editInput.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+      }
+      if (action === 'Enter') {
+        const event = new this.window.KeyboardEvent('keydown', {
+          key: 'Enter',
+          keyCode: 13,
+          bubbles: true,
+        });
+        editInput.dispatchEvent(event);
+      } else if (action === 'Escape') {
+        const event = new this.window.KeyboardEvent('keydown', {
+          key: 'Escape',
+          keyCode: 27,
+          bubbles: true,
+        });
+        editInput.dispatchEvent(event);
+      } else if (action === 'blur') {
+        editInput.dispatchEvent(new this.window.Event('blur', { bubbles: true }));
+      }
+      await new Promise((r) => setTimeout(r, 50));
+    }
+  }
+
+  async clickToggleAll() {
+    const toggleAll = this.document.querySelector('#toggle-all');
+    toggleAll.click();
+    await new Promise((r) => setTimeout(r, 50));
+  }
+
+  async clickClearCompleted() {
+    const btn = this.document.querySelector('.clear-completed');
+    if (btn) {
+      btn.click();
+      await new Promise((r) => setTimeout(r, 50));
+    }
+  }
+
+  async navigateTo(filter) {
+    this.window.location.hash = filter;
+    await new Promise((r) => setTimeout(r, 100));
+  }
+
+  async reloadPage() {
+    const html = this.appHtml;
+    const currentHash = this.window.location.hash || '';
+    this.window = new Window({ url: 'http://localhost' + currentHash });
+    this.document = this.window.document;
+    this.document.documentElement.innerHTML = html
+      .replace(/<!doctype[^>]*>/i, '')
+      .replace(/<html[^>]*>/i, '')
+      .replace(/<\/html>/i, '');
+    this._loadScripts();
+    await this._waitForApp();
+  }
+}
+
+setWorldConstructor(TodoWorld);
