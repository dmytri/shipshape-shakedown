@@ -0,0 +1,195 @@
+const { Given, When, Then } = require('@cucumber/cucumber');
+const assert = require('assert');
+
+Given('the app is loaded with an empty todo list', async function () {
+  // App loaded in Before hook
+  const items = this.getTodoItems();
+  assert.strictEqual(items.length, 0);
+});
+
+Given('the todo list is empty', function () {
+  const items = this.getTodoItems();
+  assert.strictEqual(items.length, 0);
+});
+
+Given('the todo list has these items:', async function (dataTable) {
+  for (const row of dataTable.hashes()) {
+    await this.typeInNewTodo(row.title);
+    if (row.completed === 'true') {
+      const items = this.getTodoItems();
+      await this.toggleTodo(items.length);
+    }
+  }
+});
+
+Given('I navigate to {string}', async function (filter) {
+  await this.navigateTo(filter);
+});
+
+When('I type {string} in the new todo input and press Enter', async function (text) {
+  await this.typeInNewTodo(text);
+});
+
+When('the page is reloaded', async function () {
+  await this.reloadPage();
+});
+
+When('the page loads', function () {
+  // No-op: page is already loaded
+});
+
+When('I toggle the todo at position {int}', async function (position) {
+  await this.toggleTodo(position);
+});
+
+When('I double-click the label of todo at position {int}', async function (position) {
+  await this.doubleClickLabel(position);
+});
+
+When('I hover over the todo at position {int}', async function (position) {
+  await this.hoverTodo(position);
+});
+
+When('I click the destroy button of todo at position {int}', async function (position) {
+  await this.clickDestroy(position);
+});
+
+When('I clear the edit input and type {string} and press Enter', async function (text) {
+  await this.clearEditAndType(text, 'Enter');
+});
+
+When('I clear the edit input and type {string} and blur', async function (text) {
+  await this.clearEditAndType(text, 'blur');
+});
+
+When('I clear the edit input and press Enter', async function () {
+  await this.clearEditAndType(null, 'Enter');
+});
+
+When('I clear the edit input and type {string} and press Escape', async function (text) {
+  await this.clearEditAndType(text, 'Escape');
+});
+
+When('I click the toggle-all checkbox', async function () {
+  await this.clickToggleAll();
+});
+
+When('I click the clear completed button', async function () {
+  await this.clickClearCompleted();
+});
+
+Then('the main section is hidden', function () {
+  const main = this.document.querySelector('.main');
+  assert.ok(main, '.main section exists');
+  const style = this.window.getComputedStyle(main);
+  assert.strictEqual(style.display, 'none');
+});
+
+Then('the footer section is hidden', function () {
+  const footer = this.document.querySelector('.footer');
+  assert.ok(footer, '.footer section exists');
+  const style = this.window.getComputedStyle(footer);
+  assert.strictEqual(style.display, 'none');
+});
+
+Then('the todo list has {int} item(s)', function (count) {
+  const items = this.getTodoItems();
+  assert.strictEqual(items.length, count);
+});
+
+Then('the todo at position {int} has title {string} and is not completed', function (position, title) {
+  const item = this.getTodoItem(position);
+  assert.ok(item, `Todo at position ${position} exists`);
+  const label = item.querySelector('label');
+  assert.strictEqual(label.textContent.trim(), title);
+  assert.ok(!item.classList.contains('completed'), 'Todo is not completed');
+});
+
+Then('the todo at position {int} has title {string} and is completed', function (position, title) {
+  const item = this.getTodoItem(position);
+  assert.ok(item, `Todo at position ${position} exists`);
+  const label = item.querySelector('label');
+  assert.strictEqual(label.textContent.trim(), title);
+  assert.ok(item.classList.contains('completed'), 'Todo is completed');
+});
+
+Then('the new todo input is empty', function () {
+  const input = this.getNewTodoInput();
+  assert.strictEqual(input.value, '');
+});
+
+Then('the new todo input is focused', function () {
+  const input = this.getNewTodoInput();
+  assert.ok(input.autofocus || input === this.document.activeElement, 'Input is focused');
+});
+
+Then('all todos are completed', function () {
+  const items = this.getTodoItems();
+  items.forEach((item) => {
+    assert.ok(item.classList.contains('completed'), 'Todo is completed');
+  });
+});
+
+Then('the toggle-all checkbox is checked', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  assert.ok(toggleAll.checked, 'Toggle-all is checked');
+});
+
+Then('the toggle-all checkbox is not checked', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  assert.ok(!toggleAll.checked, 'Toggle-all is not checked');
+});
+
+Then('the todo at position {int} is in editing mode', function (position) {
+  const item = this.getTodoItem(position);
+  assert.ok(item, `Todo at position ${position} exists`);
+  assert.ok(item.classList.contains('editing'), 'Todo is in editing mode');
+});
+
+Then('the destroy button of todo at position {int} is visible', function (position) {
+  const item = this.getTodoItem(position);
+  assert.ok(item, `Todo at position ${position} exists`);
+  const destroy = item.querySelector('.destroy');
+  const style = this.window.getComputedStyle(destroy);
+  assert.notStrictEqual(style.display, 'none', 'Destroy button is visible');
+});
+
+Then('the counter shows {string}', function (text) {
+  const counter = this.document.querySelector('.todo-count');
+  assert.ok(counter, '.todo-count exists');
+  assert.strictEqual(counter.textContent.trim(), text);
+});
+
+Then('the clear completed button is hidden', function () {
+  const btn = this.document.querySelector('.clear-completed');
+  assert.ok(btn, '.clear-completed exists');
+  const style = this.window.getComputedStyle(btn);
+  assert.strictEqual(style.display, 'none');
+});
+
+Then('the clear completed button is visible', function () {
+  const btn = this.document.querySelector('.clear-completed');
+  assert.ok(btn, '.clear-completed exists');
+  const style = this.window.getComputedStyle(btn);
+  assert.notStrictEqual(style.display, 'none');
+});
+
+Then('the {string} filter is selected', function (filterName) {
+  const filters = this.document.querySelectorAll('.filters a');
+  let found = false;
+  filters.forEach((a) => {
+    if (a.textContent.trim() === filterName) {
+      assert.ok(a.classList.contains('selected'), `${filterName} filter is selected`);
+      found = true;
+    }
+  });
+  assert.ok(found, `Filter "${filterName}" exists`);
+});
+
+Then('the localStorage has a key {string} with JSON containing a todo with title {string}', function (key, title) {
+  const stored = this.window.localStorage.getItem(key);
+  assert.ok(stored, `localStorage has key "${key}"`);
+  const todos = JSON.parse(stored);
+  const found = todos.some((t) => t.title === title);
+  assert.ok(found, `localStorage contains todo with title "${title}"`);
+});
