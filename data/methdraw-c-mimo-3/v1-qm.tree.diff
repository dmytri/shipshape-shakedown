+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>TodoMVC</title>
+    <link rel="stylesheet" href="node_modules/todomvc-common/base.css">
+    <link rel="stylesheet" href="node_modules/todomvc-app-css/index.css">
+    <link rel="stylesheet" href="css/app.css">
+  </head>
+  <body>
+    <section class="todoapp">
+      <header class="header">
+        <h1>todos</h1>
+        <input class="new-todo" placeholder="What needs to be done?" autofocus>
+      </header>
+      <section class="main" style="display:none">
+        <input id="toggle-all" class="toggle-all" type="checkbox">
+        <label for="toggle-all">Mark all as complete</label>
+        <ul class="todo-list"></ul>
+      </section>
+      <footer class="footer" style="display:none">
+        <span class="todo-count"><strong>0</strong> items left</span>
+        <ul class="filters">
+          <li><a class="selected" href="#/">All</a></li>
+          <li><a href="#/active">Active</a></li>
+          <li><a href="#/completed">Completed</a></li>
+        </ul>
+        <button class="clear-completed">Clear completed</button>
+      </footer>
+    </section>
+    <footer class="info">
+      <p>Double-click to edit a todo</p>
+    </footer>
+    <script src="js/app.js"></script>
+  </body>
+</html>
diff --git a/js/app.js b/js/app.js
new file mode 100644
index 0000000..932721a
--- /dev/null
+++ b/js/app.js
@@ -0,0 +1,273 @@
+/**
+ * @planks("the app is loaded with an empty todo list")
+ * @planks("the todo list is empty")
+ * @planks("the todo list has these items:")
+ * @planks("I type {string} in the new todo input and press Enter")
+ * @planks("I toggle the todo at position {int}")
+ * @planks("I double-click the label of todo at position {int}")
+ * @planks("I hover over the todo at position {int}")
+ * @planks("I click the destroy button of todo at position {int}")
+ * @planks("I clear the edit input and type {string} and press Enter")
+ * @planks("I clear the edit input and type {string} and blur")
+ * @planks("I clear the edit input and press Enter")
+ * @planks("I clear the edit input and type {string} and press Escape")
+ * @planks("I click the toggle-all checkbox")
+ * @planks("I click the clear completed button")
+ * @planks("I navigate to {string}")
+ * @planks("the page is reloaded")
+ * @planks("the page loads")
+ */
+(function () {
+  'use strict';
+
+  var STORAGE_KEY = 'todos-vanillajs';
+  var ENTER_KEY = 13;
+  var ESCAPE_KEY = 27;
+
+  var todos = [];
+  var currentFilter = '/';
+
+  function genId() {
+    return Date.now().toString(36) + Math.random().toString(36).slice(2);
+  }
+
+  function save() {
+    try {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
+    } catch (e) {}
+  }
+
+  function load() {
+    try {
+      var data = localStorage.getItem(STORAGE_KEY);
+      if (data) {
+        todos = JSON.parse(data);
+      }
+    } catch (e) {
+      todos = [];
+    }
+  }
+
+  function getActiveFilter() {
+    var hash = window.location.hash || '#/';
+    var route = hash.replace('#', '');
+    if (route === '/active') return 'active';
+    if (route === '/completed') return 'completed';
+    return '/';
+  }
+
+  function getFilteredTodos() {
+    var filter = getActiveFilter();
+    if (filter === 'active') return todos.filter(function (t) { return !t.completed; });
+    if (filter === 'completed') return todos.filter(function (t) { return t.completed; });
+    return todos.slice();
+  }
+
+  function render() {
+    var main = document.querySelector('.main');
+    var footer = document.querySelector('.footer');
+    var todoList = document.querySelector('.todo-list');
+    var toggleAll = document.querySelector('#toggle-all');
+    var counter = document.querySelector('.todo-count strong');
+    var clearBtn = document.querySelector('.clear-completed');
+    var filterLinks = document.querySelectorAll('.filters a');
+
+    todoList.innerHTML = '';
+    if (todos.length === 0) {
+      main.style.display = 'none';
+      footer.style.display = 'none';
+      return;
+    }
+
+    main.style.display = '';
+    footer.style.display = '';
+
+    var filtered = getFilteredTodos();
+
+    filtered.forEach(function (todo) {
+      var li = document.createElement('li');
+      li.dataset.id = todo.id;
+      if (todo.completed) li.classList.add('completed');
+
+      var divView = document.createElement('div');
+      divView.className = 'view';
+
+      var checkbox = document.createElement('input');
+      checkbox.className = 'toggle';
+      checkbox.type = 'checkbox';
+      checkbox.checked = todo.completed;
+
+      var label = document.createElement('label');
+      label.textContent = todo.title;
+
+      var destroyBtn = document.createElement('button');
+      destroyBtn.className = 'destroy';
+
+      divView.appendChild(checkbox);
+      divView.appendChild(label);
+      divView.appendChild(destroyBtn);
+
+      var editInput = document.createElement('input');
+      editInput.className = 'edit';
+      editInput.value = todo.title;
+
+      li.appendChild(divView);
+      li.appendChild(editInput);
+      todoList.appendChild(li);
+    });
+
+    var activeCount = todos.filter(function (t) { return !t.completed; }).length;
+    counter.textContent = activeCount;
+    var countLabel = activeCount === 1 ? ' item left' : ' items left';
+    counter.parentNode.innerHTML = '<strong>' + activeCount + '</strong>' + countLabel;
+
+    var allCompleted = todos.length > 0 && todos.every(function (t) { return t.completed; });
+    toggleAll.checked = allCompleted;
+
+    var hasCompleted = todos.some(function (t) { return t.completed; });
+    clearBtn.style.display = hasCompleted ? '' : 'none';
+
+    var filter = getActiveFilter();
+    filterLinks.forEach(function (a) {
+      a.classList.remove('selected');
+      var href = a.getAttribute('href');
+      if (filter === '/' && href === '#/') a.classList.add('selected');
+      else if (filter === 'active' && href === '#/active') a.classList.add('selected');
+      else if (filter === 'completed' && href === '#/completed') a.classList.add('selected');
+    });
+  }
+
+  function addTodo(title) {
+    var trimmed = title.trim();
+    if (!trimmed) return;
+    todos.push({ id: genId(), title: trimmed, completed: false });
+    save();
+    render();
+  }
+
+  function toggleTodo(id) {
+    todos.forEach(function (t) {
+      if (t.id === id) t.completed = !t.completed;
+    });
+    save();
+    render();
+  }
+
+  function toggleAll() {
+    var allCompleted = todos.every(function (t) { return t.completed; });
+    todos.forEach(function (t) { t.completed = !allCompleted; });
+    save();
+    render();
+  }
+
+  function destroyTodo(id) {
+    console.log('destroyTodo called, id:', id);
+    todos = todos.filter(function (t) { return t.id !== id; });
+    console.log('todos after filter:', todos.length);
+    save();
+    console.log('calling render from destroyTodo');
+    render();
+    console.log('render from destroyTodo done');
+  }
+
+  function clearCompleted() {
+    todos = todos.filter(function (t) { return !t.completed; });
+    save();
+    render();
+  }
+
+  function updateTodo(id, title) {
+    console.log('updateTodo called, id:', id, 'title:', title);
+    var trimmed = title.trim();
+    console.log('trimmed:', trimmed, 'empty:', !trimmed);
+    if (!trimmed) {
+      destroyTodo(id);
+      return;
+    }
+    todos.forEach(function (t) {
+      if (t.id === id) t.title = trimmed;
+    });
+    save();
+    render();
+  }
+
+  function findTodoAtPosition(pos) {
+    var filtered = getFilteredTodos();
+    return filtered[pos - 1] || null;
+  }
+
+  document.addEventListener('DOMContentLoaded', function () {
+    load();
+    render();
+
+    var newTodoInput = document.querySelector('.new-todo');
