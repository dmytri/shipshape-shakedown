+(function () {
+	'use strict';
+
+	var STORAGE_KEY = 'todos-vanillajs';
+
+	// Model
+	var todos = [];
+	var currentFilter = 'all';
+
+	// DOM elements
+	var newTodoInput = document.querySelector('.new-todo');
+	var todoList = document.querySelector('.todo-list');
+	var mainSection = document.querySelector('.main');
+	var footer = document.querySelector('.footer');
+	var toggleAllCheckbox = document.getElementById('toggle-all');
+	var clearCompletedButton = document.querySelector('.clear-completed');
+	var filterLinks = document.querySelectorAll('.filters a');
+
+	// Load todos from localStorage
+	function loadTodos() {
+		var stored = localStorage.getItem(STORAGE_KEY);
+		if (stored) {
+			try {
+				todos = JSON.parse(stored);
+			} catch (e) {
+				todos = [];
+			}
+		}
+	}
+
+	// Save todos to localStorage
+	function saveTodos() {
+		localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
+	}
+
+	// Generate unique ID
+	function generateId() {
+		return Date.now().toString(36) + Math.random().toString(36).substr(2);
+	}
+
+	// Create a new todo
+	function addTodo(title) {
+		title = title.trim();
+		if (title === '') {
+			return;
+		}
+		var todo = {
+			id: generateId(),
+			title: title,
+			completed: false
+		};
+		todos.push(todo);
+		saveTodos();
+		render();
+	}
+
+	// Toggle todo completion
+	function toggleTodo(id) {
+		for (var i = 0; i < todos.length; i++) {
+			if (todos[i].id === id) {
+				todos[i].completed = !todos[i].completed;
+				break;
+			}
+		}
+		saveTodos();
+		render();
+	}
+
+	// Delete a todo
+	function deleteTodo(id) {
+		todos = todos.filter(function (todo) {
+			return todo.id !== id;
+		});
+		saveTodos();
+		render();
+	}
+
+	// Edit a todo
+	function editTodo(id, newTitle) {
+		newTitle = newTitle.trim();
+		if (newTitle === '') {
+			deleteTodo(id);
+			return;
+		}
+		for (var i = 0; i < todos.length; i++) {
+			if (todos[i].id === id) {
+				todos[i].title = newTitle;
+				break;
+			}
+		}
+		saveTodos();
+		render();
+	}
+
+	// Clear completed todos
+	function clearCompleted() {
+		todos = todos.filter(function (todo) {
+			return !todo.completed;
+		});
+		saveTodos();
+		render();
+	}
+
+	// Toggle all todos
+	function toggleAll() {
+		var allCompleted = todos.every(function (todo) {
+			return todo.completed;
+		});
+		var newState = !allCompleted;
+		todos.forEach(function (todo) {
+			todo.completed = newState;
+		});
+		saveTodos();
+		render();
+	}
+
+	// Filter todos based on current filter
+	function getFilteredTodos() {
+		switch (currentFilter) {
+			case 'active':
+				return todos.filter(function (todo) {
+					return !todo.completed;
+				});
+			case 'completed':
+				return todos.filter(function (todo) {
+					return todo.completed;
+				});
+			default:
+				return todos;
+		}
+	}
+
+	// Create a new <li> element for a todo
+	function createTodoElement(todo) {
+		var li = document.createElement('li');
+		li.dataset.id = todo.id;
+		if (todo.completed) {
+			li.classList.add('completed');
+		}
+
+		var viewDiv = document.createElement('div');
+		viewDiv.className = 'view';
+
+		var toggleInput = document.createElement('input');
+		toggleInput.className = 'toggle';
+		toggleInput.type = 'checkbox';
+		if (todo.completed) {
+			toggleInput.checked = true;
+		}
+
+		var label = document.createElement('label');
+		label.textContent = todo.title;
+
+		var destroyButton = document.createElement('button');
+		destroyButton.className = 'destroy';
+
+		viewDiv.appendChild(toggleInput);
+		viewDiv.appendChild(label);
+		viewDiv.appendChild(destroyButton);
+
+		var editInput = document.createElement('input');
+		editInput.className = 'edit';
+		editInput.value = todo.title;
+
+		li.appendChild(viewDiv);
+		li.appendChild(editInput);
+
+		return li;
+	}
+
+	// Update an existing <li> element in place
+	function updateTodoElement(li, todo) {
+		// Update completed state
+		if (todo.completed) {
+			li.classList.add('completed');
+		} else {
+			li.classList.remove('completed');
+		}
+
+		// Update toggle checkbox
+		var toggleInput = li.querySelector('.toggle');
+		toggleInput.checked = todo.completed;
+
+		// Update label text
+		var label = li.querySelector('label');
+		label.textContent = todo.title;
+
+		// Update edit input value
+		var editInput = li.querySelector('.edit');
+		editInput.value = todo.title;
+	}
+
+	// Render the app
+	function render() {
+		var filteredTodos = getFilteredTodos();
+		var activeTodos = todos.filter(function (todo) {
+			return !todo.completed;
+		});
+		var completedTodos = todos.filter(function (todo) {
+			return todo.completed;
+		});
+
+		// Build a map of existing <li> elements by data-id
+		var existingLis = todoList.querySelectorAll('li');
+		var existingMap = {};
+		for (var i = 0; i < existingLis.length; i++) {
+			existingMap[existingLis[i].dataset.id] = existingLis[i];
+		}
+
+		// Build a set of filtered todo IDs
+		var filteredIds = {};
+		filteredTodos.forEach(function (todo) {
+			filteredIds[todo.id] = true;
+		});
+
+		// Remove <li> elements for todos not in the filtered set
+		var currentLis = todoList.querySelectorAll('li');
+		for (var j = currentLis.length - 1; j >= 0; j--) {
+			var existingLi = currentLis[j];
+			if (!filteredIds[existingLi.dataset.id]) {
+				todoList.removeChild(existingLi);
+			}
+		}
+
+		// Add or update <li> elements in order
+		filteredTodos.forEach(function (todo) {
+			var li = existingMap[todo.id];
+			if (li) {
+				// Update existing element in place
+				updateTodoElement(li, todo);
+			} else {
+				// Create new element and append
+				li = createTodoElement(todo);
+				todoList.appendChild(li);
+			}
+		});
+
+		// Update main section visibility
+		if (todos.length > 0) {
+			mainSection.style.display = 'block';
+			footer.style.display = 'block';
+		} else {
+			mainSection.style.display = 'none';
+			footer.style.display = 'none';
+		}
+
+		// Update toggle all checkbox
+		toggleAllCheckbox.checked = todos.length > 0 && activeTodos.length === 0;
+
+		// Update count
+		var count = activeTodos.length;
+		var countText = count === 1 ? ' item left' : ' items left';
+		var todoCountSpan = document.querySelector('.todo-count');
+		todoCountSpan.innerHTML = '';
+		var strong = document.createElement('strong');
+		strong.textContent = String(count);
+		todoCountSpan.appendChild(strong);
+		todoCountSpan.appendChild(document.createTextNode(countText));
+
+		// Update clear completed button
+		if (completedTodos.length > 0) {
+			clearCompletedButton.style.display = 'block';
+		} else {
+			clearCompletedButton.style.display = 'none';
+		}
+
+		// Update filter links
+		filterLinks.forEach(function (link) {
+			if (link.getAttribute('href') === '#/' + currentFilter ||
+				(currentFilter === 'all' && link.getAttribute('href') === '#/')) {
+				link.classList.add('selected');
+			} else {
+				link.classList.remove('selected');
+			}
+		});
+	}
+
+	// Escape HTML to prevent XSS
+	function escapeHtml(text) {
+		var div = document.createElement('div');
+		div.appendChild(document.createTextNode(text));
+		return div.innerHTML;
+	}
+
+	// Event delegation for todo list
+	function handleTodoListClick(e) {
+		var target = e.target;
+		var li = target.closest('li');
+		if (!li) return;
+		var id = li.dataset.id;
+
+		if (target.classList.contains('toggle')) {
+			toggleTodo(id);
+		} else if (target.classList.contains('destroy')) {
+			deleteTodo(id);
+		}
+	}
+
+	function handleTodoListDblClick(e) {
+		var target = e.target;
+		if (target.tagName.toLowerCase() !== 'label') return;
+		var li = target.closest('li');
+		if (!li) return;
+		li.classList.add('editing');
+		var editInput = li.querySelector('.edit');
+		editInput.focus();
+	}
+
+	function handleTodoListKeyDown(e) {
+		if (e.key === 'Enter') {
+			var target = e.target;
+			if (target.classList.contains('edit')) {
+				var li = target.closest('li');
+				var id = li.dataset.id;
+				editTodo(id, target.value);
+				li.classList.remove('editing');
+			}
+		} else if (e.key === 'Escape') {
+			var target = e.target;
+			if (target.classList.contains('edit')) {
+				var li = target.closest('li');
+				li.classList.remove('editing');
+				target.value = li.querySelector('label').textContent;
+			}
+		}
+	}
+
+	function handleTodoListBlur(e) {
+		var target = e.target;
+		if (target.classList.contains('edit')) {
+			var li = target.closest('li');
+			var id = li.dataset.id;
+			editTodo(id, target.value);
+			li.classList.remove('editing');
+		}
+	}
+
+	// New todo input
+	function handleNewTodoKeyDown(e) {
+		if (e.key === 'Enter') {
+			addTodo(newTodoInput.value);
+			newTodoInput.value = '';
+		}
+	}
+
+	// Toggle all
+	function handleToggleAllChange() {
+		toggleAll();
+	}
+
+	// Clear completed
+	function handleClearCompletedClick() {
+		clearCompleted();
+	}
+
+	// Filter links
+	function handleFilterClick(e) {
+		e.preventDefault();
+		var href = e.target.getAttribute('href');
+		if (href === '#/') {
+			currentFilter = 'all';
+		} else if (href === '#/active') {
+			currentFilter = 'active';
+		} else if (href === '#/completed') {
+			currentFilter = 'completed';
+		}
+		render();
+	}
+
+	// Handle routing
+	function handleHashChange() {
+		var hash = window.location.hash;
+		if (hash === '#/active') {
+			currentFilter = 'active';
+		} else if (hash === '#/completed') {
+			currentFilter = 'completed';
+		} else {
+			currentFilter = 'all';
+		}
+		render();
+	}
+
+	// Initialize
+	function init() {
+		loadTodos();
+		render();
+
+		// Event listeners
+		newTodoInput.addEventListener('keydown', handleNewTodoKeyDown);
+		todoList.addEventListener('click', handleTodoListClick);
+		todoList.addEventListener('dblclick', handleTodoListDblClick);
+		todoList.addEventListener('keydown', handleTodoListKeyDown);
+		todoList.addEventListener('blur', handleTodoListBlur, true);
+		toggleAllCheckbox.addEventListener('change', handleToggleAllChange);
+		clearCompletedButton.addEventListener('click', handleClearCompletedClick);
+		filterLinks.forEach(function (link) {
+			link.addEventListener('click', handleFilterClick);
+		});
+		window.addEventListener('hashchange', handleHashChange);
+
+		// Handle initial hash
+		handleHashChange();
+	}
+
+	init();
+})();
