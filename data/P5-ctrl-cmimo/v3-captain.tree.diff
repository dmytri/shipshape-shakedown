diff --git a/features/support/world.js b/features/support/world.js
index 128178f..1e926f5 100644
--- a/features/support/world.js
+++ b/features/support/world.js
@@ -2,12 +2,33 @@ const { World, setWorldConstructor } = require('@cucumber/cucumber');
 const { Window } = require('happy-dom');
 const fs = require('fs');
 const path = require('path');
+const assert = require('assert');
 
 class TodoWorld extends World {
   constructor(options) {
     super(options);
     this.window = null;
     this.document = null;
+    this._domSnapshots = {};
+  }
+
+  snapshotDom(label) {
+    const todoList = this.document.querySelector('.todo-list');
+    const items = this.getTodoItems();
+    this._domSnapshots[label] = items.map(li => ({
+      id: li.dataset.id,
+      node: li,
+      todoList: todoList
+    }));
+  }
+
+  assertDomUnchanged(label) {
+    const before = this._domSnapshots[label];
+    if (!before) throw new Error('No DOM snapshot found for: ' + label);
+    before.forEach(entry => {
+      assert.ok(entry.node.parentNode === entry.todoList,
+        'DOM node for todo with id ' + entry.id + ' must remain attached to the todo list (not replaced by re-render)');
+    });
   }
 
   setupDom() {
