diff --git a/scantlings/dom-identity.json b/scantlings/dom-identity.json
new file mode 100644
index 0000000..360964c
--- /dev/null
+++ b/scantlings/dom-identity.json
@@ -0,0 +1,24 @@
+{
+  "title": "DOM Element Identity Preservation",
+  "description": "The render() function must preserve existing <li> element identity across state changes. InnerHTML replacement (todoList.innerHTML = '') destroys all child nodes, breaking browser references and visibility checks. Mutation in place — toggle classes, update text, toggle visibility — preserves element identity.",
+  "forbidden": [
+    {
+      "pattern": "todoList.innerHTML = ''",
+      "explanation": "Replacing innerHTML destroys all child nodes, invalidating element references held by the browser/Cypress"
+    },
+    {
+      "pattern": "todoList.innerHTML = \"\"",
+      "explanation": "Same as above with double-quote syntax"
+    }
+  ],
+  "required": [
+    {
+      "pattern": "li.classList.toggle",
+      "explanation": "Toggling classList on existing elements preserves DOM identity"
+    },
+    {
+      "pattern": "editInput.focus()",
+      "explanation": "Focus must target the new (recently rendered) edit input, not a detached reference; the focus() call must act on a node still in the document"
+    }
+  ]
+}
\ No newline at end of file
