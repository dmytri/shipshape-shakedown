@@ -0,0 +1,145 @@
+const { Given, Then } = require('@cucumber/cucumber');
+const assert = require('node:assert');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const ROOT = path.resolve(__dirname, '..', '..');
+
+// ── Source-level conformance ────────────────────────────────────────────────
+
+Given('I inspect the app source', function () {
+  const appPath = path.join(ROOT, 'js', 'app.js');
+  this.appSource = fs.readFileSync(appPath, 'utf8');
+});
+
+Then('the {string} function does not clear the todo list with innerHTML', function (fnName) {
+  // The render function must NOT use `innerHTML = ''` or `innerHTML = ""` to clear the list.
+  // Instead, it should mutate existing nodes in place.
+  // We detect this by checking that the function body does not contain the pattern
+  // `innerHTML\s*=\s*['"]\s*['"]` (assignment to empty string) anywhere that would
+  // clear the todo-list container.
+  const lines = this.appSource.split('\n');
+  let inFunction = false;
+  let braceDepth = 0;
+  for (const line of lines) {
+    if (line.includes('function ' + fnName + '(')) {
+      inFunction = true;
+      braceDepth = 0;
+    }
+    if (!inFunction) continue;
+
+    // Count braces to track function boundaries
+    for (const ch of line) {
+      if (ch === '{') braceDepth++;
+      if (ch === '}') braceDepth--;
+    }
+
+    // Check for innerHTML = '' pattern
+    if (/innerHTML\s*=\s*['"]\s*['"]/.test(line) || /innerHTML\s*=\s*""/.test(line)) {
+      assert.fail(`render function uses innerHTML = '' to clear the list (line: ${line.trim()}) — must use in-place DOM mutation instead`);
+    }
+
+    if (braceDepth <= 0 && inFunction) {
+      // End of function, move on
+      inFunction = false;
+    }
+  }
+});
+
+Then('the toggle handler toggles the {string} class on the existing <li>', function (className) {
+  // The toggle click handler should NOT call render() after changing the state.
+  // Instead, it should toggle the class on the existing <li> and update the checkbox.
+  // We check that the handler does NOT call render() directly.
+  // It may call setTodos() to persist, but should not rebuild the DOM.
+  const source = this.appSource;
+  // Find the toggle click handler: it's inside the forEach loop in render()
+  // Look for the pattern where .toggle click handler does NOT call render()
+  // The bad pattern: todo.completed = ...; setTodos(); render();
+  // The good pattern: toggle class on the parent li, update checkbox, then setTodos()
+
+  // The handler should reference the parent li element and toggle the class directly
+  // Check that the source contains a pattern showing li.classList.toggle or similar
+  const hasClassToggle = /\.classList\.(add|remove|toggle)\s*\(/.test(source);
+  const hasClassListAdd = /\.classList\.add\s*\(/.test(source);
+  const hasClassListRemove = /\.classList\.remove\s*\(/.test(source);
+
+  // The current bad code does: todo.completed = this.checked; setTodos(todos); render();
+  // The good code should NOT call render() in the toggle handler
+  // Instead it should toggle the class on the LI and update the checkbox
+
+  // Check for the bad pattern: The toggle handler calls render() directly
+  // Find the toggle event listener
+  const toggleHandlerMatch = source.match(/\.toggle['"]?\)\.addEventListener\(['"]click['"][^)]*\)\s*\{[^}]*render\s*\(\)[^}]*\}/);
+  if (toggleHandlerMatch) {
+    assert.fail('Toggle click handler calls render() — it should mutate the existing <li> in place instead of rebuilding the list');
+  }
+
+  // Check for the good pattern: the toggle handler does DOM mutation
+  // Look for li.classList or parentElement.classList in the handler
+  const hasDomMutation = /classList\.(add|remove|toggle|contains)/.test(source);
+  if (!hasDomMutation) {
+    // This is a soft check — the source might use a different approach
+    // For now, we just check that the render function doesn't do innerHTML = ''
+    // which is already checked above
+  }
+});
+
+Then('the toggle-all handler toggles the {string} class on each existing <li>', function (className) {
+  // The toggle-all handler should also mutate in place, not call render()
+  const source = this.appSource;
+  // Find the toggleAllTodos function or the toggle-all click handler
+  // Check that it doesn't call render() (the bad pattern)
+  // The toggleAllTodos function at line ~132 does: todos.forEach(...); setTodos(); render();
+  // The fix should do: forEach existing li, toggle class, update checkbox
+
+  // Check if the toggleAll function calls render()
+  // Find the function definition
+  const funcMatch = source.match(/function\s+toggleAllTodos\s*\([^)]*\)\s*\{[^}]*render\s*\(\)[^}]*\}/);
+  if (funcMatch) {
+    assert.fail('toggleAllTodos function calls render() — it should mutate existing <li> elements in place');
+  }
+});
+
+Then('the dblclick handler does not use the captured {string} variable after calling {string}', function (varName, fnName) {
+  // The dblclick handler should not reference the captured `li` variable after calling render()
+  // We check that between render() and the end of the handler, there's no reference to `li.`
+  const source = this.appSource;
+
+  // Find the dblclick handler body
+  // Look for: addEventListener('dblclick', function () { ... })
+  // Specifically, the pattern: todo.editing = true; render(); var editInput = li.querySelector('.edit');
+  const dblclickMatch = source.match(/addEventListener\(['"]dblclick['"][^)]*\)\s*\{([^}]*)\}/);
+  if (dblclickMatch) {
+    const handlerBody = dblclickMatch[1];
+    // Check if render() is called and then li. is used
+    if (handlerBody.includes('render()') && (handlerBody.includes('li.') || handlerBody.includes('li['))) {
+      assert.fail(`dblclick handler references captured "${varName}" variable after calling render() — must re-query the DOM instead`);
+    }
+  }
+});
+
+Then('the dblclick handler queries the document for the new {string} input after render', function (selector) {
+  // The dblclick handler should re-query the DOM for the edit input after render
+  // It should use document.querySelector or todoList.querySelector instead of li.querySelector
+  const source = this.appSource;
+
+  // Find the dblclick handler
+  const dblclickMatch = source.match(/addEventListener\(['"]dblclick['"][^)]*\)\s*\{([^}]*)\}/);
+  if (dblclickMatch) {
+    const handlerBody = dblclickMatch[1];
+    // Check that after render(), the handler uses document.querySelector or similar
+    // to find the edit input, not li.querySelector
+    if (handlerBody.includes('render()')) {
+      const afterRender = handlerBody.split('render()')[1] || '';
+      if (afterRender.includes('li.querySelector') || afterRender.includes('li[')) {
+        assert.fail('dblclick handler uses li.querySelector after render() — must re-query the document');
+      }
+      // Check that it does query the document
+      const hasQuery = /querySelector/.test(afterRender) || /querySelectorAll/.test(afterRender);
+      if (!hasQuery) {
+        assert.fail('dblclick handler does not query the DOM for the edit input after render()');
+      }
+    }
+  }
+});
+
