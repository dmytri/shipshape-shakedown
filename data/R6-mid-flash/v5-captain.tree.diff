 const fs = require('node:fs');
 const path = require('node:path');
 
+// ── Source-level conformance helpers ─────────────────────────────────
+
+var currentSource = null;
+
+function sourcePath(fn) {
+  return path.join(ROOT, fn);
+}
+
+function readSource(filename) {
+  var p = sourcePath(filename);
+  if (!fs.existsSync(p)) throw new Error('Source file not found: ' + p);
+  currentSource = fs.readFileSync(p, 'utf8');
+}
+
+function refutePattern(pattern, msg) {
+  if (pattern.test(currentSource)) {
+    throw new Error('Source conformance FAILED: ' + msg);
+  }
+}
+
+function assertPattern(pattern, msg) {
+  if (!pattern.test(currentSource)) {
+    throw new Error('Source conformance FAILED: ' + msg);
+  }
+}
+
