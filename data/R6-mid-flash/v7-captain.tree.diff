+}
+
+// ── DOM identity ────────────────────────────────────────────────────────────
+
+const capturedElements = new Map();
+
+When('I capture the reference of the first todo element', function () {
+  const li = this.document.querySelector('.todo-list li:first-child');
+  if (!li) throw new Error('No todo element found');
+  capturedElements.set('first', li);
+});
+
+When('I capture the reference of the second todo element', function () {
+  const items = this.document.querySelectorAll('.todo-list li');
+  if (items.length < 2) throw new Error('Less than 2 todo elements found');
+  capturedElements.set('second', items[1]);
+});
+
+Then('the first todo element is still the same DOM node', function () {
+  const captured = capturedElements.get('first');
+  if (!captured) throw new Error('No captured reference for first todo element');
+  assert.ok(captured.isConnected, 'Element is no longer connected to the DOM');
+  const todoList = this.document.querySelector('.todo-list');
+  assert.ok(todoList.contains(captured), 'Element is no longer a child of the todo-list');
+});
+
+Then('the second todo element is still the same DOM node', function () {
+  const captured = capturedElements.get('second');
+  if (!captured) throw new Error('No captured reference for second todo element');
+  assert.ok(captured.isConnected, 'Element is no longer connected to the DOM');
+  const todoList = this.document.querySelector('.todo-list');
+  assert.ok(todoList.contains(captured), 'Element is no longer a child of the todo-list');
+});
+
+// ── Source-level conformance ──────────────────────────────────────────────────
+
+When('I inspect the source of {string}', function (relativePath) {
+  const filePath = path.join(ROOT, relativePath);
+  if (!fs.existsSync(filePath))
+    throw new Error('Source file not found: ' + filePath);
+  this._inspectedSource = fs.readFileSync(filePath, 'utf8');
+});
+
+Then('the source MUST NOT contain a full-list re-render pattern that destroys all child elements', function () {
+  const src = this._inspectedSource;
+  if (!src) throw new Error('No source has been inspected');
+
+  const lines = src.split('\n');
+  const violations = [];
+
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    if (/todoList\.innerHTML\s*=/.test(line) &&
+        !/todoList\.innerHTML\s*=\s*todoList\.innerHTML/.test(line)) {
+      violations.push('Line ' + (i + 1) + ': ' + line.trim());
+    }
+  }
+
+  if (violations.length > 0) {
+    assert.fail(
+      'Source code MUST NOT destroy and recreate todo-list elements. ' +
+      'Found ' + violations.length + ' violation(s):\n' +
+      violations.join('\n') + '\n\n' +
+      'Fix: mutate existing <li> nodes in place (classList.toggle, .checked =, .textContent =) ' +
+      'instead of assigning todoList.innerHTML.'
+    );
+  }
+});
