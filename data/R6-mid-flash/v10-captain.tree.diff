@@ -497,6 +497,86 @@ Then('the stored data conforms to the {string} schema in {string}', function (sc
 
 // ── Helpers ─────────────────────────────────────────────────────────────────
 
+// ── Source-level conformance checks ───────────────────────────────────────
+
+Given('the app source at {string}', function (path) {
+  this.appSourcePath = path;
+  this.appSource = fs.readFileSync(path, 'utf8');
+});
+
+When('I check for the render anti-patterns', function () {
+  // No-op: the source was captured in the Given step.
+  // Assertions run in the Then steps.
+});
+
+Then('the render function does not destroy and recreate list-item DOM nodes', function () {
+  const src = this.appSource;
+  // Detect the anti-pattern: setting innerHTML on the todo-list inside render()
+  // This destroys all existing <li> elements, causing DOM detachment.
+  const hasInnerHtmlInRender = /render\s*\(\)[\s\S]*?todoList\.innerHTML/.test(src);
+  if (hasInnerHtmlInRender) {
+    throw new Error(
+      'Conformance FAIL: render() sets todoList.innerHTML, which destroys and ' +
+      'recreates all list-item DOM nodes. This causes DOM detachment in a real browser ' +
+      'when toggling completed state, because any reference held before the render ' +
+      'cycle is invalidated. Fix: mutate existing <li> nodes in place - toggle the ' +
+      '`.completed` class on the parent <li> and update the `.toggle` checkbox ' +
+      'checked property without re-creating the elements.'
+    );
+  }
+});
+
+Then('the render function does not discard transient state by re-reading from storage', function () {
+  const src = this.appSource;
+  // Detect the anti-pattern: render() calls getTodos() from localStorage,
+  // which clears any transient in-memory state (like the editing flag).
+  const renderCallsGetTodos = /render\s*\(\)[\s\S]*?getTodos\s*\(/.test(src);
+  if (renderCallsGetTodos) {
+    throw new Error(
+      'Conformance FAIL: render() calls getTodos() which re-reads from localStorage, ' +
+      'discarding transient in-memory state such as the `editing` flag. ' +
+      'The dblclick handler sets todo.editing = true, but render() then reads from ' +
+      'localStorage where editing is never persisted, so the flag is lost and the ' +
+      '`.editing` class is never applied to the <li>. ' +
+      'Fix 1: save the editing state from the in-memory todo before getTodos() overwrites it. ' +
+      'Fix 2: pass current todos to render() instead of re-reading from storage. ' +
+      'Fix 3: mutate DOM nodes in place so render() does not need to rebuild state from storage.'
+    );
+  }
+});
+
+When('I check for the editing anti-patterns', function () {
+  // No-op: source captured in Given; assertions run in Then steps.
+});
+
+Then('the dblclick handler does not call render before persisting the editing flag', function () {
+  const src = this.appSource;
+  // Detect: in dblclick listeners, render() is called after setting todo.editing = true
+  // but before the editing state is saved/persisted.
+  const dblclickSetsThenRenders = /dblclick[\s\S]*?editing\s*=\s*true[\s\S]*?render\s*\(/.test(src);
+  if (dblclickSetsThenRenders) {
+    throw new Error(
+      'Conformance FAIL: the dblclick handler sets todo.editing = true then calls render(), ' +
+      'but render() re-reads from localStorage where the editing flag was never saved. ' +
+      'Fix: either save the editing flag to a transient in-memory store before calling render, ' +
+      'or mutate the existing <li> node in place (add .editing class) without re-rendering the list.'
+    );
+  }
+});
+
+Then('the render function does not re-read from localStorage when transient state is active', function () {
+  const src = this.appSource;
+  // Same check as the render anti-pattern, but scoped for clarity in the editing context
+  const renderCallsGetTodos = /render\s*\(\)[\s\S]*?getTodos\s*\(/.test(src);
+  if (renderCallsGetTodos) {
+    throw new Error(
+      'Conformance FAIL: render() re-reads todos from localStorage via getTodos(), ' +
+      'which discards transient in-memory state like the editing flag. ' +
+      'Fix: keep transient state in a separate in-memory store or pass it through to render().'
+    );
+  }
+});
