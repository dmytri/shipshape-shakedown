diff --git a/features/support/conformance.js b/features/support/conformance.js
new file mode 100644
index 0000000..32c29cd
--- /dev/null
+++ b/features/support/conformance.js
@@ -0,0 +1,44 @@
+const { Given, Then } = require('@cucumber/cucumber');
+const assert = require('node:assert');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const ROOT = path.resolve(__dirname, '..', '..');
+const APP_PATH = path.join(ROOT, 'js', 'app.js');
+
+Given('the app source is inspected', function () {
+  const src = fs.readFileSync(APP_PATH, 'utf8');
+  this.appSource = src;
+});
+
+Then('the render function must not clear the todo list via element replace', function () {
+  const src = this.appSource;
+  // The anti-pattern is render() clearing todoList.innerHTML and rebuilding LIs.
+  // Acceptable: in-place mutation of existing nodes.
+  // Reject: todoList.innerHTML = '' or todoList.textContent = '' inside render().
+  // Also reject: a loop that creates new <li> and appends, preceded by clearing the list.
+  const hasInnerHtmlClear = /todoList\.innerHTML\s*=\s*['"]\s*['"]/.test(src);
+  const hasTextContentClear = /todoList\.textContent\s*=\s*['"]\s*['"]/.test(src);
+  assert.ok(
+    !hasInnerHtmlClear && !hasTextContentClear,
+    'render() must not clear the todo list via innerHTML/textContent assignment — ' +
+    'mutate existing nodes in-place to preserve DOM element identity across state changes'
+  );
+});
+
+Then('the render function must not re-read todos from localStorage', function () {
+  const src = this.appSource;
+  // The anti-pattern is render() calling getTodos() which re-reads from localStorage,
+  // discarding transient in-memory state like the editing flag.
+  // Render should use the in-memory todos array, not re-read from storage.
+  // Check for the specific pattern: inside the render function body, a call to getTodos()
+  // Look for 'todos = getTodos()' or 'var todos = getTodos()' or 'let todos = getTodos()'
+  const hasGetTodosInRender =
+    /render\s*\(\s*\)\s*\{[^}]*todos\s*=\s*getTodos\s*\(\s*\)/.test(src) ||
+    /render\s*\(\s*\)\s*\{[\s\S]*?todos\s*=\s*getTodos\s*\(\s*\)/.test(src);
+  assert.ok(
+    !hasGetTodosInRender,
+    'render() must not call getTodos() — it must use the in-memory todos array ' +
+    'so that transient state like the editing flag is preserved across renders'
+  );
+});
