index 1ccba71..82846c4 100644
--- a/features/support/steps.js
+++ b/features/support/steps.js
@@ -446,6 +446,51 @@ Then('the {string} filter is selected', function (filterName) {
   throw new Error(`Filter "${filterName}" not found`);
 });
 
+// --- DOM identity ---
+
+Given('the DOM node reference for todo {string} is captured', function (title) {
+  if (!this._capturedNodes) this._capturedNodes = {};
+  const items = this.document.querySelectorAll('.todo-list li');
+  for (const item of items) {
+    const label = item.querySelector('label');
+    if (label.textContent === title) {
+      this._capturedNodes[title] = item;
+      return;
+    }
+  }
+  throw new Error(`Todo "${title}" not found for capture`);
+});
+
+Then('the captured DOM node for todo {string} is still attached to the document', function (title) {
+  if (!this._capturedNodes || !this._capturedNodes[title]) {
+    throw new Error(`No captured node for todo "${title}"`);
+  }
+  const node = this._capturedNodes[title];
+  if (!this.document.contains(node)) {
+    throw new Error(`Captured node for todo "${title}" is no longer attached to the document`);
+  }
+});
+
+Then('the captured DOM node for todo {string} has class {string}', function (title, className) {
+  if (!this._capturedNodes || !this._capturedNodes[title]) {
+    throw new Error(`No captured node for todo "${title}"`);
+  }
+  const node = this._capturedNodes[title];
+  if (!node.classList.contains(className)) {
+    throw new Error(`Captured node for todo "${title}" does not have class "${className}"`);
+  }
+});
+
+Then('the captured DOM node for todo {string} does not have class {string}', function (title, className) {
+  if (!this._capturedNodes || !this._capturedNodes[title]) {
+    throw new Error(`No captured node for todo "${title}"`);
+  }
+  const node = this._capturedNodes[title];
+  if (node.classList.contains(className)) {
+    throw new Error(`Captured node for todo "${title}" unexpectedly has class "${className}"`);
+  }
+});
+
 // --- Persistence ---
 
 When('the page is reloaded', async function () {
