+#!/usr/bin/env node
+
+// plank-join.mjs — Shipshape plank-join checker.
+//
+// Reads implementation directories (RIGGING.md ## Directories: implementation)
+// for @planks and @planks-provisional annotations. Reads step definitions from
+// step-definition files under the verification directory for their pattern
+// strings. Reports each seam with its plank and the join result.
+//
+// Exit 0 if: every @planks string matches a current step definition pattern,
+// every @planks-provisional names a scenario that carries @captain,
+// and every behaviour-bearing step pattern is planked.
+//
+// Exit 1 otherwise, with a list of faults.
+
+import fs from 'node:fs';
+import path from 'node:path';
+import { globSync } from 'node:fs';
+
+const ROOT = path.resolve(
+  import.meta.dirname || path.dirname(new URL(import.meta.url).pathname),
+  '..'
+);
+
+// Read RIGGING.md directory values
+function readRiggingValue(section, key) {
+  const rigPath = path.join(ROOT, 'RIGGING.md');
+  if (!fs.existsSync(rigPath)) return [];
+  const text = fs.readFileSync(rigPath, 'utf8');
+  const lines = text.split('\n');
+  let inSection = false;
+  const values = [];
+  for (const line of lines) {
+    if (line.startsWith('## ') && inSection) break;
+    if (line === `## ${section}`) { inSection = true; continue; }
+    if (inSection && line.trim().startsWith(`- ${key}:`)) {
+      const v = line.replace(`- ${key}:`, '').trim();
+      values.push(v);
+    }
+  }
+  return values;
+}
+
+const implPaths = readRiggingValue('Directories', 'implementation');
+const specPath = readRiggingValue('Directories', 'specs')[0] || 'features';
+const verifPath = readRiggingValue('Directories', 'verification')[0] || 'features/support';
+
+// --- Collect step definition patterns ---
+// Scan .js files under verification for /(Given|When|Then)\(\s*['"`]([^'"`]+)['"`]/g
+const stepPatterns = new Map(); // pattern -> { file, keyword }
+const verifDir = path.join(ROOT, verifPath);
+if (fs.existsSync(verifDir)) {
+  const files = fs.readdirSync(verifDir).filter(f => f.endsWith('.js'));
+  for (const f of files) {
+    const src = fs.readFileSync(path.join(verifDir, f), 'utf8');
+    const regex = /(Given|When|Then)\s*\(\s*['"`]([^'"`]+)['"`]/g;
+    let m;
+    while ((m = regex.exec(src)) !== null) {
+      const pattern = m[2];
+      if (!stepPatterns.has(pattern)) {
+        stepPatterns.set(pattern, { file: f, keyword: m[1] });
+        // Also normalize for And/But — the step definition keyword maps to the pattern
+      }
+    }
+  }
+}
+
+// --- Collect @captain scenarios ---
+const captainScenarios = new Set();
+const specDir = path.join(ROOT, specPath);
+if (fs.existsSync(specDir)) {
+  const featureFiles = [];
+  function walkDir(dir) {
+    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+      const full = path.join(dir, entry.name);
+      if (entry.isDirectory()) walkDir(full);
+      else if (entry.name.endsWith('.feature')) featureFiles.push(full);
+    }
+  }
+  walkDir(specDir);
+  for (const ff of featureFiles) {
+    const src = fs.readFileSync(ff, 'utf8');
+    const tagLines = src.split('\n');
+    let currentTags = [];
+    for (const line of tagLines) {
+      const trimmed = line.trim();
+      if (trimmed.startsWith('@')) {
+        // Collect tags on the line above a Scenario
+        if (trimmed.startsWith('@')) currentTags = trimmed.split(/\s+/).map(t => t.trim());
+      } else if (trimmed.startsWith('Scenario')) {
+        const scName = trimmed.replace(/^Scenario(?:\s*Outline)?:\s*/, '').trim();
+        const hasCaptain = currentTags.includes('@captain');
+        const relFile = path.relative(ROOT, ff);
+        const ref = `${relFile}:${scName}`;
+        if (hasCaptain) captainScenarios.add(ref);
+        currentTags = [];
+      } else if (!trimmed.startsWith('@') && trimmed.length > 0) {
+        currentTags = [];
+      }
+    }
+  }
+}
+
+// --- Scan implementation files for @planks and @planks-provisional ---
+// We look for /** */ docblock comments containing @planks or @planks-provisional
+// Also scan for bare @planks outside docblocks (fallback token search)
+
+const planks = []; // { file, line, annotation, value, isProvisional }
+const planksProvisional = [];
+
+function scanFile(filePath) {
+  const src = fs.readFileSync(filePath, 'utf8');
+  const lines = src.split('\n');
+
+  // Collect docblock comments
+  let inDocblock = false;
+  let docblockContent = '';
+  let docblockStart = 0;
+
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    if (line.trimStart().startsWith('/**')) {
+      inDocblock = true;
+      docblockContent = line;
+      docblockStart = i;
+    } else if (inDocblock) {
+      docblockContent += '\n' + line;
+      if (line.trim().endsWith('*/')) {
+        // Process docblock
+        const planksMatch = docblockContent.match(/@planks\s*\(\s*["'`]([^"'`]+)["'`]\s*\)/g);
+        if (planksMatch) {
+          for (const pm of planksMatch) {
+            const value = pm.match(/\(s*["'`]([^"'`]+)["'`]\s*\)/)[1];
+            planks.push({ file: filePath, line: docblockStart, annotation: pm, value, isProvisional: false });
+          }
+        }
+        const provMatch = docblockContent.match(/@planks-provisional\s*\(\s*["'`]([^"'`]+)["'`]\s*\)/g);
+        if (provMatch) {
+          for (const pm of provMatch) {
+            const value = pm.match(/\(s*["'`]([^"'`]+)["'`]\s*\)/)[1];
+            planksProvisional.push({ file: filePath, line: docblockStart, annotation: pm, value });
+          }
+        }
+        inDocblock = false;
+        docblockContent = '';
+      }
+    }
+  }
+}
+
+// Walk implementation paths
+for (const impl of implPaths) {
+  // Handle glob patterns
+  if (impl.includes('*')) {
+    // Simple glob: just match pattern literally against filesystem
+    const parts = impl.split('/');
+    let base = ROOT;
+    for (const part of parts) {
+      if (part === '*') {
+        // Match any single directory
+        // Not doing full glob — just skip
+        break;
+      } else {
+        base = path.join(base, part);
+      }
+    }
+    if (fs.existsSync(base) && fs.statSync(base).isDirectory()) {
+      const entries = fs.readdirSync(base);
+      for (const entry of entries) {
+        if (entry.startsWith('.')) continue;
+        const full = path.join(base, entry);
+        if (fs.statSync(full).isDirectory()) {
+          const files = fs.readdirSync(full).filter(f => f.endsWith('.js') || f.endsWith('.html') || f.endsWith('.css'));
+          for (const f of files) scanFile(path.join(full, f));
+        } else if (full.endsWith('.js') || full.endsWith('.html') || full.endsWith('.css')) {
+          scanFile(full);
+        }
+      }
+    }
+    continue;
+  }
+
+  const fullPath = path.join(ROOT, impl);
+  if (!fs.existsSync(fullPath)) continue;
+  if (fs.statSync(fullPath).isDirectory()) {
+    const files = fs.readdirSync(fullPath).filter(f => f.endsWith('.js') || f.endsWith('.html') || f.endsWith('.css'));
+    for (const f of files) scanFile(path.join(fullPath, f));
+  } else if (fullPath.endsWith('.js') || fullPath.endsWith('.html') || fullPath.endsWith('.css')) {
+    scanFile(fullPath);
+  }
+}
+
+// --- Report ---
+let exitCode = 0;
+const faults = [];
+
+// Check @planks against step patterns
+for (const p of planks) {
+  if (!stepPatterns.has(p.value)) {
+    faults.push(`UNMATCHED_PLANK: ${p.value} in ${path.relative(ROOT, p.file)}:${p.line} matches no step definition pattern`);
+    exitCode = 1;
+  }
+}
+
+// Check @planks-provisional against @captain scenarios
+for (const p of planksProvisional) {
+  if (!captainScenarios.has(p.value)) {
+    faults.push(`STALE_PROVISIONAL: ${p.value} in ${path.relative(ROOT, p.file)}:${p.line} names a scenario with no @captain tag`);
+    exitCode = 1;
+  }
+}
+
+// Check every step pattern is planked
+for (const [pattern, info] of stepPatterns) {
+  const planked = planks.some(p => p.value === pattern);
+  if (!planked) {
+    faults.push(`UNPLANKED_STEP: "${pattern}" in ${info.file} (${info.key}) has no @planks annotation on any implementation seam`);
+    exitCode = 1;
+  }
+}
+
+// --- Summary ---
+const summary = {
+  implPaths,
+  stepPatternsCount: stepPatterns.size,
+  planksCount: planks.length,
+  planksProvisionalCount: planksProvisional.length,
+  captainScenariosCount: captainScenarios.size,
+  faults,
+  exitCode,
+};
+
+fs.writeFileSync(
+  path.join(ROOT, '.shipshape', 'plank-join-report.json'),
+  JSON.stringify(summary, null, 2)
+);
+
+// Print for verification
+for (const fault of faults) {
+  console.error(fault);
+}
+
+if (exitCode === 0) {
+  console.log(`plank-join OK: ${planks.length} @planks, ${planksProvisional.length} @planks-provisional, ${stepPatterns.size} step patterns, ${captainScenarios.size} @captain scenarios`);
+} else {
+  console.error(`plank-join FAILED: ${faults.length} fault(s)`);
+}
+
+process.exit(exitCode);
\ No newline at end of file
