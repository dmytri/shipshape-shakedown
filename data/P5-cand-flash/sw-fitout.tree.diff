index 0000000..b660d35
--- /dev/null
+++ b/.shipshape/plank-join.mjs
@@ -0,0 +1,202 @@
+#!/usr/bin/env node
+// plank-join.mjs – Shipshape plank join checker.
+// Reads every .feature file under features/, every step definition under features/support/,
+// and every .js file under js/. Reports:
+//   - every production seam (exported function/class) and its @planks / @planks-provisional annotation
+//   - every step definition pattern with the scenarios that bind it
+//   - planks matching no current step pattern
+//   - @planks-provisional references to scenarios that no longer carry @captain
+//   - behaviour-bearing step-definition patterns with no matching plank token
+// Exits non-zero when any error is found.
+
+import { readFileSync, readdirSync, statSync, existsSync } from 'fs';
+import { join, relative, resolve } from 'path';
+
+const ROOT = process.cwd();
+const IMPL_DIR = resolve(ROOT, 'js');
+const FEATURES_DIR = resolve(ROOT, 'features');
+const SUPPORT_DIR = resolve(ROOT, 'features/support');
+
+// ── helpers ──────────────────────────────────────────────────────────────────
+
+function walkFiles(dir, ext) {
+  const files = [];
+  if (!existsSync(dir)) return files;
+  function walk(d) {
+    for (const entry of readdirSync(d)) {
+      const p = join(d, entry);
+      if (statSync(p).isDirectory()) { walk(p); continue; }
+      if (entry.endsWith(ext)) files.push(p);
+    }
+  }
+  walk(dir);
+  return files;
+}
+
+function slurp(path) {
+  try { return readFileSync(path, 'utf8'); } catch { return ''; }
+}
+
+// ── scan step definition patterns from support files ─────────────────────────
+
+const stepFiles = walkFiles(SUPPORT_DIR, '.js');
+const stepPatterns = new Map(); // pattern -> {keyword, file, line}
+
+for (const f of stepFiles) {
+  const text = slurp(f);
+  // Match cucumber-js step definition patterns:
+  // Given(/pattern/, ...), When(/pattern/, ...), Then(/pattern/, ...), And(/pattern/, ...)
+  const re = /(Given|When|Then|And|But)\(\s*\/((?:[^/\\]|\\.)+)\/\s*,/g;
+  let m;
+  while ((m = re.exec(text)) !== null) {
+    const kw = m[1];
+    const pattern = m[2];
+    // normalize escaped slashes
+    stepPatterns.set(pattern, { keyword: kw, file: relative(ROOT, f) });
+  }
+}
+
+// ── scan scenarios from feature files ─────────────────────────────────────────
+
+const featureFiles = walkFiles(FEATURES_DIR, '.feature');
+const scenarios = new Map(); // "features/foo.feature:Scenario Name" -> {tags: [], steps[]}
+const scenarioStepMap = new Map(); // pattern -> [scenarioRefs]
+
+for (const f of featureFiles) {
+  const text = slurp(f);
+  const rel = relative(ROOT, f);
+  const lines = text.split('\n');
+  let currentScenario = null;
+  let currentTags = [];
+  // Collect @captain scenarios and their steps
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i].trim();
+    if (line.startsWith('@')) {
+      // could be feature-level tags or scenario tags
+      // simple approach: if we're not in a scenario, accumulate
+      if (!currentScenario) {
+        currentTags = line.split(/\s+/).filter(t => t.startsWith('@'));
+      }
+      continue;
+    }
+    const scenarioMatch = line.match(/^(?:Scenario|Scenario Outline):\s*(.+)$/);
+    if (scenarioMatch) {
+      currentScenario = scenarioMatch[1];
+      scenarios.set(`${rel}:${currentScenario}`, { tags: [], steps: [] });
+      continue;
+    }
+    const stepMatch = line.match(/^(Given|When|Then|And|But)\s+(.+)$/);
+    if (currentScenario && stepMatch) {
+      const key = `${rel}:${currentScenario}`;
+      const s = scenarios.get(key);
+      if (s) s.steps.push({ keyword: stepMatch[1], text: stepMatch[2] });
+    }
+  }
+}
+
+// For each step pattern, find which scenarios bind it
+for (const [scenarioRef, data] of scenarios) {
+  for (const step of data.steps) {
+    for (const [pattern, info] of stepPatterns) {
+      try {
+        const re = new RegExp(`^${pattern}$`);
+        if (re.test(step.text)) {
+          if (!scenarioStepMap.has(pattern)) scenarioStepMap.set(pattern, []);
+          const refs = scenarioStepMap.get(pattern);
+          if (!refs.includes(scenarioRef)) refs.push(scenarioRef);
+        }
+      } catch { /* skip invalid regex */ }
+    }
+  }
+}
+
+// ── scan implementation files for @planks / @planks-provisional ───────────────
+
+const implFiles = walkFiles(IMPL_DIR, '.js');
+const planksFound = []; // { file, line, text, isProvisional, target }
+const allPlankStrings = [];
+const allProvisionalRefs = [];
+const exportedSeams = []; // { file, line, name }
+
+for (const f of implFiles) {
+  const text = slurp(f);
+  const lines = text.split('\n');
+  const rel = relative(ROOT, f);
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    // Check for @planks(...) in docblocks
+    const plankMatch = line.match(/@planks\("(.+)"\)/);
+    if (plankMatch) {
+      planksFound.push({ file: rel, line: i + 1, text: plankMatch[1], isProvisional: false, target: null });
+      allPlankStrings.push(plankMatch[1]);
+    }
+    // Check for @planks-provisional
+    const provMatch = line.match(/@planks-provisional\("(.+)"\)/);
+    if (provMatch) {
+      planksFound.push({ file: rel, line: i + 1, text: provMatch[1], isProvisional: true, target: provMatch[1] });
+      allProvisionalRefs.push(provMatch[1]);
+    }
+    // Detect exported functions/classes as seams
+    const exportMatch = line.match(/^export\s+(?:default\s+)?(?:function|class|const|let|var)\s+(\w+)/);
+    if (exportMatch) {
+      exportedSeams.push({ file: rel, line: i + 1, name: exportMatch[1] });
+    }
+  }
+}
+
+// ── validate ─────────────────────────────────────────────────────────────────
+
+let errors = 0;
+
+// 1. Planks matching no current step pattern (for non-provisional)
+for (const plank of planksFound) {
+  if (plank.isProvisional) continue;
+  if (!stepPatterns.has(plank.text)) {
+    console.error(`ERROR: @planks("${plank.text}") at ${plank.file}:${plank.line} matches no current step-definition pattern`);
+    errors++;
+  }
+}
+
+// 2. @planks-provisional references to scenarios that no longer carry @captain
+const captainScenarios = new Set();
+for (const [ref, data] of scenarios) {
+  if (data.tags.includes('@captain')) captainScenarios.add(ref);
+}
+for (const ref of allProvisionalRefs) {
+  if (!captainScenarios.has(ref) && !scenarios.has(ref)) {
+    console.error(`ERROR: @planks-provisional("${ref}") scenario not found or no longer carries @captain`);
+    errors++;
+  }
+}
+
+// 3. Behaviour-bearing step-definition patterns with no matching plank token
+for (const [pattern] of stepPatterns) {
+  if (!allPlankStrings.includes(pattern)) {
+    console.warn(`WARN: Step pattern "/${pattern}/" has no @planks annotation in implementation`);
+  }
+}
+
+// 4. Report summary
+console.log(`\nPlank join report:\n`);
+console.log(`  Step patterns:   ${stepPatterns.size}`);
+console.log(`  Scenarios:       ${scenarios.size}`);
+console.log(`  Planks found:    ${planksFound.length}`);
+console.log(`  Exported seams:  ${exportedSeams.length}`);
+console.log(`  Errors:          ${errors}`);
+
+if (planksFound.length > 0) {
+  console.log(`\n  Plank details:`);
+  for (const p of planksFound) {
+    const label = p.isProvisional ? 'PROVISIONAL' : 'PLANK';
+    console.log(`    ${label} ${p.file}:${p.line} "${p.text}"`);
+  }
+}
+
+if (exportedSeams.length > 0) {
+  console.log(`\n  Seams:`);
+  for (const s of exportedSeams) {
+    console.log(`    ${s.file}:${s.line} export ${s.name}`);
+  }
+}
+
+process.exit(errors > 0 ? 1 : 0);
\ No newline at end of file
