+When('I read the source file', function () {
+  const content = fs.readFileSync(this.sourceFile, 'utf8');
+  this.sourceContent = content;
+  this.sourceLines = content.split('\n');
+});
+
+Then('the source should contain a line setting {string} inside the render function', function (pattern) {
+  const lines = this.sourceLines;
+  // Find the render function body
+  let inRender = false;
+  let braceDepth = 0;
+  let found = false;
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    if (line.trim().startsWith('function render()') || line.trim().startsWith('function render (')) {
+      inRender = true;
+      braceDepth = 0;
+    }
+    if (inRender) {
+      for (let j = 0; j < line.length; j++) {
+        if (line[j] === '{') braceDepth++;
+        if (line[j] === '}') braceDepth--;
+      }
+      if (line.includes(pattern)) {
+        found = true;
+        break;
+      }
+      if (braceDepth <= 0 && line.includes('function ')) {
+        // Exited render for another function declaration at same level
+        inRender = false;
+      }
+    }
+  }
+  assert.ok(found, `Pattern "${pattern}" not found inside render function`);
+});
+
+Then('the Enter keydown handler for edit input should call preventDefault before saveEdit', function () {
+  const lines = this.sourceLines;
+  // Find the keydown handler for edit input that handles ENTER_KEY
+  // Look for a keydown event listener on todoListEl that has ENTER_KEY check
+  let inEnterBranch = false;
+  let inKeydownHandler = false;
+  let braceDepth = 0;
+  let hasPreventDefaultBeforeSaveEdit = false;
+  let saveEditLine = -1;
+  let preventDefaultLine = -1;
+
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    // Detect the keydown handler registration: addEventListener('keydown',
+    if (line.includes("addEventListener('keydown'") && line.includes('function')) {
+      inKeydownHandler = true;
+      braceDepth = 0;
+    }
+    if (!inKeydownHandler) continue;
+
+    for (let j = 0; j < line.length; j++) {
+      if (line[j] === '{') braceDepth++;
+      if (line[j] === '}') braceDepth--;
+    }
+
+    if (line.includes('ENTER_KEY')) {
+      inEnterBranch = true;
+    }
+
+    if (inEnterBranch && line.includes('preventDefault')) {
+      preventDefaultLine = i;
