diff --git a/features/support/dom-identity-steps.js b/features/support/dom-identity-steps.js
new file mode 100644
index 0000000..7b99891
--- /dev/null
+++ b/features/support/dom-identity-steps.js
@@ -0,0 +1,77 @@
+const { Given, When, Then } = require('@cucumber/cucumber');
+const assert = require('node:assert');
+
+/* ------------------------------------------------------------------ */
+/*  Capture element references before an action                        */
+/* ------------------------------------------------------------------ */
+
+When('I capture the list item element for {string}', function (title) {
+  const items = this.document.querySelectorAll('.todo-list li');
+  for (let i = 0; i < items.length; i++) {
+    const label = items[i].querySelector('label');
+    if (label && label.textContent.trim() === title) {
+      this.capturedElement = items[i];
+      return;
+    }
+  }
+  assert.fail(`Todo "${title}" not found for capture`);
+});
+
+When('I capture all list item elements', function () {
+  this.capturedElements = Array.from(this.document.querySelectorAll('.todo-list li'));
+  assert.ok(this.capturedElements.length > 0, 'No list items to capture');
+});
+
+/* ------------------------------------------------------------------ */
+/*  DOM connectivity assertions                                        */
+/* ------------------------------------------------------------------ */
+
+Then('the captured list item element is still connected to the DOM', function () {
+  assert.ok(this.capturedElement, 'No captured element to check');
+  assert.ok(this.capturedElement.isConnected,
+    'Captured element is detached from the DOM — the list was re-rendered');
+});
+
+Then('the captured list item element is not connected to the DOM', function () {
+  assert.ok(this.capturedElement, 'No captured element to check');
+  assert.ok(!this.capturedElement.isConnected,
+    'Captured element is still connected to the DOM');
+});
+
+Then('every captured list item element is still connected to the DOM', function () {
+  assert.ok(this.capturedElements, 'No captured elements to check');
+  assert.ok(this.capturedElements.length > 0, 'Captured elements array is empty');
+  const detached = this.capturedElements.filter(function (el) { return !el.isConnected; });
+  assert.strictEqual(detached.length, 0,
+    detached.length + ' captured element(s) are detached from the DOM — the list was re-rendered');
+});
+
+/* ------------------------------------------------------------------ */
+/*  Class assertions on captured elements                              */
+/* ------------------------------------------------------------------ */
+
+Then('the captured list item element has class {string}', function (className) {
+  assert.ok(this.capturedElement, 'No captured element to check');
+  assert.ok(this.capturedElement.classList.contains(className),
+    'Captured element does not have class "' + className + '"');
+});
+
+Then('the captured list item element does not have class {string}', function (className) {
+  assert.ok(this.capturedElement, 'No captured element to check');
+  assert.ok(!this.capturedElement.classList.contains(className),
+    'Captured element unexpectedly has class "' + className + '"');
+});
+
+Then('every captured list item element has class {string}', function (className) {
+  assert.ok(this.capturedElements, 'No captured elements to check');
+  const missing = this.capturedElements.filter(function (el) { return !el.classList.contains(className); });
+  assert.strictEqual(missing.length, 0,
+    missing.length + ' captured element(s) do not have class "' + className + '"');
+});
+
+Then('no captured list item element has class {string}', function (className) {
+  assert.ok(this.capturedElements, 'No captured elements to check');
+  const found = this.capturedElements.filter(function (el) { return el.classList.contains(className); });
+  assert.strictEqual(found.length, 0,
+    found.length + ' captured element(s) unexpectedly have class "' + className + '"');
+});
