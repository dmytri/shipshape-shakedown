+/**
+ * @planks("the app is loaded")
+ * TodoMVC Application
+ */
+(function () {
+	'use strict';
+
+	var STORAGE_KEY = 'todos';
+	var todoList = document.querySelector('.todo-list');
+	var newTodoInput = document.querySelector('.new-todo');
+	var toggleAllCheckbox = document.querySelector('#toggle-all');
+	var clearCompletedButton = document.querySelector('.clear-completed');
+	var todoCount = document.querySelector('.todo-count');
+	var mainSection = document.querySelector('.main');
+	var footer = document.querySelector('.footer');
+	var filters = document.querySelector('.filters');
+
+	var todos = [];
+	var currentFilter = '/';
+
+	/**
+	 * @planks("the user types {string} in the new-todo input and presses Enter")
+	 * @planks("a todo {string} exists")
+	 * @planks("a completed todo {string} exists")
+	 */
+	function addTodo(title) {
+		title = title.trim();
+		if (!title) return;
+		todos.push({
+			id: Date.now(),
+			title: title,
+			completed: false
+		});
+		saveTodos();
+		render();
+	}
+
+	/**
+	 * @planks("the user toggles the checkbox for {string}")
+	 * @planks("the user checks the toggle-all checkbox")
+	 * @planks("the user unchecks the toggle-all checkbox")
+	 */
+	function toggleTodo(id) {
+		var todo = todos.find(function (t) { return t.id === id; });
+		if (todo) {
+			todo.completed = !todo.completed;
+			saveTodos();
+			render();
+		}
+	}
+
+	/**
+	 * @planks("the user clicks the destroy button for {string}")
+	 */
+	function deleteTodo(id) {
+		todos = todos.filter(function (t) { return t.id !== id; });
+		saveTodos();
+		render();
+	}
+
+	/**
+	 * @planks("the user types {string} in the edit input and presses Enter")
+	 * @planks("the user types {string} in the edit input and blurs")
+	 * @planks("the user types {string} in the edit input and presses Escape")
+	 * @planks("the user clears the edit input and presses Enter")
+	 */
+	function editTodo(id, newTitle) {
+		var todo = todos.find(function (t) { return t.id === id; });
+		if (!todo) return;
+		newTitle = newTitle.trim();
+		if (!newTitle) {
+			deleteTodo(id);
+			return;
+		}
+		todo.title = newTitle;
+		saveTodos();
+		render();
+	}
+
+	/**
+	 * @planks("the user clicks the clear-completed button")
+	 */
+	function clearCompleted() {
+		todos = todos.filter(function (t) { return !t.completed; });
+		saveTodos();
+		render();
+	}
+
+	/**
+	 * @planks("a todo with title {string} exists in the list")
+	 * @planks("no todo with title {string} exists")
+	 * @planks("no todos exist")
+	 * @planks("the todo {string} is not completed")
+	 * @planks("the todo {string} is completed")
+	 * @planks("the todo item {string} has the class {string}")
+	 * @planks("the todo {string} is visible in the list")
+	 * @planks("the todo {string} is not visible in the list")
+	 */
+	function getVisibleTodos() {
+		switch (currentFilter) {
+			case '/active':
+				return todos.filter(function (t) { return !t.completed; });
+			case '/completed':
+				return todos.filter(function (t) { return t.completed; });
+			default:
+				return todos;
+		}
+	}
+
+	/**
+	 * @planks("the todo count shows {string}")
+	 */
+	function updateCount() {
+		var activeCount = todos.filter(function (t) { return !t.completed; }).length;
+		var countText = activeCount + ' item' + (activeCount !== 1 ? 's' : '') + ' left';
+		todoCount.innerHTML = '<strong>' + activeCount + '</strong> ' + countText.split(' ').slice(1).join(' ');
+	}
+
+	/**
+	 * @planks("the toggle-all checkbox is checked")
+	 * @planks("the toggle-all checkbox is not checked")
+	 */
+	function updateToggleAll() {
+		var allCompleted = todos.length > 0 && todos.every(function (t) { return t.completed; });
+		toggleAllCheckbox.checked = allCompleted;
+	}
+
+	/**
+	 * @planks("the clear-completed button is hidden")
+	 * @planks("the clear-completed button is visible")
+	 */
+	function updateClearCompleted() {
+		var hasCompleted = todos.some(function (t) { return t.completed; });
+		clearCompletedButton.style.display = hasCompleted ? '' : 'none';
+	}
+
+	/**
+	 * @planks("the main section is hidden")
+	 * @planks("the main section is visible")
+	 * @planks("the footer is hidden")
+	 * @planks("the footer is visible")
+	 */
+	function updateVisibility() {
+		var hasTodos = todos.length > 0;
+		mainSection.style.display = hasTodos ? '' : 'none';
+		footer.style.display = hasTodos ? '' : 'none';
+	}
+
+	/**
+	 * @planks("the {string} filter is selected")
+	 */
+	function updateFilters() {
+		var links = filters.querySelectorAll('a');
+		for (var i = 0; i < links.length; i++) {
+			var link = links[i];
+			var href = link.getAttribute('href');
+			if (href === '#' + currentFilter || href === currentFilter) {
+				link.classList.add('selected');
+			} else {
+				link.classList.remove('selected');
+			}
+		}
+	}
+
+	function render() {
+		var visibleTodos = getVisibleTodos();
+		todoList.innerHTML = '';
+
+		for (var i = 0; i < visibleTodos.length; i++) {
+			var todo = visibleTodos[i];
+			var li = document.createElement('li');
+			li.dataset.id = todo.id;
+			if (todo.completed) {
+				li.classList.add('completed');
+			}
+
+			var div = document.createElement('div');
+			div.className = 'view';
+
+			var checkbox = document.createElement('input');
+			checkbox.className = 'toggle';
+			checkbox.type = 'checkbox';
+			checkbox.checked = todo.completed;
+			checkbox.addEventListener('click', (function (id) {
+				return function () { toggleTodo(id); };
+			})(todo.id));
+
+			var label = document.createElement('label');
+			label.textContent = todo.title;
+			label.addEventListener('dblclick', (function (li) {
+				return function () {
+					li.classList.add('editing');
+					var editInput = li.querySelector('.edit');
+					editInput.focus();
+				};
+			})(li));
+
+			var destroyButton = document.createElement('button');
+			destroyButton.className = 'destroy';
+			destroyButton.addEventListener('click', (function (id) {
+				return function () { deleteTodo(id); };
+			})(todo.id));
+
+			div.appendChild(checkbox);
+			div.appendChild(label);
+			div.appendChild(destroyButton);
+
+			var editInput = document.createElement('input');
+			editInput.className = 'edit';
+			editInput.value = todo.title;
+			editInput.addEventListener('blur', (function (id, input) {
+				return function () {
+					var li = input.closest('li');
+					if (li && li.classList.contains('editing')) {
+						editTodo(id, input.value);
+					}
+				};
+			})(todo.id, editInput));
+			editInput.addEventListener('keydown', (function (id, input) {
+				return function (e) {
+					if (e.key === 'Enter') {
+						editTodo(id, input.value);
+					} else if (e.key === 'Escape') {
+						input.value = todos.find(function (t) { return t.id === id; }).title;
+						input.closest('li').classList.remove('editing');
+					}
+				};
+			})(todo.id, editInput));
+
+			li.appendChild(div);
+			li.appendChild(editInput);
+			todoList.appendChild(li);
+		}
+
+		updateCount();
+		updateToggleAll();
+		updateClearCompleted();
+		updateVisibility();
+		updateFilters();
+	}
+
+	function saveTodos() {
+		localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
+	}
+
+	function loadTodos() {
+		var stored = localStorage.getItem(STORAGE_KEY);
+		if (stored) {
+			todos = JSON.parse(stored);
+		}
+	}
+
+	function handleRoute() {
+		currentFilter = window.location.hash.replace('#', '') || '/';
+		render();
+	}
+
+	// Event listeners
+	newTodoInput.addEventListener('keydown', function (e) {
+		if (e.key === 'Enter') {
+			addTodo(newTodoInput.value);
+			newTodoInput.value = '';
+		}
+	});
+
+	toggleAllCheckbox.addEventListener('change', function () {
+		var allCompleted = toggleAllCheckbox.checked;
+		for (var i = 0; i < todos.length; i++) {
+			todos[i].completed = allCompleted;
+		}
+		saveTodos();
+		render();
+	});
+
+	clearCompletedButton.addEventListener('click', function () {
+		clearCompleted();
+	});
