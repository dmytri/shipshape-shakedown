+const { Given, When, Then } = require('@cucumber/cucumber');
+const assert = require('assert');
+
+// Helper: find a todo by title
+function findTodo(title) {
+  const items = this.document.querySelectorAll('.todo-list li');
+  for (const item of items) {
+    const label = item.querySelector('label');
+    if (label && label.textContent === title) return item;
+  }
+  return null;
+}
+
+// Helper: get all visible todos
+function getVisibleTodos() {
+  const items = this.document.querySelectorAll('.todo-list li');
+  return Array.from(items).filter(item => item.style.display !== 'none');
+}
+
+// ========== Given steps ==========
+
+Given('the app is loaded', function () {
+  // App is loaded by Before hook in world.js
+  assert(this.document, 'App should be loaded');
+});
+
+Given('a todo {string} exists', function (title) {
+  const input = this.document.querySelector('.new-todo');
+  input.value = title;
+  input.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, bubbles: true }));
+});
+
+Given('a completed todo {string} exists', function (title) {
+  // Create the todo first
+  const input = this.document.querySelector('.new-todo');
+  input.value = title;
+  input.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, bubbles: true }));
+  // Then mark it as completed
+  const todo = findTodo.call(this, title);
+  assert(todo, `Todo "${title}" should exist`);
+  const checkbox = todo.querySelector('.toggle');
+  checkbox.click();
+});
+
+// ========== When steps ==========
+
+When('the user types {string} in the new-todo input and presses Enter', function (title) {
+  const input = this.document.querySelector('.new-todo');
+  input.value = title;
+  input.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, bubbles: true }));
+});
+
+When('the user toggles the checkbox for {string}', function (title) {
+  const todo = findTodo.call(this, title);
+  assert(todo, `Todo "${title}" should exist`);
+  const checkbox = todo.querySelector('.toggle');
+  checkbox.click();
+});
+
+When('the user double-clicks the label {string}', function (title) {
+  const todo = findTodo.call(this, title);
+  assert(todo, `Todo "${title}" should exist`);
+  const label = todo.querySelector('label');
+  label.dispatchEvent(new this.window.Event('dblclick', { bubbles: true }));
+});
+
+When('the user types {string} in the edit input and presses Enter', function (title) {
+  const editing = this.document.querySelector('.todo-list li.editing');
+  assert(editing, 'Should be in editing mode');
+  const input = editing.querySelector('.edit');
+  input.value = title;
+  input.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, bubbles: true }));
+});
+
+When('the user types {string} in the edit input and blurs', function (title) {
+  const editing = this.document.querySelector('.todo-list li.editing');
+  assert(editing, 'Should be in editing mode');
+  const input = editing.querySelector('.edit');
+  input.value = title;
+  input.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+  input.dispatchEvent(new this.window.Event('blur', { bubbles: true }));
+});
+
+When('the user types {string} in the edit input and presses Escape', function (title) {
+  const editing = this.document.querySelector('.todo-list li.editing');
+  assert(editing, 'Should be in editing mode');
+  const input = editing.querySelector('.edit');
+  input.value = title;
+  input.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Escape', keyCode: 27, bubbles: true }));
+});
+
+When('the user clears the edit input and presses Enter', function () {
+  const editing = this.document.querySelector('.todo-list li.editing');
+  assert(editing, 'Should be in editing mode');
+  const input = editing.querySelector('.edit');
+  input.value = '';
+  input.dispatchEvent(new this.window.Event('input', { bubbles: true }));
+  input.dispatchEvent(new this.window.KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, bubbles: true }));
+});
+
+When('the user clicks the destroy button for {string}', function (title) {
+  const todo = findTodo.call(this, title);
+  assert(todo, `Todo "${title}" should exist`);
+  const destroy = todo.querySelector('.destroy');
+  destroy.click();
+});
+
+When('the user clicks the clear-completed button', function () {
+  const button = this.document.querySelector('.clear-completed');
+  button.click();
+});
+
+When('the user checks the toggle-all checkbox', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  toggleAll.checked = true;
+  toggleAll.dispatchEvent(new this.window.Event('change', { bubbles: true }));
+});
+
+When('the user unchecks the toggle-all checkbox', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  toggleAll.checked = false;
+  toggleAll.dispatchEvent(new this.window.Event('change', { bubbles: true }));
+});
+
+When('the app is reloaded', function () {
+  // Save current todos to localStorage
+  const todos = JSON.parse(this.window.localStorage.getItem('todos') || '[]');
+  // Reload the app
+  this.loadApp();
+  // Restore todos to localStorage
+  this.window.localStorage.setItem('todos', JSON.stringify(todos));
+  // Re-initialize the app with the restored data
+  this.window.eval('window.dispatchEvent(new Event("load"))');
+});
+
+When('the user navigates to {string}', function (hash) {
+  this.navigate(hash);
+});
+
+// ========== Then steps ==========
+
+Then('a todo with title {string} exists in the list', function (title) {
+  const todo = findTodo.call(this, title);
+  assert(todo, `Todo "${title}" should exist in the list`);
+});
+
+Then('no todo with title {string} exists', function (title) {
+  const todo = findTodo.call(this, title);
+  assert(!todo, `Todo "${title}" should not exist`);
+});
+
+Then('no todos exist', function () {
+  const items = this.document.querySelectorAll('.todo-list li');
+  assert.strictEqual(items.length, 0, 'No todos should exist');
+});
+
+Then('the new-todo input is empty', function () {
+  const input = this.document.querySelector('.new-todo');
+  assert.strictEqual(input.value, '', 'New-todo input should be empty');
+});
+
+Then('the new-todo input is focused', function () {
+  const input = this.document.querySelector('.new-todo');
+  assert.strictEqual(this.document.activeElement, input, 'New-todo input should be focused');
+});
+
+Then('the todo {string} is not completed', function (title) {
+  const todo = findTodo.call(this, title);
+  assert(todo, `Todo "${title}" should exist`);
+  assert(!todo.classList.contains('completed'), `Todo "${title}" should not be completed`);
+});
+
+Then('the todo {string} is completed', function (title) {
+  const todo = findTodo.call(this, title);
+  assert(todo, `Todo "${title}" should exist`);
+  assert(todo.classList.contains('completed'), `Todo "${title}" should be completed`);
+});
+
+Then('the todo item {string} has the class {string}', function (title, className) {
+  const todo = findTodo.call(this, title);
+  assert(todo, `Todo "${title}" should exist`);
+  assert(todo.classList.contains(className), `Todo "${title}" should have class "${className}"`);
+});
+
+Then('the edit input for {string} contains {string}', function (title, value) {
+  const todo = findTodo.call(this, title);
+  assert(todo, `Todo "${title}" should exist`);
+  const input = todo.querySelector('.edit');
+  assert.strictEqual(input.value, value, `Edit input should contain "${value}"`);
+});
+
+Then('the edit input for {string} is focused', function (title) {
+  const todo = findTodo.call(this, title);
+  assert(todo, `Todo "${title}" should exist`);
+  const input = todo.querySelector('.edit');
+  assert.strictEqual(this.document.activeElement, input, 'Edit input should be focused');
+});
+
+Then('the clear-completed button is hidden', function () {
+  const button = this.document.querySelector('.clear-completed');
+  const style = this.window.getComputedStyle(button);
+  assert(style.display === 'none' || button.offsetParent === null, 'Clear-completed button should be hidden');
+});
+
+Then('the clear-completed button is visible', function () {
+  const button = this.document.querySelector('.clear-completed');
+  const style = this.window.getComputedStyle(button);
+  assert(style.display !== 'none' && button.offsetParent !== null, 'Clear-completed button should be visible');
+});
+
+Then('the todo count shows {string}', function (countText) {
+  const count = this.document.querySelector('.todo-count');
+  assert(count.textContent.includes(countText), `Todo count should show "${countText}"`);
+});
+
+Then('the todo {string} is visible in the list', function (title) {
+  const todo = findTodo.call(this, title);
+  assert(todo, `Todo "${title}" should exist`);
+  const style = this.window.getComputedStyle(todo);
+  assert(style.display !== 'none', `Todo "${title}" should be visible`);
+});
+
+Then('the todo {string} is not visible in the list', function (title) {
+  const todo = findTodo.call(this, title);
+  if (todo) {
+    const style = this.window.getComputedStyle(todo);
+    assert(style.display === 'none', `Todo "${title}" should not be visible`);
+  }
+});
+
+Then('the toggle-all checkbox is checked', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  assert(toggleAll.checked, 'Toggle-all checkbox should be checked');
+});
+
+Then('the toggle-all checkbox is not checked', function () {
+  const toggleAll = this.document.querySelector('#toggle-all');
+  assert(!toggleAll.checked, 'Toggle-all checkbox should not be checked');
+});
+
+Then('the main section is hidden', function () {
+  const main = this.document.querySelector('.main');
+  const style = this.window.getComputedStyle(main);
+  assert(style.display === 'none', 'Main section should be hidden');
+});
+
+Then('the main section is visible', function () {
+  const main = this.document.querySelector('.main');
+  const style = this.window.getComputedStyle(main);
+  assert(style.display !== 'none', 'Main section should be visible');
+});
+
+Then('the footer is hidden', function () {
+  const footer = this.document.querySelector('.footer');
+  const style = this.window.getComputedStyle(footer);
+  assert(style.display === 'none', 'Footer should be hidden');
+});
+
+Then('the footer is visible', function () {
+  const footer = this.document.querySelector('.footer');
+  const style = this.window.getComputedStyle(footer);
+  assert(style.display !== 'none', 'Footer should be visible');
+});
+
+Then('the {string} filter is selected', function (filterName) {
+  const links = this.document.querySelectorAll('.filters a');
+  let found = false;
+  for (const link of links) {
+    if (link.textContent === filterName && link.classList.contains('selected')) {
+      found = true;
+      break;
+    }
+  }
+  assert(found, `Filter "${filterName}" should be selected`);
+});
