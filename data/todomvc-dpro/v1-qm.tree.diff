+});
+
+Then("the footer is visible", function () {
+  const footer = world.document.querySelector(".footer");
+  const style = world.window.getComputedStyle(footer);
+  assert.notStrictEqual(
+    style.display,
+    "none",
+    "Expected footer to be visible"
