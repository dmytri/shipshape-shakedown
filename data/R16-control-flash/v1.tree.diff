+      if ((filter === 'all' && href === '#/') ||
+          (filter === 'active' && href === '#/active') ||
+          (filter === 'completed' && href === '#/completed')) {
+        a.classList.add('selected');
+      } else {
+        a.classList.remove('selected');
+      }
+    }
+
+    // Persist filter
+    localStorage.setItem('todos-javascript-filter', filter);
+  };
