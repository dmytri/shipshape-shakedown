+  TodoApp.prototype.render = function () {
+    var todos = this.store.load();
+    var filter = this.getFilter();
+
+    // Apply filter
+    var visibleTodos;
+    if (filter === 'active') {
+      visibleTodos = todos.filter(function (t) { return !t.completed; });
+    } else if (filter === 'completed') {
+      visibleTodos = todos.filter(function (t) { return t.completed; });
+    } else {
+      visibleTodos = todos;
+    }
+
+    var activeCount = todos.filter(function (t) { return !t.completed; }).length;
+    var completedCount = todos.length - activeCount;
+
+    // Render visible todo items
+    var html = '';
+    for (var i = 0; i < visibleTodos.length; i++) {
+      var t = visibleTodos[i];
+      var cls = t.completed ? 'completed' : '';
+      html += '<li class="' + cls + '">' +
+        '<div class="view">' +
+        '<input class="toggle" type="checkbox"' + (t.completed ? ' checked' : '') + '>' +
+        '<label>' + this.escapeHtml(t.title) + '</label>' +
+        '<button class="destroy"></button>' +
+        '</div>' +
+        '<input class="edit" value="' + this.escapeHtml(t.title) + '">' +
+        '</li>';
+    }
+    this.todoList.innerHTML = html;
+
+    // Show/hide main and footer based on whether there are any todos
+    if (todos.length === 0) {
+      this.main.style.display = 'none';
+      this.footer.style.display = 'none';
+    } else {
+      this.main.style.display = 'block';
+      this.footer.style.display = 'block';
+    }
+
+    // Update toggle-all checkbox
+    this.toggleAll.checked = todos.length > 0 && activeCount === 0;
+
+    // Update todo-count
+    var word = activeCount === 1 ? 'item' : 'items';
+    this.todoCount.innerHTML = '<strong>' + activeCount + '</strong> ' + word + ' left';
+
+    // Show/hide clear-completed button
+    if (completedCount > 0) {
+      this.clearCompleted.style.display = 'block';
+    } else {
+      this.clearCompleted.style.display = 'none';
+    }
+
+    // Update filter link selected state
+    var filterLinks = this.filters.querySelectorAll('a');
+    for (var i = 0; i < filterLinks.length; i++) {
+      var a = filterLinks[i];
