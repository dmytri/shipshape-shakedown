+          self.render();
+        }
+      }
+    });
+
+    this.todoList.addEventListener('blur', function (e) {
+      if (e.target.classList.contains('edit')) {
+        var li = e.target.closest('li');
+        var label = li.querySelector('label');
+        var originalTitle = label.textContent;
+        var newTitle = e.target.value.trim();
+
+        if (newTitle && newTitle !== originalTitle) {
+          var todos = self.store.load();
+          for (var i = 0; i < todos.length; i++) {
+            if (todos[i].title === originalTitle) {
+              todos[i].title = newTitle;
+              break;
+            }
+          }
+          self.store.save(todos);
+          self.render();
+        }
+      }
+    }, true);
+  };
