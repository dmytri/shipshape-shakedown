+(function () {
+  'use strict';
+
+  var STORAGE_KEY = 'todos-javascript';
+  var ENTER_KEY = 13;
+
+  // ----- Model -----
+
+  function TodoStore(key) {
+    this.key = key;
+  }
+
+  TodoStore.prototype.load = function () {
+    var raw = localStorage.getItem(this.key);
+    return raw ? JSON.parse(raw) : [];
+  };
+
+  TodoStore.prototype.save = function (todos) {
+    localStorage.setItem(this.key, JSON.stringify(todos));
+  };
+
+  // ----- View -----
+
+  function TodoApp(element, store) {
+    this.element = element;
+    this.store = store;
+    this.newTodo = element.querySelector('.new-todo');
+    this.main = element.querySelector('.main');
+    this.footer = element.querySelector('.footer');
+    this.todoList = element.querySelector('.todo-list');
+    this.todoCount = element.querySelector('.todo-count');
+    this.clearCompleted = element.querySelector('.clear-completed');
+    this.toggleAll = element.querySelector('.toggle-all');
+    this.filters = element.querySelector('.filters');
+
+    // Restore persisted filter on init
+    var savedFilter = localStorage.getItem('todos-javascript-filter');
+    if (savedFilter === 'active') {
+      window.location.hash = '#/active';
+    } else if (savedFilter === 'completed') {
+      window.location.hash = '#/completed';
+    } else {
+      window.location.hash = '#/';
+    }
+
+    this.bindEvents();
+    this.render();
+  }
+
+  TodoApp.prototype.getFilter = function () {
+    var hash = window.location.hash;
+    if (hash === '#/active') return 'active';
+    if (hash === '#/completed') return 'completed';
+    return 'all';
+  };
+
+  TodoApp.prototype.bindEvents = function () {
+    var self = this;
+
+    this.newTodo.addEventListener('keydown', function (e) {
+      if (e.keyCode === ENTER_KEY) {
+        var title = self.newTodo.value.trim();
+        if (title) {
+          var todos = self.store.load();
+          todos.push({
+            id: Date.now().toString(),
+            title: title,
+            completed: false
+          });
+          self.store.save(todos);
+          self.newTodo.value = '';
+          self.render();
+        }
+      }
+    });
+
+    window.addEventListener('hashchange', function () {
+      self.render();
+    });
+
+    // Delegate toggle checkbox changes
+    this.todoList.addEventListener('change', function (e) {
+      if (e.target.classList.contains('toggle')) {
+        var li = e.target.closest('li');
+        var label = li.querySelector('label');
+        var title = label.textContent;
+        var todos = self.store.load();
+        for (var i = 0; i < todos.length; i++) {
+          if (todos[i].title === title) {
+            todos[i].completed = e.target.checked;
+            break;
+          }
+        }
+        self.store.save(todos);
+        self.render();
+      }
+    });
+
+    // Toggle-all checkbox
+    this.toggleAll.addEventListener('change', function () {
+      var checked = self.toggleAll.checked;
+      var todos = self.store.load();
+      for (var i = 0; i < todos.length; i++) {
+        todos[i].completed = checked;
+      }
+      self.store.save(todos);
+      self.render();
+    });
+
+    // Clear completed button
+    this.clearCompleted.addEventListener('click', function () {
+      var todos = self.store.load();
+      todos = todos.filter(function (t) { return !t.completed; });
+      self.store.save(todos);
+      self.render();
+    });
+
+    // Delegate destroy button clicks
+    this.todoList.addEventListener('click', function (e) {
+      if (e.target.classList.contains('destroy')) {
+        var li = e.target.closest('li');
+        var label = li.querySelector('label');
+        var title = label.textContent;
+        var todos = self.store.load();
+        for (var i = 0; i < todos.length; i++) {
+          if (todos[i].title === title) {
+            todos.splice(i, 1);
+            break;
+          }
+        }
+        self.store.save(todos);
+        self.render();
+      }
+    });
+
+    // Delegate label double-click for editing
