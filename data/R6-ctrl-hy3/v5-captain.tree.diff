@@ -0,0 +1,26 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "title": "edit-commit re-entrancy guard",
+  "description": "Source-level guard for the edit-commit path in the vanilla TodoMVC app. Committing an edit that empties the text must remove the item and end the editing session before the post-commit re-render, so a blur event arriving after the commit is a no-op instead of re-invoking the commit and double-removing the list item node.",
+  "seam": {
+    "file": "js/app.js",
+    "functions": ["commitEdit", "handleEditBlur"]
+  },
+  "defect": {
+    "acceptanceFailure": "TodoMVC > Editing > should remove the item if an empty text string was entered",
+    "error": "NotFoundError: Failed to execute 'removeChild' on 'Node': The node to be removed is no longer a child of this node. Perhaps it was moved in a 'blur' event handler?",
+    "origin": "render() at js/app.js:134 (list.removeChild) called from commitEdit() from handleEditKeydown()",
+    "mechanism": "In a real browser, removing the focused edit <input> (inside the list item) during the keydown-triggered render() fires a synchronous blur. handleEditBlur re-invokes commitEdit while the outer render() is still detaching that same list item, so a second render() removes the node before the outer removeChild runs, throwing NotFoundError. The edit session is never ended on commit, so the blur guard (which tests the 'editing' class) still passes and re-commits.",
+    "harnessMask": "happy-dom does not fire blur when a focused node is removed (verified in-harness: blur fired = false), so the in-harness suite cannot reproduce the double-removeChild. The guard therefore lives at the source level."
+  },
+  "invariant": "Committing an edit ends the editing session before the post-commit render(), so a re-entrant blur handler is a no-op rather than re-invoking the commit and double-removing the node.",
+  "acceptanceChecks": [
+    "commitEdit removes the 'editing' class from the committed list item before it calls render(), OR",
+    "handleEditBlur guards the re-invoke so it cannot fire once the edit is committed or the list item is already removed from the document"
+  ],
+  "currentState": "commitEdit leaves the 'editing' class on the removed list item and never ends the editing session; handleEditBlur re-invokes commitEdit on it. The checker reddens on the current source.",
+  "conformance": {
+    "verifier": "QM-owned bespoke checker (no independent engine discharges this structural invariant). Reads js/app.js and asserts the invariant above.",
+    "plantedRed": "Proven red by the current source: no end-of-edit-session guard is present, so the checker fails. After Crew ends the editing session on commit, the check turns green."
+  }
+}
